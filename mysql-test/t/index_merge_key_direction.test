--echo #
--echo # Bug #120476: Match index and clustered-key directions for rowid ordering
--echo #

# InnoDB supplies the clustered rowid order used by index merge.
if (`SELECT COUNT(*) = 0 FROM INFORMATION_SCHEMA.ENGINES WHERE ENGINE = 'InnoDB' AND SUPPORT IN ('YES', 'DEFAULT')`)
{
  --skip Requires InnoDB
}

# The input includes multibyte text, so use its declared character set.
# Keep the data distribution and statistics that select the index-merge plan.
# The first UNIQUE NOT NULL key defines InnoDB's clustered row order.
SET @save_character_set_client=@@character_set_client;

SET @save_character_set_results=@@character_set_results;

SET @save_collation_connection=@@collation_connection;

SET NAMES utf8mb4;

SET @save_optimizer_switch=@@optimizer_switch;

CREATE TABLE idx_t0 (
  `c0` int NOT NULL,
  `c2` int DEFAULT NULL,
  `c4` int NOT NULL,
  `c7` varchar(255) NOT NULL,
  UNIQUE KEY `cluster_key` (`c0` DESC,`c4`) USING BTREE,
  KEY `key_c2` (`c2`),
  KEY `key_c7_c0` (`c7`,`c0`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

