--echo #
--echo # Bug#118624 Regression coverage
--echo #
SET @save_optimizer_switch=@@optimizer_switch;
SET @save_sql_mode=@@sql_mode;
SET @save_default_storage_engine=@@default_storage_engine;
SET @save_character_set_client=@@character_set_client;
SET @save_character_set_results=@@character_set_results;
SET @save_character_set_connection=@@character_set_connection;
SET @save_collation_connection=@@collation_connection;
CREATE DATABASE bug_118624 CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE bug_118624;
SET sql_mode=DEFAULT;
SET optimizer_switch=DEFAULT;
SET default_storage_engine=InnoDB;
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
SET NAMES utf8mb4;
CREATE TABLE tt2 (emp_id varchar(64) COLLATE utf8mb4_bin NOT NULL,emp_name varchar(160) COLLATE utf8mb4_bin DEFAULT NULL,is_delete varchar(10) COLLATE utf8mb4_bin DEFAULT NULL,PRIMARY KEY(emp_id),KEY idx_mdm_employee_name(emp_name));
INSERT INTO tt2 VALUES ('Y0071839','张
凯','0');
SET SESSION optimizer_switch='index_condition_pushdown=on';
--sorted_result
SELECT emp_id,emp_name FROM tt2 T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0';
PREPARE regression_stmt FROM 'SELECT emp_id,emp_name FROM tt2 T WHERE T.emp_name LIKE CONCAT(''张'',''%'') AND T.is_delete=''0'';';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
--sorted_result
SELECT emp_id, emp_name FROM tt2 T WHERE T.emp_name LIKE '张%' AND T.is_delete='0';
--sorted_result
SELECT emp_id, emp_name FROM tt2 T WHERE T.is_delete='0' AND T.emp_name LIKE CONCAT('张','%');
--sorted_result
SELECT emp_id, emp_name FROM tt2 T FORCE INDEX (idx_mdm_employee_name) WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0';
--sorted_result
WITH filtered AS (SELECT emp_id, emp_name FROM tt2 T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0') SELECT emp_id, emp_name FROM filtered;
--sorted_result
SELECT D.emp_id, D.emp_name FROM (SELECT emp_id, emp_name, is_delete, emp_name LIKE CONCAT('张','%') AS name_matches FROM tt2) D WHERE D.name_matches AND D.is_delete='0';
--sorted_result
SELECT T.emp_id, T.emp_name FROM tt2 T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0' AND T.emp_id < 'M' UNION ALL SELECT T.emp_id, T.emp_name FROM tt2 T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0' AND NOT (T.emp_id < 'M') UNION ALL SELECT T.emp_id, T.emp_name FROM tt2 T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0' AND (T.emp_id < 'M') IS NULL;
--sorted_result
SELECT emp_id, emp_name FROM tt2 T WHERE NOT NOT (T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0');
--sorted_result
SELECT emp_id, emp_name FROM tt2 T IGNORE INDEX (idx_mdm_employee_name) WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0';
--sorted_result
SELECT emp_id, emp_name FROM tt2 T WHERE CASE WHEN (T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0') THEN (T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0') ELSE (T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0') END;
--sorted_result
SELECT T.emp_id,T.emp_name FROM tt2 AS T WHERE T.emp_name LIKE '张%' AND T.is_delete='0';
--sorted_result
SELECT T.emp_id,T.emp_name FROM tt2 AS T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete IN ('0');
--sorted_result
SELECT T.emp_id,T.emp_name FROM tt2 AS T WHERE NOT (NOT (T.emp_name LIKE CONCAT('张','%'))) AND T.is_delete='0';
--sorted_result
SELECT T.emp_id,T.emp_name FROM tt2 AS T FORCE INDEX (idx_mdm_employee_name) WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0';
--sorted_result
SELECT D.emp_id,D.emp_name FROM (SELECT emp_id,emp_name,is_delete FROM tt2) AS D WHERE D.emp_name LIKE CONCAT('张','%') AND D.is_delete='0';
--sorted_result
SELECT D.emp_id,D.emp_name FROM (SELECT emp_id,emp_name,is_delete,emp_name LIKE CONCAT('张','%') AS name_matches FROM tt2) AS D WHERE D.name_matches AND D.is_delete='0';
--sorted_result
SELECT T.emp_id,T.emp_name FROM tt2 AS T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0' AND (T.emp_name LIKE CONCAT('张','%')) UNION ALL SELECT T.emp_id,T.emp_name FROM tt2 AS T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0' AND NOT (T.emp_name LIKE CONCAT('张','%')) UNION ALL SELECT T.emp_id,T.emp_name FROM tt2 AS T WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0' AND (T.emp_name LIKE CONCAT('张','%')) IS NULL;
--sorted_result
SELECT T.emp_id,T.emp_name FROM tt2 AS T WHERE NOT (NOT (T.emp_name LIKE CONCAT('张','%')) OR NOT (T.is_delete='0'));
--sorted_result
SELECT T.emp_id,T.emp_name FROM tt2 AS T IGNORE INDEX (idx_mdm_employee_name) WHERE T.emp_name LIKE CONCAT('张','%') AND T.is_delete='0';
USE test;
DROP DATABASE bug_118624;
CREATE DATABASE bug_118624 CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE bug_118624;
SET sql_mode=DEFAULT;
SET optimizer_switch=DEFAULT;
SET default_storage_engine=InnoDB;
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
CREATE TABLE t (id INT,c VARCHAR(20) COLLATE utf8mb4_bin,KEY k(c));
INSERT INTO t VALUES (1,'张'),(2,CONCAT('张',CHAR(1))),(3,'张 '),(4,'张a'),(5,'李'),(6,NULL);
--sorted_result
SELECT id FROM t FORCE INDEX(k) WHERE c LIKE CONCAT('张','%');
PREPARE regression_stmt FROM 'SELECT id FROM t FORCE INDEX(k) WHERE c LIKE CONCAT(''张'',''%'');';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
USE test;
