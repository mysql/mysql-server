--source include/have_debug.inc
--source include/have_hypergraph.inc
--source include/elide_costs.inc

--echo #
--echo # Hypergraph iterator EXPLAIN access-path coverage
--echo #

# INDEX_DISTANCE_SCAN requires the debug handlerton capability until InnoDB
# implements physical distance scans. The flag makes the optimizer select the
# iterator access path without changing the storage engine's execution support.
CREATE TABLE t_explain_distance (
  location POINT NOT NULL SRID 0,
  SPATIAL INDEX location_idx (location),
  id INT NOT NULL AUTO_INCREMENT,
  PRIMARY KEY (id)
) ENGINE = InnoDB;
INSERT INTO t_explain_distance (location) VALUES
  (POINT(50, 35)), (POINT(50, 34)), (POINT(50, 33)), (POINT(50, 32)),
  (POINT(50, 31)), (POINT(50, 30)), (POINT(50, 29)), (POINT(50, 28)),
  (POINT(50, 27)), (POINT(49, 27)), (POINT(48, 27)), (POINT(47, 27)),
  (POINT(46, 27)), (POINT(45, 27));
--disable_result_log
ANALYZE TABLE t_explain_distance;
--enable_result_log

SET debug = '+d,handlerton_supports_distance_scan';
--replace_regex $elide_costs
EXPLAIN FORMAT = TREE
SELECT ST_Distance(location, POINT(0, 0)) AS distance_to_origin
FROM t_explain_distance
ORDER BY distance_to_origin;
SET debug = '';

DROP TABLE t_explain_distance;

# Exercise multiple residual hash-join conditions and the no-spill annotation.
CREATE TABLE t_explain_hash_left (
  a INT NOT NULL,
  b INT NOT NULL,
  c INT NOT NULL,
  padding CHAR(200) NOT NULL DEFAULT 'x'
) ENGINE = InnoDB;
INSERT INTO t_explain_hash_left (a, b, c)
WITH RECURSIVE sequence (n) AS (
  SELECT 1 UNION ALL SELECT n + 1 FROM sequence WHERE n < 1000
)
SELECT n, n, n FROM sequence;
CREATE TABLE t_explain_hash_right LIKE t_explain_hash_left;
INSERT INTO t_explain_hash_right (a, b, c)
SELECT a, b + 1, c + 1 FROM t_explain_hash_left;
--disable_result_log
ANALYZE TABLE t_explain_hash_left, t_explain_hash_right;
--enable_result_log
SET @explain_access_path_join_buffer_size = @@join_buffer_size;
SET join_buffer_size = 1024;
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT = TREE
SELECT *
FROM t_explain_hash_left AS l
JOIN t_explain_hash_right AS r ON l.a = r.a
LIMIT 3;
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT = TREE
SELECT *
FROM t_explain_hash_left AS l
JOIN t_explain_hash_right AS r
  ON l.a = r.a AND l.b < r.b AND l.c < r.c;
SET join_buffer_size = @explain_access_path_join_buffer_size;
DROP TABLE t_explain_hash_left, t_explain_hash_right;

--source include/disable_hypergraph.inc
