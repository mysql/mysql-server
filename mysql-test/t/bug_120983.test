--echo #
--echo # Bug#120983 Regression coverage
--echo #
SET @save_optimizer_switch=@@optimizer_switch;
SET @save_sql_mode=@@sql_mode;
SET @save_default_storage_engine=@@default_storage_engine;
SET @save_character_set_client=@@character_set_client;
SET @save_character_set_results=@@character_set_results;
SET @save_character_set_connection=@@character_set_connection;
SET @save_collation_connection=@@collation_connection;
CREATE DATABASE bug_120983 CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE bug_120983;
SET sql_mode=DEFAULT;
SET optimizer_switch=DEFAULT;
SET default_storage_engine=InnoDB;
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
CREATE TABLE t0 (c0 TINYTEXT, c1 BIT);
INSERT INTO t0 (c0,c1) VALUES ('a',0),('b',0),('c',1),('d',1);
CREATE TABLE t1 AS (SELECT VAR_POP(c0) AS c0, c1 AS c1 FROM t0 GROUP BY c1);
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 WHERE c1 NOT IN (SELECT c1 FROM t0 WHERE c1) GROUP BY c1;
PREPARE regression_stmt FROM 'SELECT VAR_POP(c0), c1 FROM t0 WHERE c1 NOT IN (SELECT c1 FROM t0 WHERE c1) GROUP BY c1;';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 WHERE c1 <> ALL (SELECT c1 FROM t0 WHERE c1) GROUP BY c1;
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 WHERE NOT (NOT (c1 NOT IN (SELECT c1 FROM t0 WHERE c1))) GROUP BY c1;
--sorted_result
SELECT VAR_POP(c0), c1 FROM (SELECT c0, c1, c1 NOT IN (SELECT c1 FROM t0 WHERE c1) AS predicate_result FROM t0) AS filtered_rows WHERE predicate_result GROUP BY c1;
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 WHERE NOT (c1 IN (SELECT c1 FROM t0 WHERE c1)) GROUP BY c1;
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 WHERE ((c1 NOT IN (SELECT c1 FROM t0 WHERE c1)) OR NOT (c1 NOT IN (SELECT c1 FROM t0 WHERE c1)) OR (c1 NOT IN (SELECT c1 FROM t0 WHERE c1)) IS NULL) AND (c1 NOT IN (SELECT c1 FROM t0 WHERE c1)) GROUP BY c1;
--sorted_result
SELECT VARIANCE(c0), c1 FROM t0 WHERE c1 NOT IN (SELECT c1 FROM t0 WHERE c1) GROUP BY c1;
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 WHERE c1 NOT IN (SELECT DISTINCT c1 FROM t0 WHERE c1) GROUP BY c1;
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 WHERE NOT NOT (c1 NOT IN (SELECT c1 FROM t0 WHERE c1)) GROUP BY c1;
--sorted_result
SELECT VAR_POP(d.c0), d.c1 FROM (SELECT c0, c1 FROM t0) AS d WHERE d.c1 NOT IN (SELECT c1 FROM t0 WHERE c1) GROUP BY d.c1;
--sorted_result
SELECT VAR_POP(d.c0), d.c1 FROM (SELECT c0, c1, c1 NOT IN (SELECT c1 FROM t0 WHERE c1) AS keep_row FROM t0) AS d WHERE d.keep_row GROUP BY d.c1;
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 AS outer_t WHERE c1 IS NOT NULL AND NOT EXISTS (SELECT 1 FROM t0 AS inner_t WHERE inner_t.c1 AND inner_t.c1 = outer_t.c1) GROUP BY c1;
--sorted_result
SELECT VAR_POP(c0), c1 FROM t0 WHERE CASE WHEN c1 NOT IN (SELECT c1 FROM t0 WHERE c1) THEN c1 NOT IN (SELECT c1 FROM t0 WHERE c1) ELSE c1 NOT IN (SELECT c1 FROM t0 WHERE c1) END GROUP BY c1;
USE test;
DROP DATABASE bug_120983;
CREATE DATABASE bug_120983 CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE bug_120983;
SET sql_mode=DEFAULT;
SET optimizer_switch=DEFAULT;
SET default_storage_engine=InnoDB;
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
CREATE TABLE o (id INT PRIMARY KEY,k BIT);
INSERT INTO o VALUES (1,b'0'),(2,b'1'),(3,NULL);
CREATE TABLE i_null (k BIT);
INSERT INTO i_null VALUES (b'1'),(NULL);
CREATE TABLE i_value (k BIT);
INSERT INTO i_value VALUES (b'1');
CREATE TABLE i_empty (k BIT);
CREATE TABLE i_allnull (k BIT);
INSERT INTO i_allnull VALUES (NULL);
SET optimizer_switch='materialization=on,subquery_materialization_cost_based=off,semijoin=off';
--sorted_result
SELECT id,k IN (SELECT k FROM i_null) AS present,k NOT IN (SELECT k FROM i_null) AS absent FROM o ORDER BY id;
PREPARE regression_stmt FROM 'SELECT id,k IN (SELECT k FROM i_null) AS present,k NOT IN (SELECT k FROM i_null) AS absent FROM o ORDER BY id;';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
--sorted_result
SELECT id,k IN (SELECT k FROM i_value) AS present,k NOT IN (SELECT k FROM i_value) AS absent FROM o ORDER BY id;
PREPARE regression_stmt FROM 'SELECT id,k IN (SELECT k FROM i_value) AS present,k NOT IN (SELECT k FROM i_value) AS absent FROM o ORDER BY id;';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
--sorted_result
SELECT id,k IN (SELECT k FROM i_empty) AS present,k NOT IN (SELECT k FROM i_empty) AS absent FROM o ORDER BY id;
PREPARE regression_stmt FROM 'SELECT id,k IN (SELECT k FROM i_empty) AS present,k NOT IN (SELECT k FROM i_empty) AS absent FROM o ORDER BY id;';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
--sorted_result
SELECT id,k IN (SELECT k FROM i_allnull) AS present,k NOT IN (SELECT k FROM i_allnull) AS absent FROM o ORDER BY id;
PREPARE regression_stmt FROM 'SELECT id,k IN (SELECT k FROM i_allnull) AS present,k NOT IN (SELECT k FROM i_allnull) AS absent FROM o ORDER BY id;';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
USE test;
