--echo #
--echo # Bug #121179: Empty preceding window frame after constant lookup
--echo #

CREATE TABLE idxdemo(seq INT, val INT);

INSERT INTO idxdemo VALUES (1,-3);

ALTER TABLE idxdemo ADD UNIQUE INDEX ux_seq (seq);

SELECT SUM(val) OVER (ORDER BY seq ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS res FROM idxdemo WHERE seq = 1;

DROP TABLE idxdemo;

--echo # Aggregate ordering values must be read after aggregation
CREATE TABLE t1(v INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (5), (7);
SELECT SUM(SUM(v)) OVER (ORDER BY NULLIF(COUNT(*), 2)
RANGE BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS s FROM t1;
SELECT SUM(SUM(v)) OVER (ORDER BY NULLIF(COUNT(*), 0)
RANGE BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS s FROM t1;
DROP TABLE t1;
CREATE TABLE t1(v INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1), (NULL);
SELECT * FROM (SELECT COUNT(*) OVER (
ORDER BY NULLIF(COUNT(v), 1)
RANGE BETWEEN 1 FOLLOWING AND 1 FOLLOWING) AS n FROM t1) AS d;
PREPARE stmt FROM 'SELECT * FROM (SELECT COUNT(*) OVER (
ORDER BY NULLIF(COUNT(v), 1)
RANGE BETWEEN 1 FOLLOWING AND 1 FOLLOWING) AS n FROM t1) AS d';
EXECUTE stmt;
INSERT INTO t1 VALUES (2);
EXECUTE stmt;
DELETE FROM t1 WHERE v = 2;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
DROP TABLE t1;

--echo # Temporal bounds retain interval conversion and produce no warnings
CREATE TABLE t1(seq INT, v INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 7);
SELECT SUM(v) OVER (ORDER BY DATE'2026-01-01'
RANGE BETWEEN UNBOUNDED PRECEDING AND INTERVAL 0.1 DAY PRECEDING) AS s
FROM t1 WHERE seq = 1;
SELECT SUM(v) OVER (ORDER BY TIMESTAMP'2026-01-01 12:00:00'
RANGE BETWEEN UNBOUNDED PRECEDING AND INTERVAL '0:01' HOUR_MINUTE PRECEDING) AS s
FROM t1 WHERE seq = 1;
SHOW COUNT(*) WARNINGS;
SELECT SUM(v) OVER (ORDER BY DATE'2026-01-01' DESC
RANGE BETWEEN INTERVAL 0.1 DAY FOLLOWING AND UNBOUNDED FOLLOWING) AS s,
COUNT(*) OVER (ORDER BY TIMESTAMP'2026-01-01 12:00:00' DESC
RANGE BETWEEN INTERVAL '0:01' HOUR_MINUTE FOLLOWING AND UNBOUNDED FOLLOWING) AS n
FROM t1 WHERE seq = 1;
ALTER TABLE t1 ADD UNIQUE INDEX (seq);
SELECT SUM(v) OVER (ORDER BY DATE'2026-01-01'
RANGE BETWEEN UNBOUNDED PRECEDING AND INTERVAL 0.1 DAY PRECEDING) AS s
FROM t1 WHERE seq = 1;
SELECT SUM(v) OVER (ORDER BY TIMESTAMP'2026-01-01 12:00:00'
RANGE BETWEEN UNBOUNDED PRECEDING AND INTERVAL '0:01' HOUR_MINUTE PRECEDING) AS s
FROM t1 WHERE seq = 1;
SHOW COUNT(*) WARNINGS;
SELECT SUM(v) OVER (ORDER BY DATE'2026-01-01' DESC
RANGE BETWEEN INTERVAL 0.1 DAY FOLLOWING AND UNBOUNDED FOLLOWING) AS s,
COUNT(*) OVER (ORDER BY TIMESTAMP'2026-01-01 12:00:00' DESC
RANGE BETWEEN INTERVAL '0:01' HOUR_MINUTE FOLLOWING AND UNBOUNDED FOLLOWING) AS n
FROM t1 WHERE seq = 1;
DROP TABLE t1;

--echo # Typed numeric bounds: rounded DOUBLE peers versus exact DECIMAL
CREATE TABLE t1(seq INT, d DOUBLE, v INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 1e20, 7);
SELECT SUM(v) OVER (ORDER BY d RANGE BETWEEN
UNBOUNDED PRECEDING AND 1 PRECEDING) AS p,
SUM(v) OVER (ORDER BY d RANGE BETWEEN
1 FOLLOWING AND UNBOUNDED FOLLOWING) AS f FROM t1 WHERE seq = 1;
SELECT SUM(v) OVER (ORDER BY d DESC RANGE BETWEEN
UNBOUNDED PRECEDING AND 1 PRECEDING) AS p,
SUM(v) OVER (ORDER BY d DESC RANGE BETWEEN
1 FOLLOWING AND UNBOUNDED FOLLOWING) AS f FROM t1 WHERE seq = 1;
SELECT SUM(v) OVER (ORDER BY CAST(d AS DECIMAL(25, 1)) RANGE BETWEEN
UNBOUNDED PRECEDING AND 1 PRECEDING) AS p,
SUM(v) OVER (ORDER BY CAST(d AS DECIMAL(25, 1)) RANGE BETWEEN
1 FOLLOWING AND UNBOUNDED FOLLOWING) AS f FROM t1 WHERE seq = 1;
ALTER TABLE t1 ADD UNIQUE INDEX (seq);
SELECT SUM(v) OVER (ORDER BY d RANGE BETWEEN
UNBOUNDED PRECEDING AND 1 PRECEDING) AS p,
SUM(v) OVER (ORDER BY d RANGE BETWEEN
1 FOLLOWING AND UNBOUNDED FOLLOWING) AS f FROM t1 WHERE seq = 1;
SELECT SUM(v) OVER (ORDER BY d DESC RANGE BETWEEN
UNBOUNDED PRECEDING AND 1 PRECEDING) AS p,
SUM(v) OVER (ORDER BY d DESC RANGE BETWEEN
1 FOLLOWING AND UNBOUNDED FOLLOWING) AS f FROM t1 WHERE seq = 1;
SELECT SUM(v) OVER (ORDER BY CAST(d AS DECIMAL(25, 1)) RANGE BETWEEN
UNBOUNDED PRECEDING AND 1 PRECEDING) AS p,
SUM(v) OVER (ORDER BY CAST(d AS DECIMAL(25, 1)) RANGE BETWEEN
1 FOLLOWING AND UNBOUNDED FOLLOWING) AS f FROM t1 WHERE seq = 1;
DROP TABLE t1;

--echo # Empty-frame string and JSON functions return SQL NULL
SELECT FIRST_VALUE('abc') OVER (ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) AS f;
SELECT LAST_VALUE('abc') OVER (ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) AS l;
SELECT NTH_VALUE('abc', 1) OVER (ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) AS n;
SELECT JSON_ARRAYAGG(7) OVER (ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) AS j;
SELECT JSON_OBJECTAGG('k', 7) OVER (ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING) AS j;
SELECT * FROM (SELECT FIRST_VALUE('abc') OVER w AS f,
LAST_VALUE('abc') OVER w AS l, NTH_VALUE('abc', 1) OVER w AS n,
JSON_ARRAYAGG(7) OVER w AS j
WINDOW w AS (ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING)) AS d;

--echo # ROWS zero offsets, empty aggregates and functions ignoring the frame
CREATE TABLE t1(seq INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 7);
SELECT SUM(v) OVER w AS s, COUNT(*) OVER w AS n,
MIN(v) OVER w AS lo, MAX(v) OVER w AS hi, AVG(v) OVER w AS a,
BIT_AND(v) OVER w AS ba, BIT_OR(v) OVER w AS bo, BIT_XOR(v) OVER w AS bx
FROM t1 WHERE seq = 1
WINDOW w AS (ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING);
SELECT SUM(v) OVER (ROWS BETWEEN 0 FOLLOWING AND 0 FOLLOWING) AS s,
COUNT(*) OVER (ROWS BETWEEN 0 PRECEDING AND 0 PRECEDING) AS n
FROM t1 WHERE seq = 1;
--disable_warnings
SELECT SUM(v) OVER w AS s, LAG(v, 0) OVER w AS l,
LEAD(v, 1, 99) OVER w AS f, ROW_NUMBER() OVER w AS rn,
RANK() OVER w AS r, DENSE_RANK() OVER w AS dr,
PERCENT_RANK() OVER w AS pr, CUME_DIST() OVER w AS cd, NTILE(2) OVER w AS nt
FROM t1 WHERE seq = 1
WINDOW w AS (ORDER BY seq ROWS BETWEEN 1 FOLLOWING AND 1 FOLLOWING);
--enable_warnings
DROP TABLE t1;

--echo # NULL RANGE ordering values remain peers on either side
SELECT SUM(7) OVER (ORDER BY CAST(NULL AS SIGNED)
RANGE BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING) AS p,
COUNT(*) OVER (ORDER BY CAST(NULL AS SIGNED)
RANGE BETWEEN 1 FOLLOWING AND 1 FOLLOWING) AS n;

--echo # End of Bug #121179

--echo # Single-row peer frames must not reevaluate volatile ordering items
SELECT SUM(7) OVER (
  ORDER BY CAST(0 AS SIGNED), RAND(2)
) AS s;
SELECT SUM(7) OVER w AS s, COUNT(*) OVER w AS n,
FIRST_VALUE('abc') OVER w AS f, JSON_ARRAYAGG(7) OVER w AS j
WINDOW w AS (ORDER BY CAST(0 AS SIGNED), RAND(2)
RANGE BETWEEN CURRENT ROW AND CURRENT ROW);
SELECT SUM(7) OVER (ORDER BY CAST(0 AS SIGNED), RAND(2) DESC
RANGE BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS s;
CREATE TABLE t1(seq INT PRIMARY KEY, v INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 7);
SELECT SUM(v) OVER (ORDER BY CAST(0 AS SIGNED), RAND(2)) AS s
FROM t1 WHERE seq = 1;
SELECT SUM(SUM(v)) OVER (ORDER BY CAST(0 AS SIGNED), RAND(2)) AS s
FROM t1;
SELECT * FROM (SELECT SUM(v) OVER (
ORDER BY CAST(0 AS SIGNED), RAND(2)) AS s FROM t1 WHERE seq = 1) AS d;
PREPARE stmt FROM 'SELECT SUM(v) OVER (
ORDER BY CAST(0 AS SIGNED), RAND(2)) AS s FROM t1 WHERE seq = 1';
EXECUTE stmt;
UPDATE t1 SET v = 11;
EXECUTE stmt;
UPDATE t1 SET v = 7;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
DROP TABLE t1;
