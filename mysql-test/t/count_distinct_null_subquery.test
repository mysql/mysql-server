--echo #
--echo # Bug #121270: COUNT DISTINCT with a NULL-producing scalar subquery
--echo #

CREATE TABLE t0 (c2 TINYTEXT);

INSERT INTO t0(c2) VALUES ('');

SELECT AES_ENCRYPT(NULL,(SELECT t0.c2 FROM t0)) AS ref0,COUNT(DISTINCT 1,NULL) AS ref1,COUNT(DISTINCT 1,AES_ENCRYPT(NULL,(SELECT t0.c2 FROM t0))) AS ref2 FROM t0;

DROP TABLE t0;

--echo #
--echo # Nullable parameters and routine variables must be copied to DISTINCT tables.
--echo #

CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1), (2);
PREPARE s FROM 'SELECT COUNT(DISTINCT a, ?) AS c FROM t1';
SET @x = 7;
EXECUTE s USING @x;
SET @x = NULL;
EXECUTE s USING @x;
SET @x = 9;
EXECUTE s USING @x;
SET @x = 7;
EXECUTE s USING @x;
DEALLOCATE PREPARE s;
PREPARE s FROM
  'SELECT a, COUNT(DISTINCT a, ?) AS c FROM t1 GROUP BY a ORDER BY a';
SET @x = 7;
EXECUTE s USING @x;
SET @x = NULL;
EXECUTE s USING @x;
SET @x = 9;
EXECUTE s USING @x;
SET @x = 7;
EXECUTE s USING @x;
DEALLOCATE PREPARE s;

--echo # ROLLUP copies must also fill nullable parameters and routine variables.
PREPARE s FROM
  'SELECT a, COUNT(DISTINCT a, ?) AS c FROM t1
   GROUP BY a WITH ROLLUP ORDER BY GROUPING(a), a';
SET @x = 7;
EXECUTE s USING @x;
SET @x = NULL;
EXECUTE s USING @x;
SET @x = 9;
EXECUTE s USING @x;
SET @x = 7;
EXECUTE s USING @x;
DEALLOCATE PREPARE s;

delimiter |;
CREATE PROCEDURE p(IN x INT)
BEGIN
  SELECT COUNT(DISTINCT a, x) AS c FROM t1;
  SELECT a, COUNT(DISTINCT a, x) AS c FROM t1 GROUP BY a ORDER BY a;
  SELECT a, COUNT(DISTINCT a, x) AS c FROM t1
    GROUP BY a WITH ROLLUP ORDER BY GROUPING(a), a;
END|
delimiter ;|

CALL p(7);
CALL p(NULL);
CALL p(9);
CALL p(7);

DROP PROCEDURE p;
DROP TABLE t1;
