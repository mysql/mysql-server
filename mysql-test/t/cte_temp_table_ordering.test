--echo #
--echo # Bug#120923 Wrong result with CTE, UNION ALL, GROUP BY, and COUNT()
--echo #
CREATE TABLE a (b INT);
--echo # Original input and equivalent view
INSERT INTO a VALUES (1), (NULL);
--sorted_result
WITH cte AS (
  SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
PREPARE stmt FROM
'WITH cte AS (
  SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c';
--sorted_result
EXECUTE stmt;
--sorted_result
EXECUTE stmt;
CREATE VIEW v0 AS SELECT b AS c FROM a UNION ALL SELECT b FROM a;
--sorted_result
SELECT c FROM v0 WHERE c = 0
UNION
SELECT COUNT(c) FROM v0 GROUP BY c;
DROP VIEW v0;
--echo # Duplicate, distinct and NULL values
TRUNCATE TABLE a;
INSERT INTO a VALUES (1), (1), (2), (NULL), (0);
--sorted_result
WITH cte AS (
  SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
--sorted_result
EXECUTE stmt;
--sorted_result
EXECUTE stmt;
--echo # Only NULL values
TRUNCATE TABLE a;
INSERT INTO a VALUES (NULL), (NULL);
--sorted_result
WITH cte AS (
  SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
--sorted_result
EXECUTE stmt;
--sorted_result
EXECUTE stmt;
--echo # Empty input
TRUNCATE TABLE a;
--sorted_result
WITH cte AS (
  SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
--sorted_result
EXECUTE stmt;
--sorted_result
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

--echo #
--echo # Shared CTE ORDER BY with LIMIT must retain the required sort
--echo #
TRUNCATE TABLE a;
INSERT INTO a VALUES (1), (2), (0);
--disable_result_log
ANALYZE TABLE a;
--enable_result_log
--echo # ASC ordering and repeated prepared execution
WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 0
UNION
(SELECT b FROM cte ORDER BY b ASC LIMIT 1);
PREPARE stmt FROM
'WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 0
UNION
(SELECT b FROM cte ORDER BY b ASC LIMIT 1)';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
--echo # DESC ordering and repeated prepared execution
WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 2
UNION
(SELECT b FROM cte ORDER BY b DESC LIMIT 1);
PREPARE stmt FROM
'WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 2
UNION
(SELECT b FROM cte ORDER BY b DESC LIMIT 1)';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

--echo #
--echo # DISTINCT with ordered LIMIT must preserve sort feasibility
--echo #
INSERT INTO a VALUES (NULL);
--echo # ASC distinct values from a duplicated, shared CTE
WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT DISTINCT b FROM cte
WHERE EXISTS (SELECT 1 FROM cte AS seed WHERE seed.b = 0)
ORDER BY b ASC LIMIT 2;
--echo # DESC distinct values from a duplicated, shared CTE
WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT DISTINCT b FROM cte
WHERE EXISTS (SELECT 1 FROM cte AS seed WHERE seed.b = 0)
ORDER BY b DESC LIMIT 2;
DROP TABLE a;

--echo #
--echo # Bug#120842 Wrong result with CTE, DISTINCT, NULL vs empty string,
--echo # GROUP_CONCAT() and UNION
--echo #
CREATE TABLE t0 (c0 CHAR(1), c3 INT);
--echo # Original input and equivalent view
INSERT INTO t0 VALUES ('', 1), ('', 0), (NULL, 1);
--sorted_result
WITH cte AS (
  SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
PREPARE stmt FROM
'WITH cte AS (
  SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '''' GROUP BY gk0';
--sorted_result
EXECUTE stmt;
--sorted_result
EXECUTE stmt;
CREATE VIEW v0 AS SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0;
--sorted_result
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM v0
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM v0
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
DROP VIEW v0;
--echo # Duplicate, NULL and empty-string values
TRUNCATE TABLE t0;
INSERT INTO t0 VALUES
  ('x', 2), ('', 1), ('', 0), (NULL, 2), (NULL, 1), ('', NULL), ('', 0);
--sorted_result
WITH cte AS (
  SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
--sorted_result
EXECUTE stmt;
--sorted_result
EXECUTE stmt;
--echo # Empty input
TRUNCATE TABLE t0;
--sorted_result
WITH cte AS (
  SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
