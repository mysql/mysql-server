OVER (PARTITION BY b) FROM t1 x1;

DROP TABLE t1;

--echo #
--echo # Bug#36773414: Explain format=tree does not display
--echo #               information about semijoin strategy used
--echo #

CREATE TABLE t(a INTEGER,b INTEGER);
INSERT INTO t VALUES(1,2),(2,3);
ANALYZE TABLE t;
# FirstMatch strategy - Semijoin converted to inner join by
# limiting one row from the table on the inner side.
let $query = SELECT a FROM t WHERE 4 IN (SELECT b+1 FROM t);
eval EXPLAIN $query;
--replace_regex $elide_costs
eval EXPLAIN FORMAT=tree $query;
eval EXPLAIN FORMAT=JSON INTO @var $query;
SELECT
JSON_EXTRACT(@var, '$**.semijoin_strategy') AS first_match,
JSON_SEARCH(@var, 'one', '%FirstMatch%', NULL, '$**.operation') IS NOT NULL
AS operation_contains_firstmatch;
# FirstMatch strategy - Hash Semijoin
eval EXPLAIN $query;
let $query = SELECT * FROM t WHERE b IN (SELECT a FROM t);
--replace_regex $elide_costs
eval EXPLAIN FORMAT=tree $query;
eval EXPLAIN FORMAT=JSON INTO @var $query;
SELECT
JSON_EXTRACT(@var, '$**.semijoin_strategy') AS first_match,
JSON_SEARCH(@var, 'one', '%FirstMatch%', NULL, '$**.operation') IS NOT NULL
AS operation_contains_firstmatch;
# FirstMatch strategy - Nested Loop Semijoin
let $query = SELECT * FROM t WHERE a IN (SELECT t1.a FROM t AS t1
                                         JOIN t AS t2 ON t1.a=t2.b);
eval EXPLAIN $query;
--replace_regex $elide_costs
eval EXPLAIN FORMAT=tree $query;
eval EXPLAIN FORMAT=JSON INTO @var $query;
SELECT
JSON_EXTRACT(@var, '$**.semijoin_strategy') AS first_match,
JSON_SEARCH(@var, 'one', '%FirstMatch%', NULL, '$**.operation') IS NOT NULL
AS operation_contains_firstmatch;
ALTER TABLE t ADD KEY(a,b);
ALTER TABLE t ADD KEY(b);
set optimizer_switch="firstmatch=off,duplicateweedout=off,materialization=off";
# LooseScan strategy
let $query = SELECT b FROM t WHERE a IN (SELECT t1.b FROM t AS t1);
eval EXPLAIN $query;
--replace_regex $elide_costs
eval EXPLAIN FORMAT=tree $query;
eval EXPLAIN FORMAT=JSON INTO @var $query;
SELECT
JSON_EXTRACT(@var, '$**.semijoin_strategy') AS loosescan,
JSON_SEARCH(@var, 'one', '%LooseScan%', NULL, '$**.operation') IS NOT NULL
AS operation_contains_loosescan;
# LooseScan strategy - With multiple tables in the inner side
# (LooseScan with FirstMatch).
let $query = SELECT b FROM t WHERE a  IN (SELECT t1.b
                                          FROM t AS t1 JOIN t AS t2 ON t1.b);
eval EXPLAIN $query;
--replace_regex $elide_costs
eval EXPLAIN FORMAT=tree $query;
eval EXPLAIN FORMAT=JSON INTO @var $query;
SELECT
JSON_EXTRACT(@var, '$**.semijoin_strategy') AS first_match_with_loosescan,
JSON_SEARCH(@var, 'one', '%LooseScan%', NULL, '$**.operation') IS NOT NULL
AS operation_contains_loosescan;
# DuplicateWeedout strategy
set optimizer_switch="loosescan=off,duplicateweedout=on";
let $query = SELECT b FROM t WHERE a IN (SELECT t1.b
                                         FROM t AS t1 JOIN t AS t2 ON t1.b);
eval EXPLAIN $query;
eval EXPLAIN FORMAT=TRADITIONAL $query;
--replace_regex $elide_costs
eval EXPLAIN FORMAT=tree $query;
eval EXPLAIN FORMAT=JSON INTO @var $query;
SELECT
JSON_EXTRACT(@var, '$**.semijoin_strategy') AS weedout,
JSON_SEARCH(@var, 'one', '%weedout%', NULL, '$**.operation') IS NOT NULL
AS operation_contains_weedout,
JSON_SEARCH(@var, 'one', 'weedout', NULL, '$**.access_type') IS NOT NULL
AS access_type_is_weedout;
SET @saved_explain_json_format_version = @@explain_json_format_version;
SET explain_json_format_version = 1;
eval EXPLAIN FORMAT=JSON INTO @var $query;
SELECT
JSON_CONTAINS_PATH(@var, 'one', '$**.duplicates_removal')
AS json_v1_duplicates_removal,
JSON_SEARCH(@var, 'one', 'weedout', NULL, '$**.access_type') IS NULL
AS json_v1_has_no_weedout_access_type;
SET explain_json_format_version = @saved_explain_json_format_version;
# Materialization strategy
set optimizer_switch="materialization=on,duplicateweedout=off";
let $query = SELECT * FROM t WHERE t.a IN (SELECT a FROM t AS t1
                                           WHERE t1.b <> 30);
eval EXPLAIN $query;
--replace_regex $elide_costs
eval EXPLAIN FORMAT=tree $query;
eval EXPLAIN FORMAT=JSON INTO @var $query;
SELECT
JSON_CONTAINS_PATH(@var, 'one', '$**.deduplication') AS materialization,
JSON_SEARCH(@var, 'one', '%Materialize with deduplication%', NULL,
            '$**.operation') IS NOT NULL AS operation_contains_materialzation;
DROP TABLE t;

--echo #
--echo # WL#17309: Add Selected Partition Information to Iterator-Based EXPLAIN
--echo #

SET @wl17309_optimizer_switch = @@optimizer_switch;
SET optimizer_switch =
  'batched_key_access=off,block_nested_loop=off,mrr_cost_based=off';

CREATE TABLE t_range_pk (
  id INT NOT NULL,
  payload VARCHAR(20),
  PRIMARY KEY (id)
)
PARTITION BY RANGE (id) (
  PARTITION p0 VALUES LESS THAN (100),
  PARTITION p1 VALUES LESS THAN (200),
  PARTITION p2 VALUES LESS THAN MAXVALUE
);

INSERT INTO t_range_pk VALUES (110, 'a'), (120, 'b'), (210, 'c');
ANALYZE TABLE t_range_pk;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT * FROM t_range_pk WHERE id BETWEEN 110 AND 210;
--enable_warnings

--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT * FROM t_range_pk WHERE id BETWEEN 110 AND 210;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT * FROM t_range_pk
WHERE id BETWEEN 110 AND 120
ORDER BY id DESC;
--enable_warnings

SET explain_json_format_version = 1;
--replace_regex $elide_json_costs
EXPLAIN FORMAT=JSON
SELECT * FROM t_range_pk WHERE id BETWEEN 110 AND 210;
SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT * FROM t_range_pk WHERE id BETWEEN 110 AND 210;
SELECT
  JSON_EXTRACT(@var, '$**.operation') AS range_pk_operations,
  JSON_EXTRACT(@var, '$**.partitions') AS range_pk_partitions,
  JSON_EXTRACT(@var, '$.json_schema_version') AS range_pk_schema_version;
SET explain_json_format_version = DEFAULT;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE SELECT * FROM t_range_pk WHERE id = 110;
--enable_warnings

--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE SELECT * FROM t_range_pk WHERE id = 110;

EXPLAIN SELECT * FROM t_range_pk WHERE id = 110;

SET explain_json_format_version = 1;
EXPLAIN FORMAT=JSON INTO @var SELECT * FROM t_range_pk WHERE id = 110;
SELECT JSON_EXTRACT(@var, '$**.partitions') AS top_level_const_partitions_v1;

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var SELECT * FROM t_range_pk WHERE id = 110;
SELECT
  JSON_EXTRACT(@var, '$.query_plan.access_type')
    AS top_level_const_access_type_v2,
  JSON_EXTRACT(@var, '$.query_plan.table_name')
    AS top_level_const_table_v2,
  JSON_EXTRACT(@var, '$.query_plan.partitions')
    AS top_level_const_partitions_v2,
  JSON_EXTRACT(@var, '$.query_plan.operation')
    AS top_level_const_operation_v2;
SET explain_json_format_version = DEFAULT;

# A single partitioned table optimized while evaluating MIN() retains its
# selected read partitions on the resulting pre-execution row.
--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT MIN(id) FROM t_range_pk PARTITION (p1);
--enable_warnings

--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT MIN(id) FROM t_range_pk PARTITION (p1);

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT MIN(id) FROM t_range_pk PARTITION (p1);
SELECT
  JSON_EXTRACT(@var, '$.query_plan.access_type')
    AS optimized_aggregate_access_type,
  JSON_EXTRACT(@var, '$.query_plan.table_name')
    AS optimized_aggregate_table,
  JSON_EXTRACT(@var, '$.query_plan.partitions')
    AS optimized_aggregate_partitions,
  JSON_EXTRACT(@var, '$.query_plan.operation')
    AS optimized_aggregate_operation;
SET explain_json_format_version = DEFAULT;

CREATE TABLE t_const_outer (id INT NOT NULL);
INSERT INTO t_const_outer VALUES (110);
ANALYZE TABLE t_const_outer;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT t_const_outer.id, t_const.payload
FROM t_const_outer
LEFT JOIN t_range_pk AS t_const
  ON t_const_outer.id = t_const.id AND t_const.id = 110;
--enable_warnings

--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT t_const_outer.id, t_const.payload
FROM t_const_outer
LEFT JOIN t_range_pk AS t_const
  ON t_const_outer.id = t_const.id AND t_const.id = 110;

EXPLAIN
SELECT t_const_outer.id, t_const.payload
FROM t_const_outer
LEFT JOIN t_range_pk AS t_const
  ON t_const_outer.id = t_const.id AND t_const.id = 110;

SET explain_json_format_version = 1;
EXPLAIN FORMAT=JSON INTO @var
SELECT t_const_outer.id, t_const.payload
FROM t_const_outer
LEFT JOIN t_range_pk AS t_const
  ON t_const_outer.id = t_const.id AND t_const.id = 110;
SELECT JSON_EXTRACT(@var, '$**.partitions') AS const_partitions_v1;

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT t_const_outer.id, t_const.payload
FROM t_const_outer
LEFT JOIN t_range_pk AS t_const
  ON t_const_outer.id = t_const.id AND t_const.id = 110;
SET @const_access_path = JSON_UNQUOTE(
  JSON_SEARCH(@var, 'one', 'constant_row', NULL, '$**.access_type'));
SELECT
  JSON_EXTRACT(@var, @const_access_path) AS const_access_type,
  JSON_EXTRACT(
    @var, REPLACE(@const_access_path, '.access_type', '.table_name'))
    AS const_table_name,
  JSON_EXTRACT(
    @var, REPLACE(@const_access_path, '.access_type', '.partitions'))
    AS const_partitions,
  JSON_EXTRACT(
    @var, REPLACE(@const_access_path, '.access_type', '.operation'))
    AS const_operation;
SET @const_access_path = NULL;
SET explain_json_format_version = DEFAULT;

# A partitioned unique lookup exercises the EQ_REF access path.
--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT i.payload
FROM t_const_outer AS o
STRAIGHT_JOIN t_range_pk PARTITION (p1) AS i ON i.id = o.id;
--enable_warnings

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT i.payload
FROM t_const_outer AS o
STRAIGHT_JOIN t_range_pk PARTITION (p1) AS i ON i.id = o.id;
SELECT
  JSON_EXTRACT(@var, '$**.index_access_type') AS eq_ref_index_access,
  JSON_EXTRACT(@var, '$**.partitions') AS eq_ref_partitions,
  JSON_SEARCH(@var, 'one',
              '%Single-row index lookup on i using PRIMARY in partitions (p1)%',
              NULL, '$**.operation') IS NOT NULL
    AS eq_ref_operation_has_partitions;
SET explain_json_format_version = DEFAULT;

CREATE TABLE t_range_scan (
  id INT NOT NULL,
  payload VARCHAR(20)
)
PARTITION BY RANGE (id) (
  PARTITION p0 VALUES LESS THAN (100),
  PARTITION p1 VALUES LESS THAN (200),
  PARTITION p2 VALUES LESS THAN MAXVALUE
);

INSERT INTO t_range_scan VALUES (110, 'a'), (120, 'b'), (210, 'c');
ANALYZE TABLE t_range_scan;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT * FROM t_range_scan WHERE id BETWEEN 110 AND 210;
--enable_warnings

--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT * FROM t_range_scan WHERE id BETWEEN 110 AND 210;

SET explain_json_format_version = 1;
--replace_regex $elide_json_costs
EXPLAIN FORMAT=JSON
SELECT * FROM t_range_scan WHERE id BETWEEN 110 AND 210;
SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT * FROM t_range_scan WHERE id BETWEEN 110 AND 210;
SELECT JSON_EXTRACT(@var, '$**.partitions') AS range_scan_partitions;
SET explain_json_format_version = DEFAULT;

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT * FROM t_range_pk PARTITION (p1) WHERE id BETWEEN 110 AND 120;
SELECT JSON_EXTRACT(@var, '$**.partitions') AS explicit_partitions;
EXPLAIN FORMAT=JSON INTO @var
SELECT * FROM t_range_pk PARTITION (p0, p1)
WHERE id BETWEEN 110 AND 120;
SELECT JSON_EXTRACT(@var, '$**.partitions') AS explicit_pruned_partitions;
EXPLAIN FORMAT=JSON INTO @var
INSERT INTO t_range_scan
SELECT * FROM t_range_pk PARTITION (p1) WHERE id BETWEEN 110 AND 120;
SELECT
  JSON_CONTAINS_PATH(@var, 'one', '$.query_plan.partitions')
    AS dml_node_has_partitions,
  JSON_EXTRACT(@var, '$**.partitions') AS access_partitions;

EXPLAIN FORMAT=JSON INTO @var
REPLACE INTO t_range_scan
SELECT * FROM t_range_pk PARTITION (p1) WHERE id BETWEEN 110 AND 120;
SELECT
  JSON_CONTAINS_PATH(@var, 'one', '$.query_plan.partitions')
    AS replace_root_has_partitions,
  JSON_EXTRACT(@var, '$**.partitions') AS replace_read_partitions;

EXPLAIN FORMAT=JSON INTO @var
UPDATE t_range_pk AS target
JOIN t_const_outer AS source ON target.id = source.id
SET target.payload = 'updated'
WHERE target.id BETWEEN 110 AND 120;
SELECT
  JSON_CONTAINS_PATH(@var, 'one', '$.query_plan.partitions')
    AS update_root_has_partitions,
  JSON_EXTRACT(@var, '$**.partitions') AS update_read_partitions;

EXPLAIN FORMAT=JSON INTO @var
DELETE target
FROM t_range_pk AS target
JOIN t_const_outer AS source ON target.id = source.id
WHERE target.id BETWEEN 110 AND 120;
SELECT
  JSON_CONTAINS_PATH(@var, 'one', '$.query_plan.partitions')
    AS delete_root_has_partitions,
  JSON_EXTRACT(@var, '$**.partitions') AS delete_read_partitions;
SET explain_json_format_version = DEFAULT;

CREATE TABLE t_hash (
  id INT NOT NULL,
  payload VARCHAR(20),
  PRIMARY KEY (id)
)
PARTITION BY HASH (id) PARTITIONS 3;

INSERT INTO t_hash VALUES (1, 'a'), (4, 'b'), (2, 'c');
ANALYZE TABLE t_hash;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT * FROM t_hash WHERE id IN (1, 4);
--enable_warnings

--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT * FROM t_hash WHERE id IN (1, 4);

