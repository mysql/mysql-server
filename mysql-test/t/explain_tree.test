# A planned partitioned inner access can remain unexecuted in ANALYZE.
CREATE TABLE t_plan_outer (x INT);
CREATE TABLE t_plan_inner (
  id INT NOT NULL,
  j INT NOT NULL,
  PRIMARY KEY (id)
)
PARTITION BY RANGE (id) (
  PARTITION p0 VALUES LESS THAN (100),
  PARTITION p1 VALUES LESS THAN (200),
  PARTITION p2 VALUES LESS THAN MAXVALUE
);
INSERT INTO t_plan_outer VALUES (0);
INSERT INTO t_plan_inner VALUES (110, 0);
ANALYZE TABLE t_plan_outer, t_plan_inner;

# The filter rejects the outer row, so the p1 access is never executed.
--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT STRAIGHT_JOIN i.*
FROM t_plan_outer AS o
JOIN t_plan_inner AS i ON i.j = o.x
WHERE o.x = 999 AND i.id BETWEEN 110 AND 120;

DROP TABLE t_plan_outer, t_plan_inner;

# Direct unpartitioned accesses have neither text nor a JSON v2 field.
CREATE TABLE t_unpartitioned (id INT NOT NULL);
INSERT INTO t_unpartitioned VALUES (110);
ANALYZE TABLE t_unpartitioned;
--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT * FROM t_unpartitioned WHERE id BETWEEN 110 AND 120;
--enable_warnings
SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT * FROM t_unpartitioned WHERE id BETWEEN 110 AND 120;
SELECT JSON_CONTAINS_PATH(@var, 'one', '$**.partitions')
  AS unpartitioned_has_partitions;
SELECT JSON_EXTRACT(@var, '$.json_schema_version') AS json_schema_version;

# An empty selected set caused by pruning also omits text and the JSON field.
CREATE TABLE t_all_pruned (
  id INT NOT NULL,
  PRIMARY KEY (id)
)
PARTITION BY RANGE (id) (
  PARTITION p0 VALUES LESS THAN (100),
  PARTITION p1 VALUES LESS THAN (200)
);
INSERT INTO t_all_pruned VALUES (110);
ANALYZE TABLE t_all_pruned;
--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT * FROM t_all_pruned WHERE id BETWEEN 210 AND 220;
--enable_warnings
EXPLAIN FORMAT=JSON INTO @var
SELECT * FROM t_all_pruned WHERE id BETWEEN 210 AND 220;
SELECT JSON_CONTAINS_PATH(@var, 'one', '$**.partitions')
  AS all_pruned_has_partitions;
SET explain_json_format_version = DEFAULT;

DROP TABLE t_unpartitioned, t_all_pruned;

# EXPLAIN ANALYZE FORMAT=JSON reports selected partitions together with
# runtime fields for a pruned range access and a single-row lookup.
CREATE TABLE t_analyze_json_range (
  id INT NOT NULL,
  payload VARCHAR(20),
  PRIMARY KEY (id)
)
PARTITION BY RANGE (id) (
  PARTITION p0 VALUES LESS THAN (1000),
  PARTITION p1 VALUES LESS THAN (2000),
  PARTITION p2 VALUES LESS THAN MAXVALUE
);
INSERT INTO t_analyze_json_range WITH RECURSIVE qn(n) AS
  (SELECT 0 UNION ALL SELECT n + 1 FROM qn WHERE n < 999)
  SELECT 1000 + n, CONCAT('value-', n) FROM qn;
CREATE TABLE t_analyze_json_outer (id INT NOT NULL);
INSERT INTO t_analyze_json_outer VALUES (1100);
ANALYZE TABLE t_analyze_json_range, t_analyze_json_outer;

SET explain_json_format_version = 2;
EXPLAIN ANALYZE FORMAT=JSON INTO @var
SELECT * FROM t_analyze_json_range WHERE id BETWEEN 1100 AND 1101;
SELECT
  JSON_EXTRACT(@var, '$**.partitions') AS analyze_range_partitions,
  JSON_SEARCH(@var, 'one', '%Index range scan%', NULL, '$**.operation')
    IS NOT NULL AS analyze_range_is_range_scan,
  JSON_SEARCH(@var, 'one', '%in partitions (p1)%', NULL, '$**.operation')
    IS NOT NULL AS analyze_range_operation_has_partitions,
  JSON_CONTAINS_PATH(@var, 'all', '$**.actual_rows', '$**.actual_loops')
    AS analyze_range_has_actual_metrics,
  JSON_EXTRACT(@var, '$.json_schema_version')
    AS analyze_range_schema_version;

EXPLAIN ANALYZE FORMAT=JSON INTO @var
SELECT i.payload
FROM t_analyze_json_outer AS o
STRAIGHT_JOIN t_analyze_json_range PARTITION (p1) AS i FORCE INDEX (PRIMARY)
ON i.id = o.id;
SELECT
  JSON_EXTRACT(@var, '$**.partitions') AS analyze_lookup_partitions,
  JSON_SEARCH(@var, 'one', '%Single-row index lookup%', NULL, '$**.operation')
    IS NOT NULL AS analyze_lookup_is_single_row,
  JSON_SEARCH(@var, 'one', '%in partitions (p1)%', NULL, '$**.operation')
    IS NOT NULL AS analyze_lookup_operation_has_partitions,
  JSON_CONTAINS_PATH(@var, 'all', '$**.actual_rows', '$**.actual_loops')
    AS analyze_lookup_has_actual_metrics,
  JSON_EXTRACT(@var, '$.json_schema_version')
    AS analyze_lookup_schema_version;
SET explain_json_format_version = DEFAULT;

DROP TABLE t_analyze_json_range, t_analyze_json_outer;

SET optimizer_switch = @wl17309_optimizer_switch;
