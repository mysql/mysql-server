CREATE TABLE t_count_other (
  id INT NOT NULL,
  payload VARCHAR(20),
  PRIMARY KEY (id)
)
PARTITION BY RANGE (id) (
  PARTITION q0 VALUES LESS THAN (100),
  PARTITION q1 VALUES LESS THAN (200),
