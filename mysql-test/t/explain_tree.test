EXPLAIN FORMAT=TREE SELECT 1 FROM t WHERE x = 4;
--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE SELECT 1 FROM t WHERE x = 4;

--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT 1 FROM t WHERE x > 4;
--replace_regex $elide_costs_and_time
