--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT COUNT(*) FROM t_count PARTITION (p0, p1);

# A multi-table count keeps its legacy first-table fields, but has no
# unambiguous partition set.
--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT COUNT(*)
FROM t_count PARTITION (p0) AS p,
     t_count_other PARTITION (q1) AS q;

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT COUNT(*)
FROM t_count PARTITION (p0) AS p,
     t_count_other PARTITION (q1) AS q;
SELECT
  JSON_EXTRACT(@var, '$.query_plan.operation') AS multi_count_operation,
  JSON_EXTRACT(@var, '$.query_plan.table_name') AS multi_count_table_name,
  JSON_EXTRACT(@var, '$.query_plan.schema_name') AS multi_count_schema_name,
  JSON_EXTRACT(@var, '$.query_plan.alias') AS multi_count_alias,
  JSON_CONTAINS_PATH(@var, 'one', '$.query_plan.partitions')
    AS multi_count_has_partitions;
SET explain_json_format_version = DEFAULT;

# Multiple classic const tables must not retain single-table provenance.
--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT t_range_pk.id, t_count.id
FROM t_range_pk, t_count
WHERE t_range_pk.id = 110 AND t_count.id = 110;

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT t_range_pk.id, t_count.id
FROM t_range_pk, t_count
WHERE t_range_pk.id = 110 AND t_count.id = 110;
SELECT
  JSON_EXTRACT(@var, '$.query_plan.operation') AS multi_const_operation,
  JSON_CONTAINS_PATH(@var, 'one', '$.query_plan.table_name')
    AS multi_const_has_table,
  JSON_CONTAINS_PATH(@var, 'one', '$.query_plan.partitions')
    AS multi_const_has_partitions;
SET explain_json_format_version = DEFAULT;

# A table-independent fake row must remain table-free.
--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE SELECT 1;
--enable_warnings

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var SELECT 1;
SELECT
  JSON_EXTRACT(@var, '$.query_plan.operation') AS fake_row_operation,
  JSON_CONTAINS_PATH(@var, 'one', '$**.table_name') AS fake_row_has_table,
  JSON_CONTAINS_PATH(@var, 'one', '$**.partitions')
    AS fake_row_has_partitions;
SET explain_json_format_version = DEFAULT;

# A table value constructor must remain table-free.
--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE VALUES ROW(1), ROW(2);
--enable_warnings

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var VALUES ROW(1), ROW(2);
SELECT
  JSON_EXTRACT(@var, '$.query_plan.operation') AS values_operation,
  JSON_CONTAINS_PATH(@var, 'one', '$**.table_name') AS values_has_table,
  JSON_CONTAINS_PATH(@var, 'one', '$**.partitions')
    AS values_has_partitions;
SET explain_json_format_version = DEFAULT;

CREATE TABLE t_subpart (
  id INT NOT NULL,
  payload VARCHAR(20),
  KEY (id)
)
PARTITION BY RANGE (id)
SUBPARTITION BY HASH (id) (
  PARTITION p0 VALUES LESS THAN (100) (
    SUBPARTITION p0s0,
    SUBPARTITION p0s1
  ),
  PARTITION p1 VALUES LESS THAN (200) (
    SUBPARTITION p1s0,
    SUBPARTITION p1s1
  ),
  PARTITION p2 VALUES LESS THAN MAXVALUE (
    SUBPARTITION p2s0,
    SUBPARTITION p2s1
  )
);

INSERT INTO t_subpart VALUES (110, 'a'), (111, 'b'), (210, 'c');
ANALYZE TABLE t_subpart;

SET @wl17309_subpart_optimizer_switch = @@optimizer_switch;
SET optimizer_switch = 'mrr=off,index_condition_pushdown=off';

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT * FROM t_subpart PARTITION (p1) WHERE id BETWEEN 100 AND 199;
--enable_warnings

--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT * FROM t_subpart PARTITION (p1) WHERE id BETWEEN 100 AND 199;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT * FROM t_subpart WHERE id BETWEEN 100 AND 250;
--enable_warnings

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT * FROM t_subpart PARTITION (p1) WHERE id BETWEEN 100 AND 199;
SELECT
  JSON_EXTRACT(@var, '$**.partitions') AS subpartitions,
  JSON_SEARCH(@var, 'one', '%in partitions (p1_p1s0,p1_p1s1)%',
              NULL, '$**.operation') IS NOT NULL
    AS subpartition_operation_has_partitions,
  JSON_SEARCH(@var, 'one', 'p0_p0s0', NULL, '$**.partitions') IS NULL
    AS p0s0_absent,
  JSON_SEARCH(@var, 'one', 'p0_p0s1', NULL, '$**.partitions') IS NULL
    AS p0s1_absent,
  JSON_SEARCH(@var, 'one', 'p2_p2s0', NULL, '$**.partitions') IS NULL
    AS p2s0_absent,
  JSON_SEARCH(@var, 'one', 'p2_p2s1', NULL, '$**.partitions') IS NULL
    AS p2s1_absent;
EXPLAIN FORMAT=JSON INTO @var
SELECT * FROM t_subpart WHERE id BETWEEN 100 AND 250;
SELECT JSON_EXTRACT(@var, '$**.partitions') AS ordered_subpartitions;
SET explain_json_format_version = DEFAULT;
SET optimizer_switch = @wl17309_subpart_optimizer_switch;

CREATE TABLE t_subpart_range_key (
  id INT NOT NULL,
  payload VARCHAR(20),
  KEY (id)
)
PARTITION BY RANGE (id)
SUBPARTITION BY KEY (id) (
  PARTITION p0 VALUES LESS THAN (100) (
    SUBPARTITION p0s0,
    SUBPARTITION p0s1
  ),
  PARTITION p1 VALUES LESS THAN (200) (
    SUBPARTITION p1s0,
    SUBPARTITION p1s1
  ),
  PARTITION p2 VALUES LESS THAN MAXVALUE (
    SUBPARTITION p2s0,
    SUBPARTITION p2s1
  )
);

CREATE TABLE t_subpart_list_hash (
  id INT NOT NULL,
  payload VARCHAR(20),
  KEY (id)
)
PARTITION BY LIST (id)
SUBPARTITION BY HASH (id) (
  PARTITION p0 VALUES IN (1) (
    SUBPARTITION p0s0,
    SUBPARTITION p0s1
  ),
  PARTITION p1 VALUES IN (2) (
    SUBPARTITION p1s0,
    SUBPARTITION p1s1
  ),
  PARTITION p2 VALUES IN (3) (
    SUBPARTITION p2s0,
    SUBPARTITION p2s1
  )
);

CREATE TABLE t_subpart_list_key (
  id INT NOT NULL,
  payload VARCHAR(20),
  KEY (id)
)
PARTITION BY LIST (id)
SUBPARTITION BY KEY (id) (
  PARTITION p0 VALUES IN (1) (
    SUBPARTITION p0s0,
    SUBPARTITION p0s1
  ),
  PARTITION p1 VALUES IN (2) (
    SUBPARTITION p1s0,
    SUBPARTITION p1s1
  ),
  PARTITION p2 VALUES IN (3) (
    SUBPARTITION p2s0,
    SUBPARTITION p2s1
  )
);

