# An explicitly selected partition also needs to be reported for index skip
# scans, whose ranges are assembled separately from ordinary range scans.
CREATE TABLE t_partition_skip (
  a INT,
  b INT,
  c INT,
  d INT,
  e INT,
  KEY idx1 (a, b, c, d, e)
)
PARTITION BY RANGE (a) (
  PARTITION p0 VALUES LESS THAN (100),
  PARTITION p1 VALUES LESS THAN (200),
  PARTITION p2 VALUES LESS THAN MAXVALUE
);
INSERT INTO t_partition_skip VALUES
  (110, 5, 1, 1, 150), (120, 5, 1, 1, 150),
  (130, 5, 1, 1, 150), (140, 5, 1, 1, 150),
  (150, 5, 1, 1, 150);
ANALYZE TABLE t_partition_skip;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT /*+ SKIP_SCAN(t_partition_skip) */ *
FROM t_partition_skip PARTITION (p1)
WHERE a IN (110, 120, 130, 140, 150) AND b = 5 AND e BETWEEN 100 AND 200;
--enable_warnings

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT /*+ SKIP_SCAN(t_partition_skip) */ *
FROM t_partition_skip PARTITION (p1)
WHERE a IN (110, 120, 130, 140, 150) AND b = 5 AND e BETWEEN 100 AND 200;
SELECT
  JSON_EXTRACT(@var, '$**.index_access_type') AS skip_scan_index_access,
  JSON_EXTRACT(@var, '$**.partitions') AS skip_scan_partitions,
  JSON_SEARCH(@var, 'one',
              '%skip scan on t_partition_skip using idx1 in partitions (p1)%',
              NULL, '$**.operation') IS NOT NULL
    AS skip_scan_operation_has_partitions;
SET explain_json_format_version = DEFAULT;
DROP TABLE t_partition_skip;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
WITH RECURSIVE qn AS
  (SELECT 1 AS n UNION ALL SELECT n + 1 FROM qn WHERE n < 3)
SELECT * FROM qn;
--enable_warnings

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
WITH RECURSIVE qn AS
  (SELECT 1 AS n UNION ALL SELECT n + 1 FROM qn WHERE n < 3)
SELECT * FROM qn;
SET @follow_tail_access_path = JSON_UNQUOTE(
  JSON_SEARCH(@var, 'one', 'scan_new_records', NULL, '$**.access_type'));
SELECT
  JSON_EXTRACT(@var, @follow_tail_access_path) AS follow_tail_access_type,
  JSON_EXTRACT(
    @var, REPLACE(@follow_tail_access_path, '.access_type', '.operation'))
    AS follow_tail_operation,
  JSON_EXTRACT(
    @var, REPLACE(@follow_tail_access_path, '.access_type', '.partitions'))
    IS NULL AS follow_tail_has_no_partitions;
SET @follow_tail_access_path = NULL;
SET explain_json_format_version = DEFAULT;

CREATE TABLE t_dynamic (
  x INT NOT NULL,
  y INT DEFAULT (x),
  z VARCHAR(128) DEFAULT (REPEAT('z', 128)),
  KEY (x)
)
PARTITION BY RANGE (x) (
  PARTITION p0 VALUES LESS THAN (100),
  PARTITION p1 VALUES LESS THAN (200),
  PARTITION p2 VALUES LESS THAN MAXVALUE
);

INSERT INTO t_dynamic(x) VALUES (10), (20), (30), (40), (110), (120), (130),
  (140), (210), (220);
INSERT INTO t_dynamic SELECT * FROM t_dynamic;
INSERT INTO t_dynamic SELECT * FROM t_dynamic;
INSERT INTO t_dynamic SELECT * FROM t_dynamic;
ANALYZE TABLE t_dynamic;

--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT t_inner.x
FROM t_dynamic PARTITION (p0, p1) AS t_inner,
     t_dynamic AS t_outer
WHERE t_inner.x < t_outer.y;
--enable_warnings

--replace_regex $elide_costs_and_time
EXPLAIN ANALYZE
SELECT t_inner.x
FROM t_dynamic PARTITION (p0, p1) AS t_inner,
     t_dynamic AS t_outer
WHERE t_inner.x < t_outer.y;

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT t_inner.x
FROM t_dynamic PARTITION (p0, p1) AS t_inner,
     t_dynamic AS t_outer
WHERE t_inner.x < t_outer.y;
SELECT
  JSON_EXTRACT(@var, '$**.index_access_type') AS dynamic_index_access,
  JSON_EXTRACT(@var, '$**.partitions') AS dynamic_candidate_partitions,
  JSON_SEARCH(@var, 'one',
              '%re-planned for each iteration) in partitions (p0,p1)%',
              NULL, '$**.operation') IS NOT NULL
    AS dynamic_operation_has_partitions;
SET explain_json_format_version = DEFAULT;

# Check MRR and a non-unique ref lookup, which use separate index access paths
# but both delegate partition reporting to SetIndexInfoInObject().
--replace_regex $elide_costs
--disable_warnings
EXPLAIN FORMAT=TREE
SELECT y FROM t_dynamic PARTITION (p0, p1) WHERE x IN (10, 20, 30);
--enable_warnings

SET explain_json_format_version = 2;
EXPLAIN FORMAT=JSON INTO @var
SELECT y FROM t_dynamic PARTITION (p0, p1) WHERE x IN (10, 20, 30);
SELECT
  JSON_EXTRACT(@var, '$**.multi_range_read') AS mrr_enabled,
  JSON_EXTRACT(@var, '$**.partitions') AS mrr_partitions,
  JSON_SEARCH(@var, 'one', '%Multi-Range Read%', NULL, '$**.operation')
    IS NOT NULL AS mrr_operation;

EXPLAIN FORMAT=JSON INTO @var
SELECT i.y
FROM t_const_outer AS o
STRAIGHT_JOIN t_dynamic PARTITION (p1) AS i ON i.x = o.id;
SELECT
  JSON_EXTRACT(@var, '$**.index_access_type') AS ref_index_access,
  JSON_EXTRACT(@var, '$**.partitions') AS ref_partitions,
  JSON_SEARCH(@var, 'one',
              '%Index lookup on i using x in partitions (p1)%',
              NULL, '$**.operation') IS NOT NULL
    AS ref_operation_has_partitions;
SET explain_json_format_version = DEFAULT;

