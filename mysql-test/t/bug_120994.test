CREATE DATABASE bug_120994 CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE bug_120994;
SET sql_mode=DEFAULT;
SET optimizer_switch=DEFAULT;
SET default_storage_engine=InnoDB;
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
CREATE TABLE t0 (c DECIMAL UNIQUE);
CREATE TABLE t1 (c TEXT);
INSERT INTO t0 VALUES (0);
INSERT INTO t1 VALUES ('0a');
--sorted_result
SELECT 1 FROM t1 JOIN t0 ON t1.c = t0.c;
PREPARE regression_stmt FROM 'SELECT 1 FROM t1 JOIN t0 ON t1.c = t0.c;';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
--sorted_result
SELECT 1 FROM t0 JOIN t1 ON t1.c = t0.c;
--sorted_result
SELECT 1 FROM t1 JOIN t0 ON NOT NOT (t1.c = t0.c);
--sorted_result
SELECT 1 FROM t1 WHERE EXISTS (SELECT 1 FROM t0 WHERE t1.c = t0.c);
--sorted_result
SELECT 1 FROM t1 JOIN (SELECT c FROM t0) AS derived_t0 ON t1.c = derived_t0.c;
--sorted_result
SELECT 1 FROM (SELECT t1.c = t0.c AS matches FROM t1 CROSS JOIN t0) AS pairs WHERE pairs.matches;
--sorted_result
SELECT 1 FROM t1 CROSS JOIN t0 WHERE t1.c = t0.c;
--sorted_result
SELECT 1 FROM t1 JOIN t0 ON CASE WHEN t1.c = t0.c THEN t1.c = t0.c ELSE t1.c = t0.c END;
--sorted_result
SELECT 1 FROM t1 JOIN t0 ON ((t1.c = t0.c OR NOT (t1.c = t0.c)) OR (t1.c = t0.c) IS NULL) AND (t1.c = t0.c);
USE test;
