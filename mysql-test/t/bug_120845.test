SET sql_mode=DEFAULT;
SET optimizer_switch=DEFAULT;
SET default_storage_engine=InnoDB;
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
CREATE TABLE a (d INT,e INT);
INSERT INTO a VALUES (0,0);
INSERT INTO a VALUES ();
INSERT INTO a VALUES (3,0);
CREATE VIEW v0 AS SELECT d AS f,STDDEV_POP(e) AS g FROM a GROUP BY f;
--sorted_result
WITH cte AS (SELECT d AS f,STDDEV_POP(e) AS g FROM a GROUP BY f) SELECT g,f FROM cte WHERE g=0 UNION SELECT g,STDDEV_POP(f) FROM cte GROUP BY g;
PREPARE regression_stmt FROM 'WITH cte AS (SELECT d AS f,STDDEV_POP(e) AS g FROM a GROUP BY f) SELECT g,f FROM cte WHERE g=0 UNION SELECT g,STDDEV_POP(f) FROM cte GROUP BY g;';
--sorted_result
EXECUTE regression_stmt;
--sorted_result
EXECUTE regression_stmt;
DEALLOCATE PREPARE regression_stmt;
--sorted_result
SELECT g,f FROM v0 WHERE g=0 UNION SELECT g,STDDEV_POP(f) FROM v0 GROUP BY g;
USE test;
