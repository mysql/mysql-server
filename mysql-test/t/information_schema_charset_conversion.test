--echo #
--echo # Reading INFORMATION_SCHEMA.PROCESSLIST, INFORMATION_SCHEMA.INNODB_TRX
--echo # and INFORMATION_SCHEMA.OPTIMIZER_TRACE must not fail when a statement
--echo # text can't be converted to the utf8mb3 character set of the column.
--echo # Unconvertible characters are replaced by '?' with a warning.
--echo #

--source include/have_optimizer_trace.inc
--source include/count_sessions.inc

SET NAMES utf8mb4;
CREATE TABLE t1 (a INT) ENGINE=InnoDB;

connect (con1, localhost, root,,);
SET NAMES utf8mb4;
let $con1_id = `SELECT CONNECTION_ID()`;

--echo # Another session runs a statement that contains a supplementary
--echo # character, which is valid utf8mb4 but has no utf8mb3 representation.
connection default;
SELECT GET_LOCK('processlist_charset', 0);
connection con1;
BEGIN;
INSERT INTO t1 VALUES (1);
--send SELECT GET_LOCK('processlist_charset', 600) AS l, '😀' AS c
connection default;
let $wait_condition = SELECT COUNT(*) = 1 FROM performance_schema.threads
  WHERE PROCESSLIST_ID = $con1_id AND PROCESSLIST_STATE = 'User lock';
--source include/wait_condition.inc
--replace_result $con1_id <con1_id>
eval SELECT INFO FROM INFORMATION_SCHEMA.PROCESSLIST WHERE ID = $con1_id;
--replace_result $con1_id <con1_id>
eval SELECT trx_query FROM INFORMATION_SCHEMA.INNODB_TRX
  WHERE trx_mysql_thread_id = $con1_id;
SELECT RELEASE_LOCK('processlist_charset');
connection con1;
--reap
SELECT RELEASE_LOCK('processlist_charset');
COMMIT;

--echo # Another session runs a statement that contains a binary string
--echo # literal which is not valid utf8mb4, as sent by client libraries
--echo # that inline binary parameter values.
let $bytes = query_get_value(SELECT UNHEX('9D86BA318DFB') AS b, b, 1);
connection default;
SELECT GET_LOCK('processlist_charset', 0);
connection con1;
--echo SELECT GET_LOCK('processlist_charset', 600) AS l, LENGTH(_binary'<0x9D86BA318DFB>') AS c;
--disable_query_log
--send_eval SELECT GET_LOCK('processlist_charset', 600) AS l, LENGTH(_binary'$bytes') AS c
--enable_query_log
connection default;
--source include/wait_condition.inc
--replace_result $con1_id <con1_id>
eval SELECT INFO FROM INFORMATION_SCHEMA.PROCESSLIST WHERE ID = $con1_id;
SELECT RELEASE_LOCK('processlist_charset');
connection con1;
--reap
SELECT RELEASE_LOCK('processlist_charset');

--echo # The optimizer trace of a statement that contains a supplementary
--echo # character.
SET optimizer_trace = 'enabled=on';
SELECT '😀' AS c;
SELECT QUERY FROM INFORMATION_SCHEMA.OPTIMIZER_TRACE;
SET optimizer_trace = 'enabled=off';

connection default;
disconnect con1;
DROP TABLE t1;
--source include/wait_until_count_sessions.inc
