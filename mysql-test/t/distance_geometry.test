--echo #
--echo # Bug#121547: DISTANCE() must reject GEOMETRY arguments.  A GEOMETRY
--echo # value is a binary string, like the vector arguments DISTANCE()
--echo # accepts, so it used to pass the type check.  When its length was a
--echo # multiple of 4, the SRID and WKB bytes were read as floats: a collection
--echo # of three POINT(0 0) is 76 bytes, and DISTANCE(g, g, ...) returned 0.
--echo #

CREATE TABLE t1 (g GEOMETRY, v VARBINARY(76));
INSERT INTO t1 VALUES (
  ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0), POINT(0 0), POINT(0 0))'),
  REPEAT(X'00', 76));
--echo # 19 floats' worth of bytes.
SELECT LENGTH(g) FROM t1;

--echo # A GEOMETRY column, as either argument.
--error ER_WRONG_ARGUMENTS
SELECT DISTANCE(g, g, 'EUCLIDEAN') FROM t1;
--error ER_WRONG_ARGUMENTS
SELECT DISTANCE(g, v, 'EUCLIDEAN') FROM t1;
--error ER_WRONG_ARGUMENTS
SELECT DISTANCE(v, g, 'EUCLIDEAN') FROM t1;

--echo # The type is checked when the statement is prepared, so no row is
--echo # needed.
--error ER_WRONG_ARGUMENTS
SELECT DISTANCE(g, g, 'EUCLIDEAN') FROM t1 WHERE FALSE;

--echo # The result of a spatial function.
let $gc = ST_GeomFromText('GEOMETRYCOLLECTION(POINT(0 0), POINT(0 0), POINT(0 0))');
--error ER_WRONG_ARGUMENTS
eval SELECT DISTANCE($gc, $gc, 'EUCLIDEAN');
--error ER_WRONG_ARGUMENTS
eval SELECT VECTOR_DISTANCE(TO_VECTOR(CONCAT('[', REPEAT('0,', 18), '1]')),
                            $gc, 'COSINE');

--echo # The binary string column next to it is still accepted.
SELECT DISTANCE(v, v, 'EUCLIDEAN') FROM t1;

DROP TABLE t1;
