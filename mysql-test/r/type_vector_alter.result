#
# Adding a VECTOR NOT NULL column without a default value to a
# non-empty table must be refused, as existing rows would get an
# empty (invalid) vector value.
#
CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
title VARCHAR(50) NOT NULL);
INSERT INTO t (title) VALUES ('a'), ('b'), ('c');
ALTER TABLE t ADD COLUMN embedding VECTOR(4) NOT NULL;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t ADD COLUMN embedding VECTOR(4) NOT NULL, ALGORITHM=INPLACE;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t ADD COLUMN embedding VECTOR(4) NOT NULL, ALGORITHM=COPY;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t ADD COLUMN embedding VECTOR(4) NOT NULL, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(50) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Nullable column and column with a default value are allowed.
ALTER TABLE t ADD COLUMN e1 VECTOR(4);
ALTER TABLE t ADD COLUMN e2 VECTOR(4) NOT NULL
DEFAULT (STRING_TO_VECTOR('[1,2,3,4]'));
SELECT id, e1, VECTOR_TO_STRING(e2) FROM t;
id	e1	VECTOR_TO_STRING(e2)
1	NULL	[1.00000e+00,2.00000e+00,3.00000e+00,4.00000e+00]
2	NULL	[1.00000e+00,2.00000e+00,3.00000e+00,4.00000e+00]
3	NULL	[1.00000e+00,2.00000e+00,3.00000e+00,4.00000e+00]
CREATE TABLE t2 AS SELECT * FROM t;
DROP TABLE t2;
# Allowed on an empty table.
DELETE FROM t;
ALTER TABLE t ADD COLUMN e3 VECTOR(4) NOT NULL;
ALTER TABLE t DROP COLUMN e3;
ALTER TABLE t ADD COLUMN e3 VECTOR(4) NOT NULL, ALGORITHM=COPY;
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(50) NOT NULL,
  `e1` vector(4) DEFAULT NULL,
  `e2` vector(4) NOT NULL DEFAULT (to_vector(_utf8mb4'[1,2,3,4]')),
  `e3` vector(4) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t;
# Also refused in non-strict mode.
SET sql_mode = '';
CREATE TABLE t (id INT PRIMARY KEY);
INSERT INTO t VALUES (1);
ALTER TABLE t ADD COLUMN v VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
DROP TABLE t;
SET sql_mode = DEFAULT;
#
# MODIFY/CHANGE of a nullable column holding NULLs to VECTOR NOT NULL
# must be refused in both strict and non-strict mode, as NULL would be
# converted to an empty (invalid) vector value.
#
SET sql_mode = DEFAULT;
SELECT @@sql_mode;
@@sql_mode
ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
CREATE TABLE t (id INT PRIMARY KEY, b VARBINARY(8) NULL, v VECTOR(2) NULL);
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,2]'), STRING_TO_VECTOR('[1,2]'));
INSERT INTO t VALUES (2, NULL, NULL);
ALTER TABLE t MODIFY b VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t CHANGE b b2 VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t MODIFY v VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t CHANGE v v2 VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
SELECT id, VECTOR_TO_STRING(b), VECTOR_TO_STRING(v) FROM t;
id	VECTOR_TO_STRING(b)	VECTOR_TO_STRING(v)
1	[1.00000e+00,2.00000e+00]	[1.00000e+00,2.00000e+00]
2	NULL	NULL
# Allowed once there are no NULL values.
DELETE FROM t WHERE id = 2;
ALTER TABLE t MODIFY b VECTOR(2) NOT NULL, CHANGE v v2 VECTOR(2) NOT NULL;
SELECT id, VECTOR_TO_STRING(b), VECTOR_TO_STRING(v2) FROM t;
id	VECTOR_TO_STRING(b)	VECTOR_TO_STRING(v2)
1	[1.00000e+00,2.00000e+00]	[1.00000e+00,2.00000e+00]
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `id` int NOT NULL,
  `b` vector(2) NOT NULL,
  `v2` vector(2) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t;
SET sql_mode = '';
SELECT @@sql_mode;
@@sql_mode

CREATE TABLE t (id INT PRIMARY KEY, b VARBINARY(8) NULL, v VECTOR(2) NULL);
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,2]'), STRING_TO_VECTOR('[1,2]'));
INSERT INTO t VALUES (2, NULL, NULL);
ALTER TABLE t MODIFY b VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t CHANGE b b2 VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t MODIFY v VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
ALTER TABLE t CHANGE v v2 VECTOR(2) NOT NULL;
ERROR 22004: Invalid use of NULL value
SELECT id, VECTOR_TO_STRING(b), VECTOR_TO_STRING(v) FROM t;
id	VECTOR_TO_STRING(b)	VECTOR_TO_STRING(v)
1	[1.00000e+00,2.00000e+00]	[1.00000e+00,2.00000e+00]
2	NULL	NULL
# Allowed once there are no NULL values.
DELETE FROM t WHERE id = 2;
ALTER TABLE t MODIFY b VECTOR(2) NOT NULL, CHANGE v v2 VECTOR(2) NOT NULL;
SELECT id, VECTOR_TO_STRING(b), VECTOR_TO_STRING(v2) FROM t;
id	VECTOR_TO_STRING(b)	VECTOR_TO_STRING(v2)
1	[1.00000e+00,2.00000e+00]	[1.00000e+00,2.00000e+00]
SHOW CREATE TABLE t;
Table	Create Table
t	CREATE TABLE `t` (
  `id` int NOT NULL,
  `b` vector(2) NOT NULL,
  `v2` vector(2) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t;
SET sql_mode = DEFAULT;
