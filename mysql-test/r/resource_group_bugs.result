#
# Bug#28122841 - CREATE EVENT/PROCEDURE/FUNCTION CRASHES WITH ACCENT INSENSITIVE NAMES.
#                (This issue is observed with Resource groups too.)
#
SET NAMES utf8mb3;
Warnings:
Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
#
# Test case to verify Resource group with case and accent insensitive names.
#
CREATE RESOURCE GROUP café TYPE=USER VCPU=1-3 THREAD_PRIORITY=5;
# Resource group names are case and accent insensitive. So from the
# data-dictionary "cafe" is obtained for the following statement. Since
# MDL key comparison is case and accent sensitive, assert condition to verify
# expected lock with name "test.cafe" fails (lock is obtained on the
# test.café).
CREATE RESOURCE GROUP cafe TYPE=USER VCPU=1-3 THREAD_PRIORITY=5;
ERROR HY000: Resource Group 'cafe' exists
# Following statement is to verify operation with the upper case name.
CREATE RESOURCE GROUP CAFE TYPE=USER VCPU=1-3 THREAD_PRIORITY=5;
ERROR HY000: Resource Group 'CAFE' exists
DROP RESOURCE GROUP CaFé;
SET NAMES default;
#
# Bug#35696738 RESOURCE GROUP hint fails when used within a
#              prepared statement
#
CREATE RESOURCE GROUP r1 TYPE=USER VCPU=0,1;
CREATE RESOURCE GROUP r2 TYPE=USER VCPU=2,3;

# Test 1
# Validate that a direct statement with RESOURCE_GROUP(r1) executes
# in resource group 'r1'.
# Expected behavior: query should return 1.
SELECT /*+ RESOURCE_GROUP(r1) */ resource_group = 'r1' AS is_r1
FROM performance_schema.threads WHERE processlist_id = connection_id();
is_r1
1

# Test 2
# Validate that a prepared statement preserves RESOURCE_GROUP(r1)
# across first execution and re-execution.
# Expected behavior: each EXECUTE should return 1.
PREPARE stmt1 FROM
'SELECT /*+ RESOURCE_GROUP(r1) */ resource_group = ''r1'' AS is_r1
   FROM performance_schema.threads WHERE processlist_id = connection_id()';
EXECUTE stmt1;
is_r1
1
EXECUTE stmt1;
is_r1
1

# Test 3
# Validate that a prepared statement's RESOURCE_GROUP(r1) hint takes
# precedence over a session resource group selected after PREPARE.
# Expected behavior: EXECUTE should return 1 for resource group 'r1'.
SET RESOURCE GROUP r2;
EXECUTE stmt1;
is_r1
1
# The hint is temporary; the session resource group must be restored.
SELECT resource_group = 'r2' AS is_r2
FROM performance_schema.threads WHERE processlist_id = connection_id();
is_r2
1
SET RESOURCE GROUP USR_default;

# Test 4
# Validate that a prepared statement without a RESOURCE_GROUP hint
# executes in the session resource group selected after PREPARE.
# Expected behavior: EXECUTE should return 1 for resource group 'r2'.
PREPARE stmt_no_hint FROM
'SELECT resource_group = ''r2'' AS is_r2
   FROM performance_schema.threads WHERE processlist_id = connection_id()';
SET RESOURCE GROUP r2;
EXECUTE stmt_no_hint;
is_r2
1
SET RESOURCE GROUP USR_default;
DEALLOCATE PREPARE stmt_no_hint;

# Test 5
# Validate that executing the prepared statement does not affect
# later statements in the same connection.
# Expected behavior: query should return 1 for default group.
SELECT resource_group = 'USR_default' AS is_default
FROM performance_schema.threads WHERE processlist_id = connection_id();
is_default
1

# Test 6
# Validate that multiple prepared statements in the same connection
# keep their own resource-group behavior across re-execution.
# Expected behavior: every EXECUTE should return 1.
PREPARE stmt2 FROM
'SELECT /*+ RESOURCE_GROUP(r2) */ resource_group = ''r2'' AS is_r2
   FROM performance_schema.threads WHERE processlist_id = connection_id()';
PREPARE stmt3 FROM
'SELECT resource_group = ''USR_default'' AS is_default
   FROM performance_schema.threads WHERE processlist_id = connection_id()';
EXECUTE stmt1;
is_r1
1
EXECUTE stmt2;
is_r2
1
EXECUTE stmt3;
is_default
1
EXECUTE stmt1;
is_r1
1
EXECUTE stmt2;
is_r2
1
EXECUTE stmt3;
is_default
1
# Clean-up.
DEALLOCATE PREPARE stmt1;
DEALLOCATE PREPARE stmt2;
DEALLOCATE PREPARE stmt3;
DROP RESOURCE GROUP r1;
DROP RESOURCE GROUP r2;

#
# Additional prepared statement coverage for resource group hints.
#
CREATE RESOURCE GROUP r1 TYPE=USER VCPU=0,1;
CREATE RESOURCE GROUP r2 TYPE=USER VCPU=2,3;
CREATE RESOURCE GROUP r3 TYPE=USER VCPU=0;

# Test 7
# Validate that a prepared statement keeps the hinted resource
# group name for warning reporting even if the resource group does not
# exist at EXECUTE time.
# Expected behavior: EXECUTE should return 1 for the default group,
# warning_count should be 1, and diagnostics should report
# ER_RESOURCE_GROUP_NOT_EXISTS for the hinted group name.
PREPARE stmt_missing FROM
'SELECT /*+ RESOURCE_GROUP(missing_rg) */ resource_group = ''USR_default'' AS is_default
   FROM performance_schema.threads WHERE processlist_id = connection_id()';
EXECUTE stmt_missing;
is_default
1
SHOW COUNT(*) WARNINGS;
@@session.warning_count
1
GET DIAGNOSTICS CONDITION 1 @missing_errno = MYSQL_ERRNO, @missing_txt = MESSAGE_TEXT;
SELECT @missing_errno = 3651 AS is_expected_errno,
@missing_txt = 'Resource Group ''missing_rg'' does not exist.' AS is_expected_text;
is_expected_errno	is_expected_text
1	1
DEALLOCATE PREPARE stmt_missing;

# Test 8
# Validate that a prepared statement still rejects binding a
# SYSTEM resource group when the hint is restored from prepared statement
# state during EXECUTE.
# Expected behavior: EXECUTE should return 1 for the default group,
# warning_count should be 1, and diagnostics should report warning code
# 3661.
PREPARE stmt_system FROM
'SELECT /*+ RESOURCE_GROUP(SYS_default) */ resource_group = ''USR_default'' AS is_default
   FROM performance_schema.threads WHERE processlist_id = connection_id()';
EXECUTE stmt_system;
is_default
1
SHOW COUNT(*) WARNINGS;
@@session.warning_count
1
GET DIAGNOSTICS CONDITION 1 @system_errno = MYSQL_ERRNO;
SELECT @system_errno = 3661 AS is_expected_errno;
is_expected_errno
1
DEALLOCATE PREPARE stmt_system;

# Test 9
# Validate that a prepared statement executed by a user without
# RESOURCE_GROUP_ADMIN or RESOURCE_GROUP_USER still preserves the hint
# name and emits the expected warning.
# Expected behavior: EXECUTE should return 1, warning_count should be 1,
# and diagnostics should report ER_SPECIFIC_ACCESS_DENIED_ERROR.
CREATE USER u_no_rg@localhost IDENTIFIED BY 'pwd';
PREPARE stmt_access FROM 'SELECT /*+ RESOURCE_GROUP(r1) */ 1 AS ok';
EXECUTE stmt_access;
ok
1
SHOW COUNT(*) WARNINGS;
@@session.warning_count
1
GET DIAGNOSTICS CONDITION 1 @access_errno = MYSQL_ERRNO;
SELECT @access_errno = 1227 AS is_expected_errno;
is_expected_errno
1
DEALLOCATE PREPARE stmt_access;
DROP USER u_no_rg@localhost;

# Test 10
# Validate duplicate RESOURCE_GROUP hints inside a prepared
# statement.
# Expected behavior: the last RESOURCE_GROUP hint should win, so EXECUTE
# should return 1 for resource group 'r2'.
PREPARE stmt_dups FROM
'SELECT /*+ RESOURCE_GROUP(r1) RESOURCE_GROUP(r2) */ resource_group = ''r2'' AS is_r2
   FROM performance_schema.threads WHERE processlist_id = connection_id()';
EXECUTE stmt_dups;
is_r2
1
DEALLOCATE PREPARE stmt_dups;

# Test 11
# Validate that the resource group referenced by a prepared
# statement is resolved at EXECUTE time, not frozen at PREPARE time.
# Expected behavior: if the resource group is dropped after PREPARE but
# before EXECUTE, EXECUTE should return 1 for the default group,
# warning_count should be 1, and diagnostics should report
# ER_RESOURCE_GROUP_NOT_EXISTS.
PREPARE stmt_dropped FROM
'SELECT /*+ RESOURCE_GROUP(r3) */ resource_group = ''USR_default'' AS is_default
   FROM performance_schema.threads WHERE processlist_id = connection_id()';
DROP RESOURCE GROUP r3;
EXECUTE stmt_dropped;
is_default
1
SHOW COUNT(*) WARNINGS;
@@session.warning_count
1
GET DIAGNOSTICS CONDITION 1 @dropped_errno = MYSQL_ERRNO, @dropped_txt = MESSAGE_TEXT;
SELECT @dropped_errno = 3651 AS is_expected_errno,
@dropped_txt = 'Resource Group ''r3'' does not exist.' AS is_expected_text;
is_expected_errno	is_expected_text
1	1
DEALLOCATE PREPARE stmt_dropped;

# Test 12
# Validate that a missing hinted resource group leaves the session
# resource group active when EXECUTE resolves the hint.
# Expected behavior: EXECUTE should return 1 for resource group 'r2',
# emit one warning, and report ER_RESOURCE_GROUP_NOT_EXISTS.
PREPARE stmt_missing_session FROM
'SELECT /*+ RESOURCE_GROUP(missing_session_rg) */
          resource_group = ''r2'' AS is_r2
     FROM performance_schema.threads
    WHERE processlist_id = connection_id()';
SET RESOURCE GROUP r2;
EXECUTE stmt_missing_session;
is_r2
1
SHOW COUNT(*) WARNINGS;
@@session.warning_count
1
GET DIAGNOSTICS CONDITION 1 @missing_session_errno = MYSQL_ERRNO,
@missing_session_txt = MESSAGE_TEXT;
SELECT @missing_session_errno = 3651 AS is_expected_errno,
@missing_session_txt =
'Resource Group ''missing_session_rg'' does not exist.' AS is_expected_text;
is_expected_errno	is_expected_text
1	1
SET RESOURCE GROUP USR_default;
DEALLOCATE PREPARE stmt_missing_session;

# Test 13
# Validate that RESOURCE_GROUP hint state is preserved when a
# prepared statement is reprepared after metadata changes.
# Expected behavior: EXECUTE should return 1 for resource group 'r1'
# even after ALTER TABLE forces statement reprepare.
CREATE TABLE t_reprepare (a INT);
INSERT INTO t_reprepare VALUES (1);
PREPARE stmt_reprepare FROM
'SELECT /*+ RESOURCE_GROUP(r1) */
          (SELECT resource_group = ''r1''
             FROM performance_schema.threads
            WHERE processlist_id = connection_id()) AS is_r1
     FROM t_reprepare';
ALTER TABLE t_reprepare ADD COLUMN b INT;
EXECUTE stmt_reprepare;
is_r1
1
DEALLOCATE PREPARE stmt_reprepare;
DROP TABLE t_reprepare;
# Clean-up additional coverage.
DROP RESOURCE GROUP r1;
DROP RESOURCE GROUP r2;
