#
# Test 21: Stored procedure with DELETE ... RETURNING
#
CREATE PROCEDURE p1(IN val INT)
BEGIN
DELETE FROM t1 WHERE a = val RETURNING *;
INSERT INTO t1 VALUES (val, 'reinserted');
END|
CALL p1(1);
a	b
1	a
1	A
SELECT * FROM t1;
a	b
7	ggggggg
3	ccc
4	dddd
2	BB
4	DDDD
5	EEEEE
7	GGGGGGG
2	bb
1	reinserted
DROP PROCEDURE p1;
