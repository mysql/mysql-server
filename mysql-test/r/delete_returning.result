# Test 8: DELETE ... RETURNING with subquery using GROUP_CONCAT
#
DELETE FROM t2 WHERE c < 5
RETURNING (SELECT GROUP_CONCAT(b) FROM t1 GROUP BY a HAVING a = c);
(SELECT GROUP_CONCAT(b) FROM t1 GROUP BY a HAVING a = c)
dddd,DDDD
a,A
