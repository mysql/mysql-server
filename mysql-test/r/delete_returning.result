#
# Test 9: DELETE ... RETURNING with user-defined function
#
CREATE FUNCTION f1(arg INT) RETURNS TEXT
BEGIN
RETURN (SELECT GROUP_CONCAT(b) FROM t1 WHERE a = arg);
END|
DELETE FROM t2 WHERE c < 5 RETURNING f1(c);
f1(c)
dddd,DDDD
a,A
SELECT * FROM t2;
c
5
7
DELETE FROM t2;
INSERT INTO t2 SELECT * FROM t2c;
DROP FUNCTION f1;
