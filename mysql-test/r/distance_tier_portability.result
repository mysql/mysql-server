#
# 1) Fill the table on the best tier for this CPU.
#
SELECT data REGEXP '^For VECTOR_DISTANCE using (hardware accelerated (AVX-512F|AVX2|SSE4[.]2|NEON)|software scalar)[.]$' AS message_ok
FROM performance_schema.error_log
WHERE error_code = 'MY-016026' ORDER BY logged DESC LIMIT 1;
message_ok
1
CREATE TABLE t1 (
id INT PRIMARY KEY,
v VARBINARY(268),
w VARBINARY(268),
d_euclidean DOUBLE AS (DISTANCE(v, w, 'EUCLIDEAN')) STORED,
d_squared DOUBLE AS (DISTANCE(v, w, 'EUCLIDEAN_SQUARED')) STORED,
d_cosine DOUBLE AS (DISTANCE(v, w, 'COSINE')) VIRTUAL,
INDEX i_euclidean (d_euclidean),
INDEX i_cosine (d_cosine),
INDEX i_dot ((DISTANCE(v, w, 'DOT'))),
INDEX i_manhattan ((DISTANCE(v, w, 'MANHATTAN'))));
SET SESSION group_concat_max_len = 65536;
INSERT INTO t1 (id, v, w)
WITH RECURSIVE r (i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM r WHERE i < 100),
n (j) AS (SELECT 0 UNION ALL SELECT j + 1 FROM n WHERE j < 66)
SELECT i,
TO_VECTOR(CONCAT('[', GROUP_CONCAT(
ROUND(SIN(i * 67 + j) * POW(10, j % 7 - 3), 6) ORDER BY j), ']')),
TO_VECTOR(CONCAT('[', GROUP_CONCAT(
ROUND(COS(i * 31 + j * 7) * POW(10, (j + 3) % 7 - 3), 6) ORDER BY j), ']'))
FROM r, n GROUP BY i;
SET SESSION group_concat_max_len = DEFAULT;
SELECT COUNT(*), MIN(LENGTH(v)), MAX(LENGTH(w)) FROM t1;
COUNT(*)	MIN(LENGTH(v))	MAX(LENGTH(w))
100	268	268
SELECT COUNT(*) AS stored_mismatches FROM t1
WHERE NOT (d_euclidean <=> DISTANCE(v, w, 'EUCLIDEAN'))
OR NOT (d_squared <=> DISTANCE(v, w, 'EUCLIDEAN_SQUARED'));
stored_mismatches
0
# Rows not found through i_euclidean:
SELECT COUNT(*) FROM t1 AS a WHERE (SELECT COUNT(*) FROM t1 AS b FORCE INDEX (i_euclidean) WHERE d_euclidean = DISTANCE(a.v, a.w, 'EUCLIDEAN') AND b.id = a.id) <> 1;
COUNT(*)
0
# Rows not found through i_cosine:
SELECT COUNT(*) FROM t1 AS a WHERE (SELECT COUNT(*) FROM t1 AS b FORCE INDEX (i_cosine) WHERE d_cosine = DISTANCE(a.v, a.w, 'COSINE') AND b.id = a.id) <> 1;
COUNT(*)
0
# Rows not found through i_dot:
SELECT COUNT(*) FROM t1 AS a WHERE (SELECT COUNT(*) FROM t1 AS b FORCE INDEX (i_dot) WHERE DISTANCE(b.v, b.w, 'DOT') = DISTANCE(a.v, a.w, 'DOT') AND b.id = a.id) <> 1;
COUNT(*)
0
# Rows not found through i_manhattan:
SELECT COUNT(*) FROM t1 AS a WHERE (SELECT COUNT(*) FROM t1 AS b FORCE INDEX (i_manhattan) WHERE DISTANCE(b.v, b.w, 'MANHATTAN') = DISTANCE(a.v, a.w, 'MANHATTAN') AND b.id = a.id) <> 1;
COUNT(*)
0
