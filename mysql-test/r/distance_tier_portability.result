#
# 1) Fill the table on the best tier for this CPU.
#
SELECT data REGEXP '^For VECTOR_DISTANCE using (hardware accelerated (AVX-512F|AVX2|SSE4[.]2|NEON)|software scalar)[.]$' AS message_ok
FROM performance_schema.error_log
WHERE error_code = 'MY-016026' ORDER BY logged DESC LIMIT 1;
message_ok
1
CREATE TABLE t1 (
id INT PRIMARY KEY,
v VARBINARY(268),
w VARBINARY(268),
d_euclidean DOUBLE AS (DISTANCE(v, w, 'EUCLIDEAN')) STORED,
d_squared DOUBLE AS (DISTANCE(v, w, 'EUCLIDEAN_SQUARED')) STORED,
d_cosine DOUBLE AS (DISTANCE(v, w, 'COSINE')) VIRTUAL,
INDEX i_euclidean (d_euclidean),
INDEX i_cosine (d_cosine),
INDEX i_dot ((DISTANCE(v, w, 'DOT'))),
INDEX i_manhattan ((DISTANCE(v, w, 'MANHATTAN'))));
SET SESSION group_concat_max_len = 1048576;
INSERT INTO t1 (id, v, w)
WITH RECURSIVE r (i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM r WHERE i < 100),
n (j) AS (SELECT 0 UNION ALL SELECT j + 1 FROM n WHERE j < 66)
SELECT i,
TO_VECTOR(CONCAT('[', GROUP_CONCAT(
ROUND(SIN(i * 67 + j) * POW(10, j % 7 - 3), 6) ORDER BY j), ']')),
TO_VECTOR(CONCAT('[', GROUP_CONCAT(
ROUND(COS(i * 31 + j * 7) * POW(10, (j + 3) % 7 - 3), 6) ORDER BY j), ']'))
FROM r, n GROUP BY i;
# The input vectors.  SIN() and COS() come from the platform's math
# library, so if a platform built different vectors, this digest shows it
# and the DISTANCE() digests below are not comparable.
SELECT SHA2(GROUP_CONCAT(HEX(v), HEX(w) ORDER BY id), 256) AS input_digest
FROM t1;
input_digest
9c9b5a7f86e140677dcd665447f32fe8059a56baf4c86e47ece39db4417eadde
SET SESSION group_concat_max_len = DEFAULT;
SELECT COUNT(*), MIN(LENGTH(v)), MAX(LENGTH(w)) FROM t1;
COUNT(*)	MIN(LENGTH(v))	MAX(LENGTH(w))
100	268	268
SELECT id, DISTANCE(v, w, 'EUCLIDEAN') AS euclidean,
DISTANCE(v, w, 'EUCLIDEAN_SQUARED') AS euclidean_squared,
DISTANCE(v, w, 'COSINE') AS cosine, DISTANCE(v, w, 'DOT') AS dot,
DISTANCE(v, w, 'MANHATTAN') AS manhattan
FROM t1 WHERE id IN (1, 2, 7) ORDER BY id;
id	euclidean	euclidean_squared	cosine	dot	manhattan
1	3084.9549576013396	9516947.090429083	1.000046756450287	222.06900666992044	13465.509697754413
2	3112.1744599675794	9685629.869274495	1.0001035887193812	501.29387663235957	13556.912547610453
7	3088.903205712754	9541323.014262527	1.0000420329773048	200.05504557389668	13374.307553419509
SET SESSION group_concat_max_len = 65536;
SELECT 'EUCLIDEAN' AS metric, COUNT(*) AS n, SHA2(GROUP_CONCAT(DISTANCE(v, w, 'EUCLIDEAN') ORDER BY id), 256) AS digest FROM t1;
metric	n	digest
EUCLIDEAN	100	c809eb847d1e52003dcb658628f1218163a0d946d165e894b3060a72b1ce351d
