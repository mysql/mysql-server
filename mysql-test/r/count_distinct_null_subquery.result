#
# Bug #121270: COUNT DISTINCT with a NULL-producing scalar subquery
#
CREATE TABLE t0 (c2 TINYTEXT);
INSERT INTO t0(c2) VALUES ('');
SELECT AES_ENCRYPT(NULL,(SELECT t0.c2 FROM t0)) AS ref0,COUNT(DISTINCT 1,NULL) AS ref1,COUNT(DISTINCT 1,AES_ENCRYPT(NULL,(SELECT t0.c2 FROM t0))) AS ref2 FROM t0;
ref0	ref1	ref2
NULL	0	0
DROP TABLE t0;
#
# Nullable parameters and routine variables must be copied to DISTINCT tables.
#
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1), (2);
PREPARE s FROM 'SELECT COUNT(DISTINCT a, ?) AS c FROM t1';
SET @x = 7;
EXECUTE s USING @x;
c
2
SET @x = NULL;
EXECUTE s USING @x;
c
0
SET @x = 9;
EXECUTE s USING @x;
c
2
SET @x = 7;
EXECUTE s USING @x;
c
2
DEALLOCATE PREPARE s;
PREPARE s FROM
'SELECT a, COUNT(DISTINCT a, ?) AS c FROM t1 GROUP BY a ORDER BY a';
SET @x = 7;
EXECUTE s USING @x;
a	c
1	1
2	1
SET @x = NULL;
EXECUTE s USING @x;
a	c
1	0
2	0
SET @x = 9;
EXECUTE s USING @x;
a	c
1	1
2	1
SET @x = 7;
EXECUTE s USING @x;
a	c
1	1
2	1
DEALLOCATE PREPARE s;
# ROLLUP copies must also fill nullable parameters and routine variables.
PREPARE s FROM
'SELECT a, COUNT(DISTINCT a, ?) AS c FROM t1
   GROUP BY a WITH ROLLUP ORDER BY GROUPING(a), a';
SET @x = 7;
EXECUTE s USING @x;
a	c
1	1
2	1
NULL	2
SET @x = NULL;
EXECUTE s USING @x;
a	c
1	0
2	0
NULL	0
SET @x = 9;
EXECUTE s USING @x;
a	c
1	1
2	1
NULL	2
SET @x = 7;
EXECUTE s USING @x;
a	c
1	1
2	1
NULL	2
DEALLOCATE PREPARE s;
CREATE PROCEDURE p(IN x INT)
BEGIN
SELECT COUNT(DISTINCT a, x) AS c FROM t1;
SELECT a, COUNT(DISTINCT a, x) AS c FROM t1 GROUP BY a ORDER BY a;
SELECT a, COUNT(DISTINCT a, x) AS c FROM t1
GROUP BY a WITH ROLLUP ORDER BY GROUPING(a), a;
END|
CALL p(7);
c
2
a	c
1	1
2	1
a	c
1	1
2	1
NULL	2
CALL p(NULL);
c
0
a	c
1	0
2	0
a	c
1	0
2	0
NULL	0
CALL p(9);
c
2
a	c
1	1
2	1
a	c
1	1
2	1
NULL	2
CALL p(7);
c
2
a	c
1	1
2	1
a	c
1	1
2	1
NULL	2
DROP PROCEDURE p;
DROP TABLE t1;
