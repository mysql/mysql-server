#
# DISTANCE() and VECTOR_DISTANCE() in generated columns and functional
# indexes.
#
# VECTOR columns cannot be referenced by generated columns, functional
# indexes, DEFAULT expressions or CHECK constraints, so these tests store
# the vectors as binary strings of packed float32 values, which DISTANCE()
# also accepts.
#
#
# 0) A VECTOR column is rejected in every value generator.
#
CREATE TABLE t1 (v VECTOR(2),
d DOUBLE AS (DISTANCE(v, TO_VECTOR('[1, 0]'), 'DOT')));
ERROR HY000: Incorrect type for argument v in function GENERATED COLUMN.
CREATE TABLE t1 (v VECTOR(2),
INDEX i ((DISTANCE(v, TO_VECTOR('[1, 0]'), 'DOT'))));
ERROR HY000: Incorrect type for argument v in function GENERATED COLUMN.
CREATE TABLE t1 (v VECTOR(2),
CHECK (DISTANCE(v, TO_VECTOR('[1, 0]'), 'DOT') < 0));
ERROR HY000: Incorrect type for argument v in function CHECK CONSTRAINT.
#
# 1) Stored and virtual generated columns, indexes on them, and
#    functional indexes, one per metric.
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
v VARBINARY(16),
d_euclidean DOUBLE AS
(DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'EUCLIDEAN')) STORED,
d_cosine DOUBLE AS
(VECTOR_DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'COSINE')) VIRTUAL,
INDEX i_euclidean (d_euclidean),
INDEX i_cosine (d_cosine),
INDEX i_dot ((DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'DOT'))),
INDEX i_manhattan
((VECTOR_DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'MANHATTAN'))));
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `v` varbinary(16) DEFAULT NULL,
  `d_euclidean` double GENERATED ALWAYS AS (distance(`v`,to_vector(_utf8mb4'[1, 0, 0, 0]'),_utf8mb4'EUCLIDEAN')) STORED,
  `d_cosine` double GENERATED ALWAYS AS (distance(`v`,to_vector(_utf8mb4'[1, 0, 0, 0]'),_utf8mb4'COSINE')) VIRTUAL,
  PRIMARY KEY (`id`),
  KEY `i_euclidean` (`d_euclidean`),
  KEY `i_cosine` (`d_cosine`),
  KEY `i_dot` ((distance(`v`,to_vector(_utf8mb4'[1, 0, 0, 0]'),_utf8mb4'DOT'))),
  KEY `i_manhattan` ((distance(`v`,to_vector(_utf8mb4'[1, 0, 0, 0]'),_utf8mb4'MANHATTAN')))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Row 4 is the zero vector (COSINE is NULL), row 5 a NULL vector.
INSERT INTO t1 (id, v) VALUES (1, TO_VECTOR('[1, 0, 0, 0]')),
(2, TO_VECTOR('[0, 1, 0, 0]')),
(3, TO_VECTOR('[2, 2, 0, 0]')),
(4, TO_VECTOR('[0, 0, 0, 0]')),
(5, NULL),
(6, TO_VECTOR('[-1, 0, 0, 0]'));
SELECT id, FROM_VECTOR(v), d_euclidean, d_cosine FROM t1 ORDER BY id;
id	FROM_VECTOR(v)	d_euclidean	d_cosine
1	[1.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	0	0
2	[0.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	1.4142135623730951	1
3	[2.00000e+00,2.00000e+00,0.00000e+00,0.00000e+00]	2.23606797749979	0.29289321881345254
4	[0.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	1	NULL
5	NULL	NULL	NULL
6	[-1.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	2	2
# Stored values equal the values computed now.
SELECT COUNT(*) FROM t1
WHERE NOT (d_euclidean <=> DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'EUCLIDEAN'))
OR NOT (d_cosine <=> DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'COSINE'));
COUNT(*)
0
#
# 2) The indexes are used, and give the same rows as a table scan.
#    The constant must be a DOUBLE (0e0, not 0) for the optimizer to
#    replace the expression with the indexed column.
#
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
EXPLAIN SELECT id FROM t1
WHERE DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'DOT') < 0e0;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	range	i_dot	i_dot	9	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` where (distance(`v`,to_vector(_utf8mb4'[1, 0, 0, 0]'),_utf8mb4'DOT') < 0e0)
SELECT id FROM t1 FORCE INDEX (i_dot)
WHERE DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'DOT') < 0e0 ORDER BY id;
id
1
3
SELECT id FROM t1 IGNORE INDEX (i_dot)
WHERE DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'DOT') < 0e0 ORDER BY id;
id
1
3
EXPLAIN SELECT id FROM t1
WHERE VECTOR_DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'MANHATTAN') = 2e0;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	ref	i_manhattan	i_manhattan	9	const	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` where (distance(`v`,to_vector(_utf8mb4'[1, 0, 0, 0]'),_utf8mb4'MANHATTAN') = 2e0)
SELECT id FROM t1 FORCE INDEX (i_manhattan)
WHERE VECTOR_DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'MANHATTAN') = 2e0
ORDER BY id;
id
2
6
# k-NN through a functional index and an index on a generated column.
EXPLAIN SELECT id FROM t1 FORCE INDEX (i_dot)
ORDER BY DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'DOT') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	i_dot	9	NULL	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` FORCE INDEX (`i_dot`) order by distance(`test`.`t1`.`v`,to_vector('[1, 0, 0, 0]'),'DOT') limit 3
SELECT id FROM t1 FORCE INDEX (i_dot)
WHERE DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'DOT') IS NOT NULL
ORDER BY DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'DOT'), id LIMIT 3;
id
3
1
2
EXPLAIN SELECT id FROM t1 ORDER BY d_euclidean LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	index	NULL	i_euclidean	9	NULL	#	#	Using index
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by `test`.`t1`.`d_euclidean` limit 3
SELECT id, d_euclidean FROM t1 FORCE INDEX (i_euclidean)
ORDER BY d_euclidean, id LIMIT 3;
id	d_euclidean
5	NULL
1	0
4	1
SELECT id, d_cosine FROM t1 FORCE INDEX (i_cosine)
WHERE d_cosine IS NOT NULL ORDER BY d_cosine, id LIMIT 3;
id	d_cosine
1	0
3	0.29289321881345254
2	1
#
# 3) UPDATE and DELETE maintain the indexes.
#
UPDATE t1 SET v = TO_VECTOR('[0, 0, 3, 4]') WHERE id = 3;
UPDATE t1 SET v = TO_VECTOR('[1, 1, 0, 0]') WHERE id = 5;
DELETE FROM t1 WHERE id = 2;
SELECT id, FROM_VECTOR(v), d_euclidean, d_cosine FROM t1 ORDER BY id;
id	FROM_VECTOR(v)	d_euclidean	d_cosine
1	[1.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	0	0
3	[0.00000e+00,0.00000e+00,3.00000e+00,4.00000e+00]	5.0990195135927845	1
4	[0.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	1	NULL
5	[1.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	1	0.29289321881345254
6	[-1.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	2	2
SELECT id FROM t1 FORCE INDEX (i_dot)
WHERE DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'DOT') <= -1e0 ORDER BY id;
id
1
5
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
#
# 4) Adding a generated column and a functional index to a table that
#    already has rows.
#
ALTER TABLE t1 ADD COLUMN d_squared DOUBLE AS
(DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'EUCLIDEAN_SQUARED')) STORED;
ALTER TABLE t1 ADD INDEX i_squared
((DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'EUCLIDEAN_SQUARED')));
SELECT id, d_euclidean, d_squared FROM t1 ORDER BY id;
id	d_euclidean	d_squared
1	0	0
3	5.0990195135927845	26
4	1	1
5	1	1
6	2	4
SELECT id FROM t1 FORCE INDEX (i_squared)
WHERE DISTANCE(v, TO_VECTOR('[1, 0, 0, 0]'), 'EUCLIDEAN_SQUARED') = 4e0
ORDER BY id;
id
6
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t1;
#
# 5) Errors when the generated value is computed.
#
CREATE TABLE t1 (v VARBINARY(8),
d DOUBLE AS (DISTANCE(v, TO_VECTOR('[1, 0]'), 'DOT')) STORED);
# NaN element (X'0000C07F' is a float32 NaN).
INSERT INTO t1 (v) VALUES (X'0000C07F0000803F');
ERROR 22003: DOUBLE value is out of range in 'distance(`v`,to_vector(_utf8mb4'[1, 0]'),_utf8mb4'DOT')'
# Dimension mismatch.
INSERT INTO t1 (v) VALUES (TO_VECTOR('[1]'));
ERROR HY000: Incorrect arguments to distance
# Length is not a multiple of 4.
INSERT INTO t1 (v) VALUES (X'0000803F00');
ERROR HY000: Data cannot be converted to a valid vector: ''
SELECT COUNT(*) FROM t1;
COUNT(*)
0
DROP TABLE t1;
# The metric must be a known string literal in generated columns too.
CREATE TABLE t1 (v VARBINARY(8), m VARCHAR(10));
ALTER TABLE t1 ADD COLUMN d DOUBLE AS (DISTANCE(v, v, m));
ERROR HY000: Incorrect arguments to distance
ALTER TABLE t1 ADD COLUMN d DOUBLE AS (DISTANCE(v, v, 'HAMMING'));
ERROR HY000: Incorrect arguments to distance
DROP TABLE t1;
