prepare time_parts from 'select cast(? as time) as cast_time,
                               hour(?) as h,
                               minute(?) as mi,
                               second(?) as sec,
                               microsecond(?) as micro';
prepare tf_parts from 'select time_format(?, ''%H:%i:%s'') as tf';
prepare extract_parts from 'select extract(hour from ?) as ex_h,
                                  extract(minute from ?) as ex_mi,
                                  extract(second from ?) as ex_sec,
                                  extract(microsecond from ?) as ex_micro,
                                  extract(hour_second from ?) as ex_hs,
                                  extract(day_hour from ?) as ex_dh';
prepare date_parts from 'select extract(year from ?) as ex_year,
                               extract(month from ?) as ex_month,
                               extract(day from ?) as ex_day,
                               date_format(?, ''%H:%i:%s'') as df,
                               cast(date_add(?, interval 1 day) as datetime)
                                 as date_add,
                               to_days(?) as to_days';
set @v = '02:02:02';
execute time_parts using @v, @v, @v, @v, @v;
cast_time	h	mi	sec	micro
02:02:02	2	2	2	0
select cast('02:02:02' as time) as cast_time, hour('02:02:02') as h,
minute('02:02:02') as mi, second('02:02:02') as sec,
microsecond('02:02:02') as micro;
cast_time	h	mi	sec	micro
