SET @save_late_optimizer_trace = @@optimizer_trace;
SET @save_late_trace_memory = @@optimizer_trace_max_mem_size;
SET optimizer_trace_max_mem_size = 1000000;
SET optimizer_trace = 'enabled=on';
EXPLAIN FORMAT=JSON INTO @late_range_plan
WITH cte AS (SELECT a, b, c FROM t1 LIMIT 100000)
SELECT (SELECT b FROM cte
WHERE a = 7 AND b >= 2
ORDER BY b DESC LIMIT 1) AS picked,
(SELECT a FROM cte WHERE a = 0 LIMIT 1) AS seed_a,
(SELECT a FROM cte WHERE a = 0 AND b = 0 LIMIT 1) AS seed_ab;
SELECT JSON_SEARCH(TRACE, 'one', 'unsupported TempTable reverse range',
NULL, '$**.cause') IS NOT NULL AS rejected_late_range
FROM information_schema.optimizer_trace;
rejected_late_range
1
SELECT JSON_SEARCH(@late_range_plan, 'one',
'Index lookup on cte% (a = 7) (reverse)',
NULL, '$**.operation') IS NOT NULL AS keeps_reverse_ref;
keeps_reverse_ref
1
SET optimizer_trace = @save_late_optimizer_trace;
SET optimizer_trace_max_mem_size = @save_late_trace_memory;
EXPLAIN FORMAT=JSON INTO @late_range_plan
WITH cte AS (SELECT a, b, c FROM t1 LIMIT 100000)
SELECT (SELECT b FROM cte
WHERE a = 7 AND b IN (2, 9, 99)
ORDER BY b DESC LIMIT 1) AS picked,
(SELECT a FROM cte WHERE a = 0 LIMIT 1) AS seed_a,
(SELECT a FROM cte WHERE a = 0 AND b = 0 LIMIT 1) AS seed_ab;
SELECT JSON_SEARCH(@late_range_plan, 'one',
'Index range scan on cte% (reverse)',
NULL, '$**.operation') IS NOT NULL AS supported_reverse_range;
supported_reverse_range
1
EXPLAIN FORMAT=JSON INTO @late_range_plan
WITH cte AS (SELECT a, b, c FROM t1 LIMIT 100000)
SELECT (SELECT b FROM cte
WHERE a = 7 AND b >= 2
ORDER BY b ASC LIMIT 1) AS picked,
(SELECT a FROM cte WHERE a = 0 LIMIT 1) AS seed_a,
(SELECT a FROM cte WHERE a = 0 AND b = 0 LIMIT 1) AS seed_ab;
SELECT JSON_SEARCH(@late_range_plan, 'one',
'Index range scan on cte%over (a = 7 AND 2 <= b)',
NULL, '$**.operation') IS NOT NULL AS supported_forward_range;
supported_forward_range
1
