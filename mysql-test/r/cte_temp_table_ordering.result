        ORDER BY b
        LIMIT 1) AS picked
FROM t2
JOIN t2 AS lookup
  ON lookup.id = (SELECT b FROM cte WHERE b = 1 LIMIT 1)
JOIN cte AS seed_b ON seed_b.b = 0
JOIN cte AS seed_c ON seed_c.c = 0
JOIN cte AS seed_d ON seed_d.d = 0
ORDER BY t2.id';
EXECUTE range_stmt;
