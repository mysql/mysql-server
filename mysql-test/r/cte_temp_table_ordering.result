FROM cte
WHERE a = 7 AND b < 9 AND d >= t2.k
ORDER BY b
LIMIT 1) AS picked
FROM t2
JOIN t2 AS lookup
ON lookup.id = (SELECT a FROM cte WHERE a = 1 LIMIT 1)
JOIN cte AS seed_ab ON seed_ab.a = 0 AND seed_ab.b = 0
JOIN cte AS seed_d ON seed_d.d = 0
ORDER BY t2.id;
