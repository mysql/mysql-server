'WITH cte AS (SELECT b, c FROM t1 LIMIT 100000)
SELECT t2.id,
       (SELECT b
        FROM cte
        WHERE b > 195 AND b < 210
          AND c = t2.k
        ORDER BY b ASC
        LIMIT 1) AS picked
FROM t2
JOIN t2 AS lookup
  ON lookup.id = (SELECT b FROM cte WHERE b = 1 LIMIT 1)
JOIN cte AS seed_b ON seed_b.b = 0
JOIN cte AS seed_c ON seed_c.c = 0
ORDER BY t2.id';
EXECUTE ref_stmt;
