#
# Bug#120923 Wrong result with CTE, UNION ALL, GROUP BY, and COUNT()
#
CREATE TABLE a (b INT);
# Original input and equivalent view
INSERT INTO a VALUES (1), (NULL);
WITH cte AS (
SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c;
c
0
2
