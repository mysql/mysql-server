# GROUP_CONCAT() and UNION
#
CREATE TABLE t0 (c0 CHAR(1), c3 INT);
# Original input and equivalent view
INSERT INTO t0 VALUES ('', 1), ('', 0), (NULL, 1);
WITH cte AS (
SELECT DISTINCT c0 AS vc_0, c3 AS vc_1 FROM t0
)
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 = 0 GROUP BY gk0
UNION
SELECT vc_1 AS gk0, GROUP_CONCAT(vc_1) AS gc FROM cte
WHERE vc_1 > 0 OR vc_0 = '' GROUP BY gk0;
