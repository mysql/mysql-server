#
# Range access on c must survive a rejected ordering range on b
#
ALTER TABLE t1 ADD COLUMN d INT NOT NULL DEFAULT 0;
UPDATE t1 SET d = b;
TRUNCATE TABLE t2;
INSERT INTO t2 VALUES (1, 5), (2, 55), (3, 195), (4, 220);
ANALYZE TABLE t1, t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
WITH cte AS (SELECT b, c, d FROM t1 LIMIT 100000)
SELECT t2.id,
(SELECT b
FROM cte
WHERE b < 210 AND c >= 10 AND d >= t2.k
ORDER BY b
LIMIT 1) AS picked
FROM t2
JOIN t2 AS lookup
ON lookup.id = (SELECT b FROM cte WHERE b = 1 LIMIT 1)
JOIN cte AS seed_b ON seed_b.b = 0
JOIN cte AS seed_c ON seed_c.c = 0
JOIN cte AS seed_d ON seed_d.d = 0
ORDER BY t2.id;
