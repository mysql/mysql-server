WITH cte AS (SELECT a, b, c FROM t1 LIMIT 100000)
SELECT (SELECT b FROM cte
WHERE a = 7 AND b IN (2, 9, 99)
ORDER BY b DESC LIMIT 1) AS picked,
(SELECT a FROM cte WHERE a = 0 LIMIT 1) AS seed_a,
(SELECT a FROM cte WHERE a = 0 AND b = 0 LIMIT 1) AS seed_ab;
picked	seed_a	seed_ab
99	0	0
WITH cte AS (SELECT a, b, c FROM t1 LIMIT 100000)
SELECT (SELECT b FROM cte
WHERE a = 7 AND b >= 2
ORDER BY b ASC LIMIT 1) AS picked,
(SELECT a FROM cte WHERE a = 0 LIMIT 1) AS seed_a,
(SELECT a FROM cte WHERE a = 0 AND b = 0 LIMIT 1) AS seed_ab;
picked	seed_a	seed_ab
