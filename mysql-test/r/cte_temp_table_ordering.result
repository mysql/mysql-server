#
# Shared CTE ORDER BY with LIMIT must retain the required sort
#
TRUNCATE TABLE a;
INSERT INTO a VALUES (1), (2), (0);
ANALYZE TABLE a;
# ASC ordering and repeated prepared execution
WITH cte AS (
SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 0
UNION
(SELECT b FROM cte ORDER BY b ASC LIMIT 1);
b
0
PREPARE stmt FROM
'WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 0
UNION
(SELECT b FROM cte ORDER BY b ASC LIMIT 1)';
EXECUTE stmt;
b
0
EXECUTE stmt;
b
0
DEALLOCATE PREPARE stmt;
# DESC ordering and repeated prepared execution
WITH cte AS (
SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 2
UNION
(SELECT b FROM cte ORDER BY b DESC LIMIT 1);
b
2
PREPARE stmt FROM
'WITH cte AS (
  SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT b FROM cte WHERE b = 2
UNION
(SELECT b FROM cte ORDER BY b DESC LIMIT 1)';
EXECUTE stmt;
b
2
EXECUTE stmt;
b
2
DEALLOCATE PREPARE stmt;
#
# DISTINCT with ordered LIMIT must preserve sort feasibility
#
INSERT INTO a VALUES (NULL);
# ASC distinct values from a duplicated, shared CTE
WITH cte AS (
SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT DISTINCT b FROM cte
WHERE EXISTS (SELECT 1 FROM cte AS seed WHERE seed.b = 0)
ORDER BY b ASC LIMIT 2;
b
NULL
0
# DESC distinct values from a duplicated, shared CTE
WITH cte AS (
SELECT b FROM a UNION ALL SELECT b FROM a
)
SELECT DISTINCT b FROM cte
WHERE EXISTS (SELECT 1 FROM cte AS seed WHERE seed.b = 0)
ORDER BY b DESC LIMIT 2;
b
2
1
DROP TABLE a;
#
