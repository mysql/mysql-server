'WITH cte AS (
  SELECT b AS c FROM a UNION ALL SELECT b FROM a
)
SELECT c FROM cte WHERE c = 0
UNION
SELECT COUNT(c) FROM cte GROUP BY c';
EXECUTE stmt;
c
0
2
EXECUTE stmt;
c
0
2
CREATE VIEW v0 AS SELECT b AS c FROM a UNION ALL SELECT b FROM a;
SELECT c FROM v0 WHERE c = 0
UNION
SELECT COUNT(c) FROM v0 GROUP BY c;
c
0
2
DROP VIEW v0;
