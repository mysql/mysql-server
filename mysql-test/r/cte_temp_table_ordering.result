#
# Late ref-to-range conversion must validate reverse TempTable access
#
CREATE TABLE t1 (a INT NOT NULL, b INT NOT NULL, c INT NOT NULL);
INSERT INTO t1
WITH RECURSIVE n(i) AS (
SELECT 0
UNION ALL
SELECT i + 1 FROM n WHERE i < 799
)
SELECT i DIV 100, MOD(i, 100), i FROM n;
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
WITH cte AS (SELECT a, b, c FROM t1 LIMIT 100000)
SELECT (SELECT b FROM cte
WHERE a = 7 AND b >= 2
ORDER BY b DESC LIMIT 1) AS picked,
(SELECT a FROM cte WHERE a = 0 LIMIT 1) AS seed_a,
(SELECT a FROM cte WHERE a = 0 AND b = 0 LIMIT 1) AS seed_ab;
picked	seed_a	seed_ab
99	0	0
PREPARE late_range_stmt FROM
'WITH cte AS (SELECT a, b, c FROM t1 LIMIT 100000)
SELECT (SELECT b FROM cte
        WHERE a = 7 AND b >= 2
        ORDER BY b DESC LIMIT 1) AS picked,
       (SELECT a FROM cte WHERE a = 0 LIMIT 1) AS seed_a,
       (SELECT a FROM cte WHERE a = 0 AND b = 0 LIMIT 1) AS seed_ab';
EXECUTE late_range_stmt;
picked	seed_a	seed_ab
99	0	0
EXECUTE late_range_stmt;
picked	seed_a	seed_ab
99	0	0
DEALLOCATE PREPARE late_range_stmt;
WITH cte AS (SELECT a, b, c FROM t1 LIMIT 100000)
SELECT (SELECT b FROM cte
WHERE a = 7 AND b >= 2 AND b < 90
ORDER BY b DESC LIMIT 1) AS picked,
(SELECT a FROM cte WHERE a = 0 LIMIT 1) AS seed_a,
(SELECT a FROM cte WHERE a = 0 AND b = 0 LIMIT 1) AS seed_ab;
picked	seed_a	seed_ab
89	0	0
