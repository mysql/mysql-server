# WL14955: Have backtraces of failed runs appear in pfs.error_log
#

#
# Take down server started by mtr.
#
# Start our own server. Log to LOG_FILE1.
#
# Connect to our own server.
#
# Log a header.
# If the header is present, but the stackdump is not, the stackdump
# failed. If the header is not present, we have bigger issues.
SET @@session.debug="+d,parser_stmt_to_error_log_with_system_prio";
SELECT "--- STACKTRACE TO FOLLOW ---";
--- STACKTRACE TO FOLLOW ---
--- STACKTRACE TO FOLLOW ---
SET @@session.debug="-d,parser_stmt_to_error_log_with_system_prio";
#
# Let's synthesize a crash, so to hopefully get a backtrace.
SET @@session.debug='d,crash_now';
ERROR HY000: Lost connection to MySQL server during query
#
# Restart mysqld after the crash using the same log-file.
# Then, reconnect.
# restart: --log-error=LOG_FILE1 --log-timestamps=UTC
#
# Connect to our own server.
#
# Check error-log file for stacktrace.
# Test 1: expect one match (processed line only)
include/assert_grep.inc [Found the expected stacktrace in the error-log file.]
#
# Check error-log file for stacktrace.
# Test 2: expect two matches (original and processed line)
include/assert_grep.inc [Found the expected stacktraces in the error-log file.]
#
# Show that a stacktrace was created, and was read at start-up.
# While in log_backtrace.test, we wrote the processed stacktrace
# to the JSON-log, this time we'll use the traditional error-log
# format. It is worth testing both scenarios (input and output in
# different log files vis-a-vis input and output in the same log
# file).
SET @err_code=ER_STACK_BACKTRACE;
#
# Look for 'SELECT'-header.
SELECT data
FROM performance_schema.error_log
WHERE data LIKE "%--- STACKTRACE TO FOLLOW ---%";
data
Parser saw: SELECT "--- STACKTRACE TO FOLLOW ---"
#
# Look for stacktrace in pfs.error_log. Should find 1 signal-header.
SELECT COUNT(*)
FROM performance_schema.error_log
WHERE error_code=@err_code
AND data LIKE "% UTC - mysqld got %";
COUNT(*)
1
#
# Clean up.

###################################################################
# Crash handler: format of the query printed after a fatal signal,
# see log_error_crash_query_format.
#
# The statement the crashing thread was executing is printed after
# "Trying to get some variables.". With the default, SINGLE_LINE,
# it is printed on one line after "Query (ADDR): ". With
# TAGGED_LINES, it is printed as complete lines of at most 132 bytes
# of the statement, each prefixed with "Query (ADDR) +OFFSET: ".
# In both cases printing stops at the end of the statement and the
# "Connection ID (thread ID)" line follows.
###################################################################
call mtr.add_suppression("mysqld got signal");
call mtr.add_suppression("Attempting backtrace. You can use the following information to find out");
#
# Take down the server and start our own, with the default format,
# logging to LOG_FILE2.
SELECT @@global.log_error_crash_query_format;
@@global.log_error_crash_query_format
SINGLE_LINE
#
# Crash while the long statement is in flight.
SET @@session.debug='d,crash_now' /*  END_OF_MARKER */;
ERROR HY000: Lost connection to MySQL server during query
#
# Restart with TAGGED_LINES, logging to LOG_FILE3.
# restart: --log-error=LOG_FILE3 --log-error-verbosity=1 --log-error-crash-query-format=TAGGED_LINES
SELECT @@global.log_error_crash_query_format;
@@global.log_error_crash_query_format
TAGGED_LINES
#
# SINGLE_LINE: the whole statement is on one line after the label.
include/assert_grep.inc [The statement is printed on one line.]
include/assert_grep.inc [No tagged lines are printed by default.]
# The query line and the line following it, address and thread ID
# masked.
Query (ADDR): SET @@session.debug='d,crash_now' /*  END_OF_MARKER */
Connection ID (thread ID): N
#
# Crash again while the long statement is in flight.
SET @@session.debug='d,crash_now' /*  END_OF_MARKER */;
ERROR HY000: Lost connection to MySQL server during query
#
# Restart with the default format, reusing LOG_FILE3.
# restart: --log-error=LOG_FILE3 --log-error-verbosity=1
#
# TAGGED_LINES: the statement is printed as offset-tagged lines.
include/assert_grep.inc [The first tagged line is at offset 0.]
include/assert_grep.inc [The second tagged line is at offset 132.]
include/assert_grep.inc [The third tagged line is at offset 264.]
include/assert_grep.inc [The last tagged line ends with the end of the statement.]
include/assert_grep.inc [No single-line query is printed with TAGGED_LINES.]
# The tagged lines and the line following them, address and thread
# ID masked.
Query (ADDR) +0: SET @@session.debug='d,crash_now' /* 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde
Query (ADDR) +132: f0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef012
Query (ADDR) +264: 3456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456
Query (ADDR) +396: 789abcdef0123456789abcd END_OF_MARKER */
Connection ID (thread ID): N
#
# Clean up.
