include/only_with_option.inc [GLOBAL.log_bin = 0]
RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (a INT);
SET @@SESSION.xa_detach_on_prepare = ON;
SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1';
XA START 'xa_prepare_nobinlog';
INSERT INTO t1 VALUES (1);
XA END 'xa_prepare_nobinlog';
include/execute_to_conditional_timestamp_sync_point.inc [after_call_actions_before_gtid_state_update]
XA PREPARE 'xa_prepare_nobinlog';
include/assert.inc [1 XA transaction(s) in PREPARED state]
include/assert.inc [GTID_EXECUTED does not contain the XA PREPARE GTID yet]
include/execute_from_conditional_timestamp_sync_point.inc [1@after_call_actions_before_gtid_state_update]
include/assert.inc [GTID_EXECUTED contains the XA PREPARE GTID]
SET GTID_NEXT = AUTOMATIC;
XA ROLLBACK 'xa_prepare_nobinlog';
DROP TABLE t1;
RESET BINARY LOGS AND GTIDS;
