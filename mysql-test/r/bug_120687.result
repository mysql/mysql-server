0
SELECT COUNT(*) AS cnt FROM t WHERE CASE WHEN ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) THEN ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) ELSE ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) END;
cnt
0
