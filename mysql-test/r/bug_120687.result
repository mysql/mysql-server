SELECT COUNT(*) AS cnt FROM t WHERE (('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) OR ((('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) AND NOT ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]'))) AND ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) IS NOT NULL));
