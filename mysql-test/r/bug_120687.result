CREATE DATABASE bug_120687 CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE bug_120687;
SET sql_mode=DEFAULT;
SET optimizer_switch=DEFAULT;
SET default_storage_engine=InnoDB;
SET NAMES utf8mb4 COLLATE utf8mb4_general_ci;
CREATE TABLE t (j JSON,KEY idate((CAST(j->'$[*]' AS DATE ARRAY))),KEY idt((CAST(j->'$[*]' AS DATETIME ARRAY))));
INSERT INTO t VALUES ('["2001-01-01 12:34:56"]'),('["2001-01-02 00:00:00"]');
SELECT COUNT(*) AS cnt FROM t WHERE '2001-01-01 00:00:00' MEMBER OF (j->'$[*]');
cnt
0
PREPARE regression_stmt FROM 'SELECT COUNT(*) AS cnt FROM t WHERE ''2001-01-01 00:00:00'' MEMBER OF (j->''$[*]'');';
EXECUTE regression_stmt;
cnt
0
EXECUTE regression_stmt;
cnt
0
DEALLOCATE PREPARE regression_stmt;
SELECT COUNT(*) AS cnt FROM t WHERE NOT NOT ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]'));
cnt
0
SELECT COUNT(*) AS cnt FROM t WHERE NOT (NOT ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) OR NOT ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')));
