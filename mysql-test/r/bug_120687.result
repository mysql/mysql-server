SELECT COUNT(*) AS cnt FROM t WHERE (((('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) OR NOT ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]'))) OR ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) IS NULL) AND ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')));
cnt
0
SELECT COUNT(*) AS cnt FROM t WHERE (('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) AND ((('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) OR NOT ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]'))) OR ('2001-01-01 00:00:00' MEMBER OF (j->'$[*]')) IS NULL));
