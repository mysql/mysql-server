#
# Bug#38657550 Use-after-free of TABLE::read_set in DynamicRangeIterator
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
col1 INT,
col2 INT,
col3 INT,
KEY index_col2(col2),
KEY index_col3(col3),
KEY index_c123(col1, col2, col3)
);
CREATE PROCEDURE insert_data_t1()
BEGIN
DECLARE num INT;
SET num = 1;
WHILE num <= 3955 DO
INSERT INTO t1 VALUES (num, num / 150, 0, num);
SET num = num + 1;
END WHILE;
END//
CALL insert_data_t1();
ANALYZE TABLE t1;
