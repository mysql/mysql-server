test.t1	analyze	status	OK
EXPLAIN
SELECT
CASE 1
WHEN EXISTS (
SELECT 1
FROM t1
WHERE t1.col1 = 1
AND t1.col2 = d.col2 - 10
AND t1.col3 <= 100
) THEN 2
END
FROM t1 d;
