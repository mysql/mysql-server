CREATE TABLE t1 ( a INTEGER, b INTEGER, c INTEGER );
INSERT INTO t1 (a,b,c) VALUES (1,2,3);
INSERT INTO t1 SELECT * FROM t1;
INSERT INTO t1 SELECT * FROM t1;
INSERT INTO t1 SELECT * FROM t1;
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
EXPLAIN FORMAT=tree SELECT SUM(c) OVER (PARTITION BY a ORDER BY b) FROM t1;
EXPLAIN
-> Window aggregate with buffering: sum(t1.c) OVER (PARTITION BY t1.a ORDER BY t1.b )
    -> Sort: t1.a, t1.b
        -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select sum(`test`.`t1`.`c`) OVER (PARTITION BY `test`.`t1`.`a` ORDER BY `test`.`t1`.`b` )  AS `SUM(c) OVER (PARTITION BY a ORDER BY b)` from `test`.`t1`
EXPLAIN FORMAT=tree SELECT SUM(c) OVER (PARTITION BY a ORDER BY b), SUM(c) OVER (ORDER BY a,b) FROM t1;
EXPLAIN
-> Window aggregate with buffering: sum(t1.c) OVER (ORDER BY t1.a,t1.b )
    -> Window aggregate with buffering: sum(t1.c) OVER (PARTITION BY t1.a ORDER BY t1.b )
        -> Sort: t1.a, t1.b
            -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select sum(`test`.`t1`.`c`) OVER (PARTITION BY `test`.`t1`.`a` ORDER BY `test`.`t1`.`b` )  AS `SUM(c) OVER (PARTITION BY a ORDER BY b)`,sum(`test`.`t1`.`c`) OVER (ORDER BY `test`.`t1`.`a`,`test`.`t1`.`b` )  AS `SUM(c) OVER (ORDER BY a,b)` from `test`.`t1`
EXPLAIN FORMAT=tree SELECT SUM(b) OVER (PARTITION BY a), SUM(c) OVER (ORDER BY a,b) FROM t1;
EXPLAIN
-> Window aggregate with buffering: sum(t1.c) OVER (ORDER BY t1.a,t1.b )
    -> Window aggregate with buffering: sum(t1.b) OVER (PARTITION BY t1.a )
        -> Sort: t1.a, t1.b
            -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select sum(`test`.`t1`.`b`) OVER (PARTITION BY `test`.`t1`.`a` )  AS `SUM(b) OVER (PARTITION BY a)`,sum(`test`.`t1`.`c`) OVER (ORDER BY `test`.`t1`.`a`,`test`.`t1`.`b` )  AS `SUM(c) OVER (ORDER BY a,b)` from `test`.`t1`
EXPLAIN FORMAT=tree SELECT SUM(c) OVER (PARTITION BY a ORDER BY b), SUM(c) OVER (ORDER BY b,a) FROM t1;
EXPLAIN
-> Window aggregate with buffering: sum(t1.c) OVER (ORDER BY t1.b,t1.a )
    -> Sort: t1.b, t1.a
        -> Window aggregate with buffering: sum(t1.c) OVER (PARTITION BY t1.a ORDER BY t1.b )
            -> Sort: t1.a, t1.b
                -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select sum(`test`.`t1`.`c`) OVER (PARTITION BY `test`.`t1`.`a` ORDER BY `test`.`t1`.`b` )  AS `SUM(c) OVER (PARTITION BY a ORDER BY b)`,sum(`test`.`t1`.`c`) OVER (ORDER BY `test`.`t1`.`b`,`test`.`t1`.`a` )  AS `SUM(c) OVER (ORDER BY b,a)` from `test`.`t1`
CREATE INDEX idx ON t1 (a, b);
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
EXPLAIN FORMAT=tree SELECT SUM(a) OVER (PARTITION BY a) FROM t1;
EXPLAIN
-> Window aggregate with buffering: sum(t1.a) OVER (PARTITION BY t1.a )
    -> Covering index scan on t1 using idx

Warnings:
Note	1003	/* select#1 */ select sum(`test`.`t1`.`a`) OVER (PARTITION BY `test`.`t1`.`a` )  AS `SUM(a) OVER (PARTITION BY a)` from `test`.`t1`
EXPLAIN FORMAT=tree SELECT SUM(a) OVER (PARTITION BY a ORDER BY b) FROM t1;
EXPLAIN
-> Window aggregate with buffering: sum(t1.a) OVER (PARTITION BY t1.a ORDER BY t1.b )
    -> Covering index scan on t1 using idx

Warnings:
Note	1003	/* select#1 */ select sum(`test`.`t1`.`a`) OVER (PARTITION BY `test`.`t1`.`a` ORDER BY `test`.`t1`.`b` )  AS `SUM(a) OVER (PARTITION BY a ORDER BY b)` from `test`.`t1`
ALTER TABLE t1 DROP INDEX idx;
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
EXPLAIN FORMAT=tree SELECT a, SUM(c) OVER (PARTITION BY a) FROM t1 ORDER BY a;
EXPLAIN
-> Window aggregate with buffering: sum(t1.c) OVER (PARTITION BY t1.a )
    -> Sort: t1.a
        -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,sum(`test`.`t1`.`c`) OVER (PARTITION BY `test`.`t1`.`a` )  AS `SUM(c) OVER (PARTITION BY a)` from `test`.`t1` order by `test`.`t1`.`a`
EXPLAIN FORMAT=tree SELECT a, SUM(c) OVER (ORDER BY b), AVG(c) OVER (ORDER BY a), SUM(c) OVER (PARTITION BY a) AS x FROM t1 ORDER BY b, x;
EXPLAIN
-> Window aggregate with buffering: sum(t1.c) OVER (ORDER BY t1.b )
    -> Sort: t1.b, x
        -> Window aggregate with buffering: sum(t1.c) OVER (PARTITION BY t1.a )
            -> Window aggregate with buffering: avg(t1.c) OVER (ORDER BY t1.a )
                -> Sort: t1.a
                    -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,sum(`test`.`t1`.`c`) OVER (ORDER BY `test`.`t1`.`b` )  AS `SUM(c) OVER (ORDER BY b)`,avg(`test`.`t1`.`c`) OVER (ORDER BY `test`.`t1`.`a` )  AS `AVG(c) OVER (ORDER BY a)`,sum(`test`.`t1`.`c`) OVER (PARTITION BY `test`.`t1`.`a` )  AS `x` from `test`.`t1` order by `test`.`t1`.`b`,`x`
EXPLAIN FORMAT=tree SELECT SQL_BIG_RESULT DISTINCT a, SUM(c) OVER (ORDER BY b) FROM t1;
EXPLAIN
-> Sort with duplicate removal: t1.a, `SUM(c) OVER (ORDER BY b)`
    -> Window aggregate with buffering: sum(t1.c) OVER (ORDER BY t1.b )
        -> Sort: t1.b
            -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select distinct sql_big_result `test`.`t1`.`a` AS `a`,sum(`test`.`t1`.`c`) OVER (ORDER BY `test`.`t1`.`b` )  AS `SUM(c) OVER (ORDER BY b)` from `test`.`t1`
EXPLAIN FORMAT=tree SELECT DISTINCT a, b, SUM(b) OVER (PARTITION BY a) FROM t1 ORDER BY a;
EXPLAIN
-> Remove duplicates from input grouped on t1.a, t1.b
    -> Window aggregate with buffering: sum(t1.b) OVER (PARTITION BY t1.a )
        -> Sort: t1.a, t1.b
            -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select distinct `test`.`t1`.`a` AS `a`,`test`.`t1`.`b` AS `b`,sum(`test`.`t1`.`b`) OVER (PARTITION BY `test`.`t1`.`a` )  AS `SUM(b) OVER (PARTITION BY a)` from `test`.`t1` order by `test`.`t1`.`a`
EXPLAIN FORMAT=tree SELECT SQL_BIG_RESULT DISTINCT a, SUM(c) OVER (ORDER BY b) FROM t1 ORDER BY a;
EXPLAIN
-> Sort with duplicate removal: t1.a, `SUM(c) OVER (ORDER BY b)`
    -> Window aggregate with buffering: sum(t1.c) OVER (ORDER BY t1.b )
        -> Sort: t1.b
            -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select distinct sql_big_result `test`.`t1`.`a` AS `a`,sum(`test`.`t1`.`c`) OVER (ORDER BY `test`.`t1`.`b` )  AS `SUM(c) OVER (ORDER BY b)` from `test`.`t1` order by `test`.`t1`.`a`
EXPLAIN FORMAT=tree SELECT SUM(a) OVER (ORDER BY b) FROM t1 WHERE b=3;
EXPLAIN
-> Window aggregate with buffering: sum(t1.a) OVER (ORDER BY t1.b )
    -> Filter: (t1.b = 3)
        -> Table scan on t1

Warnings:
Note	1003	/* select#1 */ select sum(`test`.`t1`.`a`) OVER (ORDER BY `test`.`t1`.`b` )  AS `SUM(a) OVER (ORDER BY b)` from `test`.`t1` where multiple equal(3, `test`.`t1`.`b`)
CREATE INDEX idx ON t1 (a);
ANALYZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
EXPLAIN FORMAT=tree SELECT t1.a, SUM(t1.a) OVER (ORDER BY t1.a), SUM(t2.b) OVER (ORDER BY t2.b) FROM t1 JOIN t1 AS t2 ON t1.a = t2.b;
EXPLAIN
-> Window aggregate with buffering: sum(t2.b) OVER (ORDER BY t2.b )
    -> Window aggregate with buffering: sum(t1.a) OVER (ORDER BY t1.a )
        -> Nested loop inner join
            -> Sort: t2.b
                -> Table scan on t2
            -> Covering index lookup on t1 using idx (a = t2.b)

Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`a` AS `a`,sum(`test`.`t1`.`a`) OVER (ORDER BY `test`.`t1`.`a` )  AS `SUM(t1.a) OVER (ORDER BY t1.a)`,sum(`test`.`t2`.`b`) OVER (ORDER BY `test`.`t2`.`b` )  AS `SUM(t2.b) OVER (ORDER BY t2.b)` from `test`.`t1` join `test`.`t1` `t2` where multiple equal(`test`.`t1`.`a`, `t2`.`b`)
DROP TABLE t1;
#
# Bug#34899286: Assertion `!OrderItemsReferenceUnavailableTables(
#               path, used_tables_before_repla
#
CREATE TABLE t1 (pk INT PRIMARY KEY, x INT);
CREATE TABLE t2 (pk INT PRIMARY KEY);
ANALYZE TABLE t1, t2;
Table	Op	Msg_type	Msg_text
test.t1	analyze	status	OK
test.t2	analyze	status	OK
EXPLAIN FORMAT=TREE
SELECT ROW_NUMBER() OVER (PARTITION BY t1.x)
FROM t1, t2 WHERE t1.x = t2.pk
GROUP BY t1.pk;
EXPLAIN
-> Window aggregate: row_number() OVER (PARTITION BY t1.x )
    -> Sort: t1.x
        -> Stream results
            -> Group (no aggregates)
                -> Sort: t1.pk
                    -> Inner hash join (t1.x = t2.pk)
                        -> Covering index scan on t2 using PRIMARY
                        -> Hash
                            -> Index scan on t1 using PRIMARY

Warnings:
Note	1003	/* select#1 */ select row_number() OVER (PARTITION BY `test`.`t1`.`x` )  AS `ROW_NUMBER() OVER (PARTITION BY t1.x)` from `test`.`t1` join `test`.`t2` where multiple equal(`test`.`t1`.`x`, `test`.`t2`.`pk`) group by `test`.`t1`.`pk`
DROP TABLE t1, t2;
