SELECT * FROM v0 WHERE CASE WHEN (vc_1=2.363159231809063e+30 AND vc_0<>0) THEN (vc_1=2.363159231809063e+30 AND vc_0<>0) ELSE (vc_1=2.363159231809063e+30 AND vc_0<>0) END;
vc_0	vc_1
1	2.363159231809063e30
SELECT * FROM v0 WHERE (((vc_1=2.363159231809063e+30 AND vc_0<>0) OR NOT (vc_1=2.363159231809063e+30 AND vc_0<>0)) OR (vc_1=2.363159231809063e+30 AND vc_0<>0) IS NULL) AND (vc_1=2.363159231809063e+30 AND vc_0<>0);
vc_0	vc_1
1	2.363159231809063e30
SELECT * FROM v0 WHERE (((vc_1=2.363159231809063e+30 AND vc_0<>0) AND NOT (vc_1=2.363159231809063e+30 AND vc_0<>0)) AND (vc_1=2.363159231809063e+30 AND vc_0<>0) IS NOT NULL) OR (vc_1=2.363159231809063e+30 AND vc_0<>0);
vc_0	vc_1
1	2.363159231809063e30
