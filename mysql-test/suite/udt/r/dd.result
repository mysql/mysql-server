SHOW CREATE TABLE mysql.user_defined_types;
Table	Create Table
user_defined_types	CREATE TABLE `user_defined_types` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `schema_id` bigint unsigned NOT NULL,
  `name` varchar(64) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL,
  `data_type` enum('MYSQL_BUILTIN_TYPE_DECIMAL','MYSQL_BUILTIN_TYPE_TINY','MYSQL_BUILTIN_TYPE_SHORT','MYSQL_BUILTIN_TYPE_LONG','MYSQL_BUILTIN_TYPE_FLOAT','MYSQL_BUILTIN_TYPE_DOUBLE','MYSQL_BUILTIN_TYPE_TIMESTAMP','MYSQL_BUILTIN_TYPE_LONGLONG','MYSQL_BUILTIN_TYPE_INT24','MYSQL_BUILTIN_TYPE_DATE','MYSQL_BUILTIN_TYPE_TIME','MYSQL_BUILTIN_TYPE_DATETIME','MYSQL_BUILTIN_TYPE_YEAR','MYSQL_BUILTIN_TYPE_NEWDATE','MYSQL_BUILTIN_TYPE_VARCHAR','MYSQL_BUILTIN_TYPE_BIT','MYSQL_BUILTIN_TYPE_TIMESTAMP2','MYSQL_BUILTIN_TYPE_DATETIME2','MYSQL_BUILTIN_TYPE_TIME2','MYSQL_BUILTIN_TYPE_NEWDECIMAL','MYSQL_BUILTIN_TYPE_TINY_BLOB','MYSQL_BUILTIN_TYPE_MEDIUM_BLOB','MYSQL_BUILTIN_TYPE_LONG_BLOB','MYSQL_BUILTIN_TYPE_BLOB','MYSQL_BUILTIN_TYPE_VAR_STRING','MYSQL_BUILTIN_TYPE_STRING') COLLATE utf8mb3_bin NOT NULL,
  `type_category` enum('DISTINCT','STRUCTURED') COLLATE utf8mb3_bin NOT NULL,
  `is_instantiable` tinyint(1) DEFAULT NULL,
  `is_final` tinyint(1) DEFAULT NULL,
  `ordering_form` enum('NO_ORDER','EQUAL_ONLY','ORDER_FULL') COLLATE utf8mb3_bin NOT NULL,
  `ordering_category` enum('NO_CATEGORY','RELATIVE','MAP','STATE') COLLATE utf8mb3_bin NOT NULL,
  `ordering_method_id` bigint unsigned DEFAULT NULL,
  `is_unsigned` tinyint(1) DEFAULT NULL,
  `char_max_length` int unsigned DEFAULT NULL,
  `char_octet_length` int unsigned DEFAULT NULL,
  `numeric_precision` int unsigned DEFAULT NULL,
  `numeric_scale` int unsigned DEFAULT NULL,
  `datetime_precision` int unsigned DEFAULT NULL,
  `collation_id` bigint unsigned DEFAULT NULL,
  `data_type_utf8` mediumtext COLLATE utf8mb3_bin NOT NULL,
  `is_explicit_collation` tinyint(1) DEFAULT NULL,
  `last_altered` timestamp NOT NULL,
  `created` timestamp NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `schema_id` (`schema_id`,`name`),
  KEY `collation_id` (`collation_id`),
  CONSTRAINT `user_defined_types_ibfk_1` FOREIGN KEY (`schema_id`) REFERENCES `schemata` (`id`),
  CONSTRAINT `user_defined_types_ibfk_2` FOREIGN KEY (`collation_id`) REFERENCES `collations` (`id`)
) /*!50100 TABLESPACE `mysql` */ ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_bin STATS_PERSISTENT=0 ROW_FORMAT=DYNAMIC
SHOW CREATE TABLE mysql.method_specifications;
Table	Create Table
method_specifications	CREATE TABLE `method_specifications` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `type_id` bigint unsigned NOT NULL,
  `name` varchar(64) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL,
  `specific_name` varchar(64) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL,
  `is_static` tinyint(1) DEFAULT NULL,
  `is_overriding` tinyint(1) DEFAULT NULL,
  `is_constructor` tinyint(1) DEFAULT NULL,
  `data_type` enum('MYSQL_TYPE_DECIMAL','MYSQL_TYPE_TINY','MYSQL_TYPE_SHORT','MYSQL_TYPE_LONG','MYSQL_TYPE_FLOAT','MYSQL_TYPE_DOUBLE','MYSQL_TYPE_TIMESTAMP','MYSQL_TYPE_LONGLONG','MYSQL_TYPE_INT24','MYSQL_TYPE_DATE','MYSQL_TYPE_TIME','MYSQL_TYPE_DATETIME','MYSQL_TYPE_YEAR','MYSQL_TYPE_NEWDATE','MYSQL_TYPE_VARCHAR','MYSQL_TYPE_BIT','MYSQL_TYPE_TIMESTAMP2','MYSQL_TYPE_DATETIME2','MYSQL_TYPE_TIME2','MYSQL_TYPE_NEWDECIMAL','MYSQL_TYPE_ENUM','MYSQL_TYPE_SET','MYSQL_TYPE_TINY_BLOB','MYSQL_TYPE_MEDIUM_BLOB','MYSQL_TYPE_LONG_BLOB','MYSQL_TYPE_BLOB','MYSQL_TYPE_VAR_STRING','MYSQL_TYPE_GEOMETRY','MYSQL_TYPE_JSON','MYSQL_TYPE_VECTOR') COLLATE utf8mb3_bin NOT NULL,
  `is_unsigned` tinyint(1) DEFAULT NULL,
  `char_max_length` int unsigned DEFAULT NULL,
  `char_octet_length` int unsigned DEFAULT NULL,
  `numeric_precision` int unsigned DEFAULT NULL,
  `numeric_scale` int unsigned DEFAULT NULL,
  `datetime_precision` int unsigned DEFAULT NULL,
  `collation_id` bigint unsigned DEFAULT NULL,
  `is_explicit_collation` tinyint(1) DEFAULT NULL,
  `return_type_id` bigint unsigned DEFAULT NULL,
  `data_type_utf8` mediumtext COLLATE utf8mb3_bin NOT NULL,
  `is_deterministic` tinyint(1) DEFAULT NULL,
  `sql_data_access` enum('NO_SQL','CONTAINS_SQL','READS_SQL','MODIFIES_SQL') COLLATE utf8mb3_bin NOT NULL,
  `is_null_call` tinyint(1) DEFAULT NULL,
  `created` timestamp NOT NULL,
  `last_altered` timestamp NOT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `type_id` (`type_id`,`name`),
  CONSTRAINT `method_specifications_ibfk_1` FOREIGN KEY (`type_id`) REFERENCES `user_defined_types` (`id`)
) /*!50100 TABLESPACE `mysql` */ ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_bin STATS_PERSISTENT=0 ROW_FORMAT=DYNAMIC
SHOW CREATE TABLE mysql.method_specification_parameters;
