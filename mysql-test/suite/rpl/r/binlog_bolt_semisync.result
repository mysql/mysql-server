[connection master]
# A promoted transaction is acknowledged at the AFTER_SYNC wait point.
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
COMMIT;
include/assert.inc [rpl_semi_sync_source_yes_tx should be 1 + 1]
include/assert.inc [rpl_semi_sync_source_no_tx should be 0 + 0]
include/assert.inc [The AFTER_SYNC transaction took the BOLT commit path.]
include/assert.inc [The AFTER_SYNC promotion opens a new active binary log.]
include/rpl/sync_to_replica.inc
[connection slave]
include/assert.inc [The replica applies every row of the AFTER_SYNC promotion.]
include/assert.inc [The replica receives the full AFTER_SYNC payload.]
