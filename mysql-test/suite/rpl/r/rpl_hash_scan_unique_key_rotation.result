include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
#
# 1. Original case: nullable UK, key rotation by c1=c1+100
[connection master]
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT DEFAULT NULL, UNIQUE KEY c1 (c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,NULL),(1,1),(2,NULL),(2,2);
INSERT INTO t1 VALUES (1,NULL),(2,NULL);
UPDATE t1 SET c1=c1+100;
INSERT INTO t1 VALUES (1,NULL),(1,1),(2,NULL),(2,2);
INSERT INTO t1 VALUES (1,NULL),(2,NULL);
UPDATE t1 SET c1=c1+100;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 2. Shift with ORDER BY DESC (event order differs from clustered order)
[connection master]
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, UNIQUE KEY uk(c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1),(2,1),(3,1);
UPDATE t1 SET c1=c1+1 ORDER BY c1 DESC;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 3. Nullable UK plus a secondary key whose order differs from row order
[connection master]
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, c3 INT,
UNIQUE KEY uk(c1,c2), KEY k(c3)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (101,1,9),(1,1,0);
UPDATE t1 SET c1=c1+100;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 4. Duplicated NULL key values interleaved with a rotated row
[connection master]
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, id INT, UNIQUE KEY uk(c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,NULL,1),(1,5,2),(1,NULL,3);
UPDATE t1 SET c2 = CASE id WHEN 1 THEN 7 WHEN 2 THEN 8 WHEN 3 THEN 5 END;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 5. Functional UK only, no other index => TABLE_SCAN
[connection master]
CREATE TABLE t1 (a INT, b INT, UNIQUE INDEX fi ((a+b))) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1),(0,1);
UPDATE t1 SET a=a+1;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 6. FULL images with an unchanged ordinary unique key keep HASH_SCAN
[connection master]
SET @old_binlog_row_image=@@session.binlog_row_image;
SET SESSION binlog_row_image = 'FULL';
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, payload INT,
UNIQUE KEY uk(c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,NULL,10),(1,1,20),(2,NULL,30);
UPDATE t1 SET payload=payload+1;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 7. MINIMAL images with an unchanged ordinary unique key keep HASH_SCAN
SET SESSION binlog_row_image = 'MINIMAL';
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, payload INT,
UNIQUE KEY uk(c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,NULL,10),(1,1,20),(2,NULL,30);
UPDATE t1 SET payload=payload+1;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 8. FULL images with unchanged generated-key inputs keep HASH_SCAN
SET SESSION binlog_row_image = 'FULL';
CREATE TABLE t1 (a INT, b INT, payload INT,
UNIQUE INDEX fi ((a+b))) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1,10),(0,1,20);
UPDATE t1 SET payload=payload+1;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
UPDATE t1 SET a=a+1;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
SET SESSION binlog_row_image = @old_binlog_row_image;
#
# 9. Unchanged paths: DELETE and tables without unique keys keep HASH_SCAN
[connection master]
CREATE TABLE t1 (c1 INT NOT NULL, c2 INT NULL, UNIQUE KEY uk(c1,c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,NULL),(1,1),(2,NULL);
DELETE FROM t1;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
[connection master]
CREATE TABLE t1 (c1 INT, c2 INT, KEY k(c1)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1),(2,2),(3,3);
UPDATE t1 SET c1=c1+1;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 10. A table with a PRIMARY KEY keeps INDEX_SCAN
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, c2 INT, payload INT,
UNIQUE KEY uk(c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1,0),(2,2,0),(3,3,0);
UPDATE t1 SET payload=payload+1;
include/rpl/sync_to_replica.inc
UPDATE t1 SET c2=c2+1 ORDER BY c2 DESC;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 11.1 BLOB key part: compared by value
[connection master]
CREATE TABLE t1 (b TEXT, c2 INT NULL, payload INT,
UNIQUE KEY uk(b(10), c2)) ENGINE=InnoDB;
INSERT INTO t1 VALUES ('a',1,0),('b',1,0),('c',1,0);
UPDATE t1 SET payload=payload+1;
include/rpl/sync_to_replica.inc
UPDATE t1 SET b=CASE b WHEN 'a' THEN 'b' WHEN 'b' THEN 'c' WHEN 'c' THEN 'd' END
ORDER BY b DESC;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 11.2 JSON column feeding a generated unique key: compared by value
[connection master]
CREATE TABLE t1 (j JSON, g INT AS (CAST(j->>'$.k' AS SIGNED)) VIRTUAL,
payload INT, UNIQUE KEY uk(g)) ENGINE=InnoDB;
INSERT INTO t1(j, payload) VALUES ('{"k":1}',0),('{"k":2}',0),('{"k":3}',0);
UPDATE t1 SET payload=payload+1;
include/rpl/sync_to_replica.inc
UPDATE t1 SET j=JSON_OBJECT('k', g+1) ORDER BY g DESC;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
#
# 12. PARTIAL_JSON updates that rotate a unique key
[connection master]
SET @old_binlog_row_value_options= @@session.binlog_row_value_options;
SET SESSION binlog_row_value_options= 'PARTIAL_JSON';
Warnings:
Warning	3647	When binlog_row_image=FULL, the option binlog_row_value_options=PARTIAL_JSON will be used only for the after-image. Full values will be written in the before-image, so the saving in disk space due to binlog_row_value_options is limited to less than 50%.
CREATE TABLE t1 (a INT, b JSON, UNIQUE KEY uk(a)) ENGINE=InnoDB;
INSERT INTO t1 VALUES
(1,'{"x":1,"long":"a long string to make a partial update worthwhile"}'),
(2,'{"x":1,"long":"a long string to make a partial update worthwhile"}'),
(3,'{"x":1,"long":"a long string to make a partial update worthwhile"}');
UPDATE t1 SET a=a+1, b=JSON_SET(b,'$.x',2) ORDER BY a DESC;
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
DROP TABLE t1;
SET SESSION binlog_row_value_options= @old_binlog_row_value_options;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
