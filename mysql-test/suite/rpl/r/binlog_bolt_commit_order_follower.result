[connection master]
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY) ENGINE=InnoDB;
include/rpl/sync_to_replica.inc
[connection slave]
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
CREATE TABLE t_local (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
# A small local transaction leads a flush group and pauses before the fetch.
SET DEBUG_SYNC = 'bgc_after_enrolling_for_flush_stage SIGNAL small_enrolled WAIT_FOR small_go';
INSERT INTO t_local VALUES (1, 'small');
[connection slave]
SET DEBUG_SYNC = 'now WAIT_FOR small_enrolled';
# A local large transaction waits as the next flush leader.
BEGIN;
SET SESSION DEBUG = '+d,bolt_pause_assigned_flush_leader';
SET DEBUG_SYNC = 'bgc_flush_leader_candidate_waiting SIGNAL big_waiting';
SET DEBUG_SYNC = 'bgc_assigned_flush_leader_woken SIGNAL big_assigned WAIT_FOR big_go';
COMMIT;
[connection slave]
SET DEBUG_SYNC = 'now WAIT_FOR big_waiting';
# The small group is fetched, and the large transaction is assigned as the next leader.
SET DEBUG_SYNC = 'now SIGNAL small_go';
SET DEBUG_SYNC = 'now WAIT_FOR big_assigned';
# A worker reaches the commit order flush stage and becomes a follower.
# Adding debug point 'syncpoint_before_follower_wait_100' to @@GLOBAL.debug
[connection master]
SET TIMESTAMP = 100;
INSERT INTO t1 VALUES (1);
SET TIMESTAMP = DEFAULT;
[connection slave]
SET DEBUG_SYNC = 'now WAIT_FOR reached_before_follower_wait_100';
# Removing debug point 'syncpoint_before_follower_wait_100' from @@GLOBAL.debug
SET DEBUG_SYNC = 'now SIGNAL continue_before_follower_wait_100';
# R1: the large transaction leads its group without a commit order leader.
SET DEBUG_SYNC = 'now SIGNAL big_go';
SET SESSION DEBUG = '-d,bolt_pause_assigned_flush_leader';
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'RESET';
[connection master]
include/rpl/sync_to_replica.inc
SET DEBUG_SYNC = 'RESET';
include/assert.inc [R1: the worker's transaction is committed.]
include/assert.inc [R2: the spilled file is promoted.]
include/assert.inc [R2: every local row is committed.]
DROP TABLE t_local;
[connection master]
DROP TABLE t1;
include/rpl/deinit.inc
