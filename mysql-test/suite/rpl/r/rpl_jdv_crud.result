# 2.3: ALTER removing explicit annotations replicates default inheritance.
ALTER JSON DUALITY VIEW gct_rpl_view AS
SELECT JSON_DUALITY_OBJECT(
"_id" : p.id,
"root_value" : p.inherited_value,
"root_check_value" : p.check_value,
"root_update_value" : p.update_value,
"singleton" : (
SELECT JSON_DUALITY_OBJECT(
"id" : s.id,
"singleton_value" : s.inherited_value,
"singleton_check_value" : s.check_value,
"singleton_update_value" : s.update_value
)
FROM gct_rpl_singleton AS s
WHERE s.id = p.singleton_id
)
)
FROM gct_rpl_parent AS p;
# Record the defaulted definition and effective annotations on the source.
SHOW CREATE VIEW gct_rpl_view;
