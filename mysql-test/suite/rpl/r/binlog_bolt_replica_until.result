include/rpl/start_receiver.inc
[connection master]
# Commit the BOLT transaction, record its end position, then add a marker.
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
COMMIT;
INSERT INTO t2 VALUES (1);
include/rpl/sync_to_replica_received.inc
[connection slave]
START REPLICA SQL_THREAD UNTIL SOURCE_LOG_FILE='SOURCE_LOG_FILE', SOURCE_LOG_POS=SOURCE_LOG_POS;;
