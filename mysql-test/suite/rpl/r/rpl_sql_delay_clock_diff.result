include/rpl/sync_to_replica.inc
#
# Test case 2: Source clock is 10 seconds ahead of the replica.
#   clock_diff_with_master = -10.
#   With the fix: sql_delay_end = ict(+10) + (-10) + 5 = now + 5,
#     replica waits ~5s, ICT diff = 5 - 10 = -5.
#   Without the fix: sql_delay_end = ict(+10) + 5 = now + 15,
#     replica waits ~15s, ICT diff = 15 - 10 = 5.
#
[connection master]
# Adding debug point 'sql_delay_inc_master_clock_10s' to @@GLOBAL.debug
[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO SOURCE_DELAY= 5;
include/rpl/start_replica.inc
STOP REPLICA IO_THREAD;
START REPLICA IO_THREAD;
include/rpl/wait_for_replica_status.inc [Replica_IO_Running]
include/assert.inc [Assert that SQL_Delay matches the configured delay for case 2]
[connection master]
CREATE TABLE t2 (a INT);
[connection slave]
[connection master]
include/rpl/sync_to_replica.inc
[connection slave]
include/assert.inc [The replica must apply clock_diff_with_master when source clock is ahead (wait ~5s, not ~15s)]
include/assert.inc [The replica must wait at least SOURCE_DELAY seconds]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO SOURCE_DELAY= 0;
include/rpl/start_replica.inc
[connection master]
# Removing debug point 'sql_delay_inc_master_clock_10s' from @@GLOBAL.debug
DROP TABLE t2;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
