include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
include/rpl/sync_to_replica.inc
include/assert.inc [The replica uses SOURCE_AUTO_POSITION=1.]
include/rpl/stop_replica.inc
[connection master]
# Commit a qualifying transaction while the replica is stopped.
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
COMMIT;
include/assert.inc [The transaction's spilled file is promoted into a new binlog file.]
INSERT INTO t1 VALUES (4, 'd');
FLUSH BINARY LOGS;
INSERT INTO t1 VALUES (5, 'e');
# R1: the replica connects with auto-positioning and receives everything.
[connection slave]
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc
include/assert.inc [R1: the replica has every row.]
include/assert.inc [R1: the replica has the full payload of the large transaction.]
[connection master]
include/assert.inc [R2: the replica's gtid_executed matches the source's.]
DROP TABLE t1;
include/rpl/deinit.inc
