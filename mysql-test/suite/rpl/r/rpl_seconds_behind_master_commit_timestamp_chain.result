[connection server_1]
CREATE TABLE t (a INT PRIMARY KEY, b INT);
include/rpl/sync.inc
#
# Test case 3: Chain topology A -> B -> C.
#   A long transaction (SLEEP(10)) commits on A, then is blocked
#   on B for 20 seconds, and finally blocked on C.
#     - B's SBM reflects the real waiting time and grows as the
#       transaction stays blocked.
#     - C's SBM does not include the 20 seconds the transaction
#       spent blocked on B, because B regenerates
#       immediate_commit_timestamp using B's local clock.
#
[connection server_2]
LOCK TABLE t WRITE;
[connection server_3]
LOCK TABLE t WRITE;
[connection server_1]
INSERT INTO t(a, b) SELECT 1, SLEEP(10);
[connection server_2]
include/assert.inc [SBM on B must be small right after transaction arrives]
include/assert.inc [SBM on B must be >= 20 (real waiting time, not reduced by source execution time)]
[connection server_3]
include/assert.inc [SBM on C must be 0 while transaction is blocked on B]
[connection server_2]
UNLOCK TABLES;
[connection server_3]
include/assert.inc [SBM on C must not include the time spent blocked on B]
UNLOCK TABLES;
include/rpl/sync.inc
#
# Cleanup
#
[connection server_1]
DROP TABLE t;
include/rpl/sync.inc
[connection server_2]
include/rpl/stop_replica.inc
SET GLOBAL replica_parallel_workers = @save_replica_parallel_workers;
include/rpl/start_replica.inc
[connection server_3]
include/rpl/stop_replica.inc
