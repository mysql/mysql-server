# ==== Purpose ====
# The same as the sourced rpl_half_atomic_ddl:
# prove successful slave service recovery after a simulated failure
# at handling recoverable DDL queries.
# This time the slave turns binlog off so its post-crash recovery...
#
# Find more comments in the sourced file.

# In MTA, atomic DDLs are executed by coordinator and complicated
# sequence of execution paths lead to expected debug point reached.
# Same debug point is not reached in CSA in expected time.
--source include/have_mta.inc

# Transaction compression wraps row events in a payload event, which can break
# this test's assumption that exactly one GTID is committed after each crash.
--source include/not_binlog_transaction_compression_on.inc

--let $commit_message=Crash right before the query gets committed
--let $crash_commit="+d,replica_crash_after_commit"

# There can't be rollback recovery, therefore it's not tested
#--let $crash_rollback="+d,no_binlog_replica_crash_before_commit"

--source rpl_half_atomic_ddl.test
