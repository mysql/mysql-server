--source include/have_binlog_format_row.inc
--source include/rpl/init_source_replica.inc

--echo # DELETE CASCADE, same child targeted by cascade and explicit delete
CREATE TABLE p (id INT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE c (
  id INT PRIMARY KEY, p_id INT,
  FOREIGN KEY (p_id) REFERENCES p(id) ON DELETE CASCADE
) ENGINE=InnoDB;
INSERT INTO p VALUES (1), (2);
INSERT INTO c VALUES (1, 1), (2, 1), (3, NULL);

DELETE p, c FROM p, c WHERE p.id = 1 AND c.id = 1;
--source include/rpl/sync_to_replica.inc
--let $diff_tables= master:p, slave:p
--source include/diff_tables.inc
--let $diff_tables= master:c, slave:c
--source include/diff_tables.inc
--source include/rpl/connection_source.inc
SELECT * FROM p ORDER BY id;
SELECT * FROM c ORDER BY id;
DROP TABLE c, p;

--echo # DELETE CASCADE, parent target only
CREATE TABLE p (id INT PRIMARY KEY, i INT) ENGINE=InnoDB;
CREATE TABLE c (
  id INT PRIMARY KEY, p_id INT,
  FOREIGN KEY (p_id) REFERENCES p(id) ON DELETE CASCADE
) ENGINE=InnoDB;
INSERT INTO p VALUES (1, 2), (2, 1);
INSERT INTO c VALUES (1, 1), (2, 2), (3, NULL);

DELETE p FROM p STRAIGHT_JOIN c ON p.i = c.id;
SELECT * FROM p ORDER BY id;
SELECT * FROM c ORDER BY id;
--source include/rpl/sync_to_replica.inc
--let $diff_tables= master:p, slave:p
--source include/diff_tables.inc
--let $diff_tables= master:c, slave:c
--source include/diff_tables.inc

--source include/rpl/connection_source.inc
DROP TABLE c, p;

--echo # DELETE CASCADE, overlapping parent and child targets
CREATE TABLE p (id INT PRIMARY KEY, i INT) ENGINE=InnoDB;
CREATE TABLE c (
  id INT PRIMARY KEY, p_id INT,
  FOREIGN KEY (p_id) REFERENCES p(id) ON DELETE CASCADE
) ENGINE=InnoDB;
INSERT INTO p VALUES (1, 2), (2, 1);
INSERT INTO c VALUES (1, 1), (2, 2), (3, NULL);

DELETE p, c FROM p STRAIGHT_JOIN c ON p.i = c.id;
SELECT * FROM p ORDER BY id;
SELECT * FROM c ORDER BY id;
--source include/rpl/sync_to_replica.inc
--let $diff_tables= master:p, slave:p
--source include/diff_tables.inc
--let $diff_tables= master:c, slave:c
--source include/diff_tables.inc

--source include/rpl/connection_source.inc
DROP TABLE c, p;

--echo # DELETE SET NULL
CREATE TABLE p (id INT PRIMARY KEY, i INT) ENGINE=InnoDB;
CREATE TABLE c (
  id INT PRIMARY KEY, p_id INT,
  FOREIGN KEY (p_id) REFERENCES p(id) ON DELETE SET NULL
) ENGINE=InnoDB;
INSERT INTO p VALUES (1, 2), (2, 1);
INSERT INTO c VALUES (1, 1), (2, 2), (3, NULL);

DELETE p FROM p STRAIGHT_JOIN c ON p.i = c.id
  WHERE c.p_id IS NOT NULL;
SELECT * FROM p ORDER BY id;
SELECT * FROM c ORDER BY id;
--source include/rpl/sync_to_replica.inc
--let $diff_tables= master:p, slave:p
--source include/diff_tables.inc
--let $diff_tables= master:c, slave:c
--source include/diff_tables.inc

--source include/rpl/connection_source.inc
DROP TABLE c, p;

--echo # UPDATE CASCADE
CREATE TABLE p (id INT PRIMARY KEY, u INT UNIQUE, i INT) ENGINE=InnoDB;
CREATE TABLE c (
  id INT PRIMARY KEY, p_u INT,
  FOREIGN KEY (p_u) REFERENCES p(u) ON UPDATE CASCADE
) ENGINE=InnoDB;
INSERT INTO p VALUES (1, 1, 2), (2, 2, 1);
INSERT INTO c VALUES (1, 1), (2, 2), (3, NULL);

UPDATE p STRAIGHT_JOIN c ON p.i = c.p_u SET p.u = p.u + 10;
SELECT * FROM p ORDER BY id;
SELECT * FROM c ORDER BY id;
--source include/rpl/sync_to_replica.inc
--let $diff_tables= master:p, slave:p
--source include/diff_tables.inc
--let $diff_tables= master:c, slave:c
--source include/diff_tables.inc

--source include/rpl/connection_source.inc
DROP TABLE c, p;

--echo # UPDATE SET NULL
CREATE TABLE p (id INT PRIMARY KEY, u INT UNIQUE, i INT) ENGINE=InnoDB;
CREATE TABLE c (
  id INT PRIMARY KEY, p_u INT,
  FOREIGN KEY (p_u) REFERENCES p(u) ON UPDATE SET NULL
) ENGINE=InnoDB;
INSERT INTO p VALUES (1, 1, 2), (2, 2, 1);
INSERT INTO c VALUES (1, 1), (2, 2), (3, NULL);

UPDATE p STRAIGHT_JOIN c ON p.i = c.p_u SET p.u = p.u + 10;
SELECT * FROM p ORDER BY id;
SELECT * FROM c ORDER BY id;
--source include/rpl/sync_to_replica.inc
--let $diff_tables= master:p, slave:p
--source include/diff_tables.inc
--let $diff_tables= master:c, slave:c
--source include/diff_tables.inc

--source include/rpl/connection_source.inc
DROP TABLE c, p;
--source include/rpl/deinit.inc
