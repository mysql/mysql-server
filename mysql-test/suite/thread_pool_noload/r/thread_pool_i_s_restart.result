# Case 1:
# Check TP_THREAD_STATE is visible, which is added by .opt.
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME LIKE 'TP_%';
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY
TP_THREAD_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_NAME LIKE 'TP_%';
TABLE_NAME
TP_THREAD_STATE
# Case 2:
# Restart server with TP_THREAD_GROUP_STATE plugin.
# Check TP_THREAD_GROUP_STATE is visible and not TP_THREAD_STATE
# restart:TP_THREAD_STATE_PLUGIN_OPT --plugin_load=TP_THREAD_GROUP_STATE=thread_pool.<extension>
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME LIKE 'TP_%';
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY
TP_THREAD_GROUP_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_NAME LIKE 'TP_%';
TABLE_NAME
TP_THREAD_GROUP_STATE
# Case 3:
# Restart server with TP_THREAD_STATE and TP_THREAD_GROUP_STATS
# Check that TP_THREAD_STATE and TP_THREAD_GROUP_STATS are visible.
# restart:TP_THREAD_STATE_PLUGIN_OPT --plugin_load=TP_THREAD_GROUP_STATS=thread_pool.<extension>;TP_THREAD_STATE=thread_pool.<extension>
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME LIKE 'TP_%';
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY
TP_THREAD_GROUP_STATS	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>
TP_THREAD_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_NAME LIKE 'TP_%';
TABLE_NAME
TP_THREAD_GROUP_STATS
TP_THREAD_STATE
# Case 4:
# Restart server should fail if I_S version is changed
# and --innodb-read-only mode is ON.
Pattern "\[ERROR\] \[[^]]*\] \[[^]]*\] Failed to update plugin metadata in dictionary tables" found
# Case 5:
# Restart server with TP_THREAD_STATE and TP_THREAD_GROUP_STATS with
# status OFF.
# Check TP_THREAD_STATE is present and TP_THREAD_GROUP_STATS is disabled.
# restart:TP_THREAD_STATE_PLUGIN_OPT --plugin_load=TP_THREAD_GROUP_STATS=thread_pool.<extension>;TP_THREAD_STATE=thread_pool.<extension> --tp_thread_group_stats=off
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME LIKE 'TP_%';
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY
TP_THREAD_GROUP_STATS	DISABLED	INFORMATION SCHEMA	thread_pool.<extension>
TP_THREAD_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_NAME LIKE 'TP_%';
TABLE_NAME
TP_THREAD_STATE
# Case 6:
# UNINSTALL TP_THREAD_STATE and make sure it is not
# present in INFORMATION_SCHEMA.TABLES.
UNINSTALL PLUGIN TP_THREAD_STATE;
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME LIKE 'TP_%';
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY
TP_THREAD_GROUP_STATS	DISABLED	INFORMATION SCHEMA	thread_pool.<extension>
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_NAME LIKE 'TP_%';
TABLE_NAME
INSTALL PLUGIN tp_thread_state SONAME 'thread_pool.so';
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME LIKE 'TP_%';
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY
TP_THREAD_GROUP_STATS	DISABLED	INFORMATION SCHEMA	thread_pool.<extension>
TP_THREAD_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_NAME LIKE 'TP_%';
TABLE_NAME
TP_THREAD_STATE
UNINSTALL PLUGIN TP_THREAD_STATE;
# Case 6.1:
# Bug#25750159 - Attempt to uninstall a plugin which is
# stated with PLUGIN_OFF load_option causes a crash.
# Following statement causes crash without fix.
UNINSTALL PLUGIN tp_thread_group_stats;
# Case 7:
# Restart server with changing the I_S version number.
# - Using a debug flag for testing.
# - Check that TP_THREAD_STATE and TP_THREAD_GROUP_STATS are visible
#   in INFORMATION_SCHEMA.PLUGINS/TABLES
# - Check if abandoned I_S views are removed, if server version is
#   changed. The test case expects I_S.EVENTS to be abandoned.
# restart:TP_THREAD_STATE_PLUGIN_OPT --plugin_load=TP_THREAD_GROUP_STATS=thread_pool.<extension>;TP_THREAD_STATE=thread_pool.<extension> --debug=+d,test_i_s_metadata_version
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME LIKE 'TP_%';
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY
TP_THREAD_GROUP_STATS	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>
TP_THREAD_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>
SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_NAME LIKE 'TP_%';
TABLE_NAME
TP_THREAD_GROUP_STATS
TP_THREAD_STATE
SELECT * FROM INFORMATION_SCHEMA.EVENTS;
ERROR 42S02: Unknown table 'EVENTS' in information_schema
#
# Bug#25761992 - VIEW VALIDATION WHEN PLUGINS ARE LOADED/UNLOADED.
#
# Create a view v1 referencing the INFORMATION_SCHEMA.TP_THREAD_STATE
# loaded from a INFORMATION_SCHEMA plugin.
CREATE VIEW v1 AS SELECT * FROM INFORMATION_SCHEMA.TP_THREAD_STATE;
SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_COMMENT FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='v1';
TABLE_SCHEMA	TABLE_NAME	TABLE_COMMENT
test	v1	VIEW
# Uninstall plugin and check status of a views referencing the
# INFORMATION_SCHEMA.TP_THREAD_STATE.
# UNINSTALL PLUGIN set state of views referencing a plugin as
# "Invalid".
UNINSTALL PLUGIN TP_THREAD_STATE;
SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_COMMENT FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='v1';
TABLE_SCHEMA	TABLE_NAME	TABLE_COMMENT
test	v1	View 'test.v1' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
Warnings:
Warning	1356	View 'test.v1' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
# Re-install plugin and check status of a views referencing the
# INFORMATION_SCHEMA.TP_THREAD_STATE.
# INSTALL PLUGIN resets state of a views referencing the plugin as
# "Valid".
INSTALL PLUGIN tp_thread_state SONAME 'thread_pool.so';
SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_COMMENT FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='v1';
TABLE_SCHEMA	TABLE_NAME	TABLE_COMMENT
test	v1	VIEW
# Uninstall TP_THREAD_STATE plugin.
UNINSTALL PLUGIN TP_THREAD_STATE;
# Restart server without TP_THREAD_STATE and check status of a views referencing the
# INFORMATION_SCHEMA.TP_THREAD_STATE.
# Since TP_THREAD_STATE plugin is not loaded on server restart, status of the view
# remains as "Invalid".
# restart:TP_THREAD_STATE_PLUGIN_OPT --plugin_load=TP_THREAD_GROUP_STATE=thread_pool.<extension>
SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_COMMENT FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='v1';
TABLE_SCHEMA	TABLE_NAME	TABLE_COMMENT
test	v1	View 'test.v1' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
Warnings:
Warning	1356	View 'test.v1' references invalid table(s) or column(s) or function(s) or definer/invoker of view lack rights to use them
# Restart server *with* TP_THREAD_STATE and check status of a view referencing the
# INFORMATION_SCHEMA.TP_THREAD_STATE.
# Since TP_THREAD_STATE plugin is loaded on server restart, status of the view
# is changed to "Valid".
# restart:TP_THREAD_STATE_PLUGIN_OPT --plugin_load=TP_THREAD_GROUP_STATS=thread_pool.<extension>;TP_THREAD_STATE=thread_pool.<extension>
SELECT TABLE_SCHEMA, TABLE_NAME, TABLE_COMMENT FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME='v1';
TABLE_SCHEMA	TABLE_NAME	TABLE_COMMENT
test	v1	VIEW
DROP VIEW v1;
