# The .opt file uses the --debug option.
--source include/have_debug.inc

--let err_msg_detect=Detected wrong page_id:
--eval CALL mtr.add_suppression("$err_msg_detect")
--let err_msg_fix=Fixed wrong page_id with sync read:
--eval CALL mtr.add_suppression("$err_msg_fix")

# This creates and reads a big table, causing the above errors to be generated.
# If this include changes and the test starts to fail, the original include
# file could be inlined here.
--source suite/innodb/include/evict_everything_from_buffer_pool.inc

let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.1.err;

let SEARCH_PATTERN=$err_msg_detect;
--source include/search_pattern.inc

let SEARCH_PATTERN=$err_msg_fix;
--source include/search_pattern.inc
