# This test is meant to check for backward compatibility with old version of MySQL
# which generated Persistent Table Metadata redo log records.
# It uses two zipped snapshots of data directories, one good, and one bad, generated by
# MySQL 9.7 from the earlier version of this test which created the desired state on the
# fly, by adding:
# --exec cd $MYSQLTEST_VARDIR && mkdir -p var/tmp && cp -a tmp/log_corruption_1 \
#   var/tmp/log_corruption_1 && zip -qr $tmp_dir/log_corruption_1.good.zip \
#   var/tmp/log_corruption_1 && rm -rf var
# and the same command for $tmp_dir/log_corruption_1.bad.zip after the two CHECK TABLE t
# which appeared in it.
#
# This test will not be needed once we drop backward compatibility support for old PTM redo logs.


--source include/have_innodb_16k.inc
--source ../include/redo_log_error_patterns.inc
--source include/stop_mysqld.inc

# Because of the very simple way the zip files were generated, they contain an overcomplicated
# directory structure with superflous ./var/tmp/ on top of the intended ./log_corruption_1.
# This should not conflict with anything as $MYSQL_TMP_DIR never contains ./var/ subdirectory.

let MYSQLD_DATADIR=$MYSQL_TMP_DIR/var/tmp/log_corruption_1;
let MYSQLD_ERROR_LOG = $MYSQL_TMP_DIR/my_restart.err;
let SEARCH_FILE = $MYSQLD_ERROR_LOG;

--echo ############################################################################################
--echo # Case 1: Crash after redo logging information about corrupted clustered index.
--echo ############################################################################################

--exec unzip -qo $MYSQL_TEST_DIR/std_data/log_corruption_1.good.zip -d $MYSQL_TMP_DIR
let restart_parameters = restart: --datadir=$MYSQLD_DATADIR --log-error=$MYSQLD_ERROR_LOG --skip-log-bin --lower_case_table_names=1;

--echo # Verify that InnoDB can recover.
--replace_result $MYSQLD_ERROR_LOG my_restart.err $MYSQLD_DATADIR tmp/log_corruption_1
--source include/start_mysqld.inc

let SEARCH_PATTERN = $PATTERN_CORRUPT_LOG_RECORD;
# Expected: not found
--source include/search_pattern.inc

# This should report that the index is corrupted
CHECK TABLE t;
ALTER TABLE t DROP INDEX b_idx;

# This should report that everything is fine now
CHECK TABLE t;
# This should succeed, too.
ALTER TABLE t ADD INDEX b_idx (b);

--source include/stop_mysqld.inc
--remove_file $SEARCH_FILE
--force-rmdir $MYSQLD_DATADIR
--rmdir $MYSQL_TMP_DIR/var/tmp
# this indirectly checks earlier claim that ./var is not used by anything else
--rmdir $MYSQL_TMP_DIR/var

--echo ############################################################################################
--echo # Case 2: Crash after redo logging *corrupted* information about corrupted clustered index
--echo #         (logging number of indexes corrupted = 100 > MAX_INDEXES).
--echo ############################################################################################

--exec unzip -qo $MYSQL_TEST_DIR/std_data/log_corruption_1.bad.zip -d $MYSQL_TMP_DIR

--echo # Verify that InnoDB cannot recover, because it encounters the corrupted redo record.
--error 1,42
--exec $MYSQLD_CMD --datadir=$MYSQLD_DATADIR --log-error=$MYSQLD_ERROR_LOG --skip-log-bin --lower_case_table_names=1 --$UNKNOWN_PARAM

--echo # Matching the server logs for corrupted redo logs...
let SEARCH_PATTERN = $PATTERN_CORRUPT_LOG_RECORD;
# Expected: found
--source include/search_pattern.inc

let SEARCH_PATTERN = Hex dump starting .* bytes before and ending .* bytes after the corrupted record;
# Expected: found
--source include/search_pattern.inc

let SEARCH_PATTERN = $PATTERN_UNKNOWN_PARAM;
# Expected: not found
--source include/search_pattern.inc

--echo ############################################################################################

--echo # Cleanup...

--remove_file $SEARCH_FILE
--force-rmdir $MYSQLD_DATADIR
--rmdir $MYSQL_TMP_DIR/var/tmp
--rmdir $MYSQL_TMP_DIR/var

let MYSQLD_DATADIR=;
let MYSQLD_ERROR_LOG=;
let SEARCH_FILE=;
let SEARCH_PATTERN=;

let restart_parameters = restart:;

--source include/start_mysqld.inc
