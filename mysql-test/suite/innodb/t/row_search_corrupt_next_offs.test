--echo #
--echo # A scan must not abort on a REDUNDANT record whose next-record offset
--echo # is beyond the page. It must report corruption, or skip the rest of
--echo # the page when innodb_force_recovery is set.
--echo #

# Debug builds assert on this corruption by design.
--source include/have_nodebug.inc

let PAGE_SIZE=`SELECT @@innodb_page_size`;

CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(1000)) ROW_FORMAT=REDUNDANT
  ENGINE=InnoDB STATS_PERSISTENT=1 STATS_AUTO_RECALC=0;
# Several leaf pages, so the scan can continue past the damaged one.
INSERT INTO t1
  WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 300)
  SELECT n, REPEAT('x', 1000) FROM s;
--disable_result_log
ANALYZE TABLE t1;
--enable_result_log

let MYSQLD_DATADIR=`SELECT @@datadir`;

SET GLOBAL innodb_fast_shutdown = 0;
--source include/shutdown_mysqld.inc

perl;
my $page_size = $ENV{PAGE_SIZE};
my $file = "$ENV{MYSQLD_DATADIR}/test/t1.ibd";
open(FILE, "+<", $file) || die "Unable to open $file";
binmode FILE;

sub page_bytes {
  my ($page, $offs, $len) = @_;
  seek(FILE, $page * $page_size + $offs, 0) || die "Unable to seek $file";
  die "Unable to read $file" unless read(FILE, my $buf, $len) == $len;
  return $buf;
}

# Page 4 is the clustered index root; find its leftmost leaf page.
my $index_id = page_bytes(4, 38 + 28, 8);
my $n_pages = (-s $file) / $page_size;
my $leaf;
for my $page (4 .. $n_pages - 1) {
  next unless unpack("n", page_bytes($page, 24, 2)) == 17855;
  next unless page_bytes($page, 38 + 28, 8) eq $index_id;
  next unless unpack("n", page_bytes($page, 38 + 26, 2)) == 0;
  next unless unpack("N", page_bytes($page, 8, 4)) == 0xFFFFFFFF;
  $leaf = $page;
  last;
}
die "Leftmost leaf page not found" unless defined $leaf;
die "Leftmost leaf is the only leaf" if unpack("N", page_bytes($leaf, 12, 4)) == 0xFFFFFFFF;
die "Leaf page is not REDUNDANT" if unpack("n", page_bytes($leaf, 38 + 4, 2)) & 0x8000;

# The infimum is at offset 101; its next-record offset is 2 bytes before it.
my $rec = unpack("n", page_bytes($leaf, 101 - 2, 2));
die "Unexpected first record offset $rec" unless $rec > 101 && $rec < $page_size;

# Point the first user record's next-record offset past the page.
my $base = $leaf * $page_size;
seek(FILE, $base + $rec - 2, 0) || die "Unable to seek $file";
syswrite(FILE, "\xff\xff") || die "Unable to write";

# Mark the page as having no checksum.
seek(FILE, $base, 0) || die "Unable to seek $file";
syswrite(FILE, pack("H*", "deadbeef")) || die "Unable to write";
seek(FILE, $base + $page_size - 8, 0) || die "Unable to seek $file";
syswrite(FILE, pack("H*", "deadbeef")) || die "Unable to write";
close(FILE);
EOF

--source include/start_mysqld.inc

--disable_query_log
call mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* Rec address .*, buf block fix count");
call mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* Index corruption: rec offs \\d+ next offs 65535");
call mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* We detected index corruption in an InnoDB type table");
call mtr.add_suppression("\\[ERROR\\] .*MY-\\d+.* innodb_force_recovery is on. We do not allow database modifications");
call mtr.add_suppression("Failed to compress the gtid_executed table.");
--source include/add_mtr_suppression_for_innodb_readonly.inc
--enable_query_log

--echo # The scan reports corruption instead of aborting the server.
--error ER_NOT_KEYFILE
SELECT COUNT(a) FROM t1 WHERE b <> '';

--echo # With innodb_force_recovery the damaged page is skipped.
let $restart_parameters = restart: --innodb-force-recovery=1;
--source include/restart_mysqld.inc
SELECT COUNT(a) > 0 AS rows_after_page, COUNT(a) < 300 AS page_skipped,
  MIN(a) > 1 AS first_page_gone FROM t1 WHERE b <> '';

let $restart_parameters =;
--source include/restart_mysqld.inc
DROP TABLE t1;
