--source include/have_debug.inc
--source include/have_perl_64bit_int.inc
--source include/have_component_keyring_file.inc
--source suite/component_keyring_file/inc/setup_component.inc
--source ../include/truncate_redo_log_and_stop_truncating.inc

DO innodb_redo_log_consumer_register();
SELECT @@global.innodb_redo_log_encrypt;
CREATE TABLE t1 (a BIGINT PRIMARY KEY, b LONGBLOB) ENGINE=InnoDB;
INSERT INTO t1 (a, b) VALUES (1, REPEAT('a', 6*512*512));
SET GLOBAL innodb_redo_log_encrypt = 1;
SELECT @@global.innodb_redo_log_encrypt;
INSERT INTO t1 (a, b) VALUES (2, REPEAT('b', 6*512*512));
SET GLOBAL innodb_redo_log_encrypt = 0;
SELECT @@global.innodb_redo_log_encrypt;
INSERT INTO t1 (a, b) VALUES (3, REPEAT('c', 6*512*512));
SET GLOBAL innodb_redo_log_encrypt = 1;
SELECT @@global.innodb_redo_log_encrypt;
INSERT INTO t1 (a, b) VALUES (4, REPEAT('d', 6*512*512));
FLUSH LOGS;
CHECKSUM TABLE t1;
--source include/kill_mysqld.inc

--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR $PLUGIN_DIR_OPT --plugin-dir=PLUGIN_DIR
--source include/start_mysqld.inc

CHECKSUM TABLE t1;
SELECT a,LEFT(b,8) FROM t1;

DO innodb_redo_log_consumer_register();
INSERT INTO t1 (a, b) VALUES (5, REPEAT('e', 6*512*512));

let MYSQLD_DATADIR = `select @@datadir`;
--source include/kill_mysqld.inc

--let REDO_MARKERS_NOT_VISIBLE_IN_PLAINTEXT = b,d
--let REDO_MARKERS_VISIBLE_IN_PLAINTEXT = a,c,e
--source ../include/verify_redo_log_marker_encryption.inc

# Restart configured ON while the current partial block is plaintext. The
# existing block containing marker e must remain plaintext, while subsequent
# physical blocks use encryption.
--let $restart_parameters = restart: --innodb_redo_log_encrypt=ON $PLUGIN_DIR_OPT
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR $PLUGIN_DIR_OPT --plugin-dir=PLUGIN_DIR
--source include/start_mysqld.inc
SELECT @@global.innodb_redo_log_encrypt;
SELECT a,LEFT(b,8) FROM t1;

DO innodb_redo_log_consumer_register();
INSERT INTO t1 (a, b) VALUES (6, REPEAT('f', 6*512*512));

let MYSQLD_DATADIR = `select @@datadir`;
--source include/kill_mysqld.inc

--let REDO_MARKERS_NOT_VISIBLE_IN_PLAINTEXT = f
--let REDO_MARKERS_VISIBLE_IN_PLAINTEXT = e
--source ../include/verify_redo_log_marker_encryption.inc

--let $restart_parameters = restart: --innodb_redo_log_encrypt=ON $PLUGIN_DIR_OPT
--replace_result $MYSQL_TMP_DIR MYSQL_TMP_DIR $PLUGIN_DIR_OPT --plugin-dir=PLUGIN_DIR
--source include/start_mysqld.inc
SELECT a,LEFT(b,8) FROM t1;

SET GLOBAL innodb_redo_log_encrypt = 0;
DROP TABLE t1;
--source suite/component_keyring_file/inc/teardown_component.inc
