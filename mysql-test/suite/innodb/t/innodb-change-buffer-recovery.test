--echo #
--echo # Bug#69122 - INNODB DOESN'T REDO-LOG INSERT BUFFER MERGE
--echo #             OPERATION IF IT IS DONE IN-PLACE
--echo #

--source include/have_debug.inc

CREATE TABLE t1(
	a INT AUTO_INCREMENT PRIMARY KEY,
	b CHAR(16) CHARACTER SET latin1 COLLATE latin1_swedish_ci,
	c INT,
	INDEX(b))
ENGINE=InnoDB STATS_PERSISTENT=0;

# Save the tablespace ID for identifying redo belonging to t1.
--let $space_id = `SELECT SPACE FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME = 'test/t1'`

# Prevent background change-buffer merges while the buffered operations are
# prepared. The checkpoint is deliberately taken only immediately before the
# SELECT that applies them.
SET GLOBAL innodb_disable_background_merge = ON;

# Force change buffering whenever possible and populate multiple secondary
# index pages. Changes to the root page itself cannot be buffered.
SET GLOBAL innodb_change_buffering_debug = 1;
INSERT INTO t1 VALUES(0, REPEAT('X', 16), 1);
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;

# Keep an old read view open so purge cannot remove the delete-marked
# secondary-index record before the buffered INSERT is merged.
BEGIN;
SELECT b FROM t1 LIMIT 3;

connect (con1,localhost,root,,);
connection con1;
BEGIN;
DELETE FROM t1 WHERE a=1;
# The case-insensitive index treats X and x as equal, while their different
# physical bytes make the in-place redo generated during the ibuf merge
# detectable.
INSERT INTO t1 VALUES(1, REPEAT('x', 16), 1);
COMMIT;

# Buffered DELETE and INSERT have already committed. Background change-buffer
# merging remains disabled. The helper checkpoints the prepared state, then
# stops page cleaners and checkpointing so the page remains old on disk.
--source ../include/stop_dirty_page_flushing_and_redo_log_truncating.inc

# Disabling background merging also forces debug fetches to evict or flush
# pages. Re-enable it before reading the target page; page cleaning and
# checkpointing remain stopped by the helper above.
SET GLOBAL innodb_disable_background_merge = OFF;
SET GLOBAL innodb_change_buffering_debug = 0;

# Load the secondary-index page and apply its pending buffered changes. The
# subsequent INSERT is applied directly to this now-resident leaf.
SELECT a, HEX(b) AS b_hex FROM t1 FORCE INDEX(b)
WHERE b = REPEAT('x', 16) AND a = 1;

# Generate more redo for the same secondary-index leaf after the in-place
# update. If that update redo were missing, recovery would encounter this later
# change after a hole in the page history.
INSERT INTO t1 VALUES(-1, REPEAT('x', 16), 2);

# The secondary-index page is dirty in memory but has its pre-SELECT image on
# disk. A crash now requires recovery to apply the in-place update redo.
--source include/kill_mysqld.inc

--let $restart_parameters = restart: --debug=d,ib_log --innodb-disable-background-merge=ON
--source include/start_mysqld.inc

# Recovery must apply the in-place-update redo record generated by the
# change-buffer merge, not merely find it while scanning the redo log.
let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN = apply [0-9]+: MLOG_REC_UPDATE_IN_PLACE len [0-9]+ page $space_id:;
--replace_regex /page [0-9]+:/page SPACE_ID:/
--source include/search_pattern.inc

# This is a covering secondary-index query. It verifies that recovery preserved
# the later INSERT and that both records contain the physical lowercase bytes.
SELECT a, HEX(b) AS b_hex FROM t1 FORCE INDEX(b)
WHERE b = REPEAT('x', 16) AND a IN (-1, 1)
ORDER BY a;

CHECK TABLE t1;

# Remove the --debug=d,ib_log setting.
--let $restart_parameters = restart;
--source include/restart_mysqld.inc

# Cleanup
DROP TABLE t1;
