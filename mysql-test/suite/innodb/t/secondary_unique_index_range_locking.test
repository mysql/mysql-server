CREATE TABLE t (
  id INT PRIMARY KEY,
  val INT UNIQUE KEY
);
INSERT INTO t (val,id) VALUES (10,4);
INSERT INTO t (val,id) VALUES (20,7);
--connect (read_view_holder, localhost, root,,)
  BEGIN;
  SELECT * FROM t;
#   +----+------+
#   | id | val  |
#   +----+------+
#   |  4 |   10 |
#   |  7 |   20 |
#   +----+------+
--connection default
  DELETE FROM t WHERE val=10; # delete-mark (val=10 --> id=4)
  BEGIN;
  INSERT INTO t (val,id) VALUES (10,3);

# Make sure that there is no "S" lock placed on val index val=20, id=7.
# There should be an "S,GAP" lock though, but LOCK_DATA may contain NULLs
# if a page is missing from BP or latched, so to avoid nondeterminism, we
# will simply count :
# how many "S" locks we have - there should be just one on the val=10,id=4
# how many "S,GAP" locks we have - there should be two, on 20,7 and 10,3 :
#   +------------+-----------+-----------+-------------+-----------+
#   | INDEX_NAME | LOCK_TYPE | LOCK_MODE | LOCK_STATUS | LOCK_DATA |
#   +------------+-----------+-----------+-------------+-----------+
#   | NULL       | TABLE     | IX        | GRANTED     | NULL      |
#   | val        | RECORD    | S         | GRANTED     | 10, 4     |
#   | val        | RECORD    | S,GAP     | GRANTED     | 20, 7     |
#   | val        | RECORD    | S,GAP     | GRANTED     | 10, 3     |
#   +------------+-----------+-----------+-------------+-----------+
  --sorted_result
  SELECT LOCK_MODE, COUNT(*)
    FROM performance_schema.data_locks
    WHERE OBJECT_SCHEMA='test'
      AND OBJECT_NAME='t'
      AND INDEX_NAME='val'
      AND LOCK_TYPE='RECORD'
    GROUP BY 1;
  ROLLBACK;

# The X-lock path must also protect only the gap before the first unequal
# record. Exercise both callers under REPEATABLE READ and READ COMMITTED.
--connect (con1, localhost, root,,)
--let $i=0
while ($i < 4)
{
  --let $isolation=REPEATABLE READ
  if ($i >= 2)
  {
    --let $isolation=READ COMMITTED
  }
  --let $insert=INSERT INTO t (val,id) VALUES (10,3) ON DUPLICATE KEY UPDATE val=10
  if ($i == 1)
  {
    --let $insert=REPLACE INTO t (val,id) VALUES (10,3)
  }
  if ($i == 3)
  {
    --let $insert=REPLACE INTO t (val,id) VALUES (10,3)
  }

  --connection default
  --eval SET SESSION TRANSACTION ISOLATION LEVEL $isolation
  BEGIN;
  --eval $insert
  --sorted_result
  SELECT LOCK_MODE, COUNT(*)
    FROM performance_schema.data_locks
    WHERE OBJECT_SCHEMA='test'
      AND OBJECT_NAME='t'
      AND INDEX_NAME='val'
      AND LOCK_TYPE='RECORD'
    GROUP BY 1;

  --connection con1
  --eval SET SESSION TRANSACTION ISOLATION LEVEL $isolation
  BEGIN;
  # The unequal record can be locked and deleted without waiting.
  SELECT * FROM t WHERE val=20 FOR UPDATE NOWAIT;
  DELETE FROM t WHERE val=20;
  ROLLBACK;

  BEGIN;
  # Insertion into the preceding gap must still wait.
  --send INSERT INTO t (val,id) VALUES (15,6)
  --connection default
  --let $wait_condition=SELECT COUNT(*)=1 FROM performance_schema.data_lock_waits
  --source include/wait_condition.inc
  ROLLBACK;
  --connection con1
  --reap
  SELECT * FROM t WHERE val=15;
  ROLLBACK;
  --inc $i
}
--disconnect con1
--connection default
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;

--connection read_view_holder
  ROLLBACK;
--connection default
--disconnect read_view_holder
DROP TABLE t;