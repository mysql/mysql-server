#
# Prepare
# t1 <-- t2 <-- t3
#
CREATE TABLE `t1`(`id` int KEY, `c1` int);
CREATE TABLE `t2`(`id` int KEY, `c1` int, CONSTRAINT `fk_t2_t1` FOREIGN KEY(`id`) REFERENCES `t1`(`id`));
CREATE TABLE `t3`(`id` int KEY, `c1` int, CONSTRAINT `fk_t3_t2` FOREIGN KEY(`id`) REFERENCES `t2`(`id`));
# restart
#
# Session 1 (DDL): ALTER t3 with COPY.
#
SET DEBUG_SYNC = 'before_copy_ddl_tmp_table_fk_inserted SIGNAL do_select_1 WAIT_FOR create_tmp';
SET DEBUG_SYNC = 'after_copy_ddl_tmp_table_fk_inserted SIGNAL do_select_2 WAIT_FOR commit_tmp';
ALTER TABLE `t3` ADD COLUMN `dummy` INT DEFAULT NULL, ALGORITHM=COPY;
#
# Session 2 (query): SELECT t1.
#
SET DEBUG = '+d,t2_before_load_fk';
SET DEBUG_SYNC = 'now WAIT_FOR do_select_1';
SET DEBUG_SYNC = 'after_dict_table_add_to_cache_before_load_fk SIGNAL create_tmp WAIT_FOR do_select_2';
SELECT * FROM `t1` LIMIT 1;;
#
# Reap Session 2 (crash without fix, success with fix).
#
id	c1
#
# Let DDL complete and verify FK constraints still work.
# After COPY ALTER with skip_referenced, the dynamic FK check path
# (dd_table_open_on_name when referenced_table == nullptr) must
# correctly enforce constraints.
#
SET DEBUG_SYNC = 'now SIGNAL commit_tmp';
INSERT INTO `t1` VALUES (1, 10);
INSERT INTO `t2` VALUES (1, 20);
INSERT INTO `t3` VALUES (1, 30, NULL);
# Child row violating FK must be rejected
INSERT INTO `t3` VALUES (999, 30, NULL);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (`test`.`t3`, CONSTRAINT `fk_t3_t2` FOREIGN KEY (`id`) REFERENCES `t2` (`id`))
# Parent delete with existing child must be rejected
DELETE FROM `t1` WHERE id = 1;
ERROR 23000: Cannot delete or update a parent row: a foreign key constraint fails (`test`.`t2`, CONSTRAINT `fk_t2_t1` FOREIGN KEY (`id`) REFERENCES `t1` (`id`))
# Valid delete chain (leaf first) must succeed
DELETE FROM `t3` WHERE id = 1;
DELETE FROM `t2` WHERE id = 1;
DELETE FROM `t1` WHERE id = 1;
#
# Cleanup
#
SET DEBUG_SYNC = 'RESET';
DROP TABLE `t1`, `t2`, `t3`;
