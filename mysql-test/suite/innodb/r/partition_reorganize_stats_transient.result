ALTER TABLE sales_add ADD PARTITION (
PARTITION p2022 VALUES LESS THAN (2023)
);
INSERT INTO sales_add (sale_date, amount) VALUES
('2022-02-14', 4000.00),
('2022-07-04', 4500.00);
