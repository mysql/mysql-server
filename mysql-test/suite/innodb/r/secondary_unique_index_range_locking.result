CREATE TABLE t (
id INT PRIMARY KEY,
val INT UNIQUE KEY
);
INSERT INTO t (val,id) VALUES (10,4);
INSERT INTO t (val,id) VALUES (20,7);
BEGIN;
SELECT * FROM t;
id	val
4	10
7	20
DELETE FROM t WHERE val=10;
BEGIN;
INSERT INTO t (val,id) VALUES (10,3);
SELECT LOCK_MODE, COUNT(*)
FROM performance_schema.data_locks
WHERE OBJECT_SCHEMA='test'
      AND OBJECT_NAME='t'
      AND INDEX_NAME='val'
      AND LOCK_TYPE='RECORD'
    GROUP BY 1;
LOCK_MODE	COUNT(*)
S	1
S,GAP	2
ROLLBACK;
BEGIN;
INSERT INTO t (val,id) VALUES (10,3) ON DUPLICATE KEY UPDATE val=10;
SELECT LOCK_MODE, COUNT(*)
FROM performance_schema.data_locks
WHERE OBJECT_SCHEMA='test'
      AND OBJECT_NAME='t'
      AND INDEX_NAME='val'
      AND LOCK_TYPE='RECORD'
    GROUP BY 1;
LOCK_MODE	COUNT(*)
X	1
X,GAP	2
BEGIN;
SELECT * FROM t WHERE val=20 FOR UPDATE NOWAIT;
id	val
7	20
DELETE FROM t WHERE val=20;
ROLLBACK;
BEGIN;
INSERT INTO t (val,id) VALUES (15,6);
ROLLBACK;
SELECT * FROM t WHERE val=15;
id	val
6	15
ROLLBACK;
BEGIN;
REPLACE INTO t (val,id) VALUES (10,3);
SELECT LOCK_MODE, COUNT(*)
FROM performance_schema.data_locks
WHERE OBJECT_SCHEMA='test'
      AND OBJECT_NAME='t'
      AND INDEX_NAME='val'
      AND LOCK_TYPE='RECORD'
    GROUP BY 1;
LOCK_MODE	COUNT(*)
X	1
X,GAP	2
BEGIN;
SELECT * FROM t WHERE val=20 FOR UPDATE NOWAIT;
id	val
7	20
DELETE FROM t WHERE val=20;
ROLLBACK;
BEGIN;
INSERT INTO t (val,id) VALUES (15,6);
ROLLBACK;
SELECT * FROM t WHERE val=15;
id	val
6	15
ROLLBACK;
ROLLBACK;
DROP TABLE t;
