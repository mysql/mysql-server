SELECT COUNT(*) = 1 AS matching_record_locked FROM performance_schema.data_locks WHERE OBJECT_SCHEMA = 'mysql' AND OBJECT_NAME = 'schemata' AND INDEX_NAME = 'catalog_id' AND LOCK_MODE = 'S,REC_NOT_GAP';
matching_record_locked
1
