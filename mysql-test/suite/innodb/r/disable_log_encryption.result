# ----------------------------------------------------------------------
# Setup
# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
DO innodb_redo_log_consumer_register();
SELECT @@global.innodb_redo_log_encrypt;
@@global.innodb_redo_log_encrypt
0
CREATE TABLE t1 (a BIGINT PRIMARY KEY, b LONGBLOB) ENGINE=InnoDB;
INSERT INTO t1 (a, b) VALUES (1, REPEAT('a', 6*512*512));
SET GLOBAL innodb_redo_log_encrypt = 1;
SELECT @@global.innodb_redo_log_encrypt;
@@global.innodb_redo_log_encrypt
1
INSERT INTO t1 (a, b) VALUES (2, REPEAT('b', 6*512*512));
SET GLOBAL innodb_redo_log_encrypt = 0;
SELECT @@global.innodb_redo_log_encrypt;
@@global.innodb_redo_log_encrypt
0
INSERT INTO t1 (a, b) VALUES (3, REPEAT('c', 6*512*512));
SET GLOBAL innodb_redo_log_encrypt = 1;
SELECT @@global.innodb_redo_log_encrypt;
@@global.innodb_redo_log_encrypt
1
INSERT INTO t1 (a, b) VALUES (4, REPEAT('d', 6*512*512));
FLUSH LOGS;
CHECKSUM TABLE t1;
Table	Checksum
test.t1	4082004932
# Kill the server
# restart: --plugin-dir=PLUGIN_DIR
CHECKSUM TABLE t1;
Table	Checksum
test.t1	4082004932
SELECT a,LEFT(b,8) FROM t1;
a	LEFT(b,8)
1	aaaaaaaa
2	bbbbbbbb
3	cccccccc
4	dddddddd
DO innodb_redo_log_consumer_register();
INSERT INTO t1 (a, b) VALUES (5, REPEAT('e', 6*512*512));
# Kill the server
# restart: --innodb_redo_log_encrypt=ON --plugin-dir=PLUGIN_DIR
SELECT @@global.innodb_redo_log_encrypt;
@@global.innodb_redo_log_encrypt
1
SELECT a,LEFT(b,8) FROM t1;
a	LEFT(b,8)
1	aaaaaaaa
2	bbbbbbbb
3	cccccccc
4	dddddddd
5	eeeeeeee
DO innodb_redo_log_consumer_register();
INSERT INTO t1 (a, b) VALUES (6, REPEAT('f', 6*512*512));
# Kill the server
# restart: --innodb_redo_log_encrypt=ON --plugin-dir=PLUGIN_DIR
SELECT a,LEFT(b,8) FROM t1;
a	LEFT(b,8)
1	aaaaaaaa
2	bbbbbbbb
3	cccccccc
4	dddddddd
5	eeeeeeee
6	ffffffff
SET GLOBAL innodb_redo_log_encrypt = 0;
DROP TABLE t1;
# ----------------------------------------------------------------------
# Teardown
# Removing manifest file for current MySQL server instance
# Removing local keyring file for keyring component: component_keyring_file
# Removing local configuration file for keyring component: component_keyring_file
# Restarting server without the manifest file
# ----------------------------------------------------------------------
