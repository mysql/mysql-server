# -----
# Setup
# -----
CREATE TABLE t1 (c1 INT);
# -----------------------------------------------------------------------
# Scenario 1 : When tablespace file wasn't found on which REDOs are there
#              to be applied. It shall write an error in server log and
#              abort server startup.
# -----------------------------------------------------------------------
# Stop the page cleaners so that REDOs are there to be applied on this
# tablespace during recovery
INSERT INTO t1 VALUES (1);
# Kill the server
# Remove the file from datadir
# Start the server. It shall abort as tablespace file isn't found.
# Expect found
Pattern "Could not find any file associated with the tablespace ID: \d+" found
# -------
# Cleanup
# -------
SELECT * FROM t1;
c1
1
DROP TABLE t1;
