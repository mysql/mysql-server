INSERT INTO zcached SELECT id + 8, k + 8, c, pad FROM zcached;
INSERT INTO zcached SELECT id + 16, k + 16, c, pad FROM zcached;
INSERT INTO zcached SELECT id + 32, k + 32, c, pad FROM zcached;
SELECT get_n_cached_pages('test/zcached', 'k_1') AS cached_pages, count_index_pages_in_lru('test/zcached', 'k_1') AS buffer_pages;;
cached_pages	buffer_pages
1	1
