CREATE TABLE t18 (
c5 INT NOT NULL,
PRIMARY KEY (c5)
) ENGINE=InnoDB;
CREATE TABLE t21 (
c1 INT NOT NULL,
c2 INT DEFAULT NULL,
KEY i15 ((c2 DIV 1), (FLOOR(c1))) USING BTREE,
CONSTRAINT t21_ibfk_1 FOREIGN KEY (c2) REFERENCES t18 (c5)
ON UPDATE SET NULL
) ENGINE=InnoDB;
INSERT INTO t18 (c5) VALUES (1), (2);
INSERT INTO t21 (c1, c2) VALUES (0, 1);
UPDATE t18 SET c5 = 3;
ERROR 23000: Duplicate entry '3' for key 't18.PRIMARY'
SELECT c5 FROM t18 ORDER BY c5;
c5
1
2
SELECT c1, c2 FROM t21;
c1	c2
0	1
DROP TABLE t21, t18;
CREATE TABLE parent (
id INT PRIMARY KEY
) ENGINE=InnoDB;
CREATE TABLE child (
a INT DEFAULT NULL,
parent_id INT DEFAULT NULL,
KEY idx_functional ((IFNULL(a, 0)), (IFNULL(parent_id, 0))),
CONSTRAINT fk_parent FOREIGN KEY (parent_id) REFERENCES parent (id)
ON DELETE SET NULL
) ENGINE=InnoDB;
INSERT INTO parent VALUES (1);
INSERT INTO child VALUES (NULL, 1);
START TRANSACTION;
DELETE FROM parent WHERE id = 1;
ROLLBACK;
SELECT id FROM parent;
id
1
SELECT a, parent_id FROM child;
a	parent_id
NULL	1
DROP TABLE child, parent;
