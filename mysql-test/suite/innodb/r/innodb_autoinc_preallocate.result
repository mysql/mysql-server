SET @initial_innodb_autoinc_preallocate = @@global.innodb_autoinc_preallocate;
SET @@global.innodb_autoinc_preallocate = 10;
SET @types = 'TINYINT|SMALLINT|MEDIUMINT|INT|BIGINT|';
SET @types = CONCAT(
@types,
REPLACE(@types,'|',' UNSIGNED|')
);
SET @types = CONCAT(
@types,
REPLACE(@types,'|',' NOT NULL|')
);
