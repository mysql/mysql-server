#
# A scan must not abort on a REDUNDANT record whose next-record offset
# is beyond the page. It must report corruption, or skip the rest of
# the page when innodb_force_recovery is set.
#
CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(1000)) ROW_FORMAT=REDUNDANT
ENGINE=InnoDB STATS_PERSISTENT=1 STATS_AUTO_RECALC=0;
INSERT INTO t1
WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 300)
SELECT n, REPEAT('x', 1000) FROM s;
ANALYZE TABLE t1;
SET GLOBAL innodb_fast_shutdown = 0;
# restart
# The scan reports corruption instead of aborting the server.
SELECT COUNT(a) FROM t1 WHERE b <> '';
ERROR HY000: Incorrect key file for table 't1'; try to repair it
# With innodb_force_recovery the damaged page is skipped.
# restart: --innodb-force-recovery=1
SELECT COUNT(a) > 0 AS rows_after_page, COUNT(a) < 300 AS page_skipped,
MIN(a) > 1 AS first_page_gone FROM t1 WHERE b <> '';
rows_after_page	page_skipped	first_page_gone
1	1	1
# restart
DROP TABLE t1;
