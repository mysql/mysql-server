#
# Bug#69122 - INNODB DOESN'T REDO-LOG INSERT BUFFER MERGE
#             OPERATION IF IT IS DONE IN-PLACE
#
CREATE TABLE t1(
a INT AUTO_INCREMENT PRIMARY KEY,
b CHAR(16) CHARACTER SET latin1 COLLATE latin1_swedish_ci,
c INT,
INDEX(b))
ENGINE=InnoDB STATS_PERSISTENT=0;
SET GLOBAL innodb_disable_background_merge = ON;
SET GLOBAL innodb_change_buffering_debug = 1;
INSERT INTO t1 VALUES(0, REPEAT('X', 16), 1);
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
INSERT INTO t1 SELECT 0,b,c FROM t1;
BEGIN;
SELECT b FROM t1 LIMIT 3;
b
XXXXXXXXXXXXXXXX
XXXXXXXXXXXXXXXX
XXXXXXXXXXXXXXXX
BEGIN;
DELETE FROM t1 WHERE a=1;
INSERT INTO t1 VALUES(1, REPEAT('x', 16), 1);
COMMIT;
SET GLOBAL innodb_log_checkpoint_now = ON;
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
SET GLOBAL innodb_checkpoint_disabled = ON;
SET GLOBAL innodb_disable_background_merge = OFF;
SET GLOBAL innodb_change_buffering_debug = 0;
SELECT a, HEX(b) AS b_hex FROM t1 FORCE INDEX(b)
WHERE b = REPEAT('x', 16) AND a = 1;
a	b_hex
1	78787878787878787878787878787878
INSERT INTO t1 VALUES(-1, REPEAT('x', 16), 2);
# Kill the server
# restart: --debug=d,ib_log --innodb-disable-background-merge=ON
Pattern "apply [0-9]+: MLOG_REC_UPDATE_IN_PLACE len [0-9]+ page SPACE_ID:" found
SELECT a, HEX(b) AS b_hex FROM t1 FORCE INDEX(b)
WHERE b = REPEAT('x', 16) AND a IN (-1, 1)
ORDER BY a;
a	b_hex
-1	78787878787878787878787878787878
1	78787878787878787878787878787878
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# restart;
DROP TABLE t1;
