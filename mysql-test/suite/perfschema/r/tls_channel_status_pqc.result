SELECT CHANNEL, PROPERTY, IF(VALUE = '', '<empty>', VALUE) AS VALUE
FROM performance_schema.tls_channel_status
WHERE CHANNEL IN ('mysql_admin', 'mysql_main')
AND PROPERTY IN ('Force_pqc', 'Use_pqc_sign', 'Tls_kex')
ORDER BY CHANNEL, FIELD(PROPERTY, 'Force_pqc', 'Use_pqc_sign', 'Tls_kex');
CHANNEL	PROPERTY	VALUE
mysql_admin	Force_pqc	OFF
mysql_admin	Use_pqc_sign	OFF
mysql_admin	Tls_kex	<empty>
mysql_main	Force_pqc	OFF
mysql_main	Use_pqc_sign	OFF
mysql_main	Tls_kex	<empty>
