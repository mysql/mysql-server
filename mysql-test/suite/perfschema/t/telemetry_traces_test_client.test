################################################################################
# Test case to test telemetry tracing service functionality using test component.
#
# This test script:
#    - Installs the query_attributes and test_server_telemetry components.
#       The test_server_telemetry component implements custom telemetry tracing callback
#       with following tracing strategy:
#              - only trace statements with trace:on query attribute
#              - do not trace requests from user 'internal'
#              - force tracing requests from user 'app'
#    - Executes mysql_test_client statements and verifies that correct tracing action happened
#    - Statements ending with errors should also reach the telemetry engine (logs) no
#      matter if they will be traced or not
#    - To synchronize output of different sessons, it's using sleep instead of wait
#       because wait loop SQL would be traced in non-deterministic way
################################################################################

--source include/have_server_telemetry_traces.inc
--source include/have_no_telemetry_component.inc
--source include/not_parallel.inc
--source include/no_ps_protocol.inc
--source include/not_windows.inc
# ASAN failures in legacy code reported in yet unsolved Bug#34713142
--source include/not_asan.inc

--echo #########
--echo # SETUP #
--echo #########

# Install required components.
INSTALL COMPONENT 'file://component_query_attributes';
INSTALL COMPONENT 'file://component_test_server_telemetry_traces';

--echo ##############
--echo # Operations #
--echo ##############

--echo # send different COM_... commands, expect them being processed by telemetry
--exec $MYSQL_CLIENT_TEST test_server_telemetry_traces > /dev/null 2>&1
--sleep 0.5

--echo ###########
--echo # CLEANUP #
--echo ###########

UNINSTALL COMPONENT 'file://component_test_server_telemetry_traces';
UNINSTALL COMPONENT 'file://component_query_attributes';

let $MYSQLD_DATADIR= `select @@datadir`;
--echo Component logs:
let TELEMETRY_TRACES_LOG= $MYSQLD_DATADIR/test_server_telemetry_traces_component.log;
let TELEMETRY_TRACES_NORMALIZED_LOG= $MYSQLTEST_VARDIR/tmp/test_server_telemetry_traces_component_normalized.log;
# This test sends intentionally malformed zero-payload COM_* packets over a
# short-lived SSL connection. Depending on OpenSSL EOF/close-notify behavior
# (OpenSSL 4.0 generated slightly different lines compared to older versions),
# the server can record one or two identical empty statement callbacks for the
# same connection close path. Keep the test focused on whether each command was
# seen by telemetry by collapsing only consecutive duplicate empty statement
# start/query-attribute pairs.
perl;
  use strict;
  use warnings;

  my $input_file = $ENV{'TELEMETRY_TRACES_LOG'};
  my $output_file = $ENV{'TELEMETRY_TRACES_NORMALIZED_LOG'};

  open(my $in, '<', $input_file)
    or die("Unable to open '$input_file': $!\n");
  my @lines = <$in>;
  close($in);

  open(my $out, '>', $output_file)
    or die("Unable to open '$output_file': $!\n");
  sub is_empty_statement_pair {
    my ($start, $notify) = @_;
    return $start =~ /^> tm_stmt_start: proceed further .*query=''\)$/ &&
           $notify =~ /^ > tm_stmt_notify_qa: skip tracing, no qa .*query=''\)$/;
  }

  for (my $i = 0; $i < @lines; $i++) {
    if ($i + 1 < @lines &&
        is_empty_statement_pair($lines[$i], $lines[$i + 1])) {
      my $start_line = $lines[$i];
      my $notify_line = $lines[$i + 1];
      print $out $start_line, $notify_line;
      $i += 2;
      while ($i + 1 < @lines &&
             $lines[$i] eq $start_line &&
             $lines[$i + 1] eq $notify_line) {
        $i += 2;
      }
      $i--;
      next;
    }
    print $out $lines[$i];
  }
  close($out);
EOF
cat_file $TELEMETRY_TRACES_NORMALIZED_LOG;
remove_file $TELEMETRY_TRACES_NORMALIZED_LOG;
remove_file $TELEMETRY_TRACES_LOG;
