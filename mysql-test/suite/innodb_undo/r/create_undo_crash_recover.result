#
# wl#16989 Innodb: Make UNDO log truncation crash safe
#
# Scenario 1 :- crash after writing ddl log
Setting server to crash at "create_undo_crash_after_ddl_log" during UNDO truncate
SET GLOBAL DEBUG = "+d,create_undo_crash_after_ddl_log";
CREATE UNDO TABLESPACE undo_003 ADD DATAFILE 'undo_003.ibu';
ERROR HY000: Lost connection to MySQL server during query
# Restart server normally
# restart:
SELECT name, space_type, state, autoextend_size FROM
INFORMATION_SCHEMA.INNODB_TABLESPACES WHERE space_type="Undo";
name	space_type	state	autoextend_size
innodb_undo_001	Undo	active	0
innodb_undo_002	Undo	active	0
undo_001
undo_002
#
# Cleanup
#
DROP UNDO TABLESPACE undo_003;
ERROR HY000: Tablespace undo_003 doesn't exist.
# Scenario 2 :- crash before undo create
Setting server to crash at "create_crash_before_undo_tablespace_create" during UNDO truncate
SET GLOBAL DEBUG = "+d,create_crash_before_undo_tablespace_create";
CREATE UNDO TABLESPACE undo_003 ADD DATAFILE 'undo_003.ibu';
ERROR HY000: Lost connection to MySQL server during query
# Restart server normally
# restart:
