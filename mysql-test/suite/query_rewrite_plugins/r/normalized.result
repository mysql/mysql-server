# Query rewrite plugin was installed.
#
# Bug#21619780: TABLE HINTS ARE LOST IN NORMALIZED PRINT OF STATEMENTS
# BEFORE RESOLVE
#
CREATE TABLE t1 (a INTEGER);
INSERT INTO query_rewrite.rewrite_rules ( pattern, replacement )
VALUES ('SELECT /*+ NO_MRR(t1 idx1) */ * FROM test.t1',
'SELECT /*+ MRR(t1) */ * FROM test.t1');
CALL query_rewrite.flush_rewrite_rules();
SELECT normalized_pattern FROM query_rewrite.rewrite_rules;
normalized_pattern
select /*+ NO_MRR(`t1`@`select#1` `idx1`) */ `*` from `test`.`t1`
DELETE FROM query_rewrite.rewrite_rules;
DROP TABLE t1;
#
# Bug#37100271: mysql_parser_parse() gets different digest for query
#               with trailing semicolon
#
INSERT INTO query_rewrite.rewrite_rules ( pattern, replacement )
VALUES ( 'SELECT ?',     'SELECT "rewritten"' ),
( 'SELECT ?;',    'SELECT "rewritten"' ),
( 'SELECT ?  ; ', 'SELECT "rewritten"' ),
( 'SELECT ?;;',   'SELECT "rewritten"' );
CALL query_rewrite.flush_rewrite_rules();
SELECT pattern, normalized_pattern, message
FROM query_rewrite.rewrite_rules ORDER BY id;
pattern	normalized_pattern	message
SELECT ?	select ?	NULL
SELECT ?;	select ?	NULL
SELECT ?  ; 	select ?	NULL
SELECT ?;;	select ?	NULL
SELECT COUNT(DISTINCT pattern_digest) AS distinct_digests
FROM query_rewrite.rewrite_rules;
distinct_digests
1
SELECT COUNT(DISTINCT normalized_pattern) AS distinct_normalized
FROM query_rewrite.rewrite_rules;
distinct_normalized
1
DELETE FROM query_rewrite.rewrite_rules;
INSERT INTO query_rewrite.rewrite_rules ( pattern, replacement )
VALUES ( 'SELECT ?;', 'SELECT "rewritten"' );
CALL query_rewrite.flush_rewrite_rules();
SELECT 1;
rewritten
rewritten
Warnings:
Note	1105	Query 'SELECT 1' rewritten to 'SELECT "rewritten"' by a query rewrite plugin
DELETE FROM query_rewrite.rewrite_rules;
INSERT INTO query_rewrite.rewrite_rules ( pattern, replacement )
VALUES ( 'SELECT ?, 0', '  SELECT ?, "padded"' );
CALL query_rewrite.flush_rewrite_rules();
SELECT 42, 0;
42	padded
42	padded
Warnings:
Note	1105	Query 'SELECT 42, 0' rewritten to '  SELECT 42, "padded"' by a query rewrite plugin
DELETE FROM query_rewrite.rewrite_rules;
