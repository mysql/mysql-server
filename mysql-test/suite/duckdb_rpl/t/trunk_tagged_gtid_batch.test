--source include/rpl/init_source_replica.inc
--source include/have_binlog_format_row.inc

--source include/rpl/connection_replica.inc
--source include/rpl/stop_applier.inc
SET GLOBAL replica_parallel_workers = 2;
--error ER_DUCKDB_DONT_SUPPORT_BATCH_MULTI_TRX
START REPLICA SQL_THREAD;
SET GLOBAL replica_parallel_workers = 1;
--source include/rpl/start_applier.inc

--source include/rpl/connection_source.inc
CREATE TABLE t_tagged_batch (id INT PRIMARY KEY, v INT) ENGINE=InnoDB;
SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:duckdb_port:1';
INSERT INTO t_tagged_batch VALUES (1, 10);
SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:duckdb_port:2';
UPDATE t_tagged_batch SET v = 20 WHERE id = 1;
SET GTID_NEXT = 'AUTOMATIC';
--source include/rpl/sync.inc
--source include/rpl/connection_replica.inc
SELECT * FROM t_tagged_batch;
SELECT GTID_SUBSET('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:duckdb_port:1-2',
                   @@GLOBAL.GTID_EXECUTED) AS tagged_gtids_executed;

--let $rpl_server_number= 2
--source include/rpl/restart_server.inc
--source include/rpl/connection_replica.inc
SELECT * FROM t_tagged_batch;
SELECT GTID_SUBSET('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:duckdb_port:1-2',
                   @@GLOBAL.GTID_EXECUTED) AS tagged_gtids_recovered;
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:duckdb_port:3';
INSERT INTO t_tagged_batch VALUES (2, 30);
SET GTID_NEXT = 'AUTOMATIC';
--source include/rpl/sync.inc
--source include/rpl/connection_replica.inc
SELECT * FROM t_tagged_batch ORDER BY id;
SELECT GTID_SUBSET('aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:duckdb_port:1-3',
                   @@GLOBAL.GTID_EXECUTED) AS tagged_gtids_after_restart;

--source include/rpl/connection_source.inc
DROP TABLE t_tagged_batch;
--source include/rpl/deinit.inc
