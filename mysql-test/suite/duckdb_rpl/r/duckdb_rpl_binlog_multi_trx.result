###########################################################################
[connection server_3]
include/rpl/stop_replica.inc
include/rpl/restart_server.inc [server_number=3 parameters: --log-replica-updates=0 --duckdb_multi_trx_in_batch=on]
include/rpl/start_replica.inc
[connection server_2]
STOP REPLICA;
[connection server_3]
STOP REPLICA;
[connection server_1]
# Trx1 and Trx2
INSERT INTO t1 (id, c0) VALUES (7, 'abc'), (7+1, 'efg'), (7+2, 'xyz');
DELETE FROM t1 WHERE id =7+2;
FLUSH LOGS;
# Trx3 and Trx4
UPDATE t1 SET id=7+2, c0='AliSQL' WHERE id=7;
INSERT INTO t1 (id, c0) VALUES (7, 'xyz');
[connection server_2]
# Will put Trx1 and Trx2 in one batch, put Trx3 and Trx4 in one batch 
