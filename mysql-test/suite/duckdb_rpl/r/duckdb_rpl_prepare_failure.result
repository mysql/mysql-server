[connection master]
INSERT INTO t1 VALUES(1, "1"), (2, "2"), (3, "3");
#
# Use a single INSERT transaction to trigger duplicate key error at
# prepare
#
INSERT INTO t1 VALUES(3, "duplicate key");
ERROR HY000: [DuckDB] DuckDB prepare transaction error. Duplicate key "c1: 3" violates primary key constraint.
SELECT * FROM t1 ORDER BY c1;
c1	c2
1	1
2	2
3	3
INSERT INTO t1 VALUES(4, "4");
SHOW BINLOG EVENTS IN 'master-bin.000001';
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000001	4	Format_desc	#	127	Server ver: #.#.#
master-bin.000001	127	Previous_gtids	#	158	
master-bin.000001	158	Gtid	#	235	SET @@SESSION.GTID_NEXT= 'SERVER_UUID:1'
master-bin.000001	235	Query	#	400	use `test`; CREATE TABLE t1(c1 INT NOT NULL PRIMARY KEY, c2 VARCHAR(200)) ENGINE = DUCKDB /* xid=# */
master-bin.000001	400	Gtid	#	479	SET @@SESSION.GTID_NEXT= 'SERVER_UUID:2'
master-bin.000001	479	Query	#	561	BEGIN
master-bin.000001	561	Query	#	689	use `test`; INSERT INTO t1 VALUES(1, "1"), (2, "2"), (3, "3")
master-bin.000001	689	Xid	#	720	COMMIT /* xid=# */
master-bin.000001	720	Gtid	#	799	SET @@SESSION.GTID_NEXT= 'SERVER_UUID:3'
master-bin.000001	799	Query	#	881	BEGIN
master-bin.000001	881	Query	#	989	use `test`; INSERT INTO t1 VALUES(4, "4")
master-bin.000001	989	Xid	#	1020	COMMIT /* xid=# */
include/rpl/diff.inc
#
# Same to above test but the INSERT in a multiple statement transaction.
# COMMIT will trigger the duplicate key error.
#
[connection master]
BEGIN;
UPDATE t1 SET c2 = "test";
INSERT INTO t1 VALUES(4, "duplicate key");
SELECT * FROM t1 ORDER BY c1;
c1	c2
1	test
2	test
3	test
4	test
COMMIT;
ERROR HY000: [DuckDB] DuckDB prepare transaction error. Duplicate key "c1: 4" violates primary key constraint.
SELECT * FROM t1 ORDER BY c1;
c1	c2
1	1
2	2
3	3
4	4
SHOW BINLOG EVENTS IN 'master-bin.000001';
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
master-bin.000001	4	Format_desc	#	127	Server ver: #.#.#
master-bin.000001	127	Previous_gtids	#	158	
master-bin.000001	158	Gtid	#	235	SET @@SESSION.GTID_NEXT= 'SERVER_UUID:1'
master-bin.000001	235	Query	#	400	use `test`; CREATE TABLE t1(c1 INT NOT NULL PRIMARY KEY, c2 VARCHAR(200)) ENGINE = DUCKDB /* xid=# */
master-bin.000001	400	Gtid	#	479	SET @@SESSION.GTID_NEXT= 'SERVER_UUID:2'
master-bin.000001	479	Query	#	561	BEGIN
master-bin.000001	561	Query	#	689	use `test`; INSERT INTO t1 VALUES(1, "1"), (2, "2"), (3, "3")
master-bin.000001	689	Xid	#	720	COMMIT /* xid=# */
master-bin.000001	720	Gtid	#	799	SET @@SESSION.GTID_NEXT= 'SERVER_UUID:3'
master-bin.000001	799	Query	#	881	BEGIN
master-bin.000001	881	Query	#	989	use `test`; INSERT INTO t1 VALUES(4, "4")
master-bin.000001	989	Xid	#	1020	COMMIT /* xid=# */
include/rpl/diff.inc
[connection master]
FLUSH BINARY LOGS;
INSERT INTO t1 VALUES(6, "6");
SELECT * FROM t1 ORDER BY c1;
c1	c2
1	1
2	2
3	3
4	4
6	6
