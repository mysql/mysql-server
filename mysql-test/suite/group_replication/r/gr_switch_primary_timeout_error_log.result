include/group_replication.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection server1]

# 1. Start group in single primary mode.
#    Server1 will be primary and server2 secondary.
[connection server1]
include/start_and_bootstrap_group_replication.inc
[connection server2]
include/start_group_replication.inc

# 2. Execute "START TRANSACTION" on server1 (primary), so that the
#    election is blocked until running_transactions_timeout is reached.
[connection server1]
START TRANSACTION;

# 3. Change the primary to server2, with running_transactions_timeout 5.
[connection server2]
SELECT group_replication_set_as_primary("MEMBER2_UUID", 5);
group_replication_set_as_primary("MEMBER2_UUID", 5)
Primary server switched to: MEMBER2_UUID
include/gr_assert_primary_member.inc

# 4. Server1 did log that new transactions were blocked and that the
#    running_transactions_timeout was reached.
include/assert_grep.inc [Server1 logged that the transaction monitor is blocking new transactions]
include/assert_grep.inc [Server1 logged that the running_transactions_timeout was reached]

# 5. The connection that was blocking the election on server1 was closed.
[connection server1]
SELECT 1;
Got one of the listed errors

# 6. Change the primary back to server1, with
#    running_transactions_timeout 600, with no transaction blocking the
#    election.
[connection server2]
SELECT group_replication_set_as_primary("MEMBER1_UUID", 600);
group_replication_set_as_primary("MEMBER1_UUID", 600)
Primary server switched to: MEMBER1_UUID
[connection server1]
include/gr_assert_primary_member.inc

# 7. Server2 did log that new transactions were blocked, but did not log
#    that the running_transactions_timeout was reached.
include/assert_grep.inc [Server2 logged that the transaction monitor is blocking new transactions]
include/assert_grep.inc [Server2 did not log that the running_transactions_timeout was reached]

# 8. Cleanup.
include/group_replication_end.inc
