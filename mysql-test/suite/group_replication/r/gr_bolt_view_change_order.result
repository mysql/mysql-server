include/group_replication.inc [rpl_server_count=2]
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection server1]
[connection server1]
include/save_sysvars.inc [ "GLOBAL.binlog_checksum", "GLOBAL.binlog_large_transaction_optimization_enabled", "GLOBAL.binlog_large_transaction_optimization_threshold" ]
SET GLOBAL binlog_checksum = CRC32;
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
SET @@GLOBAL.DEBUG = '+d,group_replication_version_with_vcle';
include/start_and_bootstrap_group_replication.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
[connection server2]
include/save_sysvars.inc [ "GLOBAL.binlog_checksum", "GLOBAL.binlog_large_transaction_optimization_enabled", "GLOBAL.binlog_large_transaction_optimization_threshold" ]
SET GLOBAL binlog_checksum = CRC32;
SET @@GLOBAL.DEBUG = '+d,group_replication_version_with_vcle';
# R1: pause a BOLT commit on server1, then let server2 join.
[connection server1]
SET DEBUG_SYNC = 'bolt_before_promotion_lock_log SIGNAL bolt_paused WAIT_FOR bolt_go';
COMMIT;
[connection server_1]
SET DEBUG_SYNC = 'now WAIT_FOR bolt_paused';
[connection server2]
START GROUP_REPLICATION;
[connection server_1]
include/assert.inc [R1: the view change is not written while the BOLT transaction waits.]
SET DEBUG_SYNC = 'now SIGNAL bolt_go';
[connection server1]
SET DEBUG_SYNC = 'RESET';
include/assert.inc [R2: the transaction is promoted.]
[connection server2]
Warnings:
Warning	1681	'group_replication_ip_allowlist' is deprecated and will be removed in a future release.
include/gr_wait_for_member_state.inc
[connection server1]
include/assert.inc [R2: the view change is not in the binary log file active before the promotion.]
include/rpl/sync.inc
# R3: server2 has the transaction.
[connection server2]
include/assert.inc [R3: server2 has every row.]
[connection server1]
DROP TABLE t1;
include/rpl/sync.inc
[connection server2]
include/stop_group_replication.inc
SET @@GLOBAL.DEBUG = '-d,group_replication_version_with_vcle';
include/restore_sysvars.inc
[connection server1]
include/stop_group_replication.inc
SET @@GLOBAL.DEBUG = '-d,group_replication_version_with_vcle';
include/restore_sysvars.inc
include/group_replication_end.inc
