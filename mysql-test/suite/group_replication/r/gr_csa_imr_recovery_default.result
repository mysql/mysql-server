include/group_replication.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection server1]

# 1. Bootstrap the group on server1 and create t1.
[connection server1]
include/start_and_bootstrap_group_replication.inc
CREATE TABLE t1 (c1 INT PRIMARY KEY);

# 2. Recreate server2's recovery channel and switch it to CSA.
[connection server2]
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 2 FOR CHANNEL 'group_replication_recovery';

# 3. The recovery channel is on CSA with IMR ON by default.
include/assert.inc [Recovery channel uses CSA with IMR ON by default]

# 4. Commit transactions server2 must recover.
[connection server1]
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);
INSERT INTO t1 VALUES (4);
INSERT INTO t1 VALUES (5);

# 5. Hold server2's applier with a global read lock and start server2.
[connection server2]
[connection server_2]
SET GLOBAL super_read_only = 1;
FLUSH TABLES WITH READ LOCK;
[connection server2]
include/start_group_replication.inc

# 6. Wait until recovery transfers state and the workers are held.
include/assert.inc [Recovery channel queue holds transactions while held]
STOP REPLICA;
Warnings:
Note	3084	Replication thread(s) for channel '' are already stopped.
include/assert.inc [Global STOP REPLICA leaves the IMR recovery channel ON with its queue]

# 7. Release the hold; server2 becomes ONLINE.
[connection server_2]
UNLOCK TABLES;
[connection server2]
include/gr_wait_for_member_state.inc

# 8. Incremental recovery with one donor connection and no error.
include/assert.inc [One donor connection during recovery]
include/assert.inc [No reconnect to another donor]
include/assert.inc [No recovery-channel error]
include/assert.inc [Recovery ended through the requested UNTIL stop]
include/assert.inc [Recovery did not end through a retry]
include/assert.inc [One SQL_AFTER_GTIDS stop message]

# 9. group_replication_applier stores ON but does not use IMR.
include/assert.inc [Applier channel stores ON and shows NO]

# 10. The data matches.
include/diff_tables.inc [server1:t1, server2:t1]

# 11. server1's recovery channel is unchanged and has no IMR queue.
[connection server1]
include/assert.inc [server1's recovery channel is unchanged]

# 12. Hold a second recovery of server2 with LOCK TABLE t1 READ.
[connection server2]
include/stop_group_replication.inc
[connection server1]
INSERT INTO t1 VALUES (6);
INSERT INTO t1 VALUES (7);
[connection server_2]
LOCK TABLE t1 READ;
[connection server2]
include/start_group_replication.inc

# 13. A failed global RESET REPLICA ALL leaves the IMR recovery channel.
include/assert.inc [Recovery channel is ON on CSA with IMR before the RESET]
RESET REPLICA ALL;
ERROR HY000: RESET REPLICA ALL FOR CHANNEL cannot be performed on channel 'group_replication_applier'.
include/assert.inc [Failed RESET REPLICA ALL keeps the IMR recovery channel row and ON state]

# 14. Kill server2 during IMR recovery; restart with skip-replica-start=FALSE.
# Kill and restart:--group_replication_local_address=GROUP_REPLICATION_LOCAL_ADDRESS --group_replication_group_seeds=GROUP_REPLICATION_GROUP_SEEDS --group_replication_communication_stack=GROUP_REPLICATION_COMMUNICATION_STACK --skip-replica-start=FALSE
include/rpl/reconnect.inc
[connection server1]
include/gr_wait_for_member_state.inc
include/rpl/gr_wait_for_number_of_members.inc
SET GLOBAL group_replication_force_members= "";
[connection server2]
include/assert.inc [After the restart the IMR recovery channel row exists and is OFF]
include/start_group_replication.inc

# 15. Restore server2's recovery channel and clean up.
[connection server2]
include/stop_group_replication.inc
include/start_group_replication.inc
[connection server1]
DROP TABLE t1;
include/rpl/sync.inc
include/group_replication_end.inc
