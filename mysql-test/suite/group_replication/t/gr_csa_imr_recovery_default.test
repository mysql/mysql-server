################################################################################
# Group Replication distributed recovery on a CSA recovery channel whose
# in-memory relay log (IMR) setting is the default ON.
#
# A new channel stores IN_MEMORY_RELAYLOG_ENABLED = ON, which takes effect once
# the channel is on CSA. A joiner whose recovery channel is switched to CSA
# without an IMR option recovers through IMR and reaches ONLINE with the right
# data. group_replication_applier stores ON as well but never uses IMR. The
# setting is per server: the other member's recovery channel is unchanged.
#
# Steps:
#   1. Bootstrap the group on server1, create t1, snapshot server1's recovery
#      channel configuration.
#   2. Recreate server2's recovery channel and switch it to CSA with no IMR
#      option.
#   3. The recovery channel is on CSA with IMR ON by default.
#   4. Commit five transactions on server1 that server2 must recover.
#   5. Remember the error-log position, hold server2's applier with FLUSH
#      TABLES WITH READ LOCK, and start server2; it stays RECOVERING.
#   6. Wait until recovery transfers state and the workers are held; the
#      recovery channel's IMR queue holds transactions. A global STOP
#      REPLICA leaves the recovery channel ON with its queue.
#   7. Release the hold; server2 becomes ONLINE.
#   8. Incremental recovery: one donor connection, no retry, no
#      recovery-channel error. Recovery ends through the UNTIL
#      SQL_AFTER_GTIDS stop that GR requests on the recovery channel.
#   9. group_replication_applier stores ON but does not use IMR.
#  10. The data matches.
#  11. server1's recovery channel is unchanged and has no IMR queue.
#  12. Stop and start Group Replication on server2 and hold its recovery with
#      LOCK TABLE t1 READ.
#  13. A global RESET REPLICA ALL fails and leaves the IMR recovery channel's
#      row, ON state and relay-log index.
#  14. Kill server2 during IMR recovery and restart it with
#      skip-replica-start=FALSE: the recovery channel row exists and is OFF.
#      server2 rejoins.
#  15. Restore server2's recovery channel and clean up.
################################################################################
--source include/have_group_replication_plugin.inc
--source include/have_binlog_format_row.inc
# Step 14 restarts server2 with extra options.
--source include/force_restart.inc

--let $rpl_skip_group_replication_start= 1
--let $group_replication_group_name= 8a94f357-aab4-11df-86ab-c80aa9429563
--source include/group_replication.inc

--echo
--echo # 1. Bootstrap the group on server1 and create t1.
--let $rpl_connection_name= server1
--source include/connection.inc
--source include/start_and_bootstrap_group_replication.inc
CREATE TABLE t1 (c1 INT PRIMARY KEY);
--let $server1_recovery_query= SELECT CONCAT_WS(',', APPLIER_VERSION, IN_MEMORY_RELAYLOG_ENABLED) FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = 'group_replication_recovery'
--let $server1_recovery_before= `$server1_recovery_query`

--echo
--echo # 2. Recreate server2's recovery channel and switch it to CSA.
--let $rpl_connection_name= server2
--source include/connection.inc
--disable_query_log
--disable_warnings
--let $saved_av= `SELECT APPLIER_VERSION FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = 'group_replication_recovery'`
--let $saved_imr= `SELECT IN_MEMORY_RELAYLOG_ENABLED FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = 'group_replication_recovery'`
--let $saved_pcu= `SELECT IFNULL(PRIVILEGE_CHECKS_USER, 'NULL') FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = 'group_replication_recovery'`
RESET REPLICA ALL FOR CHANNEL 'group_replication_recovery';
CHANGE REPLICATION SOURCE TO SOURCE_USER = 'root' FOR CHANNEL 'group_replication_recovery';
if (`SELECT "$saved_pcu" != "NULL"`)
{
  --eval CHANGE REPLICATION SOURCE TO PRIVILEGE_CHECKS_USER = $saved_pcu FOR CHANNEL 'group_replication_recovery'
}
--enable_warnings
--enable_query_log
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 2 FOR CHANNEL 'group_replication_recovery';

--echo
--echo # 3. The recovery channel is on CSA with IMR ON by default.
--let $av= query_get_value(SELECT APPLIER_VERSION FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = 'group_replication_recovery', APPLIER_VERSION, 1)
--let $imr_ps= query_get_value(SELECT IN_MEMORY_RELAYLOG_ENABLED FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = 'group_replication_recovery', IN_MEMORY_RELAYLOG_ENABLED, 1)
--let $imr= query_get_value(SELECT In_memory_relaylog AS v FROM mysql.slave_relay_log_info WHERE Channel_name = 'group_replication_recovery', v, 1)
--let $assert_text= Recovery channel uses CSA with IMR ON by default
--let $assert_cond= $av = 2 AND "$imr_ps" = "YES" AND $imr = 1
--source include/assert.inc

--echo
--echo # 4. Commit transactions server2 must recover.
--let $rpl_connection_name= server1
--source include/connection.inc
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);
INSERT INTO t1 VALUES (4);
INSERT INTO t1 VALUES (5);

--echo
--echo # 5. Hold server2's applier with a global read lock and start server2.
--let $rpl_connection_name= server2
--source include/connection.inc
--let $err_ts= `SELECT MAX(LOGGED) FROM performance_schema.error_log`

--let $rpl_connection_name= server_2
--source include/connection.inc
SET GLOBAL super_read_only = 1;
FLUSH TABLES WITH READ LOCK;

--let $rpl_connection_name= server2
--source include/connection.inc
--let $group_replication_start_member_state= RECOVERING
--source include/start_group_replication.inc

--echo
--echo # 6. Wait until recovery transfers state and the workers are held.
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.events_stages_current WHERE EVENT_NAME LIKE 'stage/group_rpl/Group Replication Recovery: Transferring state from donor'
--source include/wait_condition.inc
--let $wait_condition= SELECT COUNT(*) >= 1 FROM information_schema.processlist WHERE USER = 'system user' AND STATE = 'Waiting for global read lock'
--source include/wait_condition.inc
--let $qlen= query_get_value(SHOW REPLICA STATUS FOR CHANNEL 'group_replication_recovery', In_Memory_Queue_Length, 1)
--let $assert_text= Recovery channel queue holds transactions while held
--let $assert_cond= $qlen >= 1
--source include/assert.inc

# A global STOP REPLICA stops only the default channel (note 3084).
STOP REPLICA;
--let $rec_state= SELECT CONCAT_WS(',', c.APPLIER_VERSION, c.IN_MEMORY_RELAYLOG_ENABLED, s.SERVICE_STATE) FROM performance_schema.replication_applier_configuration c JOIN performance_schema.replication_connection_status s USING (CHANNEL_NAME) WHERE CHANNEL_NAME = 'group_replication_recovery'
--let $rec_after= `$rec_state`
--let $qlen= query_get_value(SHOW REPLICA STATUS FOR CHANNEL 'group_replication_recovery', In_Memory_Queue_Length, 1)
--let $assert_text= Global STOP REPLICA leaves the IMR recovery channel ON with its queue
--let $assert_cond= "$rec_after" = "2,YES,ON" AND $qlen >= 1
--source include/assert.inc

--echo
--echo # 7. Release the hold; server2 becomes ONLINE.
--let $rpl_connection_name= server_2
--source include/connection.inc
UNLOCK TABLES;

--let $rpl_connection_name= server2
--source include/connection.inc
--let $wait_timeout= 120
--let $group_replication_member_state= ONLINE
--source include/gr_wait_for_member_state.inc

--echo
--echo # 8. Incremental recovery with one donor connection and no error.
--let $cnt= `SELECT COUNT(*) FROM performance_schema.error_log WHERE LOGGED > '$err_ts' AND DATA LIKE '%Establishing group recovery connection with a possible donor%'`
--let $assert_text= One donor connection during recovery
--let $assert_cond= $cnt = 1
--source include/assert.inc

--let $cnt= `SELECT COUNT(*) FROM performance_schema.error_log WHERE LOGGED > '$err_ts' AND DATA LIKE '%Retrying group recovery connection with another donor%'`
--let $assert_text= No reconnect to another donor
--let $assert_cond= $cnt = 0
--source include/assert.inc

--let $cnt= `SELECT COUNT(*) FROM performance_schema.error_log WHERE LOGGED > '$err_ts' AND PRIO = 'Error' AND DATA LIKE '%group_replication_recovery%'`
--let $assert_text= No recovery-channel error
--let $assert_cond= $cnt = 0
--source include/assert.inc

# GR starts the recovery channel with UNTIL SQL_AFTER_GTIDS.
--let $cnt= `SELECT COUNT(*) FROM performance_schema.error_log WHERE LOGGED > '$err_ts' AND DATA LIKE '%The group replication recovery is complete, joiner gtid executed set has all the transactions of the donor%'`
--let $assert_text= Recovery ended through the requested UNTIL stop
--let $assert_cond= $cnt = 1
--source include/assert.inc

--let $cnt= `SELECT COUNT(*) FROM performance_schema.error_log WHERE LOGGED > '$err_ts' AND DATA LIKE '%recovery is skipped as the joiner%'`
--let $assert_text= Recovery did not end through a retry
--let $assert_cond= $cnt = 0
--source include/assert.inc

--let $cnt= `SELECT COUNT(*) FROM performance_schema.error_log WHERE LOGGED > '$err_ts' AND DATA LIKE '%Replica SQL thread stopped because it reached UNTIL SQL_AFTER_GTIDS%'`
--let $assert_text= One SQL_AFTER_GTIDS stop message
--let $assert_cond= $cnt = 1
--source include/assert.inc

--echo
--echo # 9. group_replication_applier stores ON but does not use IMR.
--let $imr= query_get_value(SELECT In_memory_relaylog AS v FROM mysql.slave_relay_log_info WHERE Channel_name = 'group_replication_applier', v, 1)
--let $imr_ps= query_get_value(SELECT IN_MEMORY_RELAYLOG_ENABLED FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = 'group_replication_applier', IN_MEMORY_RELAYLOG_ENABLED, 1)
--let $assert_text= Applier channel stores ON and shows NO
--let $assert_cond= $imr = 1 AND "$imr_ps" = "NO"
--source include/assert.inc

--echo
--echo # 10. The data matches.
--let $diff_tables= server1:t1, server2:t1
--source include/diff_tables.inc

--echo
--echo # 11. server1's recovery channel is unchanged and has no IMR queue.
--let $rpl_connection_name= server1
--source include/connection.inc
--let $server1_recovery_after= `$server1_recovery_query`
# server1 bootstrapped, so its recovery channel never ran and has no host;
# SHOW REPLICA STATUS then lists no row for it (no IMR queue).
--let $qlen= query_get_value(SHOW REPLICA STATUS FOR CHANNEL 'group_replication_recovery', In_Memory_Queue_Length, 1)
--let $assert_text= server1's recovery channel is unchanged
--let $assert_cond= "$server1_recovery_after" = "$server1_recovery_before" AND "$qlen" = "No such row"
--source include/assert.inc

--echo
--echo # 12. Hold a second recovery of server2 with LOCK TABLE t1 READ.
# FTWRL would block RESET REPLICA ALL, which resets the default channel first.
--let $rpl_connection_name= server2
--source include/connection.inc
--let $member2_uuid= `SELECT @@GLOBAL.server_uuid`
--source include/stop_group_replication.inc

--let $rpl_connection_name= server1
--source include/connection.inc
INSERT INTO t1 VALUES (6);
INSERT INTO t1 VALUES (7);

--let $rpl_connection_name= server_2
--source include/connection.inc
LOCK TABLE t1 READ;

--let $rpl_connection_name= server2
--source include/connection.inc
--let $group_replication_start_member_state= RECOVERING
--source include/start_group_replication.inc
--let $wait_condition= SELECT COUNT(*) >= 1 FROM information_schema.processlist WHERE USER = 'system user' AND STATE = 'Waiting for table metadata lock'
--source include/wait_condition.inc

--echo
--echo # 13. A failed global RESET REPLICA ALL leaves the IMR recovery channel.
--let $rec_index= `SELECT CONCAT(@@GLOBAL.relay_log_basename, '-group_replication_recovery.index')`
--file_exists $rec_index
--let $rec_before= `$rec_state`
--let $assert_text= Recovery channel is ON on CSA with IMR before the RESET
--let $assert_cond= "$rec_before" = "2,YES,ON"
--source include/assert.inc
--error ER_REPLICA_CHANNEL_OPERATION_NOT_ALLOWED
RESET REPLICA ALL;
--let $rec_after= `$rec_state`
--let $rows= `SELECT COUNT(*) FROM mysql.slave_relay_log_info WHERE Channel_name = 'group_replication_recovery'`
--let $assert_text= Failed RESET REPLICA ALL keeps the IMR recovery channel row and ON state
--let $assert_cond= "$rec_after" = "2,YES,ON" AND $rows = 1
--source include/assert.inc
--file_exists $rec_index

--echo
--echo # 14. Kill server2 during IMR recovery; restart with skip-replica-start=FALSE.
--let $gr_local_address= `SELECT @@GLOBAL.group_replication_local_address`
--let $gr_group_seeds= `SELECT @@GLOBAL.group_replication_group_seeds`
--let $gr_comm_stack= `SELECT @@GLOBAL.group_replication_communication_stack`
--let $restart_parameters= restart:--group_replication_local_address=$gr_local_address --group_replication_group_seeds=$gr_group_seeds --group_replication_communication_stack=$gr_comm_stack --skip-replica-start=FALSE
--replace_result $gr_local_address GROUP_REPLICATION_LOCAL_ADDRESS $gr_group_seeds GROUP_REPLICATION_GROUP_SEEDS $gr_comm_stack GROUP_REPLICATION_COMMUNICATION_STACK
--source include/kill_and_restart_mysqld.inc
--let $rpl_server_number= 2
--source include/rpl/reconnect.inc

# server1 alone has no majority; force it to a one-member group.
--let $rpl_connection_name= server1
--source include/connection.inc
--let $group_replication_member_state= UNREACHABLE
--let $group_replication_member_id= $member2_uuid
--source include/gr_wait_for_member_state.inc
--let $group_replication_member_id=
--let $gr_local_address1= `SELECT @@GLOBAL.group_replication_local_address`
--disable_query_log
--eval SET GLOBAL group_replication_force_members= "$gr_local_address1"
--enable_query_log
--let $group_replication_number_of_members= 1
--source include/gr_wait_for_number_of_members.inc
SET GLOBAL group_replication_force_members= "";

# Replica start at boot skips GR channels: the recovery channel stays OFF.
--let $rpl_connection_name= server2
--source include/connection.inc
--let $rec_after= `$rec_state`
--let $rows= `SELECT COUNT(*) FROM mysql.slave_relay_log_info WHERE Channel_name = 'group_replication_recovery'`
--let $assert_text= After the restart the IMR recovery channel row exists and is OFF
--let $assert_cond= @@GLOBAL.skip_replica_start = 0 AND "$rec_after" = "2,YES,OFF" AND $rows = 1
--source include/assert.inc

# Rejoin through the IMR recovery channel.
--source include/start_group_replication.inc

--echo
--echo # 15. Restore server2's recovery channel and clean up.
--let $rpl_connection_name= server2
--source include/connection.inc
--source include/stop_group_replication.inc
--disable_query_log
--disable_warnings
--let $restore_imr=
if (`SELECT "$saved_imr" = "NO"`)
{
  --let $restore_imr= , IN_MEMORY_RELAYLOG_ENABLED = OFF
}
RESET REPLICA ALL FOR CHANNEL 'group_replication_recovery';
--eval CHANGE REPLICATION SOURCE TO SOURCE_USER = 'root', APPLIER_VERSION = $saved_av$restore_imr FOR CHANNEL 'group_replication_recovery'
if (`SELECT "$saved_pcu" != "NULL"`)
{
  --eval CHANGE REPLICATION SOURCE TO PRIVILEGE_CHECKS_USER = $saved_pcu FOR CHANNEL 'group_replication_recovery'
}
--enable_warnings
--enable_query_log
--source include/start_group_replication.inc

--let $rpl_connection_name= server1
--source include/connection.inc
DROP TABLE t1;
--source include/rpl/sync.inc

--source include/group_replication_end.inc
