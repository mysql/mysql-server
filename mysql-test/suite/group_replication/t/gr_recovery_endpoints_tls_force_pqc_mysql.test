###############################################################################
# Verify MySQL incremental recovery works with force_pqc/admin_force_pqc on the
# donor and group_replication_force_pqc on the joiner over both advertised admin and main recovery ports.
###############################################################################
--source include/no_valgrind_without_big.inc
--source include/have_tlsv13.inc

--let $openssl_binary_version=OpenSSL (3\.[5-9]|3\.[1-9][0-9]|[4-9][0-9]*)\.
--source include/have_openssl_binary_version.inc

--source include/have_group_replication_plugin_base.inc
--source include/have_group_replication_mysql_communication_stack.inc
--source include/have_group_replication_plugin.inc
--let $rpl_skip_group_replication_start= 1
--source include/group_replication.inc

--let $rpl_connection_name= server1
--source include/connection.inc

SET SESSION sql_log_bin=0;
CALL mtr.add_suppression("Failed to initialize TLS for channel: mysql_admin");
CALL mtr.add_suppression("Failed to set up SSL because of the following SSL library error");
SET SESSION sql_log_bin=1;

SET SESSION sql_log_bin=0;
CREATE USER 'rec_pqc_user'@'%' REQUIRE SSL;
GRANT REPLICATION SLAVE ON *.* TO 'rec_pqc_user'@'%';
GRANT GROUP_REPLICATION_STREAM ON *.* TO 'rec_pqc_user'@'%';
GRANT SERVICE_CONNECTION_ADMIN ON *.* TO 'rec_pqc_user'@'%';
FLUSH PRIVILEGES;
SET SESSION sql_log_bin=1;

--let $server1_gr_ssl_mode_saved= `SELECT @@GLOBAL.group_replication_ssl_mode`
--let $_default_report_port= `SELECT @@GLOBAL.report_port`
--let $_group_replication_local_address= `SELECT @@GLOBAL.group_replication_local_address`
--let $_group_replication_group_seeds= `SELECT @@GLOBAL.group_replication_group_seeds`
--let $_admin_port= `SELECT @@GLOBAL.admin_port`
--let $allow_rpl_inited= 1
--let $restart_parameters=restart: --group_replication_local_address=$_group_replication_local_address --group_replication_group_seeds=$_group_replication_group_seeds --tls-version=TLSv1.3 --force_pqc=ON --admin_force_pqc=ON --admin-ssl-ca=$MYSQL_TEST_DIR/std_data/cacert.pem --admin-ssl-cert=$MYSQL_TEST_DIR/std_data/server-cert.pem --admin-ssl-key=$MYSQL_TEST_DIR/std_data/server-key.pem --admin-tls-version=TLSv1.3
--replace_result $_group_replication_local_address GROUP_REPLICATION_LOCAL_ADDRESS $_group_replication_group_seeds GROUP_REPLICATION_GROUP_SEEDS $_admin_port ADMIN_PORT $MYSQL_TEST_DIR MYSQL_TEST_DIR
--source include/restart_mysqld.inc

--let $rpl_server_number= 1
--source include/rpl/reconnect.inc

SET GLOBAL group_replication_ssl_mode= REQUIRED;

--let $server1_port= `SELECT @@GLOBAL.PORT`
--let $server1_admin_port= `SELECT @@GLOBAL.ADMIN_PORT`

SET @@GLOBAL.group_replication_advertise_recovery_endpoints =
  CONCAT('127.0.0.1:', @@GLOBAL.ADMIN_PORT);

CREATE TABLE test.t1 (c1 INT NOT NULL PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO test.t1 VALUES (1), (2);

--source include/start_and_bootstrap_group_replication.inc

--let $rpl_connection_name= server2
--source include/connection.inc

SET SESSION sql_log_bin=0;
CREATE USER 'rec_pqc_user'@'%' REQUIRE SSL;
GRANT REPLICATION SLAVE ON *.* TO 'rec_pqc_user'@'%';
GRANT GROUP_REPLICATION_STREAM ON *.* TO 'rec_pqc_user'@'%';
GRANT SERVICE_CONNECTION_ADMIN ON *.* TO 'rec_pqc_user'@'%';
FLUSH PRIVILEGES;
SET SESSION sql_log_bin=1;

SET @tls_version_saved= @@GLOBAL.tls_version;
SET @gr_ssl_mode_saved= @@GLOBAL.group_replication_ssl_mode;
SET @gr_recovery_use_ssl_saved= @@GLOBAL.group_replication_recovery_use_ssl;
SET @gr_recovery_tls_version_saved= @@GLOBAL.group_replication_recovery_tls_version;
SET @group_replication_force_pqc_saved= @@GLOBAL.group_replication_force_pqc;
SET @group_replication_tls_kex_saved= @@GLOBAL.group_replication_tls_kex;
SET @group_replication_use_pqc_sign_saved= @@GLOBAL.group_replication_use_pqc_sign;
SET GLOBAL tls_version='TLSv1.3';
SET GLOBAL group_replication_ssl_mode= REQUIRED;
SET GLOBAL group_replication_recovery_use_ssl= 1;
SET GLOBAL group_replication_recovery_tls_version= 'TLSv1.3';
SET GLOBAL group_replication_force_pqc= ON;

--echo Runtime validation rejects non-PQC group_replication_tls_kex when group_replication_force_pqc=ON
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL group_replication_tls_kex = 'X25519';

--echo Runtime validation rejects invalid group_replication_use_pqc_sign
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL group_replication_use_pqc_sign = 'not_a_bool';

SET GLOBAL group_replication_tls_kex = 'X25519MLKEM768';
SET GLOBAL group_replication_use_pqc_sign = ON;
SELECT @@GLOBAL.group_replication_tls_kex = 'X25519MLKEM768' AS group_replication_tls_kex_configured,
       @@GLOBAL.group_replication_use_pqc_sign AS group_replication_use_pqc_sign_enabled;
ALTER INSTANCE RELOAD TLS;

CHANGE REPLICATION SOURCE TO SOURCE_USER='rec_pqc_user'
  FOR CHANNEL 'group_replication_recovery';

--source include/start_group_replication.inc

--let $assert_text= Joiner recovered through the donor admin port with PQC enforced
--let $assert_cond= [SELECT COUNT(*) FROM test.t1] = 2
--source include/assert.inc

--let $assert_only_after = CURRENT_TEST: group_replication.gr_recovery_endpoints_tls_force_pqc_mysql
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_count = 1
--let $assert_select = 'Establishing connection to a group replication recovery donor .* at 127.0.0.1 port: $server1_admin_port.'
--let $assert_text = incremental recovery used the advertised admin endpoint
--source include/assert_grep.inc

--echo Runtime MySQL communication stack negotiated a PQC key exchange

--let $rpl_connection_name= server1
--source include/connection.inc
--let $server1_mysql_stack_uses_pqc= `SELECT COUNT(*) >= 1 FROM performance_schema.status_by_thread AS sbt JOIN performance_schema.threads AS t ON t.THREAD_ID=sbt.THREAD_ID WHERE sbt.VARIABLE_NAME='Tls_key_exchange_algorithm' AND sbt.VARIABLE_VALUE LIKE '%MLKEM%' AND t.PROCESSLIST_STATE='Connection delegated to Group Replication'`

--let $rpl_connection_name= server2
--source include/connection.inc
--let $server2_mysql_stack_uses_pqc= `SELECT COUNT(*) >= 1 FROM performance_schema.status_by_thread AS sbt JOIN performance_schema.threads AS t ON t.THREAD_ID=sbt.THREAD_ID WHERE sbt.VARIABLE_NAME='Tls_key_exchange_algorithm' AND sbt.VARIABLE_VALUE LIKE '%MLKEM%' AND t.PROCESSLIST_STATE='Connection delegated to Group Replication'`

--disable_query_log
--eval SET @mysql_stack_uses_pqc= $server1_mysql_stack_uses_pqc OR $server2_mysql_stack_uses_pqc
--enable_query_log
SELECT @mysql_stack_uses_pqc AS mysql_stack_uses_pqc;

STOP GROUP_REPLICATION;

--let $group_replication_member_state=OFFLINE
--source include/gr_wait_for_member_state.inc

--let $rpl_connection_name= server1
--source include/connection.inc

INSERT INTO test.t1 VALUES (3);

SET @@GLOBAL.group_replication_advertise_recovery_endpoints =
  CONCAT('127.0.0.1:', @@GLOBAL.PORT);

--let $rpl_connection_name= server2
--source include/connection.inc

--source include/start_group_replication.inc

--let $assert_text= Joiner recovered through the donor main port with PQC enforced
--let $assert_cond= [SELECT COUNT(*) FROM test.t1] = 3
--source include/assert.inc

--let $assert_only_after = CURRENT_TEST: group_replication.gr_recovery_endpoints_tls_force_pqc_mysql
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_count = 1
--let $assert_select = 'Establishing connection to a group replication recovery donor .* at 127.0.0.1 port: $server1_port.'
--let $assert_text = incremental recovery used the advertised main endpoint
--source include/assert_grep.inc

STOP GROUP_REPLICATION;

--let $group_replication_member_state=OFFLINE
--source include/gr_wait_for_member_state.inc

--disable_query_log
SET @@GLOBAL.group_replication_recovery_use_ssl= @gr_recovery_use_ssl_saved;
SET @@GLOBAL.group_replication_recovery_tls_version= @gr_recovery_tls_version_saved;
SET @@GLOBAL.group_replication_force_pqc= @group_replication_force_pqc_saved;
SET @@GLOBAL.group_replication_tls_kex= @group_replication_tls_kex_saved;
SET @@GLOBAL.group_replication_use_pqc_sign= @group_replication_use_pqc_sign_saved;
SET @@GLOBAL.group_replication_ssl_mode= @gr_ssl_mode_saved;
SET @@GLOBAL.tls_version= @tls_version_saved;
ALTER INSTANCE RELOAD TLS;
SET GLOBAL super_read_only= OFF;
SET SESSION sql_log_bin=0;
DROP USER 'rec_pqc_user'@'%';
SET SESSION sql_log_bin=1;
DROP TABLE test.t1;
--enable_query_log

--let $rpl_connection_name= server1
--source include/connection.inc

SET @@GLOBAL.group_replication_advertise_recovery_endpoints= DEFAULT;
--eval SET @@GLOBAL.group_replication_ssl_mode= $server1_gr_ssl_mode_saved
--let $allow_rpl_inited= 1
--let $_group_replication_local_address= `SELECT @@GLOBAL.group_replication_local_address`
--let $_group_replication_group_seeds= `SELECT @@GLOBAL.group_replication_group_seeds`
--let $restart_parameters=restart: --group_replication_local_address=$_group_replication_local_address --group_replication_group_seeds=$_group_replication_group_seeds --report_port=$_default_report_port
--replace_result $_group_replication_local_address GROUP_REPLICATION_LOCAL_ADDRESS $_group_replication_group_seeds GROUP_REPLICATION_GROUP_SEEDS $_default_report_port ADMIN_PORT
--source include/restart_mysqld.inc

--let $rpl_server_number= 1
--source include/rpl/reconnect.inc

SET SESSION sql_log_bin=0;
DROP USER 'rec_pqc_user'@'%';
SET SESSION sql_log_bin=1;

DROP TABLE test.t1;

--let $rpl_skip_sync= 1
--source include/group_replication_end.inc
