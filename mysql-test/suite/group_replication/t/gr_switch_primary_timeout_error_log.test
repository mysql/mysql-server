################################################################################
# This test validates that the primary switchover transaction monitor logs, at
# INFORMATION_LEVEL, that it is blocking new transactions until the switchover
# finishes, and that it logs when the running_transactions_timeout expires and
# the connections of the transactions that did not reach commit are closed.
#
# @note The transaction monitor thread only runs on the member that is the
#       primary when the election starts, so each part of the test greps the
#       error log of that member.
# @note UDF group_replication_set_as_primary() only returns after the
#       transaction monitor thread has terminated, hence both notes are
#       already in the error log when the UDF returns.
#
# Test:
# 0. The test requires two servers: M1 and M2.
# 1. Start group in single primary mode.
#    Server1 will be primary and server2 secondary.
# 2. Execute "START TRANSACTION" on server1 (primary), so that the election
#    is blocked until running_transactions_timeout is reached.
# 3. Change the primary to server2, with running_transactions_timeout 5.
# 4. Server1 did log that new transactions were blocked and that the
#    running_transactions_timeout was reached.
# 5. The connection that was blocking the election on server1 was closed.
# 6. Change the primary back to server1, with
#    running_transactions_timeout 600, with no transaction blocking the
#    election. The timeout is large so that a slow election does not reach
#    it; the monitor is terminated as soon as the election completes.
# 7. Server2 did log that new transactions were blocked, but did not log that
#    the running_transactions_timeout was reached.
# 8. Cleanup.
################################################################################
--source include/have_group_replication_plugin.inc
--let $rpl_skip_group_replication_start= 1
--let $rpl_group_replication_single_primary_mode=1
--source include/group_replication.inc

--echo
--echo # 1. Start group in single primary mode.
--echo #    Server1 will be primary and server2 secondary.

--let $rpl_connection_name= server1
--source include/connection.inc

--let $server1_uuid= query_get_value(SELECT @@SERVER_UUID, @@SERVER_UUID, 1)
--source include/start_and_bootstrap_group_replication.inc

--let $rpl_connection_name= server2
--source include/connection.inc

--let $server2_uuid= query_get_value(SELECT @@SERVER_UUID, @@SERVER_UUID, 1)
--source include/start_group_replication.inc

--echo
--echo # 2. Execute "START TRANSACTION" on server1 (primary), so that the
--echo #    election is blocked until running_transactions_timeout is reached.

--let $rpl_connection_name= server1
--source include/connection.inc

START TRANSACTION;

--echo
--echo # 3. Change the primary to server2, with running_transactions_timeout 5.

--let $rpl_connection_name= server2
--source include/connection.inc

--replace_result $server2_uuid MEMBER2_UUID
--eval SELECT group_replication_set_as_primary("$server2_uuid", 5)

--source include/gr_assert_primary_member.inc

--echo
--echo # 4. Server1 did log that new transactions were blocked and that the
--echo #    running_transactions_timeout was reached.

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.1.err

--let $assert_text= Server1 logged that the transaction monitor is blocking new transactions
--let $assert_select= Primary switchover: blocking new transactions until the switchover finishes. Running transactions have up to 5 seconds to complete
--let $assert_count= 1
--source include/assert_grep.inc

--let $assert_text= Server1 logged that the running_transactions_timeout was reached
--let $assert_select= Primary switchover: the configured timeout of 5 seconds has expired
--let $assert_count= 1
--source include/assert_grep.inc

--echo
--echo # 5. The connection that was blocking the election on server1 was closed.

--let $rpl_connection_name= server1
--source include/connection.inc

--error CR_SERVER_LOST, CR_SERVER_GONE_ERROR
SELECT 1;
--source include/wait_until_connected_again.inc

--echo
--echo # 6. Change the primary back to server1, with
--echo #    running_transactions_timeout 600, with no transaction blocking the
--echo #    election.

--let $rpl_connection_name= server2
--source include/connection.inc

--replace_result $server1_uuid MEMBER1_UUID
--eval SELECT group_replication_set_as_primary("$server1_uuid", 600)

--let $rpl_connection_name= server1
--source include/connection.inc

--source include/gr_assert_primary_member.inc

--echo
--echo # 7. Server2 did log that new transactions were blocked, but did not log
--echo #    that the running_transactions_timeout was reached.

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err

--let $assert_text= Server2 logged that the transaction monitor is blocking new transactions
--let $assert_select= Primary switchover: blocking new transactions until the switchover finishes. Running transactions have up to 600 seconds to complete
--let $assert_count= 1
--source include/assert_grep.inc

--let $assert_text= Server2 did not log that the running_transactions_timeout was reached
--let $assert_select= Primary switchover: the configured timeout of
--let $assert_count= 0
--source include/assert_grep.inc

--echo
--echo # 8. Cleanup.

--source include/group_replication_end.inc
