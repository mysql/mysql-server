# BOLT stands for Binary-log Optimization for Large Transactions.
#
# === Purpose ===
# A view change gets a newer binlog group commit ticket than every
# transaction certified before it, and must be written into the binary log
# after all of them. A transaction committed through the BOLT path is paused
# after it has waited for its ticket's turn but before it takes LOCK_log; a
# member joins meanwhile. The view change must wait for the BOLT transaction,
# instead of being written into the binary log before it.
#
# === Requirements ===
# R1. While the BOLT transaction is paused, the view change is not written.
# R2. The BOLT transaction is promoted, and the view change is not written
#     into the binary log file that was active before it.
# R3. The joining member comes ONLINE and has the transaction.
#
--source include/big_test.inc
--source include/have_debug_sync.inc
--source include/have_group_replication_plugin.inc
--source include/have_binlog_format_row.inc
--source include/not_binlog_transaction_compression_on.inc
--let $rpl_skip_group_replication_start= 1
--let $rpl_server_count= 2
--source include/group_replication.inc

--let $rpl_connection_name= server1
--source include/connection.inc
--let $sysvars_to_save = [ "GLOBAL.binlog_checksum", "GLOBAL.binlog_large_transaction_optimization_enabled", "GLOBAL.binlog_large_transaction_optimization_threshold" ]
--source include/save_sysvars.inc
SET GLOBAL binlog_checksum = CRC32;
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
# Members of this version join without a View_change event in the binary
# log; pretend to be older, so the view change is logged.
SET @@GLOBAL.DEBUG = '+d,group_replication_version_with_vcle';
--source include/start_and_bootstrap_group_replication.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;

--let $rpl_connection_name= server2
--source include/connection.inc
--source include/save_sysvars.inc
SET GLOBAL binlog_checksum = CRC32;
SET @@GLOBAL.DEBUG = '+d,group_replication_version_with_vcle';

--echo # R1: pause a BOLT commit on server1, then let server2 join.
--let $rpl_connection_name= server1
--source include/connection.inc
--let $file_before = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $vc_file = $file_before
--source ../include/gr_bolt_count_view_changes.inc
--let $vc_before = $vc_count
--let $bolt_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
--disable_query_log
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
--enable_query_log
SET DEBUG_SYNC = 'bolt_before_promotion_lock_log SIGNAL bolt_paused WAIT_FOR bolt_go';
--send COMMIT

--let $rpl_connection_name= server_1
--source include/connection.inc
SET DEBUG_SYNC = 'now WAIT_FOR bolt_paused';

--let $rpl_connection_name= server2
--source include/connection.inc
--disable_query_log
--eval SET GLOBAL group_replication_group_name = "$group_replication_group_name"
--enable_query_log
--send START GROUP_REPLICATION

--let $rpl_connection_name= server_1
--source include/connection.inc
# The view is installed in the group, so the view change event is on its way
# to server1's binary log. Give it time to be written, if it could be.
--let $wait_condition = SELECT COUNT(*) = 2 FROM performance_schema.replication_group_members
--source include/wait_condition.inc
--sleep 3
--let $vc_file = $file_before
--source ../include/gr_bolt_count_view_changes.inc
--let $assert_text = R1: the view change is not written while the BOLT transaction waits.
--let $assert_cond = $vc_count = $vc_before
--source include/assert.inc
SET DEBUG_SYNC = 'now SIGNAL bolt_go';

--let $rpl_connection_name= server1
--source include/connection.inc
--reap
SET DEBUG_SYNC = 'RESET';
--let $bolt_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
--let $assert_text = R2: the transaction is promoted.
--let $assert_cond = $bolt_after = $bolt_before + 1
--source include/assert.inc

--let $rpl_connection_name= server2
--source include/connection.inc
--reap
--let $group_replication_member_state= ONLINE
--source include/gr_wait_for_member_state.inc

--let $rpl_connection_name= server1
--source include/connection.inc
--source ../include/gr_bolt_count_view_changes.inc
--let $assert_text = R2: the view change is not in the binary log file active before the promotion.
--let $assert_cond = $vc_count = $vc_before
--source include/assert.inc
--source include/rpl/sync.inc

--echo # R3: server2 has the transaction.
--let $rpl_connection_name= server2
--source include/connection.inc
--let $assert_text = R3: server2 has every row.
--let $assert_cond = [SELECT COUNT(*) FROM t1] = 3
--source include/assert.inc

# Cleanup
--let $rpl_connection_name= server1
--source include/connection.inc
DROP TABLE t1;
--source include/rpl/sync.inc
--let $rpl_connection_name= server2
--source include/connection.inc
--source include/stop_group_replication.inc
SET @@GLOBAL.DEBUG = '-d,group_replication_version_with_vcle';
--source include/restore_sysvars.inc
--let $rpl_connection_name= server1
--source include/connection.inc
--source include/stop_group_replication.inc
SET @@GLOBAL.DEBUG = '-d,group_replication_version_with_vcle';
--source include/restore_sysvars.inc
--source include/group_replication_end.inc
