# BOLT stands for Binary-log Optimization for Large Transactions.
#
# Verify that Group Replication can serialize a local transaction whose THD
# binlog cache has been converted to BOLT's promotable checksummed
# representation. GR consumes Binlog_cache_storage through copy_to(), so it
# must see the logical checksumless event stream even when the cache's physical
# spill file is already promotable.

--source include/have_group_replication_plugin.inc
--source include/have_binlog_format_row.inc
--source include/not_binlog_transaction_compression_on.inc

--let $group_replication_group_name= 8a94f357-aab4-11df-86ab-c80aa9429563
--let $save_checksum = query_get_value(SELECT @@GLOBAL.binlog_checksum, @@GLOBAL.binlog_checksum, 1)
--let $save_enabled = query_get_value(SELECT @@GLOBAL.binlog_large_transaction_optimization_enabled, @@GLOBAL.binlog_large_transaction_optimization_enabled, 1)
--let $save_threshold = query_get_value(SELECT @@GLOBAL.binlog_large_transaction_optimization_threshold, @@GLOBAL.binlog_large_transaction_optimization_threshold, 1)
--let $save_max_binlog_size = query_get_value(SELECT @@GLOBAL.max_binlog_size, @@GLOBAL.max_binlog_size, 1)
--let $save_compression = query_get_value(SELECT @@SESSION.binlog_transaction_compression, @@SESSION.binlog_transaction_compression, 1)

--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS t1;
--enable_warnings
SET GLOBAL binlog_checksum = CRC32;
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
SET GLOBAL max_binlog_size = 1073741824;
SET SESSION binlog_transaction_compression = OFF;
--enable_query_log

--source include/start_and_bootstrap_group_replication.inc

--disable_query_log
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
--enable_query_log
--let $bolt_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)

--disable_query_log
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
COMMIT;
--enable_query_log

--let $bolt_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
--let $assert_text = Group Replication accepts a large BOLT transaction with checksummed binlog enabled.
--let $assert_cond = [SELECT COUNT(*) AS count FROM t1, count, 1] = 3
--source include/assert.inc
--let $assert_text = Group Replication preserves the large transaction payload.
--let $assert_cond = [SELECT SUM(OCTET_LENGTH(data)) AS payload FROM t1, payload, 1] = 12000000
--source include/assert.inc
--let $assert_text = BOLT promotes the large Group Replication transaction after observer serialization.
--let $assert_cond = $bolt_after = $bolt_before + 1
--source include/assert.inc

--disable_query_log
DROP TABLE t1;
--enable_query_log
--source include/stop_group_replication.inc
RESET REPLICA ALL FOR CHANNEL "group_replication_applier";
--source include/gr_clear_configuration.inc

--disable_query_log
--eval SET GLOBAL binlog_checksum = $save_checksum
--eval SET GLOBAL binlog_large_transaction_optimization_enabled = $save_enabled
--eval SET GLOBAL binlog_large_transaction_optimization_threshold = $save_threshold
--eval SET GLOBAL max_binlog_size = $save_max_binlog_size
--eval SET SESSION binlog_transaction_compression = $save_compression
--enable_query_log
