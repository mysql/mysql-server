SET @start_global_value = @@global.innodb_autoinc_preallocate;
SELECT @start_global_value;


--echo Valid values are zero or above
select @@global.innodb_autoinc_preallocate >=0;
#
# exists as global only
#
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
select @@session.innodb_autoinc_preallocate;
show global variables like 'innodb_autoinc_preallocate';
show session variables like 'innodb_autoinc_preallocate';
--disable_warnings
select * from performance_schema.global_variables where variable_name='innodb_autoinc_preallocate';
select * from performance_schema.session_variables where variable_name='innodb_autoinc_preallocate';
--enable_warnings

#
# show that it's writable
#
set global innodb_autoinc_preallocate=10;
select @@global.innodb_autoinc_preallocate;
--disable_warnings
select * from performance_schema.global_variables where variable_name='innodb_autoinc_preallocate';
select * from performance_schema.session_variables where variable_name='innodb_autoinc_preallocate';
--enable_warnings
--error ER_GLOBAL_VARIABLE
set session innodb_autoinc_preallocate=1;

#
# check the default value
#
set global innodb_autoinc_preallocate=DEFAULT;
select @@global.innodb_autoinc_preallocate;

#
# valid values
#
set global innodb_autoinc_preallocate=0;
select @@global.innodb_autoinc_preallocate;
set global innodb_autoinc_preallocate=1;
select @@global.innodb_autoinc_preallocate;
set global innodb_autoinc_preallocate=1000000000;
select @@global.innodb_autoinc_preallocate;
#
# incorrect types
#
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_autoinc_preallocate=18446744073709551616;
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_autoinc_preallocate=1.1;
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_autoinc_preallocate=1e1;
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_autoinc_preallocate="foo";
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_autoinc_preallocate=' ';
select @@global.innodb_autoinc_preallocate;
--error ER_WRONG_TYPE_FOR_VAR
set global innodb_autoinc_preallocate=" ";
select @@global.innodb_autoinc_preallocate;
set global innodb_autoinc_preallocate=-7;
select @@global.innodb_autoinc_preallocate;
set global innodb_autoinc_preallocate=-1024;
select @@global.innodb_autoinc_preallocate;
--disable_warnings
select * from performance_schema.global_variables where variable_name='innodb_autoinc_preallocate';
--enable_warnings

#
# Check for out of bounds
#

# With a 64 bit mysqld:18446744073709551615,with a 32 bit mysqld: 4294967295
--disable_warnings
SET @@global.innodb_autoinc_preallocate = 4294967296;
--enable_warnings
SELECT @@global.innodb_autoinc_preallocate IN (4294967296,4294967295);

--disable_warnings
SET @@global.innodb_autoinc_preallocate = 12345678901;
--enable_warnings
SELECT @@global.innodb_autoinc_preallocate IN (12345678901,4294967295);

--disable_warnings
SET @@global.innodb_autoinc_preallocate = 18446744073709551615;
--enable_warnings
SELECT @@global.innodb_autoinc_preallocate IN (18446744073709551615,4294967295);

#
# cleanup
#
SET @@global.innodb_autoinc_preallocate = @start_global_value;
SELECT @@global.innodb_autoinc_preallocate;