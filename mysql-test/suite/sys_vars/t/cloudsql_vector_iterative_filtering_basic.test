############## mysql-test\t\cloudsql_vector_iterative_filtering_basic.test ####
#                                                                             #
# Variable Name: cloudsql_vector_iterative_filtering                          #
# Scope: GLOBAL & SESSION                                                     #
# Access Type: Dynamic                                                        #
# Data Type: boolean                                                          #
# Default Value: OFF                                                          #
# Range:                                                                      #
#                                                                             #
#                                                                             #                                                          #
#                                                                             #
# Description: Test Cases of Dynamic System Variable                          #
#              cloudsql_vector_iterative_filtering that checks the behavior   #
#              of the variable in the following ways:                         #
#              * Default Value                                                #
#              * Valid & Invalid values                                       #
#              * Scope & Access method                                        #
#              * Data Integrity                                               #
#                                                                             #
#                                                                             #
###############################################################################

--source include/load_sysvars.inc

####################################################################
#           START OF cloudsql_vector_iterative_filtering TESTS     #
####################################################################


#############################################################
#                 Save initial value                        #
#############################################################

SET @start_global_value = @@global.cloudsql_vector_iterative_filtering;
SELECT @start_global_value;
SET @start_session_value = @@session.cloudsql_vector_iterative_filtering;
SELECT @start_session_value;


--echo '#--------------------FN_DYNVARS_054_01-------------------------#'
########################################################################
#     Display the DEFAULT value of cloudsql_vector_iterative_filtering                #
########################################################################

SET @@global.cloudsql_vector_iterative_filtering = ON;
SET @@global.cloudsql_vector_iterative_filtering = DEFAULT;
SELECT @@global.cloudsql_vector_iterative_filtering;

SET @@session.cloudsql_vector_iterative_filtering = ON;
SET @@session.cloudsql_vector_iterative_filtering = DEFAULT;
SELECT @@session.cloudsql_vector_iterative_filtering;


--echo '#--------------------FN_DYNVARS_054_02-------------------------#'
########################################################################
#     Check the DEFAULT value of cloudsql_vector_iterative_filtering                  #
########################################################################

SET @@global.cloudsql_vector_iterative_filtering = DEFAULT;
SELECT @@global.cloudsql_vector_iterative_filtering = 'OFF';

SET @@session.cloudsql_vector_iterative_filtering = DEFAULT;
SELECT @@session.cloudsql_vector_iterative_filtering = 'OFF';


--echo '#--------------------FN_DYNVARS_054_03-------------------------#'
##############################################################################
# Change the value of cloudsql_vector_iterative_filtering to a valid value   #
# for GLOBAL Scope                                                           #
##############################################################################

SET @@global.cloudsql_vector_iterative_filtering = ON;
SELECT @@global.cloudsql_vector_iterative_filtering;
SET @@global.cloudsql_vector_iterative_filtering = OFF;
SELECT @@global.cloudsql_vector_iterative_filtering;
SET @@global.cloudsql_vector_iterative_filtering = 0;
SELECT @@global.cloudsql_vector_iterative_filtering;
SET @@global.cloudsql_vector_iterative_filtering = 1;
SELECT @@global.cloudsql_vector_iterative_filtering;
SET @@global.cloudsql_vector_iterative_filtering = TRUE;
SELECT @@global.cloudsql_vector_iterative_filtering;
SET @@global.cloudsql_vector_iterative_filtering = FALSE;
SELECT @@global.cloudsql_vector_iterative_filtering;



--echo '#--------------------FN_DYNVARS_054_04-------------------------#'
###############################################################################
# Change the value of cloudsql_vector_iterative_filtering to a valid value    #
# for SESSION Scope                                                           #
###############################################################################

SET @@session.cloudsql_vector_iterative_filtering = ON;
SELECT @@session.cloudsql_vector_iterative_filtering;
SET @@session.cloudsql_vector_iterative_filtering = OFF;
SELECT @@session.cloudsql_vector_iterative_filtering;
SET @@session.cloudsql_vector_iterative_filtering = 0;
SELECT @@session.cloudsql_vector_iterative_filtering;
SET @@session.cloudsql_vector_iterative_filtering = 1;
SELECT @@session.cloudsql_vector_iterative_filtering;
SET @@session.cloudsql_vector_iterative_filtering = TRUE;
SELECT @@session.cloudsql_vector_iterative_filtering;
SET @@session.cloudsql_vector_iterative_filtering = FALSE;
SELECT @@session.cloudsql_vector_iterative_filtering;


--echo '#------------------FN_DYNVARS_054_05-----------------------#'
################################################################
# Change the value of cloudsql_vector_iterative_filtering      #
# to invalid values                                            #
################################################################

--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.cloudsql_vector_iterative_filtering = 'ONN';
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.cloudsql_vector_iterative_filtering = "OFFF";
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.cloudsql_vector_iterative_filtering = TTRUE;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.cloudsql_vector_iterative_filtering = FELSE;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.cloudsql_vector_iterative_filtering = -1024;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.cloudsql_vector_iterative_filtering = 65536;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.cloudsql_vector_iterative_filtering = 65530.34;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.cloudsql_vector_iterative_filtering = test;

--Error ER_WRONG_VALUE_FOR_VAR
SET @@session.cloudsql_vector_iterative_filtering = ONN;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@session.cloudsql_vector_iterative_filtering = ONF;
--error ER_PARSE_ERROR
SET @@session.cloudsql_vector_iterative_filtering = OF;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@session.cloudsql_vector_iterative_filtering = 'OFN';
--Error ER_WRONG_VALUE_FOR_VAR
SET @@session.cloudsql_vector_iterative_filtering = -2;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@session.cloudsql_vector_iterative_filtering = 65530.34;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@session.cloudsql_vector_iterative_filtering = 65550;

--Error ER_WRONG_VALUE_FOR_VAR
SET @@session.cloudsql_vector_iterative_filtering = test;
SELECT @@session.cloudsql_vector_iterative_filtering;


--echo '#------------------FN_DYNVARS_054_06-----------------------#'
####################################################################
#   Check if the value in GLOBAL Table matches value in variable   #
####################################################################


--disable_warnings
SELECT IF(@@global.cloudsql_vector_iterative_filtering, "ON", "OFF") = VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='cloudsql_vector_iterative_filtering';
--enable_warnings

--echo '#------------------FN_DYNVARS_054_07-----------------------#'
####################################################################
#  Check if the value in SESSION Table matches value in variable   #
####################################################################

--disable_warnings
SELECT IF(@@session.cloudsql_vector_iterative_filtering, "ON", "OFF") = VARIABLE_VALUE
FROM performance_schema.session_variables
WHERE VARIABLE_NAME='cloudsql_vector_iterative_filtering';
--enable_warnings


--echo '#---------------------FN_DYNVARS_001_08----------------------#'
###############################################################################
#  Check if accessing variable with and without GLOBAL point to same variable #
###############################################################################

SET @@cloudsql_vector_iterative_filtering = OFF;
SET @@global.cloudsql_vector_iterative_filtering = ON;
SELECT @@cloudsql_vector_iterative_filtering = @@global.cloudsql_vector_iterative_filtering;


--echo '#---------------------FN_DYNVARS_001_09----------------------#'
##############################################################################
#    Check if accessing variable with SESSION,LOCAL and without SCOPE points #
#    to same session variable                                                #
##############################################################################

SET @@cloudsql_vector_iterative_filtering = ON;
SELECT @@cloudsql_vector_iterative_filtering = @@local.cloudsql_vector_iterative_filtering;
SELECT @@local.cloudsql_vector_iterative_filtering = @@session.cloudsql_vector_iterative_filtering;


--echo '#---------------------FN_DYNVARS_001_10----------------------#'
###############################################################################
#   Check if cloudsql_vector_iterative_filtering can be accessed with and     #
#   without @@ sign                                                           #
###############################################################################

SET cloudsql_vector_iterative_filtering = 1;
SELECT @@cloudsql_vector_iterative_filtering;
--Error ER_UNKNOWN_TABLE
SELECT local.cloudsql_vector_iterative_filtering;
--Error ER_UNKNOWN_TABLE
SELECT session.cloudsql_vector_iterative_filtering;
--Error ER_BAD_FIELD_ERROR
SELECT cloudsql_vector_iterative_filtering = @@session.cloudsql_vector_iterative_filtering;


####################################
#     Restore initial value        #
####################################

SET @@global.cloudsql_vector_iterative_filtering = @start_global_value;
SELECT @@global.cloudsql_vector_iterative_filtering;
SET @@session.cloudsql_vector_iterative_filtering = @start_session_value;
SELECT @@session.cloudsql_vector_iterative_filtering;


#########################################################
#    END OF cloudsql_vector_iterative_filtering TESTS   #
#########################################################
