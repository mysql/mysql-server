############## mysql-test\t\partial_subject_match_basic.test ##################
#                                                                             #
# Variable Name: partial_subject_match                                        #
# Scope: GLOBAL                                                               #
# Access Type: Dynamic                                                        #
# Data Type: boolean                                                          #
# Default Value: 0 (OFF)                                                      #
# Range: -                                                                    #
#                                                                             #
#                                                                             #
# Description: Test Cases of Dynamic System Variable partial_subject_match    #
#              that checks the behavior of this variable in the following ways#
#              * Default Value                                                #
#              * Valid & Invalid values                                       #
#              * Scope & Access method                                        #
#              * Data Integrity                                               #
#                                                                             #
# Reference: https://dev.mysql.com/doc/refman/en/                             #
#  server-system-variables.html                                               #
#                                                                             #
###############################################################################

--source include/load_sysvars.inc

################################################################
#                 START OF partial_subject_match TESTS         #
################################################################

################################################################
# Saving initial value of partial_subject_match                #
# in a temporary variable                                      #
################################################################

SET @start_value = @@global.partial_subject_match;
SELECT @start_value;

--echo '#----- Default value -----------------------------------------#'
################################################################
#              Display the DEFAULT value of                    #
#              partial_subject_match                           #
################################################################

SET @@global.partial_subject_match = 1;
SET @@global.partial_subject_match = DEFAULT;
SELECT @@global.partial_subject_match;

###############################################
#     Verify default value of variable        #
###############################################

SET @@global.partial_subject_match = @start_value;
SELECT @@global.partial_subject_match = 0;

--echo '#----- Valid values ------------------------------------------#'
#################################################################
#        Change the value of partial_subject_match to valid     #
#        values                                                 #
#################################################################

SET @@global.partial_subject_match = 0;
SELECT @@global.partial_subject_match;
SET @@global.partial_subject_match = 1;
SELECT @@global.partial_subject_match;
SET @@global.partial_subject_match = TRUE;
SELECT @@global.partial_subject_match;
SET @@global.partial_subject_match = FALSE;
SELECT @@global.partial_subject_match;
SET @@global.partial_subject_match = ON;
SELECT @@global.partial_subject_match;
SET @@global.partial_subject_match = OFF;
SELECT @@global.partial_subject_match;

--echo '#----- Invalid values ----------------------------------------#'
####################################################################
#    Change the value of partial_subject_match to invalid values   #
####################################################################

--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.partial_subject_match = -1;
SELECT @@global.partial_subject_match;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.partial_subject_match = 4294967296;
SELECT @@global.partial_subject_match;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.partial_subject_match = 10240022115;
SELECT @@global.partial_subject_match;
--Error ER_WRONG_TYPE_FOR_VAR
SET @@global.partial_subject_match = 10000.01;
SELECT @@global.partial_subject_match;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.partial_subject_match = -1024;
SELECT @@global.partial_subject_match;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.partial_subject_match = 42949672950;
SELECT @@global.partial_subject_match;
--Error ER_WRONG_VALUE_FOR_VAR
SET @@global.partial_subject_match = 'test';
SELECT @@global.partial_subject_match;

--echo '#----- Global/Session variable -------------------------------#'
####################################################################
#   Test if accessing session partial_subject_match gives error    #
####################################################################

--Error ER_GLOBAL_VARIABLE
SET @@session.partial_subject_match = 0;
SELECT @@partial_subject_match;

##############################################################################
# Check if the value in GLOBAL & SESSION Tables matches values in variable   #
##############################################################################

--disable_warnings
SELECT IF(@@global.partial_subject_match, "ON", "OFF") = VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='partial_subject_match';

SELECT IF(@@partial_subject_match, "ON", "OFF") = VARIABLE_VALUE
FROM performance_schema.session_variables
WHERE VARIABLE_NAME='partial_subject_match';
--enable_warnings

####################################################################################################
# Check if accessing variable with SESSION,LOCAL and without SCOPE points to same session variable #
####################################################################################################

SET @@global.partial_subject_match = 1;
SELECT @@partial_subject_match = @@global.partial_subject_match;

--echo '#----- Accessing with and without @@ sign --------------------#'
#########################################################################
# Check if partial_subject_match can be accessed with and without @@    #
#########################################################################

--Error ER_GLOBAL_VARIABLE
SET partial_subject_match = 1;
SELECT @@partial_subject_match;
--Error ER_PARSE_ERROR
SET local.partial_subject_match = 1;
--Error ER_UNKNOWN_TABLE
SELECT local.partial_subject_match;
--Error ER_PARSE_ERROR
SET global.partial_subject_match = 1;
--Error ER_UNKNOWN_TABLE
SELECT global.partial_subject_match;
--Error ER_BAD_FIELD_ERROR
SELECT partial_subject_match;
--Error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@session.partial_subject_match;

##############################
#   Restore initial value    #
##############################

SET @@global.partial_subject_match = @start_value;
SELECT @@global.partial_subject_match;

#################################################################
#              END OF partial_subject_match TESTS               #
#################################################################
