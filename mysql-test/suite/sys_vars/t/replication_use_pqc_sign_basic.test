SELECT @@GLOBAL.replication_use_pqc_sign;

SELECT @@replication_use_pqc_sign = @@GLOBAL.replication_use_pqc_sign;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@SESSION.replication_use_pqc_sign;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@LOCAL.replication_use_pqc_sign;

--error ER_GLOBAL_VARIABLE
SET @@SESSION.replication_use_pqc_sign = ON;

--error ER_WRONG_VALUE_FOR_VAR
SET @@GLOBAL.replication_use_pqc_sign = 'invalid';

SELECT VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='replication_use_pqc_sign';
