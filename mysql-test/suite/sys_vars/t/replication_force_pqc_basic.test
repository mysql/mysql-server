SELECT @@GLOBAL.replication_force_pqc;

SELECT @@replication_force_pqc = @@GLOBAL.replication_force_pqc;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@SESSION.replication_force_pqc;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@LOCAL.replication_force_pqc;

--error ER_GLOBAL_VARIABLE
SET @@SESSION.replication_force_pqc = ON;

--error ER_WRONG_VALUE_FOR_VAR
SET @@GLOBAL.replication_force_pqc = 'invalid';

SELECT VARIABLE_VALUE
FROM performance_schema.global_variables
WHERE VARIABLE_NAME='replication_force_pqc';
