# restart: --group-replication-force-pqc=ON --group-replication-recovery-tls-version=TLSv1.2
Startup disables group_replication_force_pqc when recovery TLS version excludes TLSv1.3
SELECT @@GLOBAL.group_replication_force_pqc,
@@GLOBAL.group_replication_recovery_tls_version;
@@GLOBAL.group_replication_force_pqc	@@GLOBAL.group_replication_recovery_tls_version
0	TLSv1.2
include/assert_error_log.inc [server: 1, pattern: Plugin group_replication reported: 'group_replication_force_pqc=ON requires TLSv1.3 with OpenSSL 3.5.0 or newer, but group_replication_recovery_tls_version=TLSv1.2 disables TLSv1.3; setting group_replication_force_pqc=OFF']
SET @@GLOBAL.group_replication_recovery_tls_version = DEFAULT;
SELECT @@GLOBAL.group_replication_force_pqc;
@@GLOBAL.group_replication_force_pqc
0
SELECT @@group_replication_force_pqc = @@GLOBAL.group_replication_force_pqc;
@@group_replication_force_pqc = @@GLOBAL.group_replication_force_pqc
1
SELECT @@SESSION.group_replication_force_pqc;
ERROR HY000: Variable 'group_replication_force_pqc' is a GLOBAL variable
SELECT @@LOCAL.group_replication_force_pqc;
ERROR HY000: Variable 'group_replication_force_pqc' is a GLOBAL variable
SET @@SESSION.group_replication_force_pqc = ON;
