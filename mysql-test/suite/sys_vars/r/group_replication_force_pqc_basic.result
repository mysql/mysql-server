SET @@GLOBAL.group_replication_force_pqc = 'invalid';
ERROR 42000: Variable 'group_replication_force_pqc' can't be set to the value of 'invalid'
SET @group_replication_recovery_tls_version_saved =
@@GLOBAL.group_replication_recovery_tls_version;
SET @@GLOBAL.group_replication_force_pqc = OFF;
SET @@GLOBAL.group_replication_recovery_tls_version = 'TLSv1.2';
SET @@GLOBAL.group_replication_force_pqc = ON;
ERROR 42000: Variable 'group_replication_force_pqc' can't be set to the value of 'ON'
SELECT @@GLOBAL.group_replication_force_pqc;
@@GLOBAL.group_replication_force_pqc
0
0 Expected
SET @@GLOBAL.group_replication_recovery_tls_version =
@group_replication_recovery_tls_version_saved;
