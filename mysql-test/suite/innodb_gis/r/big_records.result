CREATE TABLE t1 (
a VARCHAR(255) NOT NULL,
b VARCHAR(255) NOT NULL,
c VARCHAR(255) NOT NULL,
d VARCHAR(175) NOT NULL,
g GEOMETRY NOT NULL SRID 4326,
PRIMARY KEY (a, b, c, d),
SPATIAL KEY idx_g (g)
) ENGINE=InnoDB ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=2 CHARSET=latin1;
INSERT INTO t1 (a,b,c,d,g)
VALUES ('a', 'b', 'c', 'd', ST_GeomFromText('POINT(0 0)', 4326));
INSERT INTO t1 (a,b,c,d,g) VALUES (
REPEAT('a',255),
REPEAT('b',255),
REPEAT('c',255),
REPEAT('d',175),
ST_GeomFromText('POINT(1 1)', 4326)
);
CREATE TABLE nums(id INT PRIMARY KEY);
INSERT INTO nums VALUES (1);
