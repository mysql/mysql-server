INSERT INTO t1 (a,b,c,d,g)
SELECT REPEAT(id,50), REPEAT('b',255), REPEAT('c',255), 'd2', ST_GeomFromText(
CONCAT('POINT(', MOD(id,90), ' -122.4194)'),
4326
) FROM nums;
DROP TABLE nums;
