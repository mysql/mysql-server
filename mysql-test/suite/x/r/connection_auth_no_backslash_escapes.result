CREATE USER 'quote''user'@'localhost'
  IDENTIFIED WITH 'caching_sha2_password' BY 'auth_string';
GRANT ALL ON *.* TO 'quote''user'@'localhost';
SET @old_global_sql_mode = @@GLOBAL.sql_mode;
SET @@GLOBAL.sql_mode = 'NO_BACKSLASH_ESCAPES';
