# Partitioned table with generated columns

CREATE TABLE tp (
c1 INT,
c2 INT,
c3 INT GENERATED ALWAYS AS (c1 + 1),
c4 INT AS (c3 - c2) STORED,
c5 INT NOT NULL AUTO_INCREMENT,
UNIQUE KEY(c5, c2)
)
PARTITION BY RANGE (c5) (
PARTITION p0 VALUES LESS THAN (10),
PARTITION p1 VALUES LESS THAN (20),
PARTITION p2 VALUES LESS THAN (30)
);
EXPLAIN INSERT INTO tp (c1, c2, c5) VALUES (1, 2, 4), (6, 9, 3), (10, 1, 2);
