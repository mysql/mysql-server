1	INSERT	tr	p0,p1	ALL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
Warnings:
Note	1003	insert into `test`.`tr` values (7,12,3),(2,7,21) on duplicate key update `test`.`tr`.`c` = (`test`.`tr`.`c` + 1)
INSERT INTO tr VALUES (7, 12, 3), (2, 7, 21) ON DUPLICATE KEY UPDATE c=c+1;
SELECT * FROM tr;
a	b	c
10	9	17
2	7	20
4	2	8
6	1	21
7	12	4
7	5	21
9	2	7
EXPLAIN INSERT INTO tr VALUES (7, 12, 3), (-0, 7, 21), (NULL, 21, 10) ON DUPLICATE KEY UPDATE c=c+1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	INSERT	tr	p0,p1,p2,p3	ALL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
Warnings:
Note	1003	insert into `test`.`tr` values (7,12,3),(-(0),7,21),(NULL,21,10) on duplicate key update `test`.`tr`.`c` = (`test`.`tr`.`c` + 1)
