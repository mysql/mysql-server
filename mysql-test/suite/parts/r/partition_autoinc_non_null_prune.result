id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	INSERT	tr	p0,p1,p2,p3	ALL	NULL	NULL	NULL	NULL	NULL	NULL	NULL
Warnings:
Note	1003	insert into `test`.`tr` values (7,12,3),(7,5,21) on duplicate key update `test`.`tr`.`a` = (`test`.`tr`.`a` + `test`.`tr`.`c`)
INSERT INTO tr VALUES (7, 12, 3), (7, 5, 21) ON DUPLICATE KEY UPDATE a=a+c;
