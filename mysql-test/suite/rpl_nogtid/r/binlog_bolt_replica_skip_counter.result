include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/stop_applier.inc
# Case 1: one applier worker.
SET GLOBAL replica_parallel_workers = 1;
[connection master]
BEGIN;
INSERT INTO t1 VALUES (10 + 1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (10 + 2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (10 + 3, REPEAT('c', 4000000));
COMMIT;
include/assert.inc [The source promotes the large transaction's spilled file.]
INSERT INTO t1 VALUES (10 + 9, 'after');
include/rpl/sync_to_replica_received.inc
[connection slave]
SET GLOBAL sql_replica_skip_counter = 1;
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/assert.inc [R1: the replica skips the large transaction.]
include/assert.inc [R1: the replica applies the transaction after it.]
include/assert.inc [R1: the skip counter is spent.]
[connection master]
[connection slave]
include/rpl/stop_applier.inc
# Case 2: several applier workers.
SET GLOBAL replica_parallel_workers = 4;
[connection master]
BEGIN;
INSERT INTO t1 VALUES (20 + 1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (20 + 2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (20 + 3, REPEAT('c', 4000000));
COMMIT;
include/assert.inc [The source promotes the large transaction's spilled file.]
INSERT INTO t1 VALUES (20 + 9, 'after');
include/rpl/sync_to_replica_received.inc
[connection slave]
SET GLOBAL sql_replica_skip_counter = 1;
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/assert.inc [R1: the replica skips the large transaction.]
include/assert.inc [R1: the replica applies the transaction after it.]
include/assert.inc [R1: the skip counter is spent.]
[connection master]
[connection slave]
include/rpl/stop_applier.inc
include/rpl/start_applier.inc
[connection master]
DROP TABLE t1;
include/rpl/deinit.inc
