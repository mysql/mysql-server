###########################################################################
# 1. Test Slave SQL Thread encountered an error during commit
###########################################################################
# 1.1 Insert some data and sync
[connection master]
INSERT INTO t1 (id, c0, c1) VALUES (1, 'abc', NULL);
FLUSH LOGS;
UPDATE t1 SET c1='AliSQL' WHERE id=1;
FLUSH LOGS;
# 1.2 Sync and stop replica, then inject commit error
include/rpl/sync.inc
[connection slave]
STOP REPLICA;
[connection master]
UPDATE t1 SET c1='DuckDB' WHERE id=1;
FLUSH LOGS;
# 1.3 DuckDB fails when committing due to injected error
[connection slave]
CALL mtr.add_suppression("MY-010583");
CALL mtr.add_suppression("MY-010584");
CALL mtr.add_suppression("MY-010586");
SET GLOBAL DEBUG='+d,duckdb_inject_commit_error';
START REPLICA;
include/rpl/wait_for_applier_to_stop.inc
# 1.4 Remove the error injection and restart replica
[connection slave]
SET GLOBAL DEBUG='-d,duckdb_inject_commit_error';
START REPLICA;
include/rpl/sync.inc
# 1.5 Check the result
include/rpl/diff.inc
###########################################################################
# 2. Cleanup
###########################################################################
[connection master]
DROP TABLE t1;
include/rpl/sync.inc
include/rpl/deinit.inc
