# Non-empty tables use COPY to fill implicit zero dates.
ALTER TABLE temporal_duckdb ADD COLUMN d DATE NOT NULL;
ALTER TABLE temporal_innodb ADD COLUMN d DATE NOT NULL;
ALTER TABLE temporal_duckdb ADD COLUMN dt DATETIME(6) NOT NULL;
ALTER TABLE temporal_innodb ADD COLUMN dt DATETIME(6) NOT NULL;
