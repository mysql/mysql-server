CREATE TABLE t_duckdb (
id BIGINT NOT NULL,
c0 INT,
PRIMARY KEY(id)
) ENGINE=InnoDB;
CREATE TABLE t_innodb (
id BIGINT NOT NULL,
c0 INT,
PRIMARY KEY(id)
) ENGINE=InnoDB;
