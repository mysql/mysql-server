--disable_warnings
--source include/rpl/init_source_replica.inc
--enable_warnings
--source include/have_binlog_format_row.inc

--echo ###########################################################################
--echo # Prepare
--echo ###########################################################################
--source include/rpl/connection_source.inc
CREATE TABLE t1 (
    id BIGINT NOT NULL,
    c0 VARCHAR(20) NOT NULL,
    PRIMARY KEY(id)
) ENGINE=InnoDB;
SHOW CREATE TABLE t1;

--source include/rpl/sync.inc
--source include/rpl/connection_replica.inc
SHOW CREATE TABLE t1;

--echo ###########################################################################
--echo # Test commit due to reader, Exec_Source_Log_Pos should be equal to Read_Source_Log_Pos
--echo ###########################################################################
--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (1, 'abc');

--source include/rpl/sync.inc
--source include/rpl/connection_replica.inc
--let $rpl_diff_statement = SELECT * FROM test.t1 ORDER BY id;
--source include/rpl/diff.inc

--let $read_master_log_pos = query_get_value(SHOW REPLICA STATUS, Read_Source_Log_Pos, 1)
--let $exec_master_log_pos = query_get_value(SHOW REPLICA STATUS, Exec_Source_Log_Pos, 1)
if ($read_master_log_pos != $exec_master_log_pos)
{
  --echo Read_Source_Log_Pos: $read_master_log_pos, Exec_Source_Log_Pos: $exec_master_log_pos
  --die Incorrect Master_Log_Pos!
}

--echo ###########################################################################
--echo # Cleanup
--echo ###########################################################################
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync.inc
--source include/rpl/deinit.inc
