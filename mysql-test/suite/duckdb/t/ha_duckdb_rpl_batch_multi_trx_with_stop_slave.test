--source include/have_binlog_format_row.inc
--source include/have_debug.inc
--source include/rpl/init_source_replica.inc

--echo ###########################################################################
--echo # 0. Prepare
--echo ###########################################################################
--source include/rpl/connection_source.inc
SET autocommit = 1;
--source suite/duckdb/include/rpl_batch_create_table.inc

--echo ###########################################################################
--echo # 1. Test restart SQL Thread after the Trx2 is partially executed
--echo ###########################################################################
--source include/rpl/connection_replica.inc
STOP REPLICA;

--source include/rpl/connection_source.inc
--echo # 1.1 Execute two Transactions on Master
INSERT INTO t1 (id, c0, c1) VALUES (1, 'abc', NULL), (3, 'RDS', 'duck');

BEGIN;
UPDATE t1 SET id=6, c1='AliSQL' WHERE id=1;
DELETE FROM t1 WHERE id=3;
COMMIT;

--echo # 1.2 Make SQL Thread stop after the Trx2's Update Event executed
--source include/rpl/connection_replica.inc
SET GLOBAL debug="+d,debug_sync_before_apply_update_rows_event";
START REPLICA;

--source include/rpl/connection_replica1.inc
SET debug_sync="now WAIT_FOR apply_signal";
send STOP REPLICA;

--source include/rpl/connection_replica.inc
SET debug_sync="now SIGNAL resume_signal";
--source include/rpl/wait_for_applier_to_stop.inc

--echo # 1.3 Restart SQL Thread
--source include/rpl/connection_replica1.inc
reap;
SET GLOBAL debug="-d,debug_sync_before_apply_update_rows_event";
START REPLICA;

--echo # 1.4 Check the result
--source include/rpl/sync.inc
--let $rpl_diff_statement = SELECT id, c0, c1 FROM test.t1 ORDER BY id;
--source include/rpl/diff.inc

--echo ###########################################################################
--echo # 2. Test transactions are not replayed by executing SQL
--echo ###########################################################################
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_text = Check DML SQL is not executed
--let $assert_select = duckdb_print_dml
--let $assert_count = 0
--source include/assert_grep.inc

--echo ###########################################################################
--echo # 3. Test Cleanup
--echo ###########################################################################
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync.inc
--source include/rpl/deinit.inc
