--source include/rpl/init_source_replica.inc
--source include/have_binlog_format_row.inc

--echo # Prepare
--source include/rpl/connection_source.inc
CREATE TABLE t1 (
    id BIGINT NOT NULL,
    c0 DECIMAL(40, 20) NOT NULL,
    PRIMARY KEY(id)
) ENGINE=InnoDB;

--source include/rpl/sync.inc
--source include/rpl/connection_replica.inc
ALTER TABLE t1 ENGINE=DuckDB;
SHOW CREATE TABLE t1;

--echo # Insert overflow DECIMAL into Master
--source include/rpl/stop_applier.inc
--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES(1, '123456');
INSERT INTO t1 VALUES(2, '1435323879643025700');

--echo # Slave's replication interrupted
--source include/rpl/connection_replica.inc
CALL mtr.add_suppression("MY-010584");
--source include/rpl/start_applier.inc
--let $slave_sql_errno= convert_error(ER_DUCKDB_APPENDER_ERROR)
--source include/rpl/wait_for_applier_to_stop.inc

--echo # Alter Slave's table to InnoDB, resume replication
--source include/rpl/connection_replica.inc
ALTER TABLE t1 ENGINE=InnoDB;
--source include/rpl/start_applier.inc
--source include/rpl/sync.inc

--echo # Cleanup
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync.inc
--source include/rpl/deinit.inc
