SET GLOBAL binlog_checksum = CRC32;
RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
# R1: change binlog_checksum while the large transaction waits before LOCK_log.
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
SET DEBUG_SYNC = 'bgc_before_flush_stage SIGNAL bolt_waiting WAIT_FOR bolt_go';
COMMIT;
SET DEBUG_SYNC = 'now WAIT_FOR bolt_waiting';
SET GLOBAL binlog_checksum = NONE;
SET DEBUG_SYNC = 'now SIGNAL bolt_go';
SET DEBUG_SYNC = 'RESET';
include/assert.inc [R1: the transaction's spilled file is not promoted.]
include/assert.inc [R1: the transaction is counted as a missed optimization.]
include/assert_grep.inc [R1: the checksum change is the fallback reason.]
# R2: more transactions after it.
INSERT INTO t1 VALUES (4, 'small');
INSERT INTO t1 VALUES (5, 'small');
include/assert.inc [All rows are committed.]
FLUSH BINARY LOGS;
# All binary log files verified.
DROP TABLE t1;
