# C28: SAVEPOINT / ROLLBACK TO inside a stored procedure
CREATE PROCEDURE sp_in_proc(IN len INT)
BEGIN
CALL ins(1, len);
CALL ins(2, len);
CALL ins(3, len);
SAVEPOINT p;
CALL ins(4, len);
ROLLBACK TO SAVEPOINT p;
END|
FLUSH BINARY LOGS;
BEGIN;
CALL sp_in_proc(4000000);
COMMIT;
DROP PROCEDURE sp_in_proc;
include/assert.inc [C28: SAVEPOINT / ROLLBACK TO inside a stored procedure: t1 holds exactly the expected rows]
