# C29: DDL after a savepoint commits the transaction implicitly
BEGIN;
CALL ins(1, 4000000);
CALL ins(2, 4000000);
CALL ins(3, 4000000);
SAVEPOINT s;
CALL ins(4, 4000000);
CREATE TABLE t3 (a INT);
ROLLBACK TO SAVEPOINT s;
ERROR 42000: SAVEPOINT s does not exist
include/assert.inc [C29: DDL after a savepoint commits the transaction implicitly: t1 holds exactly the expected rows]
