# C32: compression ON at the first event, then ROLLBACK TO
SET SESSION binlog_transaction_compression = ON;
BEGIN;
CALL ins(1, 4000000);
CALL ins(2, 4000000);
CALL ins(3, 4000000);
SAVEPOINT s;
CALL ins(4, 4000000);
ROLLBACK TO SAVEPOINT s;
COMMIT;
SET SESSION binlog_transaction_compression = OFF;
