SET GLOBAL binlog_checksum = CRC32;
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
CREATE PROCEDURE ins(IN i INT, IN len INT)
BEGIN
INSERT INTO t1 VALUES (i, REPEAT(CHAR(64 + MOD(i, 26)), len));
END|
# C1: two savepoints, ROLLBACK TO the second
BEGIN;
CALL ins(1, 4000000);
CALL ins(2, 4000000);
CALL ins(3, 4000000);
SAVEPOINT s1;
CALL ins(4, 4000000);
SAVEPOINT s2;
CALL ins(5, 4000000);
ROLLBACK TO SAVEPOINT s2;
COMMIT;
include/assert.inc [C1: two savepoints, ROLLBACK TO the second: t1 holds exactly the expected rows]
include/assert.inc [C1: two savepoints, ROLLBACK TO the second: every retained row has its own payload]
include/assert.inc [C1: two savepoints, ROLLBACK TO the second: promoted 1 time(s)]
include/assert.inc [C1: two savepoints, ROLLBACK TO the second: missed optimizations +0]
include/assert.inc [C1: two savepoints, ROLLBACK TO the second: the binlog inserts 4 row(s) into t1]
include/assert.inc [C1: two savepoints, ROLLBACK TO the second: no bolt_ temp file is left over]
