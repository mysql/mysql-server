# C30: savepoint and rollback in memory, then the transaction spills
BEGIN;
CALL ins(1, 100);
SAVEPOINT s;
CALL ins(2, 100);
ROLLBACK TO SAVEPOINT s;
CALL ins(3, 4000000);
CALL ins(4, 4000000);
CALL ins(5, 4000000);
COMMIT;
