SET GLOBAL binlog_checksum = CRC32;
RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
# A small transaction leads a flush group and pauses before the fetch.
SET DEBUG_SYNC = 'bgc_after_enrolling_for_flush_stage SIGNAL small_enrolled WAIT_FOR small_go';
SET DEBUG_SYNC = 'bgc_after_flush_stage_before_sync_stage SIGNAL small_fetched WAIT_FOR small_go_on';
INSERT INTO t1 VALUES (1, 'small');
SET DEBUG_SYNC = 'now WAIT_FOR small_enrolled';
# R1: two large transactions wait as candidates, in this order.
BEGIN;
SET DEBUG_SYNC = 'bgc_flush_leader_candidate_waiting SIGNAL big1_waiting';
COMMIT;
SET DEBUG_SYNC = 'now WAIT_FOR big1_waiting';
BEGIN;
SET DEBUG_SYNC = 'bgc_flush_leader_candidate_waiting SIGNAL big2_waiting';
COMMIT;
SET DEBUG_SYNC = 'now WAIT_FOR big2_waiting';
include/assert.inc [R1: nothing is promoted while the candidates wait.]
# R2: the small group is fetched, then a late transaction enrolls.
SET DEBUG_SYNC = 'now SIGNAL small_go';
SET DEBUG_SYNC = 'now WAIT_FOR small_fetched';
SET DEBUG_SYNC = 'bgc_after_enrolling_for_flush_stage SIGNAL late_enrolled';
INSERT INTO t1 VALUES (2, 'late');
SET DEBUG_SYNC = 'now WAIT_FOR late_enrolled';
SET DEBUG_SYNC = 'now SIGNAL small_go_on';
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'RESET';
SET DEBUG_SYNC = 'RESET';
include/assert.inc [R2: the small transaction is in the first binlog file.]
include/assert.inc [R2: the late transaction is in the first candidate's promoted file.]
include/assert.inc [R2: the late transaction is written behind the first candidate.]
# R3: both candidates are promoted, each into its own file, in order.
include/assert.inc [R3: both large transactions are promoted.]
include/assert.inc [R3: the second candidate leads the next group, in the next file.]
# R4: every row is committed and the binlog files verify.
include/assert.inc [R4: every row is committed.]
DROP TABLE t1;
