# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
# Restart the server with binary-log encryption enabled.
# An encrypted binary log uses the standard commit path.
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('j', 5000000));
INSERT INTO t1 VALUES (2, REPEAT('k', 5000000));
INSERT INTO t1 VALUES (3, REPEAT('l', 5000000));
COMMIT;
include/assert.inc [An encrypted binary log does not promote a binary log.]
include/assert.inc [An encrypted binary log increments the missed counter once.]
include/assert.inc [An encrypted fallback stays in the active binary log.]
include/assert.inc [An encrypted fallback commits all rows.]
DROP TABLE t2;
DROP TABLE t1;
# ----------------------------------------------------------------------
# Teardown
# Removing manifest file for current MySQL server instance
# Removing local keyring file for keyring component: component_keyring_file
# Removing local configuration file for keyring component: component_keyring_file
# Restarting server without the manifest file
