INSERT INTO t1 (y) VALUES (REPEAT('abcdefghijklmnop', 250000));
INSERT INTO t1 (y) VALUES (REPEAT('abcdefghijklmnop', 250000));
INSERT INTO t1 (y) VALUES (REPEAT('abcdefghijklmnop', 250000));
INSERT INTO t1 (y) VALUES (REPEAT('abcdefghijklmnop', 250000));
XA END 'bolt_one_phase';
XA COMMIT 'bolt_one_phase' ONE PHASE;
include/assert.inc [XA COMMIT ONE PHASE promotes one large transaction.]
include/assert.inc [XA COMMIT ONE PHASE commits all rows exactly once.]
