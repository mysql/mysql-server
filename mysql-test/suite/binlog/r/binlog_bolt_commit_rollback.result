INSERT INTO t1 (y) VALUES (REPEAT('abcdefghijklmnop', 250000));
INSERT INTO t1 (y) VALUES (REPEAT('abcdefghijklmnop', 250000));
INSERT INTO t1 (y) VALUES (REPEAT('abcdefghijklmnop', 250000));
COMMIT;
