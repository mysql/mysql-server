CREATE TABLE t1 (id INT PRIMARY KEY, v VECTOR(2));
CREATE TABLE t2 (id INT PRIMARY KEY, d DOUBLE);
INSERT INTO t1 VALUES (1, TO_VECTOR('[1, 0]')), (2, TO_VECTOR('[0, 1]'));
