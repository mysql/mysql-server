CALL mtr.add_suppression("An error occurred during flush stage of the commit");
CALL mtr.add_suppression("An error occurred in the binlog rotation that promotes the spill binlog file of a large transaction");
CALL mtr.add_suppression("Could not optimize large transaction execution in the binlog because the spill binlog file could not be promoted");
CALL mtr.add_suppression("Could not use .* for logging");
CALL mtr.add_suppression("Could not open .* for logging");
CALL mtr.add_suppression("Either disk is full, file system is read only");
CALL mtr.add_suppression("Binary logging not possible");
CALL mtr.add_suppression("Hence turning logging off for the whole duration");
CALL mtr.add_suppression("Could not write or sync the spill binlog file");
CALL mtr.add_suppression("A fatal error occurred while promoting the spill binlog file");
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
# R1: a spill-sync failure rolls the transaction back.
include/assert.inc [R1: the transaction's spilled file is not promoted.]
include/assert.inc [R1: it is not counted as a missed optimization.]
include/assert_grep.inc [R1: the error log has the actionable warning for the spilled file.]
include/assert.inc [R1: no row is committed.]
include/assert_grep.inc [R1: the transaction is not in the binlog.]
INSERT INTO t1 VALUES (4, 'd');
include/assert.inc [R1: the session commits its next transaction.]
# R2: a failure after the rename with ABORT_SERVER aborts the server.
SET GLOBAL binlog_error_action = ABORT_SERVER;
include/assert_grep.inc [R2: the error log says the server aborts.]
include/assert.inc [R2: the aborted promotion commits no rows.]
include/assert_grep.inc [R2: the aborted promotion writes no transaction to the binlog.]
# R3: a failure after the rename with IGNORE_ERROR aborts the server.
SET GLOBAL binlog_error_action = IGNORE_ERROR;
include/assert_grep.inc [R3: the error log has the abort message with the rotation's error.]
include/assert.inc [R3: the aborted promotion commits no rows.]
include/assert_grep.inc [R3: the aborted promotion writes no row events to the binlog.]
# R4: the same failure with a second member in the flush group.
SET GLOBAL binlog_error_action = IGNORE_ERROR;
SET SESSION DEBUG = "+d,fail_bolt_promoted_file_reopen";
SET DEBUG_SYNC = 'waiting_in_the_middle_of_flush_stage SIGNAL bolt_leading WAIT_FOR member_enrolled';
COMMIT;
SET DEBUG_SYNC = 'now WAIT_FOR bolt_leading';
SET SESSION binlog_transaction_compression = OFF;
SET DEBUG_SYNC = 'bgc_after_enrolling_for_flush_stage SIGNAL member_enrolled';
INSERT INTO t1 VALUES (4, 'member');
Got one of the listed errors
Got one of the listed errors
include/assert.inc [R4: neither transaction commits in the engine.]
include/assert_grep.inc [R4: neither transaction is written into the binlog.]
# R5: a directory sync failure after the rename with IGNORE_ERROR aborts the server.
SET GLOBAL binlog_error_action = IGNORE_ERROR;
include/assert_grep.inc [R5: the error log has the abort message for each of the three aborts.]
include/assert.inc [R5: the aborted promotion commits no rows.]
include/assert_grep.inc [R5: the aborted promotion writes no row events to the binlog.]
# R6: a fatal error during the promotion aborts the server.
SET GLOBAL binlog_error_action = IGNORE_ERROR;
include/assert_grep.inc [R6: the error log has the actionable abort message with the fatal error's text.]
include/assert.inc [R6: the aborted promotion commits no rows.]
include/assert_grep.inc [R6: the aborted promotion writes no transaction to the binlog.]
DROP TABLE t1;
