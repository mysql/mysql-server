# BOLT stands for Binary-log Optimization for Large Transactions.
#
# === Purpose ===
# The binary log's temp files directory, #binlog_temp_files/<binary log base
# name>, exists only once the optimization is enabled, and the binlog cache's
# standard-form spill files are not in it.
#
# === Requirements ===
# R1. Started with the optimization OFF, the server does not create the
#     directory, and a transaction that spills leaves nothing there.
# R2. SET GLOBAL binlog_large_transaction_optimization_enabled = ON creates
#     the directory.
# R3. Setting it OFF keeps the directory.
# R4. SET ... = ON fails when the directory cannot be created (a regular file
#     has its name); the variable stays OFF.
#
--source include/not_windows.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc

--let $MYSQLD_DATADIR = `SELECT @@DATADIR`
--let $bolt_binlog_base = `SELECT SUBSTRING_INDEX(@@GLOBAL.log_bin_basename, '/', -1)`
--let $BOLT_TEMP_DIR = $MYSQLD_DATADIR/#binlog_temp_files/$bolt_binlog_base
--disable_query_log
CALL mtr.add_suppression("Failed to initialize #binlog_temp_files at");
--enable_query_log

--echo # R1: the optimization is OFF; no directory, even after a spill.
--error 1
--file_exists $BOLT_TEMP_DIR
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
COMMIT;
--error 1
--file_exists $BOLT_TEMP_DIR

--echo # R2: enabling the optimization creates the directory.
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
--file_exists $BOLT_TEMP_DIR

--echo # R3: disabling it keeps the directory.
SET GLOBAL binlog_large_transaction_optimization_enabled = OFF;
--file_exists $BOLT_TEMP_DIR

--echo # R4: enabling fails when the directory cannot be created.
--rmdir $BOLT_TEMP_DIR
--write_file $BOLT_TEMP_DIR END_OF_FILE
not a directory
END_OF_FILE
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
--let $assert_text = The optimization stays OFF.
--let $assert_cond = @@GLOBAL.binlog_large_transaction_optimization_enabled = 0
--source include/assert.inc
--remove_file $BOLT_TEMP_DIR
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
--file_exists $BOLT_TEMP_DIR

# Cleanup
SET GLOBAL binlog_large_transaction_optimization_enabled = OFF;
DROP TABLE t1;
