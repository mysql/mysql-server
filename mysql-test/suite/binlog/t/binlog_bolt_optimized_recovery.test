# BOLT stands for Binary-log Optimization for Large Transactions.
#
# === Purpose ===
# Verify BOLT recovery logs the optimized seek, and that a header that does not
# describe the transaction's terminating event is ignored.
#
# === Requirements ===
# R1. Recovery logs the optimized large-transaction seek after promotion.
# R2. A BOLT transaction survives normal restart recovery.
# R3. When the LTH event's terminating event is missing (the file was
#     truncated), recovery ignores the header, reads the transaction
#     sequentially as without the optimization, and the server starts.
# R4. With source_verify_checksum ON, recovery reads a BOLT transaction
#     sequentially, so the checksum of every event in its body is verified,
#     and logs why the optimized recovery was not used.
# R5. With binlog_checksum = NONE, recovery still seeks past the body of a
#     BOLT transaction.
#
# === Implementation ===
# 1. Initialize BOLT and a clean test table.
# 2. Commit a qualifying transaction and restart to inspect recovery logging.
# 3. Stop the server, truncate the promoted file at a fixed 1 MiB offset,
#    restart, and verify the warning and the sequential recovery.
# 4. Commit a qualifying transaction, restart with source_verify_checksum ON,
#    and verify the note, that no seek is logged, and that the transaction
#    survives.
# 5. Commit a qualifying transaction with binlog_checksum = NONE, restart, and
#    verify the seek and the transaction.
#
--source include/not_windows.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc

--let $save_enabled = query_get_value(SELECT @@GLOBAL.binlog_large_transaction_optimization_enabled, @@GLOBAL.binlog_large_transaction_optimization_enabled, 1)
--let $save_threshold = query_get_value(SELECT @@GLOBAL.binlog_large_transaction_optimization_threshold, @@GLOBAL.binlog_large_transaction_optimization_threshold, 1)
--let $save_max_binlog_size = query_get_value(SELECT @@GLOBAL.max_binlog_size, @@GLOBAL.max_binlog_size, 1)
--let $MYSQLD_DATADIR = `SELECT @@DATADIR`

# Setup
--disable_query_log
CALL mtr.add_suppression("Ignored a large transaction header in binary log file");
DROP TABLE IF EXISTS t1;
--enable_query_log
RESET BINARY LOGS AND GTIDS;
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
SET GLOBAL max_binlog_size = 1073741824;
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;

############################################################################
# Case 1: Recover an intact BOLT transaction.
# Expected behavior: commit.
############################################################################
--let $binlog_file_before = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--echo # Commit a qualifying transaction for optimized recovery.
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
COMMIT;

--let $promoted_file = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_text = The transaction's spilled file was promoted into a new binary log file.
--let $assert_cond = "$promoted_file" != "$binlog_file_before"
--source include/assert.inc

--let $restart_parameters = restart:
--let $restart_parameters = $restart_parameters --binlog-large-transaction-optimization-enabled=ON
--let $restart_parameters = $restart_parameters --binlog-large-transaction-optimization-threshold=10M
--let $restart_parameters = $restart_parameters --max-binlog-size=1G
# REPEAT() payloads compress to almost nothing, so a compressed cache would
# never reach the threshold and the transaction would never be promoted.
--let $restart_parameters = $restart_parameters --binlog-transaction-compression=OFF
--source include/kill_and_restart_mysqld.inc

--echo # Recovery logs the optimized large-transaction seek.
--let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let SEARCH_PATTERN = Optimized binary log recovery by avoiding a sequential read of a large transaction body and seeking to its terminating event at offset
--source include/search_pattern.inc

--let $assert_text = The committed BOLT transaction survives recovery.
--let $assert_cond = [SELECT COUNT(*) AS count FROM t1, count, 1] = 3
--source include/assert.inc

############################################################################
# Case 2: Recover a file whose LTH does not describe its terminating event.
# We simulate it by truncating the file before the XID event, so the LTH
# points to a position that doesn't exist.
############################################################################
--let $binlog_file_before_corruption = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--echo # Commit a second qualifying transaction for corrupt-LTH recovery.
BEGIN;
INSERT INTO t1 VALUES (4, REPEAT('d', 4000000));
INSERT INTO t1 VALUES (5, REPEAT('e', 4000000));
INSERT INTO t1 VALUES (6, REPEAT('f', 4000000));
COMMIT;

--let $corrupt_file = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_text = The second transaction's spilled file was promoted into a new binary log file.
--let $assert_cond = "$corrupt_file" != "$binlog_file_before_corruption"
--source include/assert.inc

--echo # Truncate the active promoted file; recovery ignores the header.
--source include/kill_mysqld.inc
--let BOLT_BINLOG = $MYSQLD_DATADIR/$corrupt_file
--exec truncate -s 1048576 $BOLT_BINLOG
--let $restart_parameters = restart
--source include/start_mysqld.inc
--let $assert_text = Recovery ignores the header and reads the transaction sequentially.
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_only_after = CURRENT_TEST: binlog.binlog_bolt_optimized_recovery
--let $assert_select = Ignored a large transaction header in binary log file .* that does not describe the transaction's terminating event
--let $assert_count = 1
--source include/assert_grep.inc
--let $assert_text = Recovery trims the incomplete transaction from the file, as without the header.
--let $assert_select = Binlog trimmed to
--let $assert_count = 1
--source include/assert_grep.inc

############################################################################
# Case 3: Recover a BOLT transaction with source_verify_checksum ON.
# Expected behavior: the transaction is read sequentially and commits.
############################################################################
--echo # Commit a third qualifying transaction for recovery with checksum verification.
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
SET GLOBAL max_binlog_size = 1073741824;
--let $binlog_file_before_verify = query_get_value(SHOW BINARY LOG STATUS, File, 1)
BEGIN;
INSERT INTO t1 VALUES (7, REPEAT('g', 4000000));
INSERT INTO t1 VALUES (8, REPEAT('h', 4000000));
INSERT INTO t1 VALUES (9, REPEAT('i', 4000000));
COMMIT;
--let $verify_file = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_text = The third transaction's spilled file was promoted into a new binary log file.
--let $assert_cond = "$verify_file" != "$binlog_file_before_verify"
--source include/assert.inc

--let $gtid_executed_before_verify = `SELECT @@GLOBAL.gtid_executed`
--let $restart_parameters = restart: --source-verify-checksum=ON
--source include/kill_and_restart_mysqld.inc

--let $assert_text = R4: recovery logs that source_verify_checksum disabled the optimized recovery.
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_only_after = CURRENT_TEST: binlog.binlog_bolt_optimized_recovery
--let $assert_select = Read a large transaction sequentially during recovery of binary log file .*, because source_verify_checksum is enabled
--let $assert_count = 1
--source include/assert_grep.inc
--let $assert_text = R4: recovery does not seek past the body; only case 1 logged a seek.
--let $assert_select = Optimized binary log recovery by avoiding a sequential read of a large transaction body
--let $assert_count = 1
--source include/assert_grep.inc
--let $assert_text = R4: the BOLT transaction survives recovery.
--let $assert_cond = [SELECT COUNT(*) AS count FROM t1 WHERE id >= 7, count, 1] = 3
--source include/assert.inc
--let $assert_text = R4: the transaction's GTID is in gtid_executed after recovery.
--let $assert_cond = "[SELECT @@GLOBAL.gtid_executed]" = "$gtid_executed_before_verify"
--source include/assert.inc
--let $restart_parameters = restart
--source include/restart_mysqld.inc

############################################################################
# Case 4: Recover a BOLT transaction written with binlog_checksum = NONE.
# Expected behavior: recovery seeks past the body, and the transaction commits.
############################################################################
--echo # Commit a fourth qualifying transaction without event checksums.
--let $save_checksum = `SELECT @@GLOBAL.binlog_checksum`
SET GLOBAL binlog_checksum = NONE;
SET GLOBAL binlog_large_transaction_optimization_enabled = ON;
SET GLOBAL binlog_large_transaction_optimization_threshold = 10485760;
SET GLOBAL max_binlog_size = 1073741824;
--let $binlog_file_before_none = query_get_value(SHOW BINARY LOG STATUS, File, 1)
BEGIN;
INSERT INTO t1 VALUES (10, REPEAT('j', 4000000));
INSERT INTO t1 VALUES (11, REPEAT('k', 4000000));
INSERT INTO t1 VALUES (12, REPEAT('l', 4000000));
COMMIT;
--let $none_file = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_text = The fourth transaction's spilled file was promoted into a new binary log file.
--let $assert_cond = "$none_file" != "$binlog_file_before_none"
--source include/assert.inc

--let $restart_parameters = restart: --binlog-checksum=NONE
--source include/kill_and_restart_mysqld.inc

--let $assert_text = R5: recovery seeks past the body of a transaction without event checksums.
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_only_after = CURRENT_TEST: binlog.binlog_bolt_optimized_recovery
--let $assert_select = Optimized binary log recovery by avoiding a sequential read of a large transaction body
--let $assert_count = 2
--source include/assert_grep.inc
--let $assert_text = R5: the BOLT transaction survives recovery.
--let $assert_cond = [SELECT COUNT(*) AS count FROM t1 WHERE id >= 10, count, 1] = 3
--source include/assert.inc
--let $restart_parameters = restart
--source include/restart_mysqld.inc
--disable_query_log
--eval SET GLOBAL binlog_checksum = $save_checksum
--enable_query_log

# Cleanup
DROP TABLE t1;
--disable_query_log
--eval SET GLOBAL binlog_large_transaction_optimization_enabled = $save_enabled
--eval SET GLOBAL binlog_large_transaction_optimization_threshold = $save_threshold
--eval SET GLOBAL max_binlog_size = $save_max_binlog_size
--enable_query_log
