#
# === Purpose ===
# A transaction commits through the BOLT path by a binary log rotation that
# promotes its spilled binlog cache file. Verify how failures are handled:
# before the spilled file replaces the new binary log file, a failure falls
# back to the standard commit path; after it, the failure is a rotation error,
# and binlog_error_action applies, as for any rotation in the flush stage.
#
# === Requirements ===
# R1. A failure to make the spilled file durable falls back: the transaction
#     commits, its rows are in the binary log, and it is counted as a missed
#     optimization.
# R2. A failure after the rename with binlog_error_action = ABORT_SERVER
#     aborts the server, the client is told binary logging is not possible,
#     and after the restart the transaction is in neither the engine nor the
#     binary log.
# R3. The same failure with binlog_error_action = IGNORE_ERROR is reported in
#     the error log and the transaction still commits in the engine, while
#     nothing of it reaches the binary log.
#
# === Implementation ===
# R1 uses the fail_bolt_spill_file_sync debug point; R2 and R3 use
# fail_bolt_promoted_file_reopen, which fails reopening the promoted file
# after the rename. Each case resets the binary log first so the file at
# index 1 is the active one.
#
# The error log is redirected to its own file because ABORT_SERVER goes through
# the crash handler, whose backtrace MTR would otherwise flag.
#
--source include/not_crashrep.inc
--source include/not_valgrind.inc
--source include/have_debug.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc

--let $save_error_action = query_get_value(SELECT @@GLOBAL.binlog_error_action, @@GLOBAL.binlog_error_action, 1)
--let $save_compression = query_get_value(SELECT @@SESSION.binlog_transaction_compression, @@SESSION.binlog_transaction_compression, 1)
--let $MYSQLD_DATADIR = `SELECT @@DATADIR`

CALL mtr.add_suppression("An error occurred during flush stage of the commit");
CALL mtr.add_suppression("Could not optimize large transaction execution in the binary log because the spilled binary log cache file could not be promoted");
CALL mtr.add_suppression("Could not use .* for logging");
CALL mtr.add_suppression("Could not open .* for logging");
CALL mtr.add_suppression("Either disk is full, file system is read only");
CALL mtr.add_suppression("Binary logging not possible");
CALL mtr.add_suppression("Hence turning logging off for the whole duration");

--disable_query_log
--disable_warnings
DROP TABLE IF EXISTS t1;
# The payload repeats a single byte, so compression would shrink the cache far
# below the threshold and the transaction would never spill.
SET SESSION binlog_transaction_compression = OFF;
--enable_warnings
--enable_query_log
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;

############################################################################
# Case 0: the spilled file cannot be made durable.
# Expected behavior: the transaction falls back to the standard commit path.
############################################################################
--echo # R1: a spill-sync failure falls back to the standard commit path.
--disable_query_log
RESET BINARY LOGS AND GTIDS;
--enable_query_log
--let $missed_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_missed_count', Value, 1)
--let $bolt_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
--disable_query_log
--disable_result_log
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
SET SESSION DEBUG="+d,fail_bolt_spill_file_sync";
COMMIT;
SET SESSION DEBUG="-d,fail_bolt_spill_file_sync";
--enable_result_log
--enable_query_log
--let $missed_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_missed_count', Value, 1)
--let $bolt_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
--let $assert_text = R1: the transaction's spilled file is not promoted.
--let $assert_cond = $bolt_after = $bolt_before
--source include/assert.inc
--let $assert_text = R1: it is counted as a missed optimization.
--let $assert_cond = $missed_after = $missed_before + 1
--source include/assert.inc
--let $assert_text = R1: every row is committed.
--let $assert_cond = [SELECT COUNT(*) AS count FROM t1, count, 1] = 3
--source include/assert.inc
--let $bolt_log_file = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $bolt_dump = $MYSQLTEST_VARDIR/tmp/bolt_error_action_dump.txt
--exec $MYSQL_BINLOG --force-if-open $MYSQLD_DATADIR/$bolt_log_file > $bolt_dump
--let $assert_file = $bolt_dump
--let $assert_text = R1: the transaction is in the binary log.
--let $assert_select = Xid
--let $assert_count = 1
--source include/assert_grep.inc
--remove_file $bolt_dump
--disable_query_log
TRUNCATE t1;
--enable_query_log

############################################################################
# Case 1: binlog_error_action = ABORT_SERVER.
# Expected behavior: the server aborts, and the transaction reaches neither
# the engine nor the binary log.
#
# The spilled file is never promoted, so the transaction is in no binary log
# file and recovery has no reason to roll it forward.
############################################################################
--echo # R2: a failure after the rename with ABORT_SERVER aborts the server.
SET GLOBAL binlog_error_action = ABORT_SERVER;
--disable_query_log
RESET BINARY LOGS AND GTIDS;
--enable_query_log
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--disable_query_log
--disable_result_log
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('c', 4000000));
SET SESSION DEBUG="+d,fail_bolt_promoted_file_reopen";
--error ER_BINLOG_LOGGING_IMPOSSIBLE
COMMIT;
--enable_result_log
--enable_query_log
--source include/wait_until_disconnected.inc
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--source include/wait_until_connected_again.inc
--exec grep -q "Either disk is full, file system is read only or there was an encryption error while opening the binlog. Aborting the server." $MYSQLTEST_VARDIR/tmp/binlog_bolt_error_action.err
--let $assert_text = R2: the aborted promotion commits no rows.
--let $assert_cond = [SELECT COUNT(*) AS count FROM t1, count, 1] = 0
--source include/assert.inc
--let $bolt_log_file = query_get_value("SHOW BINARY LOGS", Log_name, 1)
--let $bolt_dump = $MYSQLTEST_VARDIR/tmp/bolt_error_action_dump.txt
--exec $MYSQL_BINLOG --force-if-open $MYSQLD_DATADIR/$bolt_log_file > $bolt_dump
--let $assert_file = $bolt_dump
--let $assert_text = R2: the aborted promotion writes no transaction to the binary log.
--let $assert_select = Write_rows
--let $assert_count = 0
--source include/assert_grep.inc
--remove_file $bolt_dump

############################################################################
# Case 2: binlog_error_action = IGNORE_ERROR.
# Expected behavior: binary logging is turned off for the rest of the server
# process and the transaction commits in the engine.
#
# That binlog/engine divergence is what IGNORE_ERROR means, and is what the
# standard path does for the same error.
############################################################################
--echo # R3: a failure after the rename with IGNORE_ERROR keeps the commit and stops logging.
--disable_query_log
TRUNCATE t1;
RESET BINARY LOGS AND GTIDS;
--enable_query_log
SET GLOBAL binlog_error_action = IGNORE_ERROR;
# Captured before the failure: once logging is off, SHOW BINARY LOGS fails with
# ER_NO_BINARY_LOGGING.
--let $bolt_log_file = query_get_value("SHOW BINARY LOGS", Log_name, 1)
--disable_query_log
--disable_result_log
BEGIN;
INSERT INTO t1 VALUES (1, REPEAT('d', 4000000));
INSERT INTO t1 VALUES (2, REPEAT('e', 4000000));
INSERT INTO t1 VALUES (3, REPEAT('f', 4000000));
SET SESSION DEBUG="+d,fail_bolt_promoted_file_reopen";
COMMIT;
SET SESSION DEBUG="-d,fail_bolt_promoted_file_reopen";
--enable_result_log
--enable_query_log
--let $assert_text = R3: the ignored failure still commits all rows.
--let $assert_cond = [SELECT COUNT(*) AS count FROM t1, count, 1] = 3
--source include/assert.inc
# The rotation turns logging off, as binlog_error_action = IGNORE_ERROR asks.
--exec grep -q "Could not use .*binlog.000002 for logging (error 0). Turning logging off for the whole duration of the MySQL server process." $MYSQLTEST_VARDIR/tmp/binlog_bolt_error_action.err
# Binary logging is off at this point, so restart before reading the log back.
--let $do_not_echo_parameters = 1
--source include/restart_mysqld.inc
#
# Assert on the decoded contents, not the file size: the rotation appended a
# Rotate event to the binary log, and the promoted file was removed.
#
--let $bolt_dump = $MYSQLTEST_VARDIR/tmp/bolt_error_action_dump.txt
--exec $MYSQL_BINLOG --force-if-open $MYSQLD_DATADIR/$bolt_log_file > $bolt_dump
--let $assert_file = $bolt_dump
--let $assert_text = R3: the ignored failure writes no row events to the binary log.
--let $assert_select = Write_rows
--let $assert_count = 0
--source include/assert_grep.inc
--let $assert_text = R3: the ignored failure writes no transaction to the binary log.
--let $assert_select = Xid
--let $assert_count = 0
--source include/assert_grep.inc
--remove_file $bolt_dump

# Cleanup
DROP TABLE t1;
--disable_query_log
--disable_warnings
--eval SET GLOBAL binlog_error_action = $save_error_action
--eval SET SESSION binlog_transaction_compression = $save_compression
RESET BINARY LOGS AND GTIDS;
--enable_warnings
--enable_query_log
