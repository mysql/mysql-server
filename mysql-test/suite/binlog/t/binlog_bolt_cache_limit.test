# BOLT stands for Binary-log Optimization for Large Transactions.
#
# === Purpose ===
# max_binlog_cache_size limits the bytes a transaction's binlog cache stores.
# A cache rewritten into binlog file form at its first spill stores a CRC32
# footer after every event, and the footers count against the limit. Verify
# that the limit applies to a rewritten cache, and that with CRC32 fewer
# statements fit than with the optimization OFF.
#
# === Requirements ===
# R1. With the optimization ON, a transaction whose cache was rewritten still
#     stops with ER_TRANS_CACHE_FULL.
# R2. With binlog_checksum=CRC32, the footers count against
#     max_binlog_cache_size, so fewer statements fit with the optimization ON
#     than OFF.
#
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/not_binlog_transaction_compression_on.inc

--let $save_enabled = `SELECT @@GLOBAL.binlog_large_transaction_optimization_enabled`
--let $save_checksum = `SELECT @@GLOBAL.binlog_checksum`
--let $save_cache_size = `SELECT @@GLOBAL.binlog_cache_size`
--let $save_max_cache_size = `SELECT @@GLOBAL.max_binlog_cache_size`

SET GLOBAL binlog_checksum = CRC32;
SET GLOBAL binlog_cache_size = 4096;
SET GLOBAL max_binlog_cache_size = 65536;
CREATE TABLE t1 (id INT PRIMARY KEY, data VARCHAR(32)) ENGINE=InnoDB;

--let $round = 1
while ($round <= 2)
{
  --let $knob = OFF
  if ($round == 2)
  {
    --let $knob = ON
  }
  --eval SET GLOBAL binlog_large_transaction_optimization_enabled = $knob
  # A new session opens its binlog cache with the sizes set above.
  --connect (limit_session, localhost, root,,)
  --disable_query_log
  BEGIN;
  --let $statements = 0
  --let $full = 0
  while (!$full)
  {
    --error 0, ER_TRANS_CACHE_FULL
    --eval INSERT INTO t1 VALUES ($statements, REPEAT('x', 20))
    if ($mysql_errno)
    {
      --let $full = 1
    }
    if (!$mysql_errno)
    {
      --inc $statements
    }
  }
  ROLLBACK;
  --enable_query_log
  --disconnect limit_session
  --connection default
  if ($round == 1)
  {
    --let $statements_off = $statements
  }
  if ($round == 2)
  {
    --let $statements_on = $statements
  }
  --inc $round
}

--let $assert_text = R1: the limit stops a rewritten cache after many statements.
--let $assert_cond = $statements_on > 100
--source include/assert.inc
--let $assert_text = R2: the footers count, so fewer statements fit with the optimization ON.
--let $assert_cond = $statements_on < $statements_off
--source include/assert.inc

DROP TABLE t1;
--disable_query_log
--eval SET GLOBAL binlog_large_transaction_optimization_enabled = $save_enabled
--eval SET GLOBAL binlog_checksum = $save_checksum
--eval SET GLOBAL binlog_cache_size = $save_cache_size
--eval SET GLOBAL max_binlog_cache_size = $save_max_cache_size
--enable_query_log
