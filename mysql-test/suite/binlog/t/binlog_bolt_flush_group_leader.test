# BOLT stands for Binary-log Optimization for Large Transactions.
#
# === Purpose ===
# A large transaction commits through the BOLT path by promoting its spilled
# binlog cache file in the flush stage, which rotates the binary log. It must
# be the first transaction of its flush group, its leader: while another
# flush group is forming, it waits, and the leader that fetches that group
# makes it the leader of the next one. Verify this while another
# transaction's flush group is forming.
#
# === Requirements ===
# R1. While another session leads a flush group that has not been fetched,
#     the large transaction does not join that group: it waits.
# R2. Once that group is fetched, the large transaction leads a new group and
#     is promoted; the waiting session's transaction stays in the previous
#     binary log file.
# R3. Every row is committed and every binary log file verifies.
#
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/not_binlog_transaction_compression_on.inc

--let $MYSQLD_DATADIR = `SELECT @@DATADIR`
--let $save_checksum = query_get_value(SELECT @@GLOBAL.binlog_checksum, @@GLOBAL.binlog_checksum, 1)
SET GLOBAL binlog_checksum = CRC32;
RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
--connect (con_small, localhost, root,,)
--connect (con_big, localhost, root,,)

--echo # R1: a small transaction leads a flush group and pauses before it is fetched.
--connection con_small
--let $file_before = query_get_value(SHOW BINARY LOG STATUS, File, 1)
SET DEBUG_SYNC = 'bgc_after_enrolling_for_flush_stage SIGNAL small_enrolled WAIT_FOR small_go';
--send INSERT INTO t1 VALUES (1, 'small')

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR small_enrolled';

--connection con_big
--let $bolt_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
BEGIN;
--disable_query_log
INSERT INTO t1 VALUES (11, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (12, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (13, REPEAT('c', 4000000));
--enable_query_log
SET DEBUG_SYNC = 'bgc_flush_leader_candidate_waiting SIGNAL big_waiting';
--send COMMIT

--connection default
# The large transaction does not join the group: it waits as a candidate.
SET DEBUG_SYNC = 'now WAIT_FOR big_waiting';
--let $assert_text = R1: nothing is promoted yet.
--let $assert_cond = [SHOW GLOBAL STATUS LIKE "Binlog_large_transaction_optimization_count", Value, 1] = $bolt_before
--source include/assert.inc
SET DEBUG_SYNC = 'now SIGNAL small_go';

--connection con_small
--reap
SET DEBUG_SYNC = 'RESET';
--connection con_big
--reap
SET DEBUG_SYNC = 'RESET';

--echo # R2: the large transaction led its own group and was promoted.
--connection default
--let $bolt_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
--let $assert_text = R2: the large transaction's spilled file is promoted.
--let $assert_cond = $bolt_after = $bolt_before + 1
--source include/assert.inc
--let $file_after = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--let $assert_text = R2: the promotion opened a new binary log file.
--let $assert_cond = "$file_after" != "$file_before"
--source include/assert.inc
--let $small_inc = $MYSQLTEST_VARDIR/tmp/bolt_flush_group_leader_small.inc
--exec $MYSQL_BINLOG -v $MYSQLD_DATADIR/$file_before | grep -c "@1=1$" | xargs printf -- '--let \044small_rows = %s\n' > $small_inc
--source $small_inc
--remove_file $small_inc
--let $assert_text = R2: the small transaction is in the previous binary log file.
--let $assert_cond = $small_rows = 1
--source include/assert.inc

--echo # R3: every row is committed and the binary logs verify.
--let $assert_text = R3: every row is committed.
--let $assert_cond = [SELECT COUNT(*) FROM t1] = 4
--source include/assert.inc
--exec $MYSQL_BINLOG --verify-binlog-checksum $MYSQLD_DATADIR/$file_before > /dev/null
--exec $MYSQL_BINLOG --force-if-open --verify-binlog-checksum $MYSQLD_DATADIR/$file_after > /dev/null

--disconnect con_small
--disconnect con_big
DROP TABLE t1;
--disable_query_log
--eval SET GLOBAL binlog_checksum = $save_checksum
--enable_query_log
