# BOLT stands for Binary-log Optimization for Large Transactions.
#
# === Purpose ===
# A large transaction that promotes its spilled binlog cache file must lead
# its flush group. When it finds the flush queue not empty, it waits in a
# first-in, first-out candidate list, and the leader that fetches the flush
# queue appends the first candidate to the emptied queue as the leader of the
# next group. Verify this handoff with two waiting large transactions and a
# small transaction that commits right after the fetch.
#
# === Requirements ===
# R1. Large transactions that find the flush queue not empty wait as
#     candidates, and nothing is promoted while they wait.
# R2. A small transaction that enrolls after the fetch joins the group of the
#     first candidate, behind it, in its promoted binary log file.
# R3. Each candidate leads its own group in arrival order, so both are
#     promoted, each into its own binary log file.
# R4. Every row is committed and every binary log file verifies.
#
--source include/have_debug_sync.inc
--source include/have_log_bin.inc
--source include/have_binlog_format_row.inc
--source include/not_binlog_transaction_compression_on.inc

--let $MYSQLD_DATADIR = `SELECT @@DATADIR`
--let $save_checksum = query_get_value(SELECT @@GLOBAL.binlog_checksum, @@GLOBAL.binlog_checksum, 1)
SET GLOBAL binlog_checksum = CRC32;
RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB) ENGINE=InnoDB;
--let $bolt_before = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
--connect (con_small, localhost, root,,)
--connect (con_late, localhost, root,,)
--connect (con_big1, localhost, root,,)
--connect (con_big2, localhost, root,,)

--echo # A small transaction leads a flush group and pauses before the fetch.
--connection con_small
SET DEBUG_SYNC = 'bgc_after_enrolling_for_flush_stage SIGNAL small_enrolled WAIT_FOR small_go';
SET DEBUG_SYNC = 'bgc_after_flush_stage_before_sync_stage SIGNAL small_fetched WAIT_FOR small_go_on';
--send INSERT INTO t1 VALUES (1, 'small')

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR small_enrolled';

--echo # R1: two large transactions wait as candidates, in this order.
--connection con_big1
BEGIN;
--disable_query_log
INSERT INTO t1 VALUES (11, REPEAT('a', 4000000));
INSERT INTO t1 VALUES (12, REPEAT('b', 4000000));
INSERT INTO t1 VALUES (13, REPEAT('c', 4000000));
--enable_query_log
SET DEBUG_SYNC = 'bgc_flush_leader_candidate_waiting SIGNAL big1_waiting';
--send COMMIT

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR big1_waiting';

--connection con_big2
BEGIN;
--disable_query_log
INSERT INTO t1 VALUES (21, REPEAT('d', 4000000));
INSERT INTO t1 VALUES (22, REPEAT('e', 4000000));
INSERT INTO t1 VALUES (23, REPEAT('f', 4000000));
--enable_query_log
SET DEBUG_SYNC = 'bgc_flush_leader_candidate_waiting SIGNAL big2_waiting';
--send COMMIT

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR big2_waiting';
--let $assert_text = R1: nothing is promoted while the candidates wait.
--let $assert_cond = [SHOW GLOBAL STATUS LIKE "Binlog_large_transaction_optimization_count", Value, 1] = $bolt_before
--source include/assert.inc

--echo # R2: the small group is fetched, then a late transaction enrolls.
SET DEBUG_SYNC = 'now SIGNAL small_go';
SET DEBUG_SYNC = 'now WAIT_FOR small_fetched';

--connection con_late
SET DEBUG_SYNC = 'bgc_after_enrolling_for_flush_stage SIGNAL late_enrolled';
--send INSERT INTO t1 VALUES (2, 'late')

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR late_enrolled';
SET DEBUG_SYNC = 'now SIGNAL small_go_on';

--connection con_small
--reap
SET DEBUG_SYNC = 'RESET';
--connection con_late
--reap
SET DEBUG_SYNC = 'RESET';
--connection con_big1
--reap
SET DEBUG_SYNC = 'RESET';
--connection con_big2
--reap
SET DEBUG_SYNC = 'RESET';

--connection default
SET DEBUG_SYNC = 'RESET';
--let $file_small = query_get_value(SHOW BINARY LOGS, Log_name, 1)
--let $file_big1 = query_get_value(SHOW BINARY LOGS, Log_name, 2)
--let $file_big2 = query_get_value(SHOW BINARY LOGS, Log_name, 3)

--let $rows_inc = $MYSQLTEST_VARDIR/tmp/bolt_flush_leader_handoff_rows.inc
--exec $MYSQL_BINLOG -v $MYSQLD_DATADIR/$file_small | grep -c "@1=1$" | xargs printf -- '--let \044small_rows = %s\n' > $rows_inc
--exec $MYSQL_BINLOG -v $MYSQLD_DATADIR/$file_big1 | grep -c "@1=2$" | xargs printf -- '--let \044late_rows = %s\n' >> $rows_inc
--exec $MYSQL_BINLOG -v $MYSQLD_DATADIR/$file_big1 | grep -o "@1=\(11\|2\)$" | tr '\n' ',' | xargs printf -- '--let \044big1_order = %s\n' >> $rows_inc
--exec $MYSQL_BINLOG -v --force-if-open $MYSQLD_DATADIR/$file_big2 | grep -c "@1=21$" | xargs printf -- '--let \044big2_rows = %s\n' >> $rows_inc
--source $rows_inc
--remove_file $rows_inc

--let $assert_text = R2: the small transaction is in the first binary log file.
--let $assert_cond = $small_rows = 1
--source include/assert.inc
--let $assert_text = R2: the late transaction is in the first candidate's promoted file.
--let $assert_cond = $late_rows = 1
--source include/assert.inc
--let $assert_text = R2: the late transaction is written behind the first candidate.
--let $assert_cond = "$big1_order" = "@1=11,@1=2,"
--source include/assert.inc

--echo # R3: both candidates are promoted, each into its own file, in order.
--let $bolt_after = query_get_value(SHOW GLOBAL STATUS LIKE 'Binlog_large_transaction_optimization_count', Value, 1)
--let $assert_text = R3: both large transactions are promoted.
--let $assert_cond = $bolt_after = $bolt_before + 2
--source include/assert.inc
--let $assert_text = R3: the second candidate leads the next group, in the next file.
--let $assert_cond = $big2_rows = 1
--source include/assert.inc

--echo # R4: every row is committed and the binary logs verify.
--let $assert_text = R4: every row is committed.
--let $assert_cond = [SELECT COUNT(*) FROM t1] = 8
--source include/assert.inc
--exec $MYSQL_BINLOG --verify-binlog-checksum $MYSQLD_DATADIR/$file_small > /dev/null
--exec $MYSQL_BINLOG --verify-binlog-checksum $MYSQLD_DATADIR/$file_big1 > /dev/null
--exec $MYSQL_BINLOG --force-if-open --verify-binlog-checksum $MYSQLD_DATADIR/$file_big2 > /dev/null

--disconnect con_small
--disconnect con_late
--disconnect con_big1
--disconnect con_big2
DROP TABLE t1;
--disable_query_log
--eval SET GLOBAL binlog_checksum = $save_checksum
--enable_query_log
