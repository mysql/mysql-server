RESET BINARY LOGS AND GTIDS;
#
# R5: empty GTID_EXECUTED (must return an empty GTID set)
#
SET SESSION session_track_gtids = 'ALL_GTIDS';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
SET SESSION session_track_gtids = 'OFF';
CREATE TABLE t1 (c1 INT PRIMARY KEY) ENGINE=InnoDB;
#
# R1: the snapshot returns its GTID set (must return GTID:1)
#
SET SESSION session_track_gtids = 'ALL_GTIDS';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
#
# R2: a commit is visible in InnoDB, its GTID is not in GTID_EXECUTED yet
#
SET DEBUG_SYNC = 'bgc_after_commit_in_engines_before_gtid_update SIGNAL engines_done WAIT_FOR continue_commit';
INSERT INTO t1 VALUES (1);
SET DEBUG_SYNC = 'now WAIT_FOR engines_done';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
# The snapshot cannot finish while the commit holds LOCK_commit
SET DEBUG_SYNC = 'now SIGNAL continue_commit';
# Must return GTID:1-2 and see the row
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-2

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

SELECT * FROM t1;
c1
1
COMMIT;
#
# R3: implicit commit before the snapshot (must return GTID:1-3)
#
BEGIN;
INSERT INTO t1 VALUES (2);
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_GTIDS
-- 00000000-1111-0000-1111-000000000000:1-3

-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

SELECT * FROM t1;
c1
1
2
COMMIT;
#
# R4: OWN_GTID returns nothing for the snapshot
#
SET SESSION session_track_gtids = 'OWN_GTID';
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

COMMIT;
#
# R4: READ COMMITTED takes no snapshot, so no snapshot GTID set
#
SET SESSION session_track_gtids = 'ALL_GTIDS';
SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;
START TRANSACTION WITH CONSISTENT SNAPSHOT;
-- Tracker : SESSION_TRACK_TRANSACTION_STATE
-- T_R_____

Warnings:
Warning	138	InnoDB: WITH CONSISTENT SNAPSHOT was ignored because this phrase can only be used with REPEATABLE READ isolation level.
COMMIT;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET DEBUG_SYNC = 'RESET';
DROP TABLE t1;
RESET BINARY LOGS AND GTIDS;
