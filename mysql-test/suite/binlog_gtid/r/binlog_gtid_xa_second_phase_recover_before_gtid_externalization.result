RESET BINARY LOGS AND GTIDS;
CREATE TABLE t1 (a INT);
SET @@SESSION.xa_detach_on_prepare = ON;
XA START 'xa_commit';
INSERT INTO t1 VALUES (1);
XA END 'xa_commit';
XA PREPARE 'xa_commit';
SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1';
include/execute_to_conditional_timestamp_sync_point.inc [after_call_actions_before_gtid_state_update]
XA COMMIT 'xa_commit';
include/assert.inc [No XA transactions in PREPARED state]
include/assert.inc [GTID_EXECUTED does not contain the XA COMMIT GTID yet]
include/execute_from_conditional_timestamp_sync_point.inc [1@after_call_actions_before_gtid_state_update]
include/assert.inc [GTID_EXECUTED contains the XA COMMIT GTID]
SET GTID_NEXT = AUTOMATIC;
XA START 'xa_rollback';
INSERT INTO t1 VALUES (2);
XA END 'xa_rollback';
XA PREPARE 'xa_rollback';
SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:2';
include/execute_to_conditional_timestamp_sync_point.inc [after_call_actions_before_gtid_state_update]
XA ROLLBACK 'xa_rollback';
include/assert.inc [No XA transactions in PREPARED state]
include/assert.inc [GTID_EXECUTED does not contain the XA ROLLBACK GTID yet]
include/execute_from_conditional_timestamp_sync_point.inc [1@after_call_actions_before_gtid_state_update]
include/assert.inc [GTID_EXECUTED contains the XA ROLLBACK GTID]
SET GTID_NEXT = AUTOMATIC;
SELECT * FROM t1;
a
1
DROP TABLE t1;
RESET BINARY LOGS AND GTIDS;
