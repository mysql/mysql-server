<timestamp>	<mysqld>	<pid>	<vm_rss>	<vm_data>	<vm_swap>	<page_faults>
<timestamp>	<mysqld>	<pid>	<vm_rss>	<vm_data>	<vm_swap>	<page_faults>
<timestamp>	<mysqld>	<pid>	<vm_rss>	<vm_data>	<vm_swap>	<page_faults>
<timestamp>	<mysqld>	<pid>	<vm_rss>	<vm_data>	<vm_swap>	<page_faults>

###
### Verify new data replaces old data
###

truncate health_system_memory;
truncate health_process_memory;

set @@global.health_monitor.memory_running = on;

#
# Wait for 8 rows
#

set @@global.health_monitor.memory_running = off;

#
# Save the timestamps of the first and last rows
#
select timestamp from health_system_memory limit 0,1 into @sm_oldest_1;
select timestamp from health_system_memory limit 7,1 into @sm_newest_1;

select timestamp from health_process_memory limit 0,1 into @pm_oldest_1;
select timestamp from health_process_memory limit 7,1 into @pm_newest_1;

#
# Verify that the newer timestamp is greater
#
select @sm_newest_1 > @sm_oldest_1 as 'Expect 1';
Expect 1
1
select @pm_newest_1 > @pm_oldest_1 as 'Expect 1';
Expect 1
1

#
# Generate a few more rows to ensure the data wraps
#
set @@global.health_monitor.memory_running = on;
Sleep 3
set @@global.health_monitor.memory_running = off;

select timestamp from health_system_memory limit 0,1 into @sm_oldest_2;
select timestamp from health_system_memory limit 7,1 into @sm_newest_2;

select timestamp from health_process_memory limit 0,1 into @pm_oldest_2;
select timestamp from health_process_memory limit 7,1 into @pm_newest_2;

#
# Verify that the timestamps changed and that the newer timestamp is greater
#
select @sm_oldest_2 > @sm_oldest_1 as 'Expect 1';
Expect 1
1
select @sm_newest_2 > @sm_newest_1 as 'Expect 1';
Expect 1
1

select @pm_oldest_2 > @pm_oldest_1 as 'Expect 1';
Expect 1
1
select @pm_newest_2 > @pm_newest_1 as 'Expect 1';
Expect 1
1

###
### Status message interval
###

set @@global.health_monitor.memory_running = off;
#
# Set the sample rate to 3 seconds and status interval to 1
# Expect a status message after 3 seconds
#
set @@global.health_monitor.memory_sample_rate = 3;
set @@global.health_monitor.status_interval = 1;
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = off;

#
# Run for 6 seconds, generate some status messages
#
set @@global.health_monitor.memory_running = off;

#
# Verify status update message was issued
#
Pattern "Memory: avail=" found

###
### Revoke and uninstall
###

REVOKE PROCESS ON *.* FROM 'mysql.session'@localhost;
REVOKE SELECT ON sys.* FROM 'mysql.session'@localhost;
REVOKE EXECUTE ON sys.* FROM 'mysql.session'@localhost;

uninstall component 'file://component_health_monitor';;
