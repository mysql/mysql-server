<timestamp>	<total_memory>	<available>	<use_pct>	<memory_free>	<fs_cache>	<swap_total>	<swap_free>
<timestamp>	<total_memory>	<available>	<use_pct>	<memory_free>	<fs_cache>	<swap_total>	<swap_free>
