##
## Test the Health Monitor component
##
## Test cases:
##   0. Parallel selects on on-demand tables
##   1. Enable/disable history tables
##   2. Table resize

## Test case initialization - Begin

# Storage quantities allow up to ULONG_MAX - 1
set @ulong_max = 18446744073709551615;
set @max_level = @ulong_max - 1;

# A very high offline level will force the offline mode
set @force_offline_mode = @max_level;

# Disk usage warning level = 100% will force warnings, 0% will disable warnings
set @force_disk_warning = 100;
set @no_disk_warning = 0;

# Memory usage warning level = ULONG_MAX-1 will force warnings, 0 will disable warnings
set @force_memory_warning = @max_level;
set @no_memory_warning = 0;

# Ignore warnings during startup
set session sql_log_bin = 0;
call mtr.add_suppression("Disk: Normal");
call mtr.add_suppression("Disk: Warning");
call mtr.add_suppression("Disk: Low Level");
call mtr.add_suppression("Disk: Critical");
call mtr.add_suppression("Disk: Error");
call mtr.add_suppression("Disk: Available space");
call mtr.add_suppression("Disk: Fallback");
call mtr.add_suppression("Disk: Recovery");
call mtr.add_suppression("Disk: Maximum recovery cycles");
call mtr.add_suppression("Disk: OFFLINE_MODE");
call mtr.add_suppression("Disk: SUPER_READ_ONLY");
call mtr.add_suppression("Disk Collector: Error");
call mtr.add_suppression("Memory: Warning");
set session sql_log_bin = 1;

# Install the component
install component 'file://component_health_monitor';

# Turn off the collectors
set @@global.health_monitor.periodic_reporting = off;
set @@global.health_monitor.memory_reporting = off;
set @@global.health_monitor.disk_running = off;
set @@global.health_monitor.memory_running = off;
set @@global.health_monitor.system_running = off;

# Disable low disk space warnings
set @@global.health_monitor.disk_usage_warning_level_1 = @no_disk_warning;
set @@global.health_monitor.disk_usage_warning_level_2 = @no_disk_warning;
set @@global.health_monitor.disk_usage_warning_level_3 = @no_disk_warning;

# Disable low memory warnings
set @@global.health_monitor.memory_usage_warning_level_1 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @no_memory_warning;

# Disable the low level storage thresholds to avoid inadvertently triggering
# fallback mode on the vardir volume
set @@global.health_monitor.disk_low_space_level = 0;
set @@global.health_monitor.disk_low_space_percent = 0;
set @@global.health_monitor.disk_low_space_critical_level = 0;
# Disable recovery mode
set @@global.health_monitor.disk_recovery_enable = off;

# Fallback mode may have been triggered when the component was loaded,
# so reset offline_mode and super_read_only as a precaution.
# The 'super_read_only_disk_full' status variable will be reset when the
# monitored disk path is changed.

set @@global.super_read_only = off;
set @@global.read_only = off;
set @@global.offline_mode = off;

# Set monitored disk after disabling the low space thresholds
set @@global.health_monitor.disk_monitored = 'MYSQLTEST_VARDIR';

select @@global.offline_mode;
@@global.offline_mode
0
select @@global.super_read_only;
@@global.super_read_only
0
select @@global.read_only;
@@global.read_only
0
show status like 'super_read_only_disk_full';
Variable_name	Value
super_read_only_disk_full	OFF
show status like 'offline_mode_disk_full';
Variable_name	Value
offline_mode_disk_full	OFF

use performance_schema;

## Test case initialization - End

##
## Parallel selects on the on-demand tables
##
use test;

# Create a table to store results

drop table if exists test.t1;
Warnings:
Note	1051	Unknown table 'test.t1'

create table test.t1 (time varchar(32), con int, iter int, cpu int, disk int, memory int, process int);

# Create a procedure to do repeated selects on the on-demand tables

drop procedure if exists test.select_stat_tables;
Warnings:
Note	1305	PROCEDURE test.select_stat_tables does not exist

create procedure test.select_stat_tables(in n int, in con int)
begin
declare i int;
set i = n;
while i > 0 do
select count(*) from performance_schema.system_cpu_stats into @cpu;
select count(*) from performance_schema.system_disk_stats into @disk;
select count(*) from performance_schema.system_memory_stats into @memory;
select count(*) from performance_schema.system_process_stats into @process;
insert into test.t1 values(now(), con, i, @cpu, @disk, @memory, @process);
set i = i - 1;
end while;
end|

# Start the system collector

set @@global.health_monitor.system_running = ON;

# Connection 1 - select_stat_tables
call test.select_stat_tables(5, 1);;

# Connection 2 - select_stat_tables
call test.select_stat_tables(5, 2);;

# Connection 3 - select_stat_tables
call test.select_stat_tables(5, 3);;

# Connection 4 - select_stat_tables
call test.select_stat_tables(5, 4);;

# Sleep 5

# Reap


select * from test.t1 order by con, iter;
time	con	iter	cpu	disk	memory	process
<time>	1	1	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	1	2	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	1	3	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	1	4	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	1	5	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	2	1	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	2	2	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	2	3	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	2	4	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	2	5	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	3	1	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	3	2	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	3	3	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	3	4	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	3	5	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	4	1	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	4	2	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	4	3	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	4	4	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>
<time>	4	5	<cpu_rows>	<disk_rows>	<memory_rows>	<process_rows>

##
## Enable/disable history tables
##
use performance_schema;

# Stop the system collector, set sample rate to 1 sec

set @@global.health_monitor.system_running = OFF;
set @@global.health_monitor.system_sample_rate = 1;

# Disable and truncate the history tables

set @@global.health_monitor.system_cpu_stats_history = OFF;
set @@global.health_monitor.system_disk_stats_history = OFF;
set @@global.health_monitor.system_memory_stats_history = OFF;
set @@global.health_monitor.system_process_stats_history = OFF;

truncate system_cpu_stats_history;
truncate system_disk_stats_history;
truncate system_memory_stats_history;
truncate system_process_stats_history;

# Start the system collector

set @@global.health_monitor.system_running = ON;

# Expect zero rows for all history tables

include/assert.inc [Expect 0 rows from system_cpu_stats_history]
include/assert.inc [Expect 0 rows from system_disk_stats_history]
include/assert.inc [Expect 0 rows from system_memory_stats_history]
include/assert.inc [Expect 0 rows from system_process_stats_history]

# Enable history tables

set @@global.health_monitor.system_cpu_stats_history = ON;
set @@global.health_monitor.system_disk_stats_history = ON;
set @@global.health_monitor.system_memory_stats_history = ON;
set @@global.health_monitor.system_process_stats_history = ON;

# Wait for 1 sample

# Expect non-zero rows for all history tables

include/assert.inc [Expect > 0 rows from system_cpu_stats_history]
include/assert.inc [Expect platform-appropriate rows from system_disk_stats_history]
include/assert.inc [Expect > 0 rows from system_memory_stats_history]
include/assert.inc [Expect > 0 rows from system_process_stats_history]

##
## History table resize
##

use performance_schema;

# Get the number of processors via system_cpu_stats TODO use system(nprocs)

select count(*) from system_cpu_stats into @ncpus;

# Get the number of attached block devices via system_disk_stats TODO use system(/proc/diskstats)

select count(*) from system_disk_stats into @ndisks;

# Stop the system collector, set sample rate to 1 sec, retention to 10 samples

set @@global.health_monitor.system_running = OFF;
set @@global.health_monitor.system_sample_rate = 1;
set @@global.health_monitor.system_retention = 3;

# Determine expected tables size

set @sample_rate = @@global.health_monitor.system_sample_rate;
set @retention = @@global.health_monitor.system_retention;
set @nsamples = @retention div @sample_rate;

select @nsamples as 'Number of samples';
Number of samples
3

set @cpu_expected = @ncpus * @nsamples;
set @disk_expected = @ndisks * @nsamples;
set @memory_expected = @nsamples;
set @process_expected = @nsamples;

# Start the system collector and wait long enough to fill the history tables

set @@global.health_monitor.system_running = ON;

# Wait for 3 samples

set @@global.health_monitor.system_running = OFF;

select count(*) from system_cpu_stats_history into @cpu_actual;
select count(*) from system_disk_stats_history into @disk_actual;
select count(*) from system_memory_stats_history into @memory_actual;
select count(*) from system_process_stats_history into @process_actual;

# Verify the expected row counts

include/assert.inc [Expect @disk_actual >= @disk_expected]
include/assert.inc [Expect @memory_actual >= @memory_expected]
include/assert.inc [Expect @process_actual >= @process_expected]

##
## Verify that the columns derived from /proc are populated
##

include/assert.inc [Expect (select count(*) from system_cpu_stats where cpu = '' or user_ms = 0 or system_ms = 0) = 0]
include/assert.inc [Expect (select count(*) from system_disk_stats where device = '' or read_count = 0 or read_time_ms = 0) = 0]
include/assert.inc [Expect (select count(*) from system_process_stats where pid = 0 or process_name not like '%mysqld%' or tid = 0) = 0]

##
## Cleanup
##

drop table test.t1;
drop procedure test.select_stat_tables;

uninstall component 'file://component_health_monitor';
