--echo ##
--echo ## Health Monitor component
--echo ##
--echo ## Test updates to the Health Monitor system variables while the
--echo ## disk collector is attempting to set SUPER_READ_ONLY.
--echo ##
--echo ## Bug#35081279	Health Monitor: "SET @@global.health_monitor.disk_sample_rate = 5;" hangs
--echo ##
--echo ## 1. Create an admin user and non-admin user
--echo ## 2. Admin user sets a global table lock
--echo ## 3. Non-admin user sets a global table lock
--echo ## 4. Trigger a critical disk space fallback mode
--echo ##    The Health Monitor will target 1 candidate for termination, but will still be unable
--echo ##    to set SUPER_READ_ONLY because the admin user still holds a global lock.
--echo ##    This creates a window of time to set the system variable.
--echo ## 5. Set a disk system variables while the Health Monitor is attempting to set SUPER_READ_ONLY
--echo ## 6. Wait until server is fenced
--echo ## 7. Verify no deadlocks and that the system variable was changed
--echo ##

--source ../include/health_monitor_setup.inc

--echo
--echo # Enable low disk space fencing explicitly for this supervisor test
set @@global.health_monitor.disk_fallback_enable = on;

--echo
--echo # Connection default
--connection default

let $disk_debug = 0;

--echo
--echo # Low sample rate with status interval = 1 to get a status message every cycle
set @@global.health_monitor.disk_sample_rate = 10;
set @@global.health_monitor.status_interval = 1;

--echo
--echo # Setup the transition to CRITICAL to fence the server
set @@global.health_monitor.disk_low_space_critical_level = @force_offline_mode;

--echo
--echo # Enable the fallback 'force' mode to terminate foreground queries if SUPER_READ_ONLY is blocked
let $fallback_force_save = `select @@global.health_monitor.disk_fallback_force`;
set @@global.health_monitor.disk_fallback_force = 1;

--echo
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
show global variables like "%health%";

--echo
--echo # Create a user that is eligible for termination
create user user1@localhost;
grant all on *.* to user1@localhost;

--echo
--echo # Create a user that is immune from termination
create user mysql_router01@localhost;
grant all on *.* to mysql_router01@localhost;

--echo
--echo # Connect with a protected service account
--echo # Acquire a global lock to block SUPER_READ_ONLY that won't be terminated
connect(con1, localhost, mysql_router01,,);
use test;
create table t1 (c1 int);
lock tables t1 write;

--echo
--echo # Connect with user1
--echo # Acquire a global lock to block SUPER_READ_ONLY that will be terminated
connect(con2, localhost, user1,,);
use test;
create table t2 (c1 int);
lock tables t2 write;

--echo
--echo # Connection default
--connection default

--echo
--echo # Start the disk collector, trigger low disk space response
set @@global.health_monitor.disk_running = on;

--echo
--echo Sleep 20
--sleep 20

--echo
--echo # Wait for CRITICAL state before attempting to set the system variable
let $wait_condition = select count(*) from performance_schema.error_log
                        where data like "%Disk: Critical Level%";
--source include/wait_condition.inc

--echo
--echo Sleep 20
--sleep 20

--echo
--echo # Set a disk system variable while the Health Monitor is attempting to fence the server.
--echo #
--echo # The Health Monitor checks for pending settings changes after processing the storage state.
--echo # The storage state cycle is once every 10 seconds, however, the process of fencing the server
--echo # occurs within a single cycle. In this case, the multiple attempts to set SUPER_READ_ONLY will
--echo # take about 45 seconds.
--echo #
--echo # Once the server is fenced, the cycle ends and the Health Monitor checks for pending updates.
--echo
--echo # Current sample rate is 10
set @@global.health_monitor.disk_sample_rate = 20;

--echo
--echo # Now wait for the server to be fenced indicated by status 'super_read_only_disk_full = ON'.
--echo
--echo # The Health Monitor sets 'super_read_only_disk_full' when it sets SUPER_READ_ONLY = ON,
--echo # but only after completing all retries and, if necessary, terminating foreground queries
--echo # that block setting SUPER_READ_ONLY.
--echo
--echo # Wait for status 'super_read_only_disk_full' = ON
let $wait_timeout = 180;
let $wait_condition = select variable_value = 'ON' from performance_schema.global_status
                        where variable_name like 'super_read_only_disk_full';
--source include/wait_condition.inc

--echo
--echo # The user1 connection should have been terminated
--let $assert_text = Verify the user1 connection was terminated
--let $assert_cond = "[select count(*) from performance_schema.threads where processlist_user in (\'user1\')]" = 0
--source include/assert.inc

--echo
--echo # Connect with the protected service account and release the table lock
--connection con1
unlock tables;

--echo
--echo # Connection default
--connection default

--echo
--echo # Verify that the protected service account was not affected
--let $assert_text = Verify the protected service account is still connected
--let $assert_cond = "[select count(*) from performance_schema.threads where processlist_user in (\'mysql_router01\')]" > 0
--source include/assert.inc
  
--echo
--echo # Verify the system variable was changed
--let $assert_text = Verify the system variable was changed
--let $assert_variable_name = global.health_monitor.disk_sample_rate
--let $assert_variable_value = 20
--source include/assert_variable.inc

--echo
--echo # Stop the disk collector
set @@global.health_monitor.disk_running = off;

--echo
--echo # Expect multiple query and session terminations and at least one retry
--let $assert_text = Expect KILL QUERY
--let $assert_cond = "[select count(*) from error_log where data like \'%KILL QUERY%\']" > 0
--source include/assert.inc
--let $assert_text = Expect KILL CONNECTION
--let $assert_cond = "[select count(*) from error_log where data like \'%KILL CONNECTION%\']" > 0
--source include/assert.inc
--let $assert_text = Expect Retry SUPER_READ_ONLY
--let $assert_cond = "[select count(*) from error_log where data like \'%Retry SUPER_READ_ONLY%\']" > 0
--source include/assert.inc

--echo
--echo ##
--echo ## Clean up
--echo ##
--echo
set @@global.super_read_only = off;
set @@global.read_only = off;
set @@global.offline_mode = off;
eval set @@global.health_monitor.disk_fallback_force = $fallback_force_save;
drop user user1@localhost;
drop user mysql_router01@localhost;
drop table test.t1;
drop table test.t2;
--echo
--eval uninstall component 'file://component_health_monitor';
