--echo ##
--echo ## Health Monitor component
--echo ##
--echo ## Test storage recovery from fallback mode. Verify that:
--echo ## - server is fenced even if OFFLINE_MODE is already ON
--echo ## - the initial values of SUPER_READ_ONLY and OFFLINE_MODE are preserved.
--echo ##

--source ../include/health_monitor_setup.inc

--echo
--echo # Enable low disk space fencing explicitly for this recovery test
set @@global.health_monitor.disk_fallback_enable = on;

--echo
--echo # Low sample rate with status interval = 1 to get a status message every cycle
set @@global.health_monitor.disk_sample_rate = 10;
set @@global.health_monitor.status_interval = 1;

--echo
--echo # Set OFFLILNE_MODE = ON, expect that server will still be fenced
set @@global.offline_mode = ON;

--echo
--echo # Set the critical low space level to the maximum level to force fallback mode
set @@global.health_monitor.disk_low_space_critical_level = @force_offline_mode;

--echo
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
show global variables like "%health%";

--echo
--echo # Start the disk collector
call mtr.add_suppression("Disk Collector: Critical Level");
set @@global.health_monitor.disk_running = on;

--echo
--echo # Wait for the offline mode to be triggered (should be immediate)
let $wait_condition = select @@global.offline_mode;
let $wait_timeout = 60;
--source include/wait_condition.inc

--echo
--echo # Run in CRITICAL state for a few cycles
--echo Sleep 20
--sleep 20

--echo
--echo # Stop the disk collector
set @@global.health_monitor.disk_running = off;

--echo
--echo # Verify server is fenced
--let $assert_text = Expect OFFLINE_MODE = ON
--let $assert_variable_name = global.offline_mode
--let $assert_variable_value = 1
--source include/assert_variable.inc

--let $assert_text = Expect SUPER_READ_ONLY = ON
--let $assert_variable_name = global.super_read_only
--let $assert_variable_value = 1
--source include/assert_variable.inc

--echo
--echo # Verify that the Health Monitor set SUPER_READ_ONLY
--let $assert_text = Expect status 'super_read_only_disk_full' = ON
--let $assert_cond = "[show status like \"super_read_only_disk_full\", Value, 1]" = "ON"
--source include/assert.inc

--echo
--echo # Verify that the Health Monitor *did not* set OFFLINE_MODE
--let $assert_text = Expect status 'offline_mode_disk_full' = OFF
--let $assert_cond = "[show status like \"offline_mode_disk_full\", Value, 1]" = "OFF"
--source include/assert.inc

--echo
--echo # Trigger fence recovery
--echo
--disable_query_log
select now(6) into @recovery_start;
--enable_query_log
set @@global.health_monitor.disk_low_space_critical_level = 0;
# set @@global.health_monitor.disk_usage_warning_level_1 = @force_disk_warning;
set @@global.health_monitor.disk_recovery_level = 0;
set @@global.health_monitor.disk_recovery_time_1 = 15;
set @@global.health_monitor.disk_recovery_time_2 = 15;
set @@global.health_monitor.disk_recovery_increment = 1;
set @@global.health_monitor.disk_recovery_enable = on;
set @@global.health_monitor.disk_running = on;

--echo
--echo # Wait for status 'super_read_only_disk_full = OFF'
let $wait_timeout = 90;
let $wait_condition = select count(*) from performance_schema.global_status
                        where variable_name in ('super_read_only_disk_full')
                          and variable_value = 'OFF';
--source include/wait_condition.inc

--echo
--echo # Stop the disk collector
set @@global.health_monitor.disk_running = off;

--echo
--echo # Expect OFFLINE_MODE recovery timer not to have run
--let $assert_text = Expect no "Recovery: Timer 1: Expired" log message
--let $assert_cond = "[select count(*) from error_log where data like \'%Timer 1: Expired%\' and logged > @recovery_start]" = 0
--source include/assert.inc

--echo
--echo # Expect message indicating OFFLINE_MODE = ON
--let $assert_text = Expect "Recovery: OFFLINE_MODE = ON" log message
--let $assert_cond = "[select count(*) from error_log where data like \'%Recovery: OFFLINE_MODE = ON%\' and logged > @recovery_start]" > 0
--source include/assert.inc

--echo
--echo # Expect SUPER_READ_ONLY recovery timer to have expired
--let $assert_text = Expect "Recovery: Timer 2: Expired" log message
--let $assert_cond = "[select count(*) from error_log where data like \'%Timer 2: Expired%\' and logged > @recovery_start]" > 0
--source include/assert.inc

--echo
--echo # Verify server is unfenced and that OFFLINE_MODE is unchanged
--let $assert_text = Expect OFFLINE_MODE = ON
--let $assert_variable_name = global.offline_mode
--let $assert_variable_value = 1
--source include/assert_variable.inc

--let $assert_text = Expect SUPER_READ_ONLY = OFF
--let $assert_variable_name = global.super_read_only
--let $assert_variable_value = 0
--source include/assert_variable.inc

--let $assert_text = Expect status 'super_read_only_disk_full' = OFF
--let $assert_cond = "[show status like \"super_read_only_disk_full\", Value, 1]" = "OFF"
--source include/assert.inc

--let $assert_text = Expect status 'offline_mode_disk_full' = OFF
--let $assert_cond = "[show status like \"offline_mode_disk_full\", Value, 1]" = "OFF"
--source include/assert.inc

--echo
--echo ##
--echo ## Clean up
--echo ##
--echo
set @@global.super_read_only = off;
set @@global.read_only = off;
set @@global.offline_mode = off;
--echo
--eval uninstall component 'file://component_health_monitor';
