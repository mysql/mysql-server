--echo ##
--echo ## Health Monitor component
--echo ##
--echo ## Verify that the Health Monitor will fence a group replication primary.
--echo ##
--echo
--echo ## Procedure:
--echo ##   0. This test requires two servers in single primary mode
--echo ##   1. Bootstrap the group with server1
--echo ##   2. Verify error log verbosity, necessary to validate Health Monitor response
--echo ##   3. Install the Health Monitor component on server 1
--echo ##   4. Confirm server 1 is the primary node
--echo ##   5. Start server 2
--echo ##   6. Verify log verbosity
--echo ##   7. Install the Health Monitor component on server 2 before starting group replication
--echo ##   8. Start group replication on server 2
--echo ##   9. Confirm that server 2 is a secondary member
--echo ##  10. Switch to server 1
--echo ##  11. Force critical low disk space on server 1
--echo ##  12. Set low sample rate and status interval to get status messages every measurement cycle
--echo ##  13. Set the low space critical level to maximum to trigger a fence attempt
--echo ##  14. Start the disk collector
--echo ##  15. Wait for the fence to be attempted
--echo ##  16. Run the collector at critical level for a few seconds
--echo ##  17. Stop the disk collector
--echo ##  18. Verify that the server is fenced
--echo ##  19. Clean up
--echo

--source include/have_debug_sync.inc
--source include/have_group_replication_plugin.inc
--let $rpl_skip_group_replication_start= 1
--let $rpl_group_replication_single_primary_mode=1
--source include/group_replication.inc

--echo
--echo # 1. Bootstrap the group with server 1
--source include/start_and_bootstrap_group_replication.inc

--echo
--echo # 2. Verify log verbosity
--let $assert_text = Verify log verbosity = 3
--let $assert_variable_name = global.log_error_verbosity
--let $assert_variable_value = 3
--source include/assert_variable.inc

--echo
--echo # 3. Install the Health Monitor on server 1
--source ../include/health_monitor_setup.inc

--echo
--echo # 4. Confirm primary member
--source include/gr_assert_primary_member.inc

--echo
--echo # 5. Start server 2
--let $rpl_connection_name= server2
--source include/connection.inc

--echo
--echo # 6. Confirm error log verbosity
--let $assert_text = Confirm error log verbosity = 3
--let $assert_variable_name = global.log_error_verbosity
--let $assert_variable_value = 3
--source include/assert_variable.inc

--echo
--echo # 7. Install the Health Monitor on server 2 before starting group replication,
--echo #    otherwise SUPER_READ_ONLY will prevent loading the component
--source ../include/health_monitor_setup.inc

--echo
--echo # 8. Start group replication for server 2
--source include/start_group_replication.inc
--let $server2_uuid = query_get_value(SELECT @@SERVER_UUID, @@SERVER_UUID, 1)

--echo
--echo # 9. Confirm secondary member
--source include/gr_assert_secondary_member.inc

--echo
--echo # 10. Switch to server 1
--let $rpl_connection_name= server1
--source include/connection.inc

--echo
--echo # 11. Force critical level on server 1, fallback mode triggered

--echo
--echo # Enable low disk space fencing explicitly for this Group Replication test
set @@global.health_monitor.disk_fallback_enable = on;

--disable_warnings

--echo
--echo # 12. Set a low sample rate and status interval to get a status message every cycle
set @@global.health_monitor.disk_sample_rate = 10;
set @@global.health_monitor.status_interval = 1;

--echo
--echo # 13. Set up the transition to CRITICAL level that will fence the server
set @@global.health_monitor.disk_low_space_critical_level = @force_offline_mode;

--echo
--replace_result $MYSQLTEST_VARDIR MYSQLTEST_VARDIR
show global variables like "%health%";

--echo
--echo # 14. Start the disk collector
set @@global.health_monitor.disk_running = on;

--echo
--echo # 15. Wait for the server to be fenced (should be immediate)
let $wait_condition = select @@global.offline_mode;
let $wait_timeout = 60;
--source include/wait_condition.inc

--echo
--echo # 16. Run in CRITICAL state for a few cycles
--echo Sleep 20
--sleep 20

--echo
--echo # 17. Stop the disk collector
set @@global.health_monitor.disk_running = off;

--echo
--echo # 18. Verify server is fenced
--source ../include/health_monitor_verify_fenced.inc

--enable_warnings

--echo
--echo ##
--echo ## Clean up
--echo ##
--echo

--echo # Switch to server 1
--let $rpl_connection_name= server1
--source include/connection.inc
set @@global.super_read_only = 0;
set @@global.offline_mode = 0;

--echo
--echo # Uninstall Health Monitor, server 1
--eval uninstall component 'file://component_health_monitor'

--echo
--echo # Switch to server 2
--let $rpl_connection_name= server2
--source include/connection.inc
set @@global.super_read_only = 0;

--echo
--echo # Uninstall Health Monitor, server 2
--eval uninstall component 'file://component_health_monitor'

--echo
--let $rpl_group_replication_reset_persistent_vars=1
--source include/group_replication_end.inc
