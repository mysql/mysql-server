--echo ##
--echo ## Test the Health Monitor component
--echo ##
--echo ## Test cases:
--echo ##   1. Load the component
--echo ##   2. DML operations on Health Monitor tables
--echo ##   3. Unload the component

# System stats not supported on Windows
--source include/not_windows.inc
--source ../include/health_monitor_setup.inc

--echo
--echo ###
--echo ### Table Operations: DML
--echo ###

--echo
--echo #
--echo # system_process_stats
--echo #
--echo

--echo
--error ER_TABLEACCESS_DENIED_ERROR
insert into system_process_stats
  set process_name = 'foo', vsize = 1000, rsslim_bytes = 1000;

--echo
--error ER_TABLEACCESS_DENIED_ERROR
update system_process_stats
  set pid = 0;

--echo
--error ER_TABLEACCESS_DENIED_ERROR
delete from system_process_stats
  where pid <> 0;

--echo
--error ER_TABLEACCESS_DENIED_ERROR
delete from system_process_stats;

--echo
--echo # Truncate is not allowed
--error ER_TABLEACCESS_DENIED_ERROR
truncate table system_process_stats;

--echo
--echo ###
--echo ### Uninstall
--echo ###
--echo
--eval uninstall component 'file://component_health_monitor';
