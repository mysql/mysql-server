--echo ##
--echo ## Test the Health Monitor component
--echo ##
--echo ## Test cases:
--echo ##   1. Load the component
--echo ##   2. DML operations on Health Monitor tables
--echo ##   3. Unload the component

--source ../include/health_monitor_setup.inc

--echo
--echo ###
--echo ### Table Operations: DML
--echo ###

--echo
--echo #
--echo # health_process_memory
--echo #

--echo
--error ER_TABLEACCESS_DENIED_ERROR
insert into health_process_memory
  set total_memory = 1000, memory_free = 1000;

--echo
--error ER_TABLEACCESS_DENIED_ERROR
update health_process_memory
  set total_memory = 1000;

--echo
--error ER_TABLEACCESS_DENIED_ERROR
delete from health_process_memory
  where total_memory > 0;

--echo
--error ER_TABLEACCESS_DENIED_ERROR
delete from health_process_memory;

--echo
--echo # Truncate is allowed
truncate table health_process_memory;

--echo
--echo ###
--echo ### Uninstall
--echo ###
--echo
--eval uninstall component 'file://component_health_monitor';
