--echo ##
--echo ## Test the Health Monitor component
--echo ## Specifically, we will test memory reporting
--echo ##
--echo ## Test cases:
--echo ##   1. No reports when memory collector is not running
--echo ##   2. No reports when memory collector does not emit
--echo ##      warnings.
--echo ##   3. Reports emitted when collector emits warnings
--echo ##      at level 1, 2 or 3.
--echo ##   4. Reports not emitted when collector emits warnings
--echo ##      at level 1, 2 or 3 and reporting turned off.
--echo ##   5. Report is skipped if less than half of the
--echo ##      level 3 limit is available.

--echo
--echo ## Test temporarily disabled
exit;

--source include/have_log_diagnostic.inc

--echo # Enable diagnostics.

--let $MYSQLD_DIAGNOSTIC_LOG= $MYSQL_TMP_DIR/diagnostic.log
--let $MYSQLD_ERROR_LOG= $MYSQLTEST_VARDIR/log/diagnostic_error.log
--let $restart_parameters= "restart:  --log-diagnostic-enable=1 --log-diagnostic=$MYSQLD_DIAGNOSTIC_LOG --log-error=$MYSQLD_ERROR_LOG"
--replace_result $MYSQLD_DIAGNOSTIC_LOG MYSQLD_DIAGNOSTIC_LOG $MYSQLD_ERROR_LOG MYSQLD_ERROR_LOG

--source include/restart_mysqld.inc
--source include/wait_until_connected_again.inc
--source ../include/health_monitor_setup.inc

--echo #
--echo # Allow mysql.session to select from sys views and execute sys procedures.
--echo # This is a pre requisite to query sys views from the component.
--echo #
GRANT PROCESS ON *.* TO 'mysql.session'@localhost;
GRANT SELECT ON sys.* TO 'mysql.session'@localhost;
GRANT EXECUTE ON sys.* TO 'mysql.session'@localhost;

--echo
--echo #
--echo # Test configuration: 8 rows, 1 second sample rate
--echo #
set @@global.health_monitor.memory_retention = 8;
set @@global.health_monitor.memory_sample_rate = 1;
set @@global.health_monitor.status_interval = 1;
set @@global.health_monitor.periodic_reporting = off;

--echo
--echo ###
--echo ### No reports when memory collector is not running
--echo ###
--echo
set @@global.health_monitor.memory_running = off;
set @@global.health_monitor.memory_reporting = on;

--sleep 3

--echo
--echo #
--echo # Verify no report was emitted
--echo #
--let SEARCH_FILE= $MYSQLD_DIAGNOSTIC_LOG
--let SEARCH_PATTERN= MEMORY AGGREGATION
--source include/search_pattern.inc

--echo
--echo ###
--echo ### No reports when memory collector is not emitting warnings
--echo ###
--echo
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = on;
set @@global.health_monitor.memory_usage_warning_level_1 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @no_memory_warning;

--echo
--echo #
--echo # Wait for the memory tables to fill up
--echo #
let $count = 8;
let $table = health_system_memory;
let $wait_timeout = 60;
--source include/wait_until_rows_count.inc

--echo
--echo #
--echo # Verify no warning or report was issued
--echo #
--let SEARCH_FILE= $MYSQLD_ERROR_LOG
--let SEARCH_PATTERN= Memory: Warning Level 1
--source include/search_pattern.inc

--let SEARCH_FILE= $MYSQLD_DIAGNOSTIC_LOG
--let SEARCH_PATTERN= MEMORY AGGREGATION
--source include/search_pattern.inc

--echo
--echo ###
--echo ### Reports emitted when memory collector issues warnings
--echo ###
--echo
--echo # 
--echo # Warning level 1
--echo #
--echo
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = on;
set @@global.health_monitor.memory_usage_warning_level_1 = @force_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @no_memory_warning;

--sleep 20

--echo
--echo #
--echo # Verify warning and report were issued
--echo #
--let SEARCH_FILE= $MYSQLD_ERROR_LOG
--let SEARCH_PATTERN= Memory: Warning Level 1
--source include/search_pattern.inc

--let SEARCH_FILE= $MYSQLD_DIAGNOSTIC_LOG
--let SEARCH_PATTERN= MEMORY AGGREGATION
--source include/search_pattern.inc

--let $grep_file= $MYSQLD_DIAGNOSTIC_LOG
--let $grep_output= none
--let $grep_pattern= MEMORY AGGREGATION
--source include/grep_pattern.inc

--let $count_1= $GREP_RESULT
--let $assert_text= "Number of level 1 reports > 0"
--let $assert_cond= $count_1 > 0
--source include/assert.inc

--echo
--echo #
--echo # Warning level 2
--echo #
--echo
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = on;
set @@global.health_monitor.memory_usage_warning_level_1 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @force_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @no_memory_warning;

--sleep 20

--echo
--echo #
--echo # Verify warning and report were issued
--echo #
--let SEARCH_FILE= $MYSQLD_ERROR_LOG
--let SEARCH_PATTERN= Memory: Warning Level 2
--source include/search_pattern.inc

--let SEARCH_FILE= $MYSQLD_DIAGNOSTIC_LOG
--let SEARCH_PATTERN= MEMORY AGGREGATION
--source include/search_pattern.inc

--let $grep_file= $MYSQLD_DIAGNOSTIC_LOG
--let $grep_output= none
--let $grep_pattern= MEMORY AGGREGATION
--source include/grep_pattern.inc

--let $count_2= $GREP_RESULT
--let $assert_text= "Number of level 2 reports > number of level 1 reports"
--let $assert_cond= $count_2 > $count_1
--source include/assert.inc

--echo
--echo #
--echo # Warning level 3
--echo #
--echo
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = on;
set @@global.health_monitor.memory_usage_warning_level_1 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @force_memory_warning;

--sleep 10

--echo
--echo #
--echo # Verify warning and report were issued
--echo #
--let SEARCH_FILE= $MYSQLD_ERROR_LOG
--let SEARCH_PATTERN= Memory: Warning Level 3
--source include/search_pattern.inc

--let SEARCH_FILE= $MYSQLD_DIAGNOSTIC_LOG
--let SEARCH_PATTERN= MEMORY AGGREGATION
--source include/search_pattern.inc

--let $grep_file= $MYSQLD_DIAGNOSTIC_LOG
--let $grep_output= none
--let $grep_pattern= MEMORY AGGREGATION
--source include/grep_pattern.inc

--let $count_3= $GREP_RESULT
--let $assert_text= "Number of level 3 reports > number of level 2 reports"
--let $assert_cond= $count_3 > $count_2
--source include/assert.inc


--echo
--echo ###
--echo ### Reports not emitted when memory collector issues warnings
--echo ### if reporter turned off.
--echo ###
--echo
--echo # Memory note baseline count
--echo

--let $grep_file= $MYSQLD_ERROR_LOG
--let $grep_output= none
--let $grep_pattern= Memory: Warning Level 1
--source include/grep_pattern.inc
--let $baseline_count_1= $GREP_RESULT

--let $grep_pattern= Memory: Warning Level 2
--source include/grep_pattern.inc
--let $baseline_count_2= $GREP_RESULT

--let $grep_pattern= Memory: Warning Level 3
--source include/grep_pattern.inc
--let $baseline_count_3= $GREP_RESULT

--echo
--echo #
--echo # Warning level 1
--echo #
--echo
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = off;
set @@global.health_monitor.memory_usage_warning_level_1 = @force_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @no_memory_warning;

--sleep 3

--echo
--echo #
--echo # Verify warning and no report were issued
--echo #

--let $grep_file= $MYSQLD_ERROR_LOG
--let $grep_output= none
--let $grep_pattern= Memory: Warning Level 1
--source include/grep_pattern.inc

--let $warn_count_1= $GREP_RESULT
--let $assert_text= "Number of level 1 warnings increased"
--let $assert_cond= $warn_count_1 > $baseline_count_1
--source include/assert.inc

--let $grep_file= $MYSQLD_DIAGNOSTIC_LOG
--let $grep_output= none
--let $grep_pattern= MEMORY AGGREGATION
--source include/grep_pattern.inc

--let $no_count= $GREP_RESULT
--let $assert_text= "Number of reports unchanged"
--let $assert_cond= $no_count = $count_3
--source include/assert.inc

--echo
--echo #
--echo # Warning level 2
--echo #
--echo
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = off;
set @@global.health_monitor.memory_usage_warning_level_1 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @force_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @no_memory_warning;

--sleep 3

--echo
--echo #
--echo # Verify warning and no report were issued
--echo #

--let $grep_file= $MYSQLD_ERROR_LOG
--let $grep_output= none
--let $grep_pattern= Memory: Warning Level 2
--source include/grep_pattern.inc

--let $warn_count_2= $GREP_RESULT
--let $assert_text= "Number of level 2 warnings increased"
--let $assert_cond= $warn_count_2 > $baseline_count_2
--source include/assert.inc

--let $grep_file= $MYSQLD_DIAGNOSTIC_LOG
--let $grep_output= none
--let $grep_pattern= MEMORY AGGREGATION
--source include/grep_pattern.inc

--let $no_count= $GREP_RESULT
--let $assert_text= "Number of reports unchanged"
--let $assert_cond= $no_count = $count_3
--source include/assert.inc

--echo
--echo #
--echo # Warning level 3
--echo #
--echo
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = off;
set @@global.health_monitor.memory_usage_warning_level_1 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @force_memory_warning;

--sleep 3

--echo
--echo #
--echo # Verify warning and no report were issued
--echo #

--let $grep_file= $MYSQLD_ERROR_LOG
--let $grep_output= none
--let $grep_pattern= Memory: Warning Level 3
--source include/grep_pattern.inc

--let $warn_count_3= $GREP_RESULT
--let $assert_text= "Number of level 3 warnings increased"
--let $assert_cond= $warn_count_3 > $baseline_count_3
--source include/assert.inc

--let $grep_file= $MYSQLD_DIAGNOSTIC_LOG
--let $grep_output= none
--let $grep_pattern= MEMORY AGGREGATION
--source include/grep_pattern.inc

--let $no_count= $GREP_RESULT
--let $assert_text= "Number of reports unchanged"
--let $assert_cond= $no_count = $count_3
--source include/assert.inc

--echo
--echo #
--echo # Report skipped if approaching OOM
--echo #
--echo
set @@global.health_monitor.memory_usage_warning_level_1 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_2 = @no_memory_warning;
set @@global.health_monitor.memory_usage_warning_level_3 = @force_memory_warning - 1;
set @@global.health_monitor.memory_running = on;
set @@global.health_monitor.memory_reporting = on;

--sleep 3

--echo
--echo #
--echo # Verify warning and no report were issued
--echo #

--let $grep_file= $MYSQLD_ERROR_LOG
--let $grep_output= none
--let $grep_pattern= Memory: Warning Level 3
--source include/grep_pattern.inc

--let $warn_count_3_skip= $GREP_RESULT
--let $assert_text= "Number of level 3 warnings increased"
--let $assert_cond= $warn_count_3_skip > $warn_count_3
--source include/assert.inc

--let $grep_file= $MYSQLD_DIAGNOSTIC_LOG
--let $grep_output= none
--let $grep_pattern= Diagnostic report unavailable due to low memory
--source include/grep_pattern.inc

--let $skip_count= $GREP_RESULT
--let $assert_text= "Skip report"
--let $assert_cond= $skip_count > 0
--source include/assert.inc

--echo
--echo ###
--echo ### Stop, revoke and uninstall
--echo ###
--echo
set @@global.health_monitor.memory_running = off;
set @@global.health_monitor.memory_reporting = off;

REVOKE PROCESS ON *.* FROM 'mysql.session'@localhost;
REVOKE SELECT ON sys.* FROM 'mysql.session'@localhost;
REVOKE EXECUTE ON sys.* FROM 'mysql.session'@localhost;
--echo
--eval uninstall component 'file://component_health_monitor';

--remove_file $MYSQLD_DIAGNOSTIC_LOG
