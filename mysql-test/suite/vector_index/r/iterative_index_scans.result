select i from t1 where i % 20 = 0 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
i
explain format=tree select * from t1 where i % 20 = 0 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
EXPLAIN
-> Limit: 10 row(s)  (rows=10)
    -> Sort: approx_distance(t1.j,to_vector('[1,2,3]'),'distance_measure=l2_squared'), limit input to 10 row(s) per chunk  (rows=1000)
        -> Filter: ((t1.i % 20) = 0)  (rows=10)
            -> Nested loop inner join  (rows=10)
                -> Vector index scan on t1  (rows=10)
                -> Single-row index lookup on t1 using PRIMARY (i = t1.i)  (rows=1)

explain format=tree select * from t1 where i between 20 and 200 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
EXPLAIN
-> Limit: 10 row(s)  (rows=10)
    -> Sort: approx_distance(t1.j,to_vector('[1,2,3]'),'distance_measure=l2_squared'), limit input to 10 row(s) per chunk  (rows=1000)
        -> Filter: (t1.i between 20 and 200)  (rows=10)
            -> Nested loop inner join  (rows=10)
                -> Vector index scan on t1  (rows=10)
                -> Single-row index lookup on t1 using PRIMARY (i = t1.i)  (rows=1)

explain format=tree select * from t1 where i between 20 and 200 order by i % 3, approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
EXPLAIN
-> Limit: 10 row(s)  (rows=10)
    -> Sort: (t1.i % 3), approx_distance(t1.j,to_vector('[1,2,3]'),'distance_measure=l2_squared'), limit input to 10 row(s) per chunk  (rows=1000)
        -> Filter: (t1.i between 20 and 200)  (rows=10)
            -> Nested loop inner join  (rows=10)
                -> Vector index scan on t1  (rows=10)
                -> Single-row index lookup on t1 using PRIMARY (i = t1.i)  (rows=1)

