# VectorSearchResults uint32 x uint32 allocation wrap in iterative filtering
CREATE TABLE t4 (
pk1 CHAR(250) CHARACTER SET latin1 NOT NULL,
pk2 CHAR(250) CHARACTER SET latin1 NOT NULL,
pk3 CHAR(250) CHARACTER SET latin1 NOT NULL,
pk4 CHAR(250) CHARACTER SET latin1 NOT NULL,
j VECTOR(3) USING VARBINARY,
PRIMARY KEY(pk1,pk2,pk3,pk4)
) ENGINE=InnoDB STATS_PERSISTENT=1 STATS_AUTO_RECALC=0;
INSERT INTO t4 SELECT LPAD(i,250,'a'), LPAD(i,250,'b'),
LPAD(i,250,'c'), LPAD(i,250,'d'), j FROM t1;
CREATE VECTOR INDEX vec_index4 ON t4(j) DISTANCE_MEASURE=l2_squared;
ANALYZE TABLE t4;
Table	Op	Msg_type	Msg_text
test.t4	analyze	status	OK
UPDATE mysql.innodb_table_stats SET n_rows=1000000000
WHERE database_name='test' AND table_name='t4';
UPDATE mysql.innodb_index_stats SET stat_value=1000000000
WHERE database_name='test' AND table_name='t4' AND stat_name='n_diff_pfx04';
FLUSH TABLE t4;
SELECT 1 FROM t4 WHERE LENGTH(pk2) > 0 AND pk2 = LPAD(1, 250, 'b')
ORDER BY approx_distance(j, string_to_vector('[1,2,3]'),
'distance_measure=l2_squared')
LIMIT 4290677;
1
