Alter embedding to be NULL
UPDATE t1 SET j = NULL WHERE i = 10;
SELECT i FROM t1 WHERE j IS NULL;
i
1
10
Insert non-null value
INSERT INTO t1 (i, j) VALUES (1001, string_to_vector(@temp));
Confirm ANN still works after all the changes we've made
SELECT COUNT(*) FROM t1 ORDER BY APPROX_DISTANCE(j, string_to_vector(@temp), 'distance_measure=dot_product') LIMIT 1;
COUNT(*)
1001
Drop Index
DROP INDEX idx1 ON t1;
