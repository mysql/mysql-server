"Setup database, tables and vector indexes"
CREATE DATABASE csqlvectorddls;
USE csqlvectorddls;
"CREATE TABLE test"
CREATE TABLE t1 (
id BIGINT NOT NULL,
title varchar(100) NOT NULL,
embeddings vector (3) using varbinary,
PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint NOT NULL,
  `title` varchar(100) NOT NULL,
  `embeddings` vector(3) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
DROP TABLE t1;
