"Table and index with DATE PK"
CREATE TABLE gloveds_datepk (
id DATE,
id2 BIGINT,
gloveword VARCHAR(100) NOT NULL,
embeddings VECTOR (50) USING VARBINARY,
PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
set @date_id := '2000-01-01';
INSERT INTO gloveds_datepk(id, gloveword, embeddings) SELECT (@date_id:=DATE_ADD(@date_id, INTERVAL 1 DAY)), gloveword, embeddings from gloveds;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
CREATE VECTOR INDEX index_datepk ON gloveds_datepk(embeddings) DISTANCE_MEASURE=L2_SQUARED;
"Table and index with DATETIME PK"
CREATE TABLE gloveds_datetimepk (
id DATETIME (3),
id2 BIGINT,
gloveword VARCHAR(100) NOT NULL,
embeddings VECTOR (50) USING VARBINARY,
PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO gloveds_datetimepk(id, gloveword, embeddings) SELECT id, gloveword, embeddings from gloveds_datepk;
CREATE VECTOR INDEX index_datetimepk ON gloveds_datetimepk(embeddings) DISTANCE_MEASURE=L2_SQUARED;
"Table and index with TIMESTAMP PK"
CREATE TABLE gloveds_timestamppk (
id TIMESTAMP (6),
id2 BIGINT,
gloveword VARCHAR(100) NOT NULL,
embeddings VECTOR (50) USING VARBINARY,
PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO gloveds_timestamppk(id, gloveword, embeddings) SELECT id, gloveword, embeddings from gloveds_datepk;
CREATE VECTOR INDEX index_timestamppk ON gloveds_timestamppk(embeddings) DISTANCE_MEASURE=L2_SQUARED;
"Table and index with TIME PK"
CREATE TABLE gloveds_timepk (
id TIME (4),
id2 BIGINT,
gloveword VARCHAR(100) NOT NULL,
embeddings VECTOR (50) USING VARBINARY,
PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
set @time_id := '00:00:00';
INSERT INTO gloveds_timepk(id, gloveword, embeddings) SELECT (@time_id:=ADDTIME(@time_id, "1")), gloveword, embeddings from gloveds;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
CREATE VECTOR INDEX index_timepk ON gloveds_timepk(embeddings) DISTANCE_MEASURE=L2_SQUARED;
"Table and index with ENUM PK"
SET SESSION group_concat_max_len = 1000000;
SELECT GROUP_CONCAT(DISTINCT CONCAT("'", id, "'") SEPARATOR ',') 
INTO @pk_set
FROM gloveds_charpk;
SET @create_sql = CONCAT(
'CREATE TABLE gloveds_enumpk (
        id ENUM(',
@pk_set,
') NOT NULL,
        id2 BIGINT,
        gloveword VARCHAR(100) NOT NULL,
        embeddings VECTOR (50) USING VARBINARY,
        PRIMARY KEY (id)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;'
);
PREPARE stmt FROM @create_sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
INSERT INTO gloveds_enumpk(id, id2, gloveword, embeddings) SELECT id, id2, gloveword, embeddings from gloveds_charpk;
