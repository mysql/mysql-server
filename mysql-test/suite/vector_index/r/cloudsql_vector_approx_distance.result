"Table and index with BOOL PK"
CREATE TABLE gloveds_boolpk (
id BOOL NOT NULL,
gloveword VARCHAR(100) NOT NULL,
embeddings VECTOR (50) USING VARBINARY,
PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO gloveds_boolpk SELECT TRUE, gloveds_unsignedintpk.gloveword, gloveds_unsignedintpk.embeddings FROM gloveds_unsignedintpk LIMIT 1;
INSERT INTO gloveds_boolpk SELECT FALSE, gloveds_unsignedintpk.gloveword, gloveds_unsignedintpk.embeddings FROM gloveds_unsignedintpk WHERE id = '110005' LIMIT 1;
"Table and index with BIGINT and TINYINT UNSIGNED PK"
CREATE TABLE gloveds_bigint_tinyintpk (
id BIGINT NOT NULL,
id2  TINYINT UNSIGNED NOT NULL,
gloveword VARCHAR(100) NOT NULL,
embeddings VECTOR (50) USING VARBINARY,
PRIMARY KEY (id, id2)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci;
Warnings:
Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
Warning	3778	'utf8mb3_general_ci' is a collation of the deprecated character set UTF8MB3. Please consider using UTF8MB4 with an appropriate collation instead.
INSERT INTO gloveds_bigint_tinyintpk SELECT gloveds_bigintpk.id, 1, gloveds_bigintpk.gloveword, gloveds_bigintpk.embeddings FROM gloveds_bigintpk;
CREATE VECTOR INDEX index_bigint_tinyint_pk ON gloveds_bigint_tinyintpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;
"Table and index with SMALLINT and VARCHAR PK"
CREATE TABLE gloveds_int_varcharpk (
id SMALLINT NOT NULL,
gloveword VARCHAR(100) CHARACTER SET latin1 COLLATE latin1_german1_ci NOT NULL ,
embeddings VECTOR (50) USING VARBINARY,
PRIMARY KEY (id, gloveword)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci;
Warnings:
Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
Warning	3778	'utf8mb3_general_ci' is a collation of the deprecated character set UTF8MB3. Please consider using UTF8MB4 with an appropriate collation instead.
SET @smallint_id := 0;
INSERT INTO gloveds_int_varcharpk SELECT (@smallint_id:=@smallint_id + 1), gloveds_bigintpk.gloveword, gloveds_bigintpk.embeddings FROM gloveds_bigintpk ;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
CREATE VECTOR INDEX index_int_varchar_pk ON gloveds_int_varcharpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;
"Table and index with REAL, FLOAT and CHAR PK"
CREATE TABLE gloveds_real_float_charpk (
id REAL(10,4) NOT NULL,
id2  FLOAT(15,3) NOT NULL,
gloveword CHAR(100) CHARACTER SET utf8mb3 COLLATE utf8mb3_general_ci NOT NULL,
embeddings VECTOR (50) USING VARBINARY,
PRIMARY KEY (id, id2, gloveword)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci;
Warnings:
Warning	1681	Specifying number of digits for floating point data types is deprecated and will be removed in a future release.
Warning	1681	Specifying number of digits for floating point data types is deprecated and will be removed in a future release.
Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
Warning	3778	'utf8mb3_general_ci' is a collation of the deprecated character set UTF8MB3. Please consider using UTF8MB4 with an appropriate collation instead.
Warning	1287	'utf8mb3' is deprecated and will be removed in a future release. Please use utf8mb4 instead
Warning	3778	'utf8mb3_general_ci' is a collation of the deprecated character set UTF8MB3. Please consider using UTF8MB4 with an appropriate collation instead.
INSERT INTO gloveds_real_float_charpk SELECT gloveds_bigintpk.id * 2.3456789, gloveds_bigintpk.id * 1.01, concat(gloveds_bigintpk.gloveword, 'new'), gloveds_bigintpk.embeddings FROM gloveds_bigintpk;
CREATE VECTOR INDEX index_real_float_char_pk ON gloveds_real_float_charpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;
