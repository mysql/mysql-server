######## Testing REPEATABLE READ (default) isolation level ########
# We'll work with three connections: con_2, con_3, con_4
# con_3: where DMLs will happen and will be committed
# con_2: which will have a transaction started before con_3
# con_4: which will have a transaction started after con_3
# Neither con_2 nor con_4 should be able to see the changes in con_3
# even after the transaction is committed in default
# Once we start a new transaction in con_2 and con_4 these changes should
# be visible in those connections.
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT id from t1 where id > 2500;
id
START TRANSACTION;
SELECT id from t1 where id > 2500;
id
START TRANSACTION;
SELECT id from t1 where id > 2500;
id
# -- Inserting a row in t1
