set global log_error_verbosity = 3;
CREATE VECTOR INDEX l2_sq ON t1(j) DISTANCE_MEASURE=l2_squared NUM_LEAVES=5;
CREATE VECTOR INDEX cos ON t2(j) DISTANCE_MEASURE=cosine NUM_LEAVES=20;
CREATE VECTOR INDEX dot ON t3(j) DISTANCE_MEASURE=dot_product NUM_LEAVES=50;
select * from information_schema.innodb_vector_indexes;
