use test;
Initial Data inserted
# create vector index with generated PK
create vector index vec_index on t1(j) distance_measure=l2_squared;
# verify PK order is honored with APPROX
select i, APPROX_DISTANCE(j, string_to_vector('[60, 59, 58]'), 'distance_measure=l2_squared') FROM t1 order by i LIMIT 12;
i	APPROX_DISTANCE(j, string_to_vector('[60, 59, 58]'), 'distance_measure=l2_squared')
