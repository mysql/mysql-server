# verify without ANN, query still uses index-based order
explain format=tree select i from t1 order by i;
EXPLAIN
-> Covering index scan on t1 using PRIMARY  (...)

# verify PK order is honored with function of PK in order by
select i, 3*(i-55), APPROX_DISTANCE(j, string_to_vector('[60, 59, 58]'), 'distance_measure=l2_squared') FROM t1 order by 3*(i-55) LIMIT 12;
i	3*(i-55)	APPROX_DISTANCE(j, string_to_vector('[60, 59, 58]'), 'distance_measure=l2_squared')
