CREATE DATABASE db1;
USE db1;
CREATE VECTOR INDEX t1_j ON test.t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=cosine NUM_LEAVES=10;;
SELECT i, vector_to_string(j) from test.t1 LIMIT 4;;
i	vector_to_string(j)
1	[7.91640e-01,2.48619e-02,6.36966e-01]
2	[8.62281e-01,7.07793e-01,4.07944e-01]
3	[3.13589e-01,2.38428e-01,9.55827e-01]
4	[8.83954e-01,1.77457e-01,4.43411e-01]
SELECT i, approx_distance(j, string_to_vector('[0.3,0.4,0.5]'), 'distance_measure=cosine') app from test.t1 order by app, i LIMIT 4;;
i	app
303	-0.0026
97	-0.0025
383	-0.0025
935	-0.0015
SELECT * FROM information_schema.innodb_vector_indexes;
INDEX_NAME	TABLE_NAME	INDEX_TYPE	DIMENSION	DIST_MEASURE	STATUS	STATE	NUM_LEAVES	NUM_LEAVES_TO_SEARCH	QUERIES	MUTATIONS	TREE_MEMORY
t1_j	test.t1	TREE_SQ	3	COSINE	Ready	INDEX_READY_TO_USE	10	10	1	0	443
SELECT NUM_LEAVES FROM information_schema.innodb_vector_indexes;
NUM_LEAVES
10
DROP DATABASE db1;
