CALL mtr.add_suppression("Vector index marked corrupted");
CREATE VECTOR INDEX vectorIndext1 ON t1(j) DISTANCE_MEASURE=cosine;
CREATE VECTOR INDEX vectorIndext2 ON t2(j) DISTANCE_MEASURE=dot_product;
