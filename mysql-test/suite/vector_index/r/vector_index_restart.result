########################################################################
#     Test that corruption persist through a restart                   #
########################################################################
SET SESSION debug='+d,dict_set_sub_table_clust_index_row_scan_corrupted';
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	Warning	InnoDB: The vector index vectorIndext2 is corrupted.
test.t2	check	Warning	InnoDB: Vector index 'vectorIndext2' contains 1000 entries, should be 1002.
test.t2	check	error	Corrupt
SET SESSION debug='-d,dict_set_sub_table_clust_index_row_scan_corrupted';
SELECT count(*) FROM information_schema.innodb_all_vector_indexes where corrupted = 1;
count(*)
