id int, emb vector(50) USING varbinary, name VARCHAR(20) CHARACTER SET latin1 COLLATE latin1_swedish_ci, next_id VARCHAR(10) CHARACTER SET utf8 COLLATE utf8mb3_unicode_ci, PRIMARY KEY(next_id, name));
