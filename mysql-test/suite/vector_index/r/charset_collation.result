# Test case 1: VARCHAR PK (various charset & collation)
SELECT embeddings FROM gloveds LIMIT 1 INTO @value;
CREATE TABLE t0(
id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id VARCHAR(10) CHARACTER SET gbk COLLATE gbk_chinese_ci PRIMARY KEY);
INSERT INTO t0 SELECT id, embeddings, "name", CAST(id+1 AS CHAR(10)) FROM gloveds;
UPDATE t0 SET next_id = '桌子' WHERE id=1;
CREATE VECTOR INDEX vec_index0 ON t0(emb) DISTANCE_MEASURE=l2_squared;
SELECT id FROM t0 ORDER BY APPROX_DISTANCE(emb, @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
id
110001
110043
110154
110004
110007
