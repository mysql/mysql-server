create vector index vec_index on t1(j) distance_measure=cosine;
select * from information_schema.innodb_vector_indexes;
INDEX_NAME	TABLE_NAME	INDEX_TYPE	DIMENSION	DIST_MEASURE	STATUS	STATE	NUM_LEAVES	NUM_LEAVES_TO_SEARCH	QUERIES	MUTATIONS	TREE_MEMORY
vec_index	test.t1	TREE_SQ	3	COSINE	Ready	INDEX_READY_TO_USE	100	100	0	0	4133
select it.name as table_name, ii.name as index_name, avi.state, avi.config
from information_schema.innodb_all_vector_indexes as avi
join information_schema.innodb_tables as it on avi.table_id = it.table_id
join information_schema.innodb_indexes as ii on avi.id = ii.index_id
where it.name = 'test/t1' and ii.name = 'vec_index';
table_name	index_name	state	config
test/t1	vec_index	INDEX_READY_TO_USE	{"index_type":{"D":"TREE_SQ"},"distance_measure":{"D":"SquaredL2Distance","C":"CosineDistance"},"tree_levels":{"D":"1"},"num_partitions":{"G":"100"},"num_neighbors":{"D":"10"},"clusters_per_block":{"D":"16"},"min_cluster_size":{"D":"10.000000"},"max_clustering_iteration":{"D":"10"},"vector_dimensions":{"D":"768","C":"3"},"num_query_partitions":{"G":"100"}}
drop index vec_index on t1;
create vector index vec_index on t1(j) num_leaves=10000 distance_measure=l2_squared;
select * from information_schema.innodb_vector_indexes;
INDEX_NAME	TABLE_NAME	INDEX_TYPE	DIMENSION	DIST_MEASURE	STATUS	STATE	NUM_LEAVES	NUM_LEAVES_TO_SEARCH	QUERIES	MUTATIONS	TREE_MEMORY
vec_index	test.t1	TREE_SQ	3	L2_SQUARED	Ready	INDEX_READY_TO_USE	10000	120	0	0	491687
select it.name as table_name, ii.name as index_name, avi.state, avi.config
from information_schema.innodb_all_vector_indexes as avi
join information_schema.innodb_tables as it on avi.table_id = it.table_id
join information_schema.innodb_indexes as ii on avi.id = ii.index_id
where it.name = 'test/t1' and ii.name = 'vec_index';
table_name	index_name	state	config
test/t1	vec_index	INDEX_READY_TO_USE	{"index_type":{"D":"TREE_SQ"},"distance_measure":{"D":"SquaredL2Distance","C":"SquaredL2Distance"},"tree_levels":{"D":"1"},"num_partitions":{"C":"10000"},"num_neighbors":{"D":"10"},"clusters_per_block":{"D":"16"},"min_cluster_size":{"D":"10.000000"},"max_clustering_iteration":{"D":"10"},"vector_dimensions":{"D":"768","C":"3"},"num_query_partitions":{"G":"120"},"num_tlp":{"G":"1000"},"num_search_tlp":{"G":"100"}}
drop table t1;
