INSERT INTO t14 (id, emb, name, next_id) SELECT id, embeddings, "name", id+1 FROM gloveds;
CREATE VECTOR INDEX vec_index14 ON t14(emb) DISTANCE_MEASURE=l2_squared;
ERROR HY000: Feature not supported with vector columns, Vector column specified with unsupported primary key datatype
DROP TABLE t14;
