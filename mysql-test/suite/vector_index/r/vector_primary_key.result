# Test case 9: Altering PK
UPDATE t1 SET id = 1001 WHERE id = 1;
SELECT id FROM t1 ORDER BY APPROX_DISTANCE(emb,  @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
id
110001
110043
110154
110004
110007
# Test case 10: Table uses foreign key as PK
# Disable AHI to avoid hitting upstream bug described in b/379985107
SET @start_global_value  = @@global.innodb_adaptive_hash_index;
SET GLOBAL innodb_adaptive_hash_index = off;
CREATE TABLE t11(id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id int PRIMARY KEY, FOREIGN KEY (next_id) REFERENCES t3(next_id));
INSERT INTO t11 SELECT id, embeddings, "name", id+1 FROM gloveds;
CREATE VECTOR INDEX vec_index11 ON t11(emb) DISTANCE_MEASURE=l2_squared;
SELECT id FROM t11 ORDER BY APPROX_DISTANCE(emb,  @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
id
110001
110043
110154
110004
110007
CREATE TABLE t12(id int, emb vector(50) USING varbinary, name VARCHAR(20),
next_id int PRIMARY KEY,
FOREIGN KEY (next_id) REFERENCES t3(next_id),
INDEX id_idx (id),
INDEX id_next_idx (id, next_id));
INSERT INTO t12 SELECT id, embeddings, "name", id+1 FROM gloveds;
SET GLOBAL innodb_adaptive_hash_index = @start_global_value;
CREATE VECTOR INDEX vec_index12 ON t12(emb) DISTANCE_MEASURE=l2_squared;
SELECT id FROM t12 ORDER BY APPROX_DISTANCE(emb,  @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
id
110001
110043
110154
110004
110007
# Test case 13: (Happy case) Create with constraint on PK
CREATE TABLE t13(id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id int PRIMARY KEY,
CONSTRAINT CHK_id_positive1 CHECK (next_id > 0));
INSERT INTO t13 SELECT id, embeddings, "name", id+1 FROM gloveds;
# create vector index
CREATE VECTOR INDEX vec_index13 ON t13(emb) DISTANCE_MEASURE=l2_squared;
SELECT id FROM t13 ORDER BY APPROX_DISTANCE(emb,  @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
id
110001
110043
110154
110004
110007
# Test case 14: Sad case BINARY/VARBINARY/BLOB PK 
CREATE TABLE t14(id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id BINARY(100));
INSERT INTO t14 (id, emb, name, next_id) SELECT id, embeddings, "name", id+1 FROM gloveds;
CREATE VECTOR INDEX vec_index14 ON t14(emb) DISTANCE_MEASURE=l2_squared;
ERROR HY000: Vector index: vector indexes without primary key is not supported yet.
DROP TABLE t14;
CREATE TABLE t14(id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id VARBINARY(100) PRIMARY KEY);
INSERT INTO t14 (id, emb, name, next_id) SELECT id, embeddings, "name", id+1 FROM gloveds;
CREATE VECTOR INDEX vec_index14 ON t14(emb) DISTANCE_MEASURE=l2_squared;
ERROR HY000: Feature not supported with vector columns, Vector column specified with unsupported primary key datatype
DROP TABLE t14;
