# Test case 4: Attempt to create vector column with no PK
CREATE TABLE t4(id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id int);
INSERT INTO t4 (id, emb, name, next_id) SELECT id, embeddings, "name", id+1 FROM gloveds;
CREATE VECTOR INDEX vec_index4 ON t4(emb) DISTANCE_MEASURE=l2_squared;
ERROR HY000: Vector index: vector indexes without primary key is not supported yet.
DROP TABLE t4;
# Test case 5: Generated PK
CREATE TABLE t4(
gen_id INT NOT NULL AUTO_INCREMENT
PRIMARY KEY,
id int,
emb vector(50) USING varbinary, name VARCHAR(20), next_id int);
INSERT INTO t4 (id, emb, name, next_id) SELECT id, embeddings, "name", id+1 FROM gloveds;
# create vector index
CREATE VECTOR INDEX vec_index4 ON t4(emb) DISTANCE_MEASURE=l2_squared;
SELECT id FROM t4 ORDER BY APPROX_DISTANCE(emb,  @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
