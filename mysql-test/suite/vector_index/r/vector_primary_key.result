use test;
select embeddings from gloveds limit 1 into @value;
# Test case 1: composite PK
CREATE TABLE t1(
id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id int, PRIMARY KEY(id, name));
INSERT INTO t1 SELECT id, embeddings, "name", id+1 FROM gloveds;
# create vector index
CREATE VECTOR INDEX vec_index ON t1(emb) DISTANCE_MEASURE=l2_squared;
SELECT id FROM t1 ORDER BY APPROX_DISTANCE(emb,  @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
id
110001
110043
110154
110004
110007
# Test case 2: composite PK in different column order than table definition
CREATE TABLE t2(
id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id int, PRIMARY KEY(name, id));
INSERT INTO t2 SELECT id, embeddings, "name", id+1 FROM gloveds;
# create vector index
CREATE VECTOR INDEX vec_index2 ON t2(emb) DISTANCE_MEASURE=l2_squared;
SELECT id FROM t2 ORDER BY APPROX_DISTANCE(emb,  @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
id
110001
110043
110154
110004
110007
