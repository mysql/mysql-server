# Test case 15: Create index on table with view
CREATE TABLE t15(id int, emb vector(50) USING varbinary, name VARCHAR(20), next_id int PRIMARY KEY);
CREATE VIEW t15_view AS
SELECT * FROM t15;
INSERT INTO t15_view SELECT id, embeddings, "name", id+1 FROM gloveds;
# create vector index
CREATE VECTOR INDEX vec_index15 ON t15(emb) DISTANCE_MEASURE=l2_squared;
SELECT id FROM t15 ORDER BY APPROX_DISTANCE(emb,  @value, 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
id
110001
110043
110154
110004
110007
