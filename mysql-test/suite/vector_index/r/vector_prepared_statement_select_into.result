# Test case 1: prepared statements
PREPARE stmt FROM 'INSERT INTO t1 VALUES (?, ?)';
SET @value1 = 1001;
SET @value2 = string_to_vector("[1,1,1]");
EXECUTE stmt USING @value1, @value2;
PREPARE stmt FROM 'SELECT vector_to_string(j) FROM t1 WHERE i=? AND j=?';
EXECUTE stmt USING @value1, @value2;
vector_to_string(j)
[1.00000e+00,1.00000e+00,1.00000e+00]
PREPARE stmt FROM 'INSERT INTO t1 VALUES (?, string_to_vector(?))';
SET @value1 = 1002;
SET @value2 = "[1,1,1]";
EXECUTE stmt USING @value1, @value2;
PREPARE stmt FROM 'SELECT vector_to_string(j) FROM t1 WHERE i=?';
EXECUTE stmt USING @value1;
vector_to_string(j)
[1.00000e+00,1.00000e+00,1.00000e+00]
