--source include/have_debug.inc
--source include/elide_costs.inc

--echo #
--echo # With cloudsql_vector_iterative_filtering=ON, a filtered ANN query must
--echo # still scan all qualifying rows when the vector index turns out to be
--echo # unusable (brute-force fallback). Previously, the original scan was
--echo # replaced by a self-referencing primary key lookup before the usability
--echo # check, so the fallback returned no rows (or a single unrelated row).
--echo #

use test;

--let $table_name=t1
--source suite/vector_index/include/vector_data.inc
create vector index vec_index on t1(j) distance_measure=l2_squared;

--echo # Reference: exact (KNN) results for the filtered query.
set cloudsql_vector_iterative_filtering=OFF;
set session debug='+d,vector_index_unusable';
select i from t1 where i % 20 = 0 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
select i from t1 where i between 20 and 200 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
set session debug='-d,vector_index_unusable';

--echo # Iterative filtering with an unusable vector index must fall back to a
--echo # full brute-force scan and return the same rows as above.
set cloudsql_vector_iterative_filtering=ON;
set session debug='+d,vector_index_unusable';
select i from t1 where i % 20 = 0 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
select i from t1 where i between 20 and 200 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
select count(*) from (select i from t1 where i % 20 = 0 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10) as dt;

--echo # The plan must not contain the primary key lookup without a vector
--echo # index scan feeding it.
--replace_regex $elide_costs
explain format=tree select * from t1 where i % 20 = 0 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;
set session debug='-d,vector_index_unusable';

--echo # Sanity check: with a usable index the iterative plan is still chosen.
--replace_regex $elide_costs
explain format=tree select * from t1 where i % 20 = 0 order by approx_distance(j, string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') limit 10;

--echo # A prepared statement that falls back must emit a warning on each
--echo # fallback execution and retry ANN once the index is usable again.
prepare stmt from 'select i from t1 where i % 20 = 0 order by approx_distance(j, string_to_vector(''[1,2,3]''), ''distance_measure=l2_squared'') limit 10';
select queries from information_schema.innodb_vector_indexes where index_name = 'vec_index';
set session debug='+d,vector_index_unusable';
execute stmt;
execute stmt;
select queries from information_schema.innodb_vector_indexes where index_name = 'vec_index';
set session debug='-d,vector_index_unusable';
execute stmt;
select queries from information_schema.innodb_vector_indexes where index_name = 'vec_index';
deallocate prepare stmt;

set cloudsql_vector_iterative_filtering=default;
drop table t1;
