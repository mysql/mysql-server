SELECT id FROM gloveds_datepk WHERE id % 100 = 1 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_datetimepk WHERE id % 100 = 1 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_timestamppk WHERE id > '2024-01-05 8:15:34' ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_timepk WHERE id < '01:59:59.5999' ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_enumpk WHERE id % 100 = 1 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_setpk WHERE LENGTH(id) > 2 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
