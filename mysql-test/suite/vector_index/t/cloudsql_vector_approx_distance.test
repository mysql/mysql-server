# INSERT INTO gloveds_compositepk SELECT gloveds_bigintpk.id, gloveds_bigintpk.id % 10 + 25, gloveds_bigintpk.id /1000, gloveds_bigintpk.id * 1.1, gloveds_bigintpk.id - 1.2345, gloveds_bigintpk.id + 1.2345, gloveds_bigintpk.id/100 * 1.0001, ABS(gloveds_bigintpk.id / 100000), substr(gloveds_bigintpk.gloveword, 1, 20), gloveds_bigintpk.id, IFNULL(cast(gloveds_timestamppk.id as DATE), '2024-03-18'), IFNULL(gloveds_timestamppk.id, '2024-03-18 02:51:52'), IFNULL(gloveds_timepk.id, '00:00:00.0000'), IFNULL(gloveds_enumpk.id, 'ABCDEF'), IFNULL(gloveds_setpk.id, 'MNOP'), gloveds_bigintpk.id/100000, gloveds_bigintpk.gloveword, gloveds_bigintpk.embeddings FROM gloveds_bigintpk LEFT JOIN gloveds_timestamppk ON gloveds_bigintpk.gloveword = gloveds_timestamppk.gloveword LEFT JOIN gloveds_timepk ON gloveds_bigintpk.gloveword = gloveds_timepk.gloveword LEFT JOIN gloveds_enumpk ON gloveds_bigintpk.gloveword = gloveds_enumpk.gloveword LEFT JOIN gloveds_setpk ON gloveds_bigintpk.gloveword = gloveds_setpk.gloveword;

