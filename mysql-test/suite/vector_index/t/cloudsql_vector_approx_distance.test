# Copyright 2026 Google LLC

# Test support for NEAREST TO Predicate on Cloudsql Vector columns

# Vector reload approximiately takes two seconds after server start.
--sleep 2
# Setup database and tables
-- echo "Setup database, tables and vector indexes"
CREATE DATABASE csqlvector;
USE csqlvector;

--disable_query_log
--source suite/vector_index/include/setup_gloveds_table.inc
--source include/elide_costs.inc
--enable_query_log

-- echo "Table and index with BIGINT PK"
CREATE TABLE gloveds_bigintpk (
  id BIGINT NOT NULL,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;


set @bigint_id := '-110103';
INSERT INTO gloveds_bigintpk(id, gloveword, embeddings) SELECT (@bigint_id:=@bigint_id + 1), gloveword, embeddings from gloveds;

CREATE VECTOR INDEX index_bigintpk ON gloveds_bigintpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with INT UNSIGNED PK"
CREATE TABLE gloveds_unsignedintpk (
  id INT(6) UNSIGNED NOT NULL,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO gloveds_unsignedintpk(id, gloveword, embeddings) SELECT ABS(id), gloveword, embeddings from gloveds_bigintpk;


select count(*) from gloveds_unsignedintpk;
CREATE VECTOR INDEX index_unsignedintpk ON gloveds_unsignedintpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with DECIMAL PK"
CREATE TABLE gloveds_decimalpk (
  id DECIMAL(9,3) NOT NULL,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO gloveds_decimalpk(id, gloveword, embeddings) SELECT id / 100 + .05, gloveword, embeddings from gloveds_unsignedintpk;


select count(*) from gloveds_decimalpk;
CREATE VECTOR INDEX index_decimalpk ON gloveds_decimalpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with NUMERIC PK"
CREATE TABLE gloveds_numericpk (
  id NUMERIC (11,4) NOT NULL,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO gloveds_numericpk(id, gloveword, embeddings) SELECT id, gloveword, embeddings from gloveds_decimalpk;

CREATE VECTOR INDEX index_numericpk ON gloveds_numericpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with FLOAT PK"
CREATE TABLE gloveds_floatpk (
  id FLOAT (28) NOT NULL,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO gloveds_floatpk(id, gloveword, embeddings) SELECT id, gloveword, embeddings from gloveds_decimalpk;
CREATE VECTOR INDEX index_floatpk ON gloveds_floatpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with DOUBLE PK"
CREATE TABLE gloveds_doublepk (
  id DOUBLE (11,4) NOT NULL,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO gloveds_doublepk(id, gloveword, embeddings) SELECT id, gloveword, embeddings from gloveds_decimalpk;
CREATE VECTOR INDEX index_doublepk ON gloveds_doublepk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with REAL PK"
CREATE TABLE gloveds_realpk (
  id REAL (23,6) NOT NULL,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
INSERT INTO gloveds_realpk(id, gloveword, embeddings) SELECT id, gloveword, embeddings from gloveds_decimalpk;
CREATE VECTOR INDEX index_realpk ON gloveds_realpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with BIT PK"
CREATE TABLE gloveds_bitpk (
  id BIT (8) NOT NULL,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
