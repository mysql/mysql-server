-- echo "Table and index with VARCHAR PK"
CREATE TABLE gloveds_varcharpk (
  id VARCHAR(20) NOT NULL,
  id2 BIGINT,
  gloveword VARCHAR(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;


INSERT INTO gloveds_varcharpk(id, gloveword, embeddings) SELECT CONCAT(id, 'test'), gloveword, embeddings from gloveds;
CREATE VECTOR INDEX index_varcharpk ON gloveds_varcharpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with CHAR PK"
CREATE TABLE gloveds_charpk (
  id char(20) NOT NULL,
  id2 BIGINT,
  gloveword char(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

INSERT INTO gloveds_charpk(id, gloveword, embeddings) SELECT id, gloveword, embeddings from gloveds_varcharpk;
CREATE VECTOR INDEX index_charpk ON gloveds_charpk(embeddings) DISTANCE_MEASURE=L2_SQUARED;

-- echo "Table and index with VARBINARY PK"
CREATE TABLE gloveds_varbinarypk (
  id VARBINARY(20) NOT NULL,
  id2 BIGINT,
  gloveword VARBINARY(100) NOT NULL,
  embeddings VECTOR (50) USING VARBINARY,
  PRIMARY KEY (id)
 ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;

