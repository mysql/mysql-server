-- echo "NEAREST with AND predicate (post-filtering)"
SELECT id FROM gloveds_bigintpk WHERE id % 2 = 1 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_unsignedintpk WHERE id % 2 = 1 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_decimalpk WHERE id > 1 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_numericpk WHERE id > 1 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_floatpk WHERE id > 0.5 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_doublepk WHERE id > 0.5 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
SELECT id FROM gloveds_realpk WHERE id < 0 ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;
