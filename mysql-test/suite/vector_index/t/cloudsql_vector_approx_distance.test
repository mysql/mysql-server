-- echo "Constant as query vector"
# String query vector
SELECT id FROM gloveds_bigintpk ORDER BY id, APPROX_DISTANCE(embeddings, REPEAT('A', 200), 'distance_measure=l2_squared') LIMIT 10;

# Hexadecimal query vector
SELECT id FROM gloveds_bigintpk ORDER BY id, APPROX_DISTANCE(embeddings, , 'distance_measure=l2_squared') LIMIT 10;

# Binary query vector
SELECT id FROM gloveds_bigintpk ORDER BY id, APPROX_DISTANCE(embeddings, b'', 'distance_measure=l2_squared') LIMIT 10;

# Row query vector
set @search=(select embeddings from csqlvector.gloveds_bigintpk limit 1);
SELECT id FROM gloveds_bigintpk ORDER BY id, APPROX_DISTANCE(embeddings, @search, 'distance_measure=l2_squared') LIMIT 10;

