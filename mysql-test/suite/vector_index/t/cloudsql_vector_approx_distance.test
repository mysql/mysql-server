-- echo "Table and index with BINARY PK"
 CREATE TABLE gloveds_binarypk (
   id BINARY(20) NOT NULL,
   id2 BIGINT,
   gloveword BINARY(100) NOT NULL,
   embeddings VECTOR (50) USING VARBINARY,
   PRIMARY KEY (id)
