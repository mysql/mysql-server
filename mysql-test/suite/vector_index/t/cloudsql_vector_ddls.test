SHOW CREATE TABLE t1;

ALTER TABLE t1 DROP COLUMN embeddings;
--let $assert_text= CHECK THAT SUB TABLE EXISTS DROPPED
--let $assert_cond= [SELECT count(*) as Value from INFORMATION_SCHEMA.INNODB_TABLES WHERE name LIKE "%vector\_index\_%", Value, 1] = 0
--source include/assert.inc

