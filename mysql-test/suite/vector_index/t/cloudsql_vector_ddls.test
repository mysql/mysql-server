# Test Cloudsql vector column DDLs
#
# Vector reload approximiately takes two seconds after server start.
--sleep 2

# Setup database and tables
-- echo "Setup database, tables and vector indexes"
CREATE DATABASE csqlvectorddls;
USE csqlvectorddls;

-- echo "CREATE TABLE test"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  embeddings vector (3) using varbinary,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
DROP TABLE t1;

-- echo "ALTER TABLE ADD COLUMN with DEFAULT NULL"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
ALTER TABLE t1 ADD COLUMN embeddings vector (3) using varbinary;
INSERT INTO t1 VALUES (1, 'Book 1', string_to_vector('[1,2,3]'));
INSERT INTO t1 VALUES (2, 'Book 2', NULL);
SHOW CREATE TABLE t1;
DROP TABLE t1;

-- echo "ALTER TABLE ADD COLUMN with DEFAULT NOT NULL"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
ALTER TABLE t1 ADD COLUMN embeddings vector (3) using varbinary NOT NULL;
INSERT INTO t1 VALUES (1, 'Book 1', string_to_vector('[1,2,3]'));
-- ERROR ER_BAD_NULL_ERROR
INSERT INTO t1 VALUES (2, 'Book 2', NULL);
SHOW CREATE TABLE t1;
DROP TABLE t1;

-- echo "ALTER TABLE ADD COLUMN WITH DEFAULT NULL after inserting DATA"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
INSERT INTO t1 VALUES (1, 'Book 1');
INSERT INTO t1 VALUES (2, 'Book 2');
SELECT * FROM t1;
ALTER TABLE t1 ADD COLUMN embeddings vector (3) using varbinary;
SHOW CREATE TABLE t1;
SELECT id, title, vector_to_string(embeddings) FROM t1;
INSERT INTO t1 VALUES (3, 'Book 3', string_to_vector('[1,2,3]'));
INSERT INTO t1 VALUES (4, 'Book 4', NULL);
INSERT INTO t1 (id, title) VALUES (5, 'Book 5');
SELECT id, title, vector_to_string(embeddings) FROM t1;
DROP TABLE t1;

-- echo "ALTER TABLE ADD COLUMN WITH DEFAULT NOT NULL after inserting DATA"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
INSERT INTO t1 VALUES (1, 'Book 1');
INSERT INTO t1 VALUES (2, 'Book 2');
SELECT * FROM t1;
ALTER TABLE t1 ADD COLUMN embeddings vector (3) using varbinary NOT NULL;
SHOW CREATE TABLE t1;
DROP TABLE t1;

-- echo "ALTER TABLE DROP COLUMN"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  embeddings vector (3) using varbinary,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
ALTER TABLE t1 DROP COLUMN embeddings;
SHOW CREATE TABLE t1;
DROP TABLE t1;

-- echo "ALTER TABLE DROP COLUMN with DATA"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  embeddings vector (3) using varbinary,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
