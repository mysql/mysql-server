INSERT INTO t1 VALUES (1, 'Book 1', string_to_vector('[1,2,3]'));
INSERT INTO t1 VALUES (2, 'Book 2', NULL);
SELECT id, title, vector_to_string(embeddings) FROM t1;
ALTER TABLE t1 DROP COLUMN embeddings;
SHOW CREATE TABLE t1;
SELECT * FROM t1;
DROP TABLE t1;

-- echo "ALTER TABLE DROP COLUMN after creating index"
CREATE TABLE t1 (
  id BIGINT NOT NULL AUTO_INCREMENT,
  title varchar(100),
  embeddings vector (3) using varbinary,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
INSERT INTO t1 VALUES (1, 'Book 1', string_to_vector('[1,2,3]'));
INSERT INTO t1 VALUES (2, 'Book 2', string_to_vector('[2,3,4]'));
INSERT INTO t1 VALUES (3, 'Book 3', NULL);
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
INSERT INTO t1(title, embeddings) SELECT title, embeddings FROM t1;
ALTER TABLE t1 add constraint chk check (title IS NOT NULL);

CREATE VECTOR INDEX t1_vector_index ON t1(embeddings) DISTANCE_MEASURE=L2_SQUARED;
