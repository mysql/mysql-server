-- echo "ALTER TABLE CHANGE COLUMN"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  embeddings vector (3) using varbinary,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
