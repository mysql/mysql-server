-- echo "DROP PK"
CREATE TABLE t1 (
  id BIGINT NOT NULL,
  title varchar(100) NOT NULL,
  embeddings vector (3) using varbinary,
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
SHOW CREATE TABLE t1;
ALTER TABLE t1 DROP PRIMARY KEY;
DROP TABLE t1;

-- echo "DROP PK with DATA"
--let $table_name=t1
--let $dimensions=3
--let $rows=1000
--let $deterministic=1
--exec include/vector_data_generate.sh $table_name $dimensions $rows $deterministic | $MYSQL csqlvectorddls 2>&1
SHOW CREATE TABLE t1;
ALTER TABLE t1 MODIFY i INT;
CREATE VECTOR INDEX t1_vector_index ON t1(j) DISTANCE_MEASURE=L2_SQUARED;
-- ERROR ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
ALTER TABLE t1 DROP PRIMARY KEY;
DROP TABLE t1;

-- echo "ADD PK AND INDEX WITH DATA"
--let $table_name=t1
--let $dimensions=3
--let $rows=1000
--let $deterministic=1
--exec include/vector_data_generate.sh $table_name $dimensions $rows $deterministic | $MYSQL csqlvectorddls 2>&1
ALTER TABLE t1 MODIFY i INT;
ALTER TABLE t1 DROP PRIMARY KEY;
SHOW CREATE TABLE t1;
ALTER TABLE t1 ADD PRIMARY KEY (i);
SHOW CREATE TABLE t1;
CREATE VECTOR INDEX t1_vector_index ON t1(j) DISTANCE_MEASURE=L2_SQUARED;
SHOW CREATE TABLE t1;
-- ERROR ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
ALTER TABLE t1 DROP PRIMARY KEY;
DROP INDEX t1_vector_index ON t1;
ALTER TABLE t1 DROP PRIMARY KEY;
DROP TABLE t1;

-- echo "ADD multiple columns"
