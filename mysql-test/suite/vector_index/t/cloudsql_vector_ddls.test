ALTER TABLE t1 CHANGE COLUMN embeddings new_embeddings vector (3) using varbinary;
SHOW CREATE TABLE t1;
ALTER TABLE t1 CHANGE COLUMN new_embeddings varchar_embeddings varchar(50);
ALTER TABLE t1 CHANGE COLUMN varchar_embeddings embeddings vector(3);

SHOW CREATE TABLE t1;
ALTER TABLE t1 CHANGE COLUMN embeddings embeddings vector (3) using varbinary;
SHOW CREATE TABLE t1;
ALTER TABLE t1 CHANGE COLUMN embeddings embeddings vector (100) using varbinary;
