CREATE TABLE t1(id int PRIMARY KEY);
ALTER TABLE t1 ADD COLUMN embeddings vector(3) USING varbinary GENERATED ALWAYS AS (string_to_vector('[1,2,3]')) STORED;
DROP TABLE t1, t2;

CREATE TABLE t1(id int PRIMARY KEY, embeddings vector(3) USING varbinary GENERATED ALWAYS AS (string_to_vector('[1,2,3]')) VIRTUAL);

CREATE TABLE t2(id int PRIMARY KEY);
ALTER TABLE t2 ADD COLUMN embeddings vector(3) USING varbinary GENERATED ALWAYS AS (string_to_vector('[1,2,3]')) VIRTUAL;
DROP TABLE t1, t2;

--echo "Vector column on Non Innodb tables/Temp tables are not allowed"

CREATE TABLE t1(id int PRIMARY KEY, embeddings vector(3) USING varbinary) engine=MyISAM;
--ERROR ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
CREATE VECTOR INDEX t1_idx ON t1(embeddings) DISTANCE_MEASURE=l2_squared;
DROP TABLE t1;

CREATE TABLE t1(id int PRIMARY KEY) engine=MyISAM;
ALTER TABLE t1 add embeddings vector(3) USING varbinary;
DROP TABLE t1;

CREATE TEMPORARY TABLE t1(id int PRIMARY KEY, embeddings vector(3) USING varbinary);
--ERROR ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
CREATE VECTOR INDEX t1_idx ON t1(embeddings) DISTANCE_MEASURE=l2_squared;
DROP TABLE t1;

CREATE TEMPORARY TABLE t1(id int PRIMARY KEY);
ALTER TABLE t1 add embeddings vector(3) USING varbinary;
DROP TABLE t1;

--ERROR ER_ILLEGAL_HA
CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=FIXED;

CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=COMPRESSED;
--ERROR ER_VECTOR_FEATURE_UNSUPPORTED
CREATE VECTOR INDEX t1_idx ON t1(j) DISTANCE_MEASURE=l2_squared;
DROP TABLE t1;

CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=REDUNDANT;
--ERROR ER_VECTOR_FEATURE_UNSUPPORTED
CREATE VECTOR INDEX t1_idx ON t1(j) DISTANCE_MEASURE=l2_squared;
DROP TABLE t1;

CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=COMPACT;
--ERROR ER_VECTOR_FEATURE_UNSUPPORTED
CREATE VECTOR INDEX t1_idx ON t1(j) DISTANCE_MEASURE=l2_squared;
DROP TABLE t1;

CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=DEFAULT;
DROP TABLE t1;

CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=DYNAMIC;
DROP TABLE t1;

CREATE TABLE t1(i int PRIMARY KEY AUTO_INCREMENT) ROW_FORMAT=COMPRESSED;
ALTER TABLE t1 ADD COLUMN j VECTOR(3) USING VARBINARY;
--ERROR ER_VECTOR_FEATURE_UNSUPPORTED
CREATE VECTOR INDEX t1_idx ON t1(j) DISTANCE_MEASURE=l2_squared;
DROP TABLE t1;


CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=DYNAMIC;
ALTER TABLE t1 ROW_FORMAT=COMPACT;
--ERROR ER_VECTOR_FEATURE_UNSUPPORTED
CREATE VECTOR INDEX t1_idx ON t1(j) DISTANCE_MEASURE=l2_squared;

DROP TABLE t1;

SET GLOBAL innodb_file_per_table=OFF;
CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=DYNAMIC;
DROP TABLE t1;

SET GLOBAL innodb_file_per_table=ON;
CREATE TABLE t1(i INT PRIMARY KEY AUTO_INCREMENT, j VECTOR(3) USING VARBINARY) ROW_FORMAT=DYNAMIC;

SET GLOBAL innodb_file_per_table=OFF;
--ERROR ER_VECTOR_FEATURE_UNSUPPORTED
CREATE VECTOR INDEX t1_idx ON t1(j) DISTANCE_MEASURE=l2_squared;

--ERROR ER_VECTOR_FEATURE_UNSUPPORTED
ALTER TABLE t1 ADD VECTOR INDEX t1_idx(j) DISTANCE_MEASURE=l2_squared;

DROP TABLE t1;
SET GLOBAL innodb_file_per_table=ON;

# Test new keywords as object identifiers
# Should be able to use QUANTIZER, TREE, DISTANCE_MEASURE, NUM_LEAVES
CREATE TABLE quantizer(tree INT);
CREATE TABLE tree(distance_measure INT);
CREATE TABLE distance_measure(num_leaves INT);
CREATE TABLE num_leave(quantizer INT);
# but VECTOR is still a reserved word.
--error 1064
CREATE TABLE vector(i INT);
--error 1064
CREATE TABLE not_allowed(vector INT);

# VECTOR can be used as an identifier when quoted.
CREATE TABLE `vector`(i INT);
CREATE TABLE not_allowed(`vector` INT);

-- echo "Cleanup"
DROP DATABASE csqlvectorddls;
