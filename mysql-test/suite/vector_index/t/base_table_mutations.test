# Copyright 2026 Google LLC

use test;

--disable_query_log
--source suite/vector_index/include/setup_gloveds_table.inc
--enable_query_log

CREATE TABLE t1 (id int primary key, name VARCHAR(10), emb vector(3) using varbinary);
INSERT INTO t1 SELECT id, "name", substr(embeddings,1,12) FROM gloveds;

--echo # create vector index
CREATE VECTOR INDEX vec_index ON t1(emb) DISTANCE_MEASURE=l2_squared;


--echo # Test Case 1: Altering the embedding column in base table.
SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--let $target_vector = [10,10,10]
--source suite/vector_index/include/get_closest_vector.inc

UPDATE t1
SET emb = string_to_vector('[9, 9, 9]')
WHERE id = 110001;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc


--echo # Test Case 2: Altering the primary key column in base table.
UPDATE t1
SET id = 99999
WHERE emb = string_to_vector('[9, 9, 9]');

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc


--echo # Test Case 3: Updating embedding column in base table, then rolling back.
SET autocommit = 0;
START TRANSACTION;
UPDATE t1
SET emb = string_to_vector('[0, 0, 0]')
WHERE id = 99999;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

ROLLBACK;
SET autocommit = 1;
SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc


--echo # Test Case 4: Altering the primary key column in base table, then rolling back.
SET autocommit = 0;
START TRANSACTION;
UPDATE t1
SET id = 100000
WHERE emb = string_to_vector('[9, 9, 9]');

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

ROLLBACK;
SET autocommit = 1;
SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc


--echo # Test Case 5: Altering the embedding and primary key columns in base table.
UPDATE t1
SET id = 211111, emb = string_to_vector('[11, 11, 11]')
WHERE id = 99999;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

UPDATE t1
SET id = 99999, emb = string_to_vector('[9, 9, 9]')
WHERE id = 211111;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc


--echo # Test Case 6: Deleting a row base table, then inserting.
DELETE FROM t1 WHERE emb = string_to_vector('[9, 9, 9]');

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

INSERT INTO t1 (id, name, emb) VALUES (59, 'name1', string_to_vector('[9,9,9]'));

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc


--echo # Test Case 7: Altering the embedding column in base table to NULL vector with rollback.

SET autocommit = 0;
START TRANSACTION;
UPDATE t1
SET emb = NULL
WHERE id = 110055;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

SELECT id, vector_to_string(emb),
       vector_distance(emb, string_to_vector('[10,10,10]')) dist
FROM t1 WHERE vector_distance(emb, string_to_vector('[10,10,10]')) IS NOT NULL ORDER BY dist LIMIT 1;

ROLLBACK;
SET autocommit = 1;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

SELECT id, vector_to_string(emb),
       vector_distance(emb, string_to_vector('[10,10,10]')) dist
FROM t1 WHERE vector_distance(emb, string_to_vector('[10,10,10]')) IS NOT NULL ORDER BY dist LIMIT 1;


--echo # Test Case 8: Inserting, altering PK, & deleting NULL vector row with rollback
INSERT INTO t1 (id, name, emb) VALUES (1001, 'name2', NULL);
SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

SET autocommit = 0;
START TRANSACTION;

UPDATE t1 SET id = 1005 WHERE id = 1001;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

DELETE FROM t1 WHERE emb IS NULL;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

ROLLBACK;
SET autocommit = 1;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

--echo # Test Case 9: Setting embedding from NULL to non-null to null with rollback

SET autocommit = 0;
START TRANSACTION;

UPDATE t1 SET emb = string_to_vector("[0,0,0]") WHERE id = 1001;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

UPDATE t1 SET emb = NULL WHERE id = 1001;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

ROLLBACK;
SET autocommit = 1;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc


--echo # Test Case 10: Update non-embedding non-PK column (should not cause mutation)

SELECT name, vector_to_string(emb) FROM t1 WHERE id = 110200;

UPDATE t1 SET name = "nametest" WHERE id = 110200;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';
SELECT name, vector_to_string(emb) FROM t1 WHERE id = 110200;


--echo # Test Case 11: Delete and then insert row in the same transaction
SET autocommit = 0;
START TRANSACTION;
DELETE FROM t1 WHERE id = 59;
INSERT INTO t1 (id, name, emb) VALUES (59, 'name1', string_to_vector('[9,9,9]'));

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc
DELETE FROM t1 WHERE emb is NULL;
DELETE FROM t1 WHERE id = 59;
INSERT INTO t1 (id, name, emb) VALUES (59, 'name2', string_to_vector('[9,9,9]'));

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

DELETE FROM t1 WHERE id = 59;
INSERT INTO t1 (id, name, emb) VALUES (59, 'name1', string_to_vector('[10,10,10]'));

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

ROLLBACK;
SET autocommit = 1;

SELECT mutations FROM information_schema.innodb_vector_indexes WHERE INDEX_NAME = 'vec_index';

--source suite/vector_index/include/get_closest_vector.inc

--echo # cleanup
DROP TABLE gloveds;
DROP TABLE t1;
