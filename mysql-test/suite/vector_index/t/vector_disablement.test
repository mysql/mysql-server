# Test that vector index creation is blocked when cloudsql_vector = OFF
# Create a table with vector column before turning off vector.
CREATE TABLE t1(i INTEGER PRIMARY KEY, j VECTOR(3) USING VARBINARY);
# Uncomment the following line after b/376925421
# Initial data
#--let $table_name=t2
#--let $dimensions=3
#--let $rows=1000
#--let $deterministic=1
#--exec include/vector_data_generate.sh $table_name $dimensions $rows $deterministic| $MYSQL test 2>&1
#CREATE VECTOR INDEX t2_x ON t2(j) DISTANCE_MEASURE=l2_squared;

# Turn off vector for rest of the Test
--let $restart_parameters = restart: --cloudsql_vector=OFF
--source include/restart_mysqld.inc

--echo # Create vector index is blocked if cloudsql_vector = OFF
--error ER_VECTOR_FEATURE_CANNOT_BE_USED
CREATE VECTOR INDEX t1_x ON t1(j) DISTANCE_MEASURE=l2_squared;
# --error ER_VECTOR_FEATURE_CANNOT_BE_USED TODO b/471001225
# ALTER TABLE t1 ADD VECTOR INDEX t1_x(j) DISTANCE_MEASURE=l2_squared;

--echo # We should be able to drop existing vector index
--echo #  when cloudsql_vector = OFF
# Uncomment the following line after b/376925421
#DROP INDEX t2_x on t2;
#DROP TABLE t2;
DROP TABLE t1;

--echo # Check that scam_indexes directory does not exist when vector is disabled.
let MYSQLD_DATADIR=`SELECT @@datadir`;
perl;
my $pdfilename = "$ENV{'MYSQLD_DATADIR'}#scam_indexes";
my $dir = $ENV{'MYSQL_TMP_DIR'};
open ( OUTPUT, ">$dir/tmp_data") ;
if (-e $pdfilename) {
    print OUTPUT "-->the file exists on PD\n";
} else {
    print OUTPUT "-->the file does not exist on PD\n";
}
EOF

--echo "Check that scam_indexes directory does not exist when vector is disabled."
--let $grep_file=$MYSQL_TMP_DIR/tmp_data
--let $grep_pattern=the file does not exist on PD
--let $grep_output=boolean
--source include/grep_pattern.inc

USE test;

--echo # create table with vector type column when flag is disabled
CREATE TABLE t2(id int PRIMARY KEY, emb vector(3) USING varbinary);

--echo # create dummy table to use
CREATE TABLE t3 (id int PRIMARY KEY, emb VARCHAR(3));

--echo # add vector column when flag is disabled
ALTER TABLE t3 ADD COLUMN emb2 vector(3) USING varbinary;

--echo # attempt to use ANN
--error ER_VECTOR_FEATURE_CANNOT_BE_USED
SELECT id FROM t2 ORDER BY APPROX_DISTANCE(emb,string_to_vector('[1,2,3]'), 'distance_measure=l2_squared') LIMIT 10;

--echo # attempt to create vector index when flag is disabled
--error ER_VECTOR_FEATURE_CANNOT_BE_USED
CREATE VECTOR INDEX t2_x ON t2(emb) DISTANCE_MEASURE=l2_squared;

--echo # verify we can still use string_to_vector/vector_to_string
SELECT vector_to_string(string_to_vector('[1.0, -2.0, 3]'));

--echo # verify we can still use vector_distance
SELECT vector_distance(string_to_vector('[1.0, -2.0, 3]'), string_to_vector('[1.0, 0, 30]'));

--echo # Cleanup
--remove_file $MYSQL_TMP_DIR/tmp_data
drop table t2;
