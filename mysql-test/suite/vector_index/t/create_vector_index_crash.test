# Test error code paths for vector index creation

--source include/have_debug.inc
--source include/not_valgrind.inc
--source include/not_crashrep.inc

# Initial data
--let $table_name=t1
--let $index_name=t1_j
--let $dimensions=3
--let $rows=1000
--let $deterministic=1
--exec include/vector_data_generate.sh $table_name $dimensions $rows $deterministic| $MYSQL test 2>&1

--eval SET SESSION debug='+d,vector_index_invalid_ddl_crash';
--source include/expect_crash.inc
--error 2013
--eval CREATE VECTOR INDEX t1_j ON t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared NUM_LEAVES=10;
--source include/start_mysqld.inc
--source suite/vector_index/include/assert_no_vector_index.inc

--eval SET SESSION debug='+d,vector_index_sub_table_crash';
--source include/expect_crash.inc
--error 2013
--eval CREATE VECTOR INDEX t1_j ON t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared NUM_LEAVES=10;
--source include/start_mysqld.inc
--source suite/vector_index/include/assert_no_vector_index.inc

--eval SET SESSION debug='+d,vector_index_sub_table_crash';
--source include/expect_crash.inc
--error 2013
--eval CREATE VECTOR INDEX t1_j ON t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared NUM_LEAVES=10;
--source include/start_mysqld.inc
--source suite/vector_index/include/assert_no_vector_index.inc

--eval SET SESSION debug='+d,vector_index_cfg_crash';
--source include/expect_crash.inc
--error 2013
--eval CREATE VECTOR INDEX t1_j ON t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared NUM_LEAVES=10;
--source include/start_mysqld.inc
--source suite/vector_index/include/assert_no_vector_index.inc

--eval SET SESSION debug='+d,vector_index_scan_crash';
--source include/expect_crash.inc
--error 2013
--eval CREATE VECTOR INDEX t1_j ON t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared NUM_LEAVES=10;
--source include/start_mysqld.inc
--source suite/vector_index/include/assert_no_vector_index.inc

--eval SET SESSION debug='+d,vector_index_train_crash';
--source include/expect_crash.inc
--error 2013
--eval CREATE VECTOR INDEX t1_j ON t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared NUM_LEAVES=10;
--source include/start_mysqld.inc
--source suite/vector_index/include/assert_no_vector_index.inc

--eval SET SESSION debug='+d,vector_index_persist_crash';
--source include/expect_crash.inc
--error 2013
--eval CREATE VECTOR INDEX t1_j ON t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared NUM_LEAVES=10;
--source include/start_mysqld.inc
--source suite/vector_index/include/assert_no_vector_index.inc

DROP TABLE t1;
--source suite/vector_index/include/assert_no_vector_index.inc
