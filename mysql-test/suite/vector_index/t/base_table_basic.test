# Copyright 2026 Google LLC

# Testing basic functionality on base table when cloudsql_vector is enabled
# No vector index created in this test

use test;

--echo # We can create a simple table
create table t1 (id int primary key, embeddings vector(4) using varbinary);

show create table t1;

--echo # We can do DMLs on table with conversion functions
insert into t1 values (1, string_to_vector('[1.2, 2.0, -0.8, 54]'));
select vector_to_string(embeddings) from t1;

update t1 set embeddings = string_to_vector('[0, 0, 0, 0]');
select vector_to_string(embeddings) from t1;

delete from t1;
select vector_to_string(embeddings) from t1;

--echo # test if dimension mismatch is caught
--error ER_VECTOR_DATA_DIMENSION_MISMATCH
insert into t1 values (1, string_to_vector('[1.2, 2.0, -0.8]'));

--error ER_TO_VECTOR_CONVERSION
insert into t1 values (1, string_to_vector('[blah, blah]'));

--echo # test if we can add and change comment to vector column
ALTER TABLE t1 MODIFY COLUMN embeddings vector(3) using varbinary COMMENT '';

ALTER TABLE t1 MODIFY COLUMN embeddings vector(3) using varbinary COMMENT 'test';

--echo # test if we can add a constraint to a vector column
--error ER_INCORRECT_TYPE
ALTER TABLE t1 ADD CONSTRAINT vector_dimensions CHECK (VECTOR_DIM(embeddings) = 3);
--error ER_INCORRECT_TYPE
ALTER TABLE t1 ADD CONSTRAINT vector_dimensions CHECK (VECTOR_DIM(embeddings) = 4);

--echo # two vector columns are allowed
create table t2 (id int primary key, c1 vector(3) using varbinary, c2 vector(7) using varbinary);
--error ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
create vector index v_idx on t2 (c1) DISTANCE_MEASURE=dot_product;
drop table t2;

--echo # table without PK and without index is allowed
create table t2 (id int, c1 vector(3) using varbinary);
alter table t1 drop primary key;
--error ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
create vector index v_idx on t1 (c1) DISTANCE_MEASURE=dot_product;
--error ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
create vector index v_idx on t2 (c1) DISTANCE_MEASURE=dot_product;

drop table t2;

--echo # partitioned tables with vector column and without index are allowed
create table t2 (id int primary key, c1 vector(3) using varbinary)
partition by key () partitions 4;
--error ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
create vector index v_idx on t2 (c1) DISTANCE_MEASURE=dot_product;
drop table t2;

create table t2 (id int primary key, c1 vector(3) using varbinary)
partition by hash (id) partitions 100;
--error ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
create vector index v_idx on t2 (c1) DISTANCE_MEASURE=dot_product;
drop table t2;

create table t2 (id int primary key, c1 vector(3) using varbinary)
partition by range (id) (
  partition p0 values less than (10000),
  partition p1 values less than (20000)
);
--error ER_VECTOR_INDEX_FEATURE_UNSUPPORTED
create vector index v_idx on t2 (c1) DISTANCE_MEASURE=dot_product;
drop table t2;

--echo # alter and rename should work as long as we don't have any active index
rename table t1 to t2;
rename table t2 to t1;
alter table t1 add column c_new varchar(25);

alter table t1 add column c_second vector(8) using varbinary;

--echo # cleanup
drop table t1;