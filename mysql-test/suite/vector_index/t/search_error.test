# Copyright 2026 Google LLC

# To test search scenarios where underlying index goes through size changes

call mtr.add_suppression("vector_results is empty");
use test;

delimiter |;
create procedure fill_vector_table(tname varchar(40), n_rows int)
begin
  declare i int default 1;
  declare d1 float default 1.0;
  declare d2 float default 2.0;
  declare d3 float default 3.0;
  while i <= n_rows do
    set @s = concat("insert into ", tname, " values (", i , ", string_to_vector('[", d1, ",", d2, ",", d3, "]'))");
    prepare stmt from @s;
    execute stmt;
    set i = i + 1;
    set d1 = d1 + 1;
    set d2 = d2 + 1;
    set d3 = d3 + 1;
  end while;
end |
delimiter ;|

--echo # search - try a table without vector column
create table t2 (id int primary key, emb varbinary(12));
--error ER_UNABLE_TO_EXECUTE_ANN
select count(id) from t2 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squared') LIMIT 10;
drop table t2;

create table t1 (id int primary key, emb vector(3) using varbinary);
--disable_query_log
call fill_vector_table('t1', 1000);
--enable_query_log

--echo # search - try table without vector index , this should fallback to KNN
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squared') LIMIT 10;

--echo # create brute_force vector index - more neighbors than index size
CREATE VECTOR INDEX vec_index ON t1(emb) DISTANCE_MEASURE=l2_squared;

--echo # normal search
select count(id) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squared') LIMIT 10;
select count(id) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squared') LIMIT 10;

--echo # search - more neighbors than size
select count(id) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squared') LIMIT 10;

--echo # search - only one row in the index
delete from t1 where id != 1;
# uncomment after b/378766011 is fixed
select count(id) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squared') LIMIT 10;

--echo # search - zero row in the index
delete from t1;
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squared') LIMIT 10;

select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squared') LIMIT 10;

--echo # misspelled search options
--error ER_INVALID_OPTION_VALUE
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=l2_squred') LIMIT 10;
--error ER_INVALID_OPTION_END_CHARACTER
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=') LIMIT 10;
--error ER_INVALID_OPTION_KEY
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_mesure=l2_squared') LIMIT 10;
--error ER_UNABLE_TO_EXECUTE_ANN
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), '') LIMIT 10;
--error ER_INVALID_OPTION_VALUE
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'num_leaves_to_search=foo,distance_measure=l2_squared') LIMIT 10;
--error ER_INVALID_OPTION_KEY
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'numleaves_to_search=10,distance_measure=l2_squared') LIMIT 10;
--error ER_INVALID_OPTION_VALUE
select id from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'num_leaves_to_search=-10,distance_measure=l2_squared') LIMIT 10;

--echo # capitalized search options
select count(*) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'DISTANCE_MEASURE=l2_squared') LIMIT 10;
select count(*) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'DISTANCE_measure=l2_squared') LIMIT 10;
select count(*) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'DISTANCE_MEASURE=l2_Squared') LIMIT 10;
select count(*) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=L2_SQUARED') LIMIT 10;
select count(*) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=L2_SQUARED,num_leaves_to_search=10') LIMIT 10;
select count(*) from t1 order by APPROX_DISTANCE(emb, string_to_vector('[1, 2, 3]'), 'distance_measure=L2_SQUARED,NUM_LEAVES_to_search=10') LIMIT 10;

--echo # drop vector index
DROP INDEX vec_index ON t1;

--echo # cleanup
drop procedure fill_vector_table;
drop table t1;
