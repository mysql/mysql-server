SET @tls_kex_saved = @@GLOBAL.tls_kex;
SET @force_pqc_saved = @@GLOBAL.force_pqc;
SET @use_pqc_sign_saved = @@GLOBAL.use_pqc_sign;
SET GLOBAL tls_kex = '';
SET GLOBAL force_pqc = OFF;
SET GLOBAL use_pqc_sign = OFF;
