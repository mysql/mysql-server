# Want to skip this test from daily Valgrind execution
--source include/no_valgrind_without_big.inc

--source include/have_tlsv13.inc

--let $openssl_binary_version=OpenSSL (3\.[5-9]|3\.[1-9][0-9]|[4-9][0-9]*)\.
--source include/have_openssl_binary_version.inc

--disable_query_log
CALL mtr.add_suppression("Failed to set up SSL because of");
CALL mtr.add_suppression("Plugin mysqlx reported: 'Failed at SSL configuration");
--enable_query_log

--echo #
--echo # client/server PQC flag combinations
--echo #

SET @tls_kex_saved = @@GLOBAL.tls_kex;
SET @force_pqc_saved = @@GLOBAL.force_pqc;
SET @use_pqc_sign_saved = @@GLOBAL.use_pqc_sign;

SET GLOBAL tls_kex = '';
SET GLOBAL force_pqc = OFF;
SET GLOBAL use_pqc_sign = OFF;

--echo Both client and server use default PQC flags
--exec $MYSQL --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE = 'X25519MLKEM768' AS negotiated_default_pqc_kex FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'; SELECT VARIABLE_VALUE <> '' AS has_sign_algorithm FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_sign_algorithm'"

--echo Client force-pqc negotiates a PQC key exchange when server uses default flags
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE = 'X25519MLKEM768' AS negotiated_client_force_pqc_kex FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Client force-pqc=0 permits TLSv1.2 when server uses default flags
--exec $MYSQL --force-pqc=0 --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.2 -e "SHOW STATUS LIKE 'Ssl_version'"

--echo Client force-pqc rejects TLSv1.2-only client configuration
--error 1
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.2 -e "SELECT 1 AS force_pqc_tls12"

--echo Client force-pqc rejects configured classical tls_kex
--error 1
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 --tls-kex=X25519 -e "SELECT 1 AS force_pqc_classical_kex"

--echo Client force-pqc accepts configured PQC tls_kex
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 --tls-kex=X25519MLKEM768 -e "SELECT VARIABLE_VALUE = 'X25519MLKEM768' AS client_pqc_tls_kex_wins FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Client use-pqc-sign is accepted for TLSv1.3
--exec $MYSQL --use-pqc-sign --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE <> '' AS has_sign_algorithm FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_sign_algorithm'"

--echo Client use-pqc-sign=0 is accepted for TLSv1.3
--exec $MYSQL --use-pqc-sign=0 --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE <> '' AS has_sign_algorithm FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_sign_algorithm'"

--echo Client configured PQC tls_kex wins when server uses default flags
--exec $MYSQL --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 --tls-kex=secp384r1MLKEM1024 -e "SELECT VARIABLE_VALUE = 'secp384r1MLKEM1024' AS client_pqc_tls_kex_wins FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Client configured classical tls_kex wins when server force_pqc is disabled
--exec $MYSQL --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 --tls-kex=X25519 -e "SELECT VARIABLE_VALUE = 'X25519' AS client_classical_tls_kex_wins FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Server force_pqc negotiates a PQC key exchange with default client flags
SET GLOBAL tls_kex = '';
SET GLOBAL force_pqc = ON;
SET GLOBAL use_pqc_sign = OFF;
--exec $MYSQL --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE = 'X25519MLKEM768' AS negotiated_server_force_pqc_kex FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Server force_pqc rejects TLSv1.2 with default client flags
--error 1
--exec $MYSQL --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.2 -e "SHOW STATUS LIKE 'Ssl_version'"

--echo Server use_pqc_sign is accepted with default client flags
SET GLOBAL force_pqc = OFF;
SET GLOBAL use_pqc_sign = ON;
--exec $MYSQL --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE <> '' AS has_sign_algorithm FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_sign_algorithm'"

--echo Server configured classical tls_kex wins with default client flags when force_pqc is disabled
SET GLOBAL tls_kex = 'X25519';
SELECT @@GLOBAL.tls_kex = 'X25519' AS tls_kex_configured,
       @@GLOBAL.use_pqc_sign AS use_pqc_sign_enabled;
--exec $MYSQL --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE = 'X25519' AS server_classical_tls_kex_wins FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Server configured PQC tls_kex wins with default client flags
SET GLOBAL tls_kex = 'secp384r1MLKEM1024';
SET GLOBAL use_pqc_sign = OFF;
--exec $MYSQL --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE = 'secp384r1MLKEM1024' AS server_pqc_tls_kex_wins FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Both client and server force_pqc negotiate a PQC key exchange
SET GLOBAL tls_kex = '';
SET GLOBAL force_pqc = ON;
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE = 'X25519MLKEM768' AS negotiated_both_force_pqc_kex FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Both client and server use PQC signature flags
SET GLOBAL use_pqc_sign = ON;
--exec $MYSQL --force-pqc --use-pqc-sign --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE = 'X25519MLKEM768' AS negotiated_both_pqc_flags_kex FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'; SELECT VARIABLE_VALUE <> '' AS has_sign_algorithm FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_sign_algorithm'"

--echo Server constrained PQC tls_kex wins over client default force-pqc
SET GLOBAL tls_kex = 'secp384r1MLKEM1024';
SET GLOBAL use_pqc_sign = OFF;
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 -e "SELECT VARIABLE_VALUE = 'secp384r1MLKEM1024' AS server_pqc_tls_kex_wins FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Client constrained PQC tls_kex wins over server default force_pqc groups
SET GLOBAL tls_kex = '';
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 --tls-kex=secp256r1MLKEM768 -e "SELECT VARIABLE_VALUE = 'secp256r1MLKEM768' AS client_pqc_tls_kex_wins FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

# OpenSSL may select either side's first group to avoid a HelloRetryRequest
# when both sides use colon-only TLS group lists, so only assert the shared
# PQC overlap for this reversed-order case.
--echo Both sides advertise reversed PQC tls_kex orders
SET GLOBAL tls_kex = 'secp384r1MLKEM1024:X25519MLKEM768';
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 --tls-kex=X25519MLKEM768:secp384r1MLKEM1024 -e "SELECT VARIABLE_VALUE IN ('secp384r1MLKEM1024', 'X25519MLKEM768') AS negotiated_shared_pqc_kex FROM performance_schema.session_status WHERE VARIABLE_NAME='Tls_key_exchange_algorithm'"

--echo Both sides fail when enforced PQC tls_kex lists have no overlap
SET GLOBAL tls_kex = 'secp384r1MLKEM1024';
--error 1
--exec $MYSQL --force-pqc --ssl-mode=REQUIRED --host=127.0.0.1 -P $MASTER_MYPORT --tls-version=TLSv1.3 --tls-kex=X25519MLKEM768 -e "SELECT 1 AS unexpected_tls_kex_overlap"

SET GLOBAL tls_kex = @tls_kex_saved;
SET GLOBAL force_pqc = @force_pqc_saved;
SET GLOBAL use_pqc_sign = @use_pqc_sign_saved;
