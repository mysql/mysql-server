--source include/have_expect.inc
--source include/not_windows.inc
--source include/have_plugin_auth.inc

let PLUGIN_AUTH_OPT=`SELECT TRIM(TRAILING '/debug' FROM '$PLUGIN_AUTH_OPT')`;
let MYSQL_AUTH_TEST_MYSQL= $MYSQL;
let MYSQL_AUTH_TEST_PLUGIN_OPT= $PLUGIN_AUTH_OPT;

--echo # Setup MFA users with long interactive credentials
--disable_query_log
SET @saved_authentication_policy = @@global.authentication_policy;
SET GLOBAL authentication_policy = '*,*,';

--disable_warnings
DROP USER IF EXISTS
  'mfa_len_79'@'localhost',
  'mfa_len_80'@'localhost',
  'mfa_len_81'@'localhost',
  'mfa_len_100'@'localhost',
  'mfa_len_128'@'localhost',
  'mfa_len_2391'@'localhost';
--enable_warnings

SET @p79 = REPEAT('a', 79);
SET @p80 = REPEAT('b', 80);
SET @p81 = REPEAT('c', 81);
SET @p100 = REPEAT('d', 100);
SET @p128 = REPEAT('e', 128);
SET @token2391 = CONCAT('eyJ', REPEAT('A', 796), '.', REPEAT('B', 796), '.',
                        REPEAT('C', 794));
SET @short_second_factor = 'second_factor';

SET @sql = CONCAT(
  "CREATE USER 'mfa_len_79'@'localhost' ",
  "IDENTIFIED WITH 'caching_sha2_password' BY '", @p79, "' ",
  "AND IDENTIFIED WITH 'cleartext_plugin_server' AS '", @p79, "'");
PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

SET @sql = CONCAT(
  "CREATE USER 'mfa_len_80'@'localhost' ",
  "IDENTIFIED WITH 'caching_sha2_password' BY '", @p80, "' ",
  "AND IDENTIFIED WITH 'cleartext_plugin_server' AS '", @p80, "'");
PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

SET @sql = CONCAT(
  "CREATE USER 'mfa_len_81'@'localhost' ",
  "IDENTIFIED WITH 'sha256_password' BY '", @p81, "' ",
  "AND IDENTIFIED WITH 'cleartext_plugin_server' AS '", @p81, "'");
PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

SET @sql = CONCAT(
  "CREATE USER 'mfa_len_100'@'localhost' ",
  "IDENTIFIED WITH 'sha256_password' BY '", @p100, "' ",
  "AND IDENTIFIED WITH 'cleartext_plugin_server' AS '", @p100, "'");
PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

SET @sql = CONCAT(
  "CREATE USER 'mfa_len_128'@'localhost' ",
  "IDENTIFIED WITH 'caching_sha2_password' BY '", @p128, "' ",
  "AND IDENTIFIED WITH 'cleartext_plugin_server' AS '", @p128, "'");
PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

SET @sql = CONCAT(
  "CREATE USER 'mfa_len_2391'@'localhost' ",
  "IDENTIFIED WITH 'cleartext_plugin_server' AS '", @token2391, "' ",
  "AND IDENTIFIED WITH 'cleartext_plugin_server' AS '", @short_second_factor,
  "'");
PREPARE stmt FROM @sql;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
--enable_query_log

--echo # Interactive MFA password prompts
--perl
use strict;
use warnings;
require Expect;

sub token_2391 {
  return 'eyJ' . ('A' x 796) . '.' . ('B' x 796) . '.' . ('C' x 794);
}

my @cases = (
  {
    label => '79-byte caching_sha2_password + cleartext_plugin_server',
    user => 'mfa_len_79',
    password1 => 'a' x 79,
    password2 => 'a' x 79,
  },
  {
    label => '80-byte caching_sha2_password + cleartext_plugin_server',
    user => 'mfa_len_80',
    password1 => 'b' x 80,
    password2 => 'b' x 80,
  },
  {
    label => '81-byte sha256_password + cleartext_plugin_server',
    user => 'mfa_len_81',
    password1 => 'c' x 81,
    password2 => 'c' x 81,
  },
  {
    label => '100-byte sha256_password + cleartext_plugin_server',
    user => 'mfa_len_100',
    password1 => 'd' x 100,
    password2 => 'd' x 100,
  },
  {
    label => '128-byte caching_sha2_password + cleartext_plugin_server',
    user => 'mfa_len_128',
    password1 => 'e' x 128,
    password2 => 'e' x 128,
  },
  {
    label => '2391-byte token-style cleartext_plugin_server factor',
    user => 'mfa_len_2391',
    password1 => token_2391(),
    password2 => 'second_factor',
  },
);

my $mysql = $ENV{MYSQL_AUTH_TEST_MYSQL} or die 'MYSQL_AUTH_TEST_MYSQL environment variable is not set';
my $port = $ENV{MASTER_MYPORT} or die 'MASTER_MYPORT environment variable is not set';
my $plugin_opt = $ENV{MYSQL_AUTH_TEST_PLUGIN_OPT} // '';
my $tmpdir = $ENV{MYSQL_TMP_DIR} or die 'MYSQL_TMP_DIR environment variable is not set';
my @mysql_cmd = grep { length($_) } split(/\s+/, $mysql);

for my $case (@cases) {
  my $log_file = "$tmpdir/interactive_password_lengths_mfa_$case->{user}.log";
  unlink $log_file;

  my @cmd = (
    @mysql_cmd,
    grep { length($_) } split(/\s+/, $plugin_opt),
    '--protocol=TCP',
    '--host=127.0.0.1',
    "--port=$port",
    '--ssl-mode=REQUIRED',
    '--enable-cleartext-plugin',
    '--batch',
    '--skip-column-names',
    "--user=$case->{user}",
    '--password1',
    '--password2',
    '--execute=SELECT 1',
  );

  my $texp = Expect->new();
  $texp->raw_pty(1);
  $texp->log_stdout(0);
  $texp->log_file($log_file, 'w');
  $texp->spawn(@cmd) or die "Could not spawn mysql for $case->{label}: $!";

  $texp->expect(15, ' -re ', ['Enter password:' => sub {
    $texp->send($case->{password1} . "\n");
  }]) or die "No first password prompt for $case->{label}";

  $texp->expect(15, ' -re ', ['Enter password:' => sub {
    $texp->send($case->{password2} . "\n");
  }]) or die "No second password prompt for $case->{label}";

  $texp->expect(60, 'eof');
  my $exit_status = $texp->exitstatus();
  $texp->soft_close();

  if (defined $exit_status && $exit_status != 0) {
    open(my $fh, '<', $log_file) or die "Cannot read $log_file: $!";
    my $log = do { local $/; <$fh> };
    close($fh);
    die "mysql failed for $case->{label} with exit status $exit_status\n$log";
  }

  unlink $log_file;
  print "$case->{label}: ok\n";
}
EOF

--echo # Cleanup
--disable_query_log
DROP USER
  'mfa_len_79'@'localhost',
  'mfa_len_80'@'localhost',
  'mfa_len_81'@'localhost',
  'mfa_len_100'@'localhost',
  'mfa_len_128'@'localhost',
  'mfa_len_2391'@'localhost';

SET GLOBAL authentication_policy = @saved_authentication_policy;
--enable_query_log
