--source ../inc/thread_pool_err.inc

--let $error_pattern= $tp_size_min_warn

--source ../inc/wrong_value.inc

# Test by setting a wrong min value at runtime
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET SESSION thread_pool_size = 0;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET GLOBAL thread_pool_size = 0;
