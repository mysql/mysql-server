--echo #
--echo # WL#14037: Thread Pool Optimizations
--echo #
--echo #

# Display the value of thread_pool_max_transactions_limit.
SELECT @@global.thread_pool_max_transactions_limit;
let $old_thread_pool_max_transactions_limit = `SELECT @@global.thread_pool_max_transactions_limit`;

# Get number of thread_pool_query_worker_threads (which are executing queries).
--replace_column 2 #
SHOW STATUS LIKE 'Thread_pool_query_threads';

CREATE TABLE t1(c1 INT);
INSERT INTO t1 VALUES(1);

--echo # perform write lock on table t1
LOCK TABLES t1 WRITE;

--echo # from con1, select query stalled due to write lock on t1
connect (con1, localhost, root,,);
--send SELECT * FROM t1


connection default;
UNLOCK TABLES;

connection con1;
--reap
connection default;
disconnect con1;

CREATE USER u1;
--connect(con1, localhost,u1,'',)
--error ER_SPECIFIC_ACCESS_DENIED_ERROR
SET @@global.thread_pool_max_transactions_limit=32;

connection default;
GRANT SYSTEM_VARIABLES_ADMIN ON *.* TO u1;
GRANT CONNECTION_ADMIN ON *.* TO u1;

--connection con1
SET @@global.thread_pool_max_transactions_limit=32;
SELECT @@global.thread_pool_max_transactions_limit;

# Check thread_pool_dedicated_listeners variable is read-only.
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET @@global.thread_pool_dedicated_listeners=ON;

--connection default
--disconnect con1
DROP USER u1;
DROP TABLE t1;

--error ER_TP_CANNOT_DISABLE_MTL_WITH_DL
SET @@global.thread_pool_max_transactions_limit = 0;
SHOW VARIABLES LIKE 'thread_pool_max_transactions_limit';

SET @@global.thread_pool_max_transactions_limit = DEFAULT;
SHOW VARIABLES LIKE 'thread_pool_max_transactions_limit';

# Check negative value of thread_pool_max_transaction_limit is disallowed.
--error ER_WRONG_VALUE_FOR_VAR
SET @@global.thread_pool_max_transactions_limit = -1;

# Check thread_pool_max_transactions_limit > 1000001
--error ER_WRONG_VALUE_FOR_VAR
SET @@global.thread_pool_max_transactions_limit = 1000001;

--echo # Bug#35019884: set persist_only thread_pool_max_transactions_limit
--echo # broken

SET PERSIST_ONLY thread_pool_max_transactions_limit = 256;

--source include/restart_mysqld.inc

SELECT COUNT(*) AS EXPECT_0 FROM performance_schema.error_log WHERE ERROR_CODE = 'MY-013140';

SHOW VARIABLES LIKE 'thread_pool_max_transactions_limit';

RESET PERSIST;
--disable_query_log
--eval SET @@GLOBAL.thread_pool_max_transactions_limit = $old_thread_pool_max_transactions_limit
--enable_query_log
