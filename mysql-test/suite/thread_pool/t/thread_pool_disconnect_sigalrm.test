--source include/have_thread_pool.inc
--source include/have_debug.inc

CREATE TABLE t1(i INT);

--echo # Force the connection thread to terminate after processing this
--echo # connection. This makes the original thread id in Vio::thread_id
--echo # invalid.
SET GLOBAL DEBUG="+d,terminate_connect_thread";
connect(c1,localhost,root,,,,,);
--let $victim = `SELECT CONNECTION_ID()`

BEGIN WORK;
INSERT INTO t1 VALUES (0),(1),(2);

connection default;
SELECT TP_GROUP_ID, CONNECT_THREAD_COUNT FROM
performance_schema.tp_thread_group_state WHERE TP_GROUP_ID = 0;

SET GLOBAL DEBUG="-d,terminate_connect_thread";

--echo # Kill connection
--replace_regex / \d+/ <CONNECTION-ID>/
--eval KILL $victim 

--echo # Cleanup
DROP TABLE t1;
