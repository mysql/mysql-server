--source ../inc/thread_pool_err.inc

--let $error_pattern= $tp_mut_max_warn

--source ../inc/wrong_value.inc

# Test by setting a wrong max value at runtime
--error ER_GLOBAL_VARIABLE
SET SESSION thread_pool_max_unused_threads = 4097;

--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL thread_pool_max_unused_threads = 4097;
