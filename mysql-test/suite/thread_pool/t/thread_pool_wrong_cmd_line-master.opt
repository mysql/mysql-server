--thread-pool-algorithm=1234
--thread-pool-longrun-trx-limit=100000000
--thread-pool-max-active-query-threads=1000000
--thread-pool-max-transactions-limit=1100000
--thread-pool-max-unused-threads=1000000
--thread-pool-prio-kickup-timer=4294967296
--thread-pool-query-threads-per-group=0
--thread-pool-size=0
--thread-pool-stall-limit=1000000
--thread-pool-transaction-delay=-100
--force-restart
