# Reveal that the thread pooling does not unfortunately disable limits like max_connections and other checks.
#
# We simply source here the corresponding test from the main testsuite.
# It contains a few checks which are irrelevant for thread pooling.
#
# Author:
# 2011-01-13 mleich develop tests for WL#5136 New Thread pool design
#

--source include/have_thread_pool.inc

# The tests connect and thread_pool_connect must have the same expected results.
# We take connect.result as reference because this test is more frequent maintained.
let $reference_expectation= $MYSQL_TEST_DIR/r/connect.result;
let $current_expectation=   $MYSQL_TEST_DIR/suite/thread_pool/r/thread_pool_connect.result;

# The result file may have been moved somewhere else.
--perl
open (OUT, "> $ENV{'MYSQL_TMP_DIR'}/find_tpc_result.inc") or
  die "Could not open $ENV{'MYSQL_TMP_DIR'}/find_tpc_result.inc for writing!\n";
if ( -f "$ENV{'MYSQL_TEST_DIR'}/suite/thread_pool/r/thread_pool_connect.result" )
{
  print OUT "let \$current_expectation=\$MYSQL_TEST_DIR/suite/thread_pool/r/thread_pool_connect.result;\n";
}
close OUT;
EOF

--source $MYSQL_TMP_DIR/find_tpc_result.inc
--remove_file $MYSQL_TMP_DIR/find_tpc_result.inc
--diff_files $reference_expectation $current_expectation

if(`SELECT @@global.thread_pool_size < 2`)
{
   --die @@global.thread_pool_size must be >= 2, please check <testcase>-master.opt
}

--source t/connect.test
