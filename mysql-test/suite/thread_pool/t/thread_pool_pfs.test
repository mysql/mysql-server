# Test to check basic instrumentation of a the thread pool plugin.

--source include/have_thread_pool.inc

# save the initial number of concurrent sessions.
--source include/count_sessions.inc

# Should print root@localhost in thread "thread/sql/one_connection"

select
  NAME,
  TYPE,
  PROCESSLIST_ID - connection_id() as PROCESSLIST_ID_delta,
  PROCESSLIST_USER,
  PROCESSLIST_HOST
  from performance_schema.threads
  where processlist_id = connection_id();

# Should print PROCESSLIST_USER = NULL, PROCESSLIST_HOST = NULL

select NAME, TYPE, PROCESSLIST_USER, PROCESSLIST_HOST
  from performance_schema.threads
  where NAME = "thread/sql/main";

# Should print THREAD_OS_ID = NULL
select NAME, TYPE, THREAD_OS_ID
  from performance_schema.threads
  where PROCESSLIST_ID = CONNECTION_ID();

--echo #
--echo # Bug#34019988 - PFS events related to THD creation are never cleared
--echo #

CREATE TABLE tp_thd_pfs_mem_events(event_name VARCHAR(256));
INSERT INTO tp_thd_pfs_mem_events VALUES ("memory/sql/Prepared_statement::infrastructure"),
       ("memory/sql/user_var_entry"),("memory/sql/User_level_lock"),
       ("memory/sql/NET::buff"), ("memory/sql/THD::handler_tables_hash"),
       ("Session_tracker"), ("memory/sql/THD::Session_sysvar_resource_manager"),
       ("memory/vio/vio");

--echo # Create new user connection.
connect (con1,localhost,root,,test);
--let $con1_thread_id = `SELECT thread_id FROM performance_schema.threads WHERE processlist_id = CONNECTION_ID()`

--echo #
--echo # Verify that all PFS events related to the THD for "con1" are
--echo # under user job instrumentation.
connection default;
--replace_result $con1_thread_id con1_thread_id
--sorted_result
--eval SELECT event_name FROM performance_schema.memory_summary_by_thread_by_event_name WHERE thread_id = $con1_thread_id AND count_alloc > 0 AND event_name IN (SELECT event_name FROM tp_thd_pfs_mem_events)

--echo #
--echo # Verify that all PFS events related to the THD for "con1" are
--echo # cleared when connecton terminates.
disconnect con1;
--source include/wait_until_count_sessions.inc

--replace_result $con1_thread_id con1_thread_id
--eval SELECT event_name FROM performance_schema.memory_summary_by_thread_by_event_name WHERE thread_id = $con1_thread_id AND count_alloc > 0 AND event_name IN (SELECT event_name FROM tp_thd_pfs_mem_events)

--echo #
--echo # Verify that thread pool worker thread uses thread pool memory
--echo # and does not use SQL memory.
--echo #
--echo # Event "tp_client_low_level" is excluded intentionally. Only on platforms
--echo # using epoll implementation to handle event notifications, memory for
--echo # tp_client_low_level instance is instrumented using the PSI key
--echo # "memory/thread_pool/tp_client_low_level". But on platforms using poll
--echo # implementation, memory allocation for tp_client_low_level is not
--echo # instrumented. Hence event "tp_client_low_level" is excluded to run
--echo # test on all the platforms.
SELECT event_name FROM performance_schema.memory_summary_by_thread_by_event_name
       WHERE thread_id IN (SELECT thread_id FROM performance_schema.threads
                                  WHERE name LIKE '%thread_pool/tp_worker')
             AND event_name NOT LIKE '%tp_client_low_level'
             AND count_alloc > 0 group by(event_name);

--echo #
--echo # Verify mutexes used by the thread pool worker thread.
--echo # Query lists mostly thread pool mutexes and following non thread pool
--echo # mutexes,
--echo # "THD_LOCK_threads"      - acquired to initialize worker thread.
--echo #                           Excluding this in the resultset as it is
--echo #                           acquired only in the debug build.
--echo # "LOCK_thd_data"         - acquired to set client context to THD::scheduler
SELECT event_name FROM performance_schema.events_waits_summary_by_thread_by_event_name
       WHERE thread_id IN (SELECT thread_id FROM performance_schema.threads
                                  WHERE name LIKE '%thread_pool/tp_worker')
             AND event_name LIKE '%mutex%' AND event_name NOT LIKE "%THR_LOCK_threads"
             AND count_star > 0 group by(event_name) order by (event_name);

--echo #
--echo # Verify that user connection does not uses thread pool memory.
SELECT event_name FROM performance_schema.memory_summary_by_thread_by_event_name
       WHERE thread_id IN (SELECT thread_id FROM performance_schema.threads
                                WHERE processlist_id = CONNECTION_ID())
             AND event_name LIKE '%thread_pool%' AND count_alloc > 0;

--echo #
--echo # Verify that user connection does not uses thread pool mutexes.
--echo # User connections uses only SQL mutexes. Query lists
--echo # `wait/synch/mutex/thread_pool/tp_group_t::LOCK_group` acquired to
--echo # update thread group by thd_begin_wait().
SELECT event_name FROM performance_schema.events_waits_summary_by_thread_by_event_name
       WHERE thread_id IN (SELECT thread_id FROM performance_schema.threads
                                  WHERE processlist_id = CONNECTION_ID())
             AND event_name LIKE '%mutex/thread_pool%' AND count_star > 0 group by(event_name);

DROP TABLE tp_thd_pfs_mem_events;
