--echo #
--echo # WL#12915: Thread Pool Optimizations
--echo #
--echo #

--echo # If threads in thread group stalled,
--echo # then create new threads so the thread group is not blocked.

SET @old_active_query_threads = @@global.thread_pool_max_active_query_threads;
SET @@global.thread_pool_max_active_query_threads=2;
SELECT @@global.thread_pool_max_active_query_threads;

CREATE TABLE t1(c1 INT);
INSERT INTO t1 VALUES(1);

--echo # perform write lock on table t1
LOCK TABLES t1 WRITE;

--echo # from con1, select query stalled due to write lock on t1
connect (con1, localhost, root,,);
--send SELECT * FROM t1

--echo # from con2, select query stalled due to write lock on t1
connect (con2, localhost, root,,);
--send SELECT * FROM t1

--echo # con3 will create new threads
connect (con3, localhost, root,,);
CREATE TABLE t2(c1 INT);
INSERT INTO t2 VALUES(1);
SELECT * FROM t2;
DROP TABLE t2;

connection default;
UNLOCK TABLES;

connection con1;
--reap

connection con2;
--reap

disconnect con1;
disconnect con2;
disconnect con3;

connection default;
DROP TABLE t1;

SET @@global.thread_pool_max_active_query_threads= @old_active_query_threads;
