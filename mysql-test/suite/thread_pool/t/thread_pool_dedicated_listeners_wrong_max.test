--source ../inc/thread_pool_err.inc

--let $error_pattern= $tp_dl_max_warn

--source ../inc/wrong_value.inc

# Test by setting a wrong max value at runtime
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET SESSION thread_pool_dedicated_listeners = 0;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET GLOBAL thread_pool_algorithm = 1;

--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET GLOBAL thread_pool_algorithm = 2;
