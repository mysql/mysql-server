SET @default_val =                   6;
SET @min_val     =                   4;
SET @max_val     =                 600;
SET @some_val    =                 100;
SELECT @min_val < @some_val AND @some_val < @max_val
AND @some_val <> @default_val AS "Expect 1";
Expect 1
1
CREATE USER low_priv@localhost;
GRANT USAGE ON test.* TO low_priv@localhost;
SET @default_val = <default_val>;
SET @some_val = <some_val>;
