SET @prev_txn_limit = @@global.thread_pool_max_transactions_limit;
# The mtr default connection was established before root got TP_CONNECTION_ADMIN, so it
# is supposed to be in thread group 0. There should be no connections in the admin
# thread group (1)
SELECT TP_GROUP_ID, CONNECTION_COUNT FROM performance_schema.tp_thread_group_state;
TP_GROUP_ID	CONNECTION_COUNT
0	1
1	0
CREATE TABLE t1 (i INT);
CREATE USER u1;
# Grant the user u1 the privilege SERVICE_CONNECTION_ADMIN
# so that u1 is able to connect on the admin interface.
GRANT SERVICE_CONNECTION_ADMIN ON *.* TO u1;
# Grant the TP-provided dynamic privilege TP_CONNECTION_ADMIN to root
# so that root can bypass max_transactions_limit. Granting to root since
# the user bypassing max_transactions_limit typically need to perform
# cleanup actions which require special privileges.
GRANT TP_CONNECTION_ADMIN ON *.* TO root@localhost;
# Check that u1 can connect and an uncommitted transaction
# blocks normal connections
connect u1_con1,localhost,u1,,,,,;
SELECT CURRENT_USER();
CURRENT_USER()
u1@%
BEGIN WORK;
INSERT INTO t1 VALUES (10),(20),(30);
# Create another connection with u1 which is unable to complete a
# select, and needs to use --send
connect u1_con2,localhost,u1,,,,,;
SELECT * FROM t1;
# New connection with root. Should not
# be blocked since root has TP_CONNECTION_ADMIN
# and should end up in admin thread group.
connect con_r1,localhost,root,,,,,;
# u1_con1 and u1_con2 should end up in thread group 0 (non-admin), and con_r1 ends up in the admin group.
# so there should now be 3 connections in group 0, and 1 in group 1.
SELECT TP_GROUP_ID, CONNECTION_COUNT FROM performance_schema.tp_thread_group_state;
TP_GROUP_ID	CONNECTION_COUNT
0	3
1	1
SELECT * FROM t1;
i
# Terminate one of the existing connections
KILL <id>;
# Increase max_transactions_limit
SET GLOBAL thread_pool_max_transactions_limit = 4;
disconnect con_r1;
# Complete the blocked SELECT on u1_con2
connection u1_con2;
# Reaping SELECT
i
# Check that the var change is visible
SELECT @@thread_pool_max_transactions_limit;
@@thread_pool_max_transactions_limit
4
# Disconnect the killed connection
connection u1_con1;
disconnect u1_con1;
connection default;
SET GLOBAL thread_pool_max_transactions_limit = 1;
REVOKE TP_CONNECTION_ADMIN ON *.* FROM root@localhost;
GRANT SELECT ON performance_schema.* TO u1;
# Check that connection on admin interface can bypass max_transactions_limit
# Start single transaction on ordinary connection. This will prevent further transactions
# from being started since thread_pool_max_transactions_limit=1
connect ordinary_con,localhost,u1,,,,,;
SELECT CURRENT_USER();
CURRENT_USER()
u1@%
BEGIN WORK;
INSERT INTO t1 VALUES (100),(200),(300);
# Check that the user u1 can establish connection to admin interface since
# this user has the privilege SERVICE_CONNECTION_ADMIN
connect admin_con_u1,127.0.0.1,u1,,,$MASTER_ADMINPORT,,;
SELECT CURRENT_USER();
CURRENT_USER()
u1@%
# default, u1_con2 and ordinary con should give 3 connection in group 0.
# admin_con_u1 replaces con_r1 to give 1 connection in group 1.
SELECT TP_GROUP_ID, CONNECTION_COUNT FROM performance_schema.tp_thread_group_state;
TP_GROUP_ID	CONNECTION_COUNT
0	3
1	1
disconnect admin_con_u1;
# Check that root can establish connection to admin interface even
# without TP_CONNECTION_ADMIN
connect admin_con_r,127.0.0.1,root,,,$MASTER_ADMINPORT,,;
SELECT CURRENT_USER();
CURRENT_USER()
root@localhost
SELECT * FROM t1;
i
# Terminate one of the existing connections
KILL <id>;
# Increase max_transactions_limit
SET GLOBAL thread_pool_max_transactions_limit = 4;
disconnect admin_con_r;
connection ordinary_con;
ROLLBACK WORK;
disconnect ordinary_con;
connection default;
# Check that the var change is visible
SELECT @@thread_pool_max_transactions_limit;
@@thread_pool_max_transactions_limit
4
# Cleaning up 
SET GLOBAL thread_pool_max_transactions_limit = @prev_txn_limit;
REVOKE TP_CONNECTION_ADMIN ON *.* FROM root@localhost;
DROP USER u1;
DROP TABLE t1;
