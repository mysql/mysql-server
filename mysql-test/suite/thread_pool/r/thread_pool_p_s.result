#
# Bug#34020058 - Extend PFS.tp_thread_state table to include PFS thread_id and TP thread type
#
# PFS thread id and thread type of each thread should be listed.
SELECT TP_GROUP_ID, WAIT_TYPE, TP_THREAD_TYPE FROM performance_schema.tp_thread_state WHERE TP_GROUP_ID = 0
AND TP_THREAD_TYPE = 'CONNECTION_HANDLER_WORKER_THREAD';
TP_GROUP_ID	WAIT_TYPE	TP_THREAD_TYPE
0	NULL	CONNECTION_HANDLER_WORKER_THREAD
SELECT TP_GROUP_ID, WAIT_TYPE, TP_THREAD_TYPE FROM performance_schema.tp_thread_state WHERE TP_GROUP_ID = 0
AND TP_THREAD_TYPE = 'QUERY_WORKER_THREAD' LIMIT 1;
TP_GROUP_ID	WAIT_TYPE	TP_THREAD_TYPE
0	NULL	QUERY_WORKER_THREAD
#
# Wl#15515: Add TP connection information to PFS
#
SHOW CREATE TABLE performance_schema.tp_connections;
Table	Create Table
tp_connections	CREATE TABLE `tp_connections` (
  `CONNECTION_ID` int unsigned NOT NULL,
  `TP_GROUP_ID` int unsigned NOT NULL,
  `TP_PROCESSING_THREAD_NUMBER` int unsigned DEFAULT NULL,
  `THREAD_ID` bigint unsigned DEFAULT NULL,
  `STATE` varchar(30) NOT NULL,
  `ACTIVE_FLAG` int unsigned NOT NULL,
  `KILLED_STATE` varchar(30) NOT NULL,
  `CLEANUP_STATE` varchar(30) NOT NULL,
  `TIME_OF_LAST_EVENT_COMPLETION` bigint unsigned NOT NULL,
  `TIME_OF_EXPIRY` bigint unsigned NOT NULL,
  `TIME_OF_ADD` bigint unsigned NOT NULL,
  `TIME_OF_POP` bigint unsigned NOT NULL,
  `TIME_OF_ARM` bigint unsigned NOT NULL,
  `CONNECT_HANDLER_INDEX` int unsigned NOT NULL,
  `TYPE` varchar(30) NOT NULL,
  `DIRECT_QUERY_EVENTS` bigint unsigned NOT NULL,
  `QUEUED_QUERY_EVENTS` bigint unsigned NOT NULL,
  `TIME_OF_EVENT_ARRIVAL` bigint unsigned NOT NULL,
  `MANAGEMENT_TIME` bigint unsigned NOT NULL
) ENGINE=PERFORMANCE_SCHEMA DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Show only those columns which have stable values
SELECT ACTIVE_FLAG, KILLED_STATE, CLEANUP_STATE, CONNECT_HANDLER_INDEX, TYPE
FROM performance_schema.tp_connections ORDER BY CONNECTION_ID;
ACTIVE_FLAG	KILLED_STATE	CLEANUP_STATE	CONNECT_HANDLER_INDEX	TYPE
1	TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User
# After adding some additional connections
SELECT
KILLED_STATE, CLEANUP_STATE, CONNECT_HANDLER_INDEX, TYPE
FROM performance_schema.tp_connections ORDER BY CONNECTION_ID;
KILLED_STATE	CLEANUP_STATE	CONNECT_HANDLER_INDEX	TYPE
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User
# Join with tp_thread_state, to show the processing thread (if any)
SELECT
c.KILLED_STATE, c.CLEANUP_STATE,
c.CONNECT_HANDLER_INDEX, c.TYPE, t.STATE
FROM performance_schema.tp_connections c, performance_schema.tp_thread_state t
WHERE c.TP_GROUP_ID = t.TP_GROUP_ID AND
c.TP_PROCESSING_THREAD_NUMBER = t.TP_THREAD_NUMBER AND
c.CONNECTION_ID = CONNECTION_ID();
KILLED_STATE	CLEANUP_STATE	CONNECT_HANDLER_INDEX	TYPE	STATE
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User	PROCESSING_DIRECT
# Join with P_S.threads on PROCESSLIST_ID. This joins each connection with
# their tp_one_connection "fake" entry in P_S.threads, not the actual tp_worker_thread
# executing on behalf of the connection.
SELECT
c.KILLED_STATE, c.CLEANUP_STATE,
c.CONNECT_HANDLER_INDEX, c.TYPE, t.NAME, t.TYPE, t.PROCESSLIST_USER, t.PROCESSLIST_DB
FROM performance_schema.tp_connections c, performance_schema.threads t
WHERE c.CONNECTION_ID = t.PROCESSLIST_ID ORDER BY c.STATE;
KILLED_STATE	CLEANUP_STATE	CONNECT_HANDLER_INDEX	TYPE	NAME	TYPE	PROCESSLIST_USER	PROCESSLIST_DB
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User	thread/thread_pool/tp_one_connection	FOREGROUND	root	test
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User	thread/thread_pool/tp_one_connection	FOREGROUND	root	test
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User	thread/thread_pool/tp_one_connection	FOREGROUND	root	test
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User	thread/thread_pool/tp_one_connection	FOREGROUND	root	test
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User	thread/thread_pool/tp_one_connection	FOREGROUND	root	test
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User	thread/thread_pool/tp_one_connection	FOREGROUND	root	test
# Get info about current connection and its current worker thread (if it has one).
SELECT
c.KILLED_STATE, c.CLEANUP_STATE,
c.CONNECT_HANDLER_INDEX, c.TYPE
FROM
performance_schema.tp_connections c,
performance_schema.tp_thread_state t
WHERE c.CONNECTION_ID = CONNECTION_ID() AND
c.TP_GROUP_ID = t.TP_GROUP_ID AND
c.TP_PROCESSING_THREAD_NUMBER = t.TP_THREAD_NUMBER;
KILLED_STATE	CLEANUP_STATE	CONNECT_HANDLER_INDEX	TYPE
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User
# Get info about the tp_worker_thread for the current connection by joining with
# tp_thread_state and P_S.threads
SELECT
c.KILLED_STATE, c.CLEANUP_STATE,
c.CONNECT_HANDLER_INDEX, c.TYPE, t.STATE,
pt.NAME, pt.TYPE
FROM
performance_schema.tp_connections c,
performance_schema.tp_thread_state t,
performance_schema.threads pt
WHERE
c.CONNECTION_ID = CONNECTION_ID() AND
c.TP_GROUP_ID = t.TP_GROUP_ID AND
c.TP_PROCESSING_THREAD_NUMBER = t.TP_THREAD_NUMBER AND
t.THREAD_ID = pt.THREAD_ID;
KILLED_STATE	CLEANUP_STATE	CONNECT_HANDLER_INDEX	TYPE	STATE	NAME	TYPE
TP_CONNECTION_NOT_KILLED	TP_CLEANUP_IDLE	1	User	PROCESSING_DIRECT	thread/thread_pool/tp_worker	BACKGROUND
#
# Bug#36296830: TP PFS Table tp_connections does not report connections
# in the admin group
#
GRANT TP_CONNECTION_ADMIN ON *.* TO root@localhost;
SET @conn_id = CONNECTION_ID();
SELECT COUNT(*) = 1 AS AS_EXPECTED FROM performance_schema.tp_connections WHERE CONNECTION_ID = @conn_id;
AS_EXPECTED
1
# Cleanup
REVOKE TP_CONNECTION_ADMIN ON *.* FROM root@localhost;
#
# Bug#24796018: THREAD_ID IS EMPTY IN P*_SCHEMA.SOCKET_INSTANCES WHEN
# THREAD_POOL IS INSTALLED
#
# Verify that it is possible to join socket_instances with threads on
# THREAD_ID
SELECT si.EVENT_NAME, t.NAME, t.PROCESSLIST_INFO
FROM performance_schema.socket_instances si JOIN performance_schema.threads t
ON si.THREAD_ID = t.THREAD_ID
WHERE t.NAME = 'thread/thread_pool/tp_one_connection';
EVENT_NAME	NAME	PROCESSLIST_INFO
wait/io/socket/sql/client_connection	thread/thread_pool/tp_one_connection	SELECT si.EVENT_NAME, t.NAME, t.PROCESSLIST_INFO
FROM performance_schema.socket_instances si JOIN performance_schema.threads t
ON si.THREAD_ID = t.THREAD_ID
WHERE t.NAME = 'thread/thread_pool/tp_one_connection'
CALL mtr.add_suppression("thread_pool_query_threads_per_group.1. is not recommended when used with HIGH_CONCURRENCY_ALGORITHM");
