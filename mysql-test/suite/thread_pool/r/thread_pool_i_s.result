# 4. All these tables contain a column named TP_GROUP_ID and
#    these columns must be of the same type.
SELECT COUNT(*) AS "Expect 1" FROM
( SELECT COLUMN_DEFAULT,IS_NULLABLE,DATA_TYPE,NUMERIC_PRECISION,NUMERIC_SCALE,
COLUMN_TYPE,EXTRA,PRIVILEGES
FROM information_schema.columns
WHERE table_schema = 'information_schema' AND column_name = 'TP_GROUP_ID' AND table_name = 'TP_THREAD_GROUP_STATS'
  UNION DISTINCT
SELECT COLUMN_DEFAULT,IS_NULLABLE,DATA_TYPE,NUMERIC_PRECISION,NUMERIC_SCALE,
COLUMN_TYPE,EXTRA,PRIVILEGES
FROM information_schema.columns
WHERE table_schema = 'information_schema' AND column_name = 'TP_GROUP_ID' AND table_name = 'TP_THREAD_GROUP_STATE'
  UNION DISTINCT
SELECT COLUMN_DEFAULT,IS_NULLABLE,DATA_TYPE,NUMERIC_PRECISION,NUMERIC_SCALE,
COLUMN_TYPE,EXTRA,PRIVILEGES
FROM information_schema.columns
WHERE table_schema = 'information_schema' AND column_name = 'TP_GROUP_ID' AND table_name = 'TP_THREAD_STATE') AS A;
Expect 1
1
# 5. It must be impossible to alter the layout of these tables or
#    or to modify their content.
DELETE FROM information_schema.TP_THREAD_GROUP_STATS;
ERROR 42000: Access denied for user 'root'@'localhost' to database 'information_schema'
ALTER TABLE information_schema.TP_THREAD_GROUP_STATS ADD COLUMN garbage VARCHAR(20);
ERROR 42000: Access denied for user 'root'@'localhost' to database 'information_schema'
DELETE FROM information_schema.TP_THREAD_GROUP_STATE;
ERROR 42000: Access denied for user 'root'@'localhost' to database 'information_schema'
ALTER TABLE information_schema.TP_THREAD_GROUP_STATE ADD COLUMN garbage VARCHAR(20);
ERROR 42000: Access denied for user 'root'@'localhost' to database 'information_schema'
DELETE FROM information_schema.TP_THREAD_STATE;
ERROR 42000: Access denied for user 'root'@'localhost' to database 'information_schema'
ALTER TABLE information_schema.TP_THREAD_STATE ADD COLUMN garbage VARCHAR(20);
ERROR 42000: Access denied for user 'root'@'localhost' to database 'information_schema'
# 6. It must be possible to SELECT on these tables.
#    The printing of results is partially suppressed.
#    A high privileged user should see the same like a low
#    privileged user. Example:
#    There must be @@global.thread_pool_size distinct TP_GROUP_ID
#    values per table.
CREATE USER low_privilege@localhost;
GRANT USAGE ON test.* TO low_privilege@localhost;
# Establish connection (low_privilege,localhost,low_privilege,,test)
SELECT * FROM information_schema.TP_THREAD_GROUP_STATS;
SELECT * FROM information_schema.TP_THREAD_GROUP_STATE;
SELECT * FROM information_schema.TP_THREAD_STATE;
SET @admin_thread_groups = 1;
SELECT COUNT(DISTINCT TP_GROUP_ID) = @@global.thread_pool_size + @admin_thread_groups AS "Expect 1",
'TP_THREAD_GROUP_STATS' AS "Table"
FROM information_schema.TP_THREAD_GROUP_STATS
UNION ALL
SELECT COUNT(DISTINCT TP_GROUP_ID) = @@global.thread_pool_size + @admin_thread_groups AS "Expect 1",
'TP_THREAD_GROUP_STATE'
FROM information_schema.TP_THREAD_GROUP_STATE
UNION ALL
SELECT COUNT(DISTINCT TP_GROUP_ID) = @@global.thread_pool_size + @admin_thread_groups AS "Expect 1",
'TP_THREAD_STATE'
FROM information_schema.TP_THREAD_STATE;
Expect 1	Table
1	TP_THREAD_GROUP_STATS
1	TP_THREAD_GROUP_STATE
1	TP_THREAD_STATE
Warnings:
Warning	1287	'information_schema.tp_thread_group_stats' is deprecated and will be removed in a future release. Please use performance_schema.tp_thread_group_stats instead
Warning	1287	'information_schema.tp_thread_group_state' is deprecated and will be removed in a future release. Please use performance_schema.tp_thread_group_state instead
Warning	1287	'information_schema.tp_thread_state' is deprecated and will be removed in a future release. Please use performance_schema.tp_thread_state instead
# Switch to connection default
SELECT * FROM information_schema.TP_THREAD_GROUP_STATS;
SELECT * FROM information_schema.TP_THREAD_GROUP_STATE;
SELECT * FROM information_schema.TP_THREAD_STATE;
SELECT COUNT(DISTINCT TP_GROUP_ID) = @@global.thread_pool_size + @admin_thread_groups AS "Expect 1",
'TP_THREAD_GROUP_STATS' AS "Table"
FROM information_schema.TP_THREAD_GROUP_STATS
UNION ALL
SELECT COUNT(DISTINCT TP_GROUP_ID) = @@global.thread_pool_size + @admin_thread_groups AS "Expect 1",
'TP_THREAD_GROUP_STATE'
FROM information_schema.TP_THREAD_GROUP_STATE
UNION ALL
SELECT COUNT(DISTINCT TP_GROUP_ID) = @@global.thread_pool_size + @admin_thread_groups AS "Expect 1",
'TP_THREAD_STATE'
FROM information_schema.TP_THREAD_STATE;
Expect 1	Table
1	TP_THREAD_GROUP_STATS
1	TP_THREAD_GROUP_STATE
1	TP_THREAD_STATE
Warnings:
Warning	1287	'information_schema.tp_thread_group_stats' is deprecated and will be removed in a future release. Please use performance_schema.tp_thread_group_stats instead
Warning	1287	'information_schema.tp_thread_group_state' is deprecated and will be removed in a future release. Please use performance_schema.tp_thread_group_state instead
Warning	1287	'information_schema.tp_thread_state' is deprecated and will be removed in a future release. Please use performance_schema.tp_thread_state instead
DROP USER low_privilege@localhost;
#
# Bug#34020058 - Extend PFS.tp_thread_state table to include PFS thread_id and TP thread type
#
# PFS thread id and thread type of each thread should be listed.
SELECT TP_GROUP_ID, WAIT_TYPE, TP_THREAD_TYPE FROM information_schema.TP_THREAD_STATE WHERE TP_GROUP_ID = 0
AND TP_THREAD_TYPE = 'CONNECTION_HANDLER_WORKER_THREAD';
TP_GROUP_ID	WAIT_TYPE	TP_THREAD_TYPE
0	NULL	CONNECTION_HANDLER_WORKER_THREAD
Warnings:
Warning	1287	'information_schema.tp_thread_state' is deprecated and will be removed in a future release. Please use performance_schema.tp_thread_state instead
SELECT TP_GROUP_ID, WAIT_TYPE, TP_THREAD_TYPE FROM information_schema.TP_THREAD_STATE WHERE TP_GROUP_ID = 0
AND TP_THREAD_TYPE = 'QUERY_WORKER_THREAD' LIMIT 1;
TP_GROUP_ID	WAIT_TYPE	TP_THREAD_TYPE
0	NULL	QUERY_WORKER_THREAD
Warnings:
Warning	1287	'information_schema.tp_thread_state' is deprecated and will be removed in a future release. Please use performance_schema.tp_thread_state instead
#
# Bug#36359860: No deprecation warning when accessing TP I_S tables
#
# Show increase in I_S usage counter from running this test
SELECT VARIABLE_VALUE - @saved_deprecated_i_s_usage_count AS EXPECT_14
FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Deprecated_thread_pool_i_s_usage_count';
EXPECT_14
14
#
# Bug#39694379: thread_pool plugin reports PLUGIN_LICENSE = PROPRIETARYr
# in Community Server 26.7
#
# Show output from I_S.plugins for TP.
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY, PLUGIN_LICENSE, PLUGIN_AUTHOR
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_LIBRARY='thread_pool.so';
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY	PLUGIN_LICENSE	PLUGIN_AUTHOR
thread_pool	ACTIVE	DAEMON	thread_pool.so	GPL	Oracle Corporation
TP_THREAD_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.so	GPL	Oracle Corporation
TP_THREAD_GROUP_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.so	GPL	Oracle Corporation
TP_THREAD_GROUP_STATS	ACTIVE	INFORMATION SCHEMA	thread_pool.so	GPL	Oracle Corporation
SELECT COUNT(*) AS EXPECT_0 FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_LIBRARY='thread_pool.so' AND  PLUGIN_LICENSE = 'PROPRIETARY';
EXPECT_0
0
SELECT COUNT(*) AS EXPECT_4 FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_LIBRARY='thread_pool.so' AND  PLUGIN_LICENSE = 'GPL';
EXPECT_4
4
