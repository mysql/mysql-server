SET @saved_deprecated_i_s_usage_count = (SELECT VARIABLE_VALUE
FROM performance_schema.global_status WHERE VARIABLE_NAME = 'Deprecated_thread_pool_i_s_usage_count');
SET @admin_thread_groups = 1;
# 1. "pool of threads" functionality and its information_schema tables
#    are provided as plugin.
SELECT PLUGIN_NAME, PLUGIN_STATUS, PLUGIN_TYPE, PLUGIN_LIBRARY,
PLUGIN_AUTHOR, PLUGIN_LICENSE
FROM INFORMATION_SCHEMA.PLUGINS
WHERE PLUGIN_NAME IN
('thread_pool','TP_THREAD_STATE','TP_THREAD_GROUP_STATE','TP_THREAD_GROUP_STATS');
PLUGIN_NAME	PLUGIN_STATUS	PLUGIN_TYPE	PLUGIN_LIBRARY	PLUGIN_AUTHOR	PLUGIN_LICENSE
thread_pool	ACTIVE	DAEMON	thread_pool.<extension>	Oracle Corporation	GPL
TP_THREAD_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>	Oracle Corporation	GPL
TP_THREAD_GROUP_STATE	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>	Oracle Corporation	GPL
TP_THREAD_GROUP_STATS	ACTIVE	INFORMATION SCHEMA	thread_pool.<extension>	Oracle Corporation	GPL
# 2. Show the layout of the "pool of threads" tables.
SHOW CREATE TABLE information_schema.TP_THREAD_GROUP_STATS;
Table	Create Table
TP_THREAD_GROUP_STATS	CREATE TEMPORARY TABLE `TP_THREAD_GROUP_STATS` (
  `TP_GROUP_ID` int unsigned NOT NULL DEFAULT '0',
  `CONNECTIONS_STARTED` bigint unsigned NOT NULL DEFAULT '0',
  `CONNECTIONS_CLOSED` bigint unsigned NOT NULL DEFAULT '0',
  `QUERIES_EXECUTED` bigint unsigned NOT NULL DEFAULT '0',
  `QUERIES_QUEUED` bigint unsigned NOT NULL DEFAULT '0',
  `THREADS_STARTED` bigint unsigned NOT NULL DEFAULT '0',
  `PRIO_KICKUPS` bigint unsigned NOT NULL DEFAULT '0',
  `STALLED_QUERIES_EXECUTED` bigint unsigned NOT NULL DEFAULT '0',
  `BECOME_CONSUMER_THREAD` bigint unsigned NOT NULL DEFAULT '0',
  `BECOME_RESERVE_THREAD` bigint unsigned NOT NULL DEFAULT '0',
  `BECOME_WAITING_THREAD` bigint unsigned NOT NULL DEFAULT '0',
  `WAKE_THREAD_STALL_CHECKER` bigint unsigned NOT NULL DEFAULT '0',
  `SLEEP_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `DISK_IO_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `ROW_LOCK_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `GLOBAL_LOCK_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `META_DATA_LOCK_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `TABLE_LOCK_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `USER_LOCK_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `BINLOG_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `GROUP_COMMIT_WAITS` bigint unsigned NOT NULL DEFAULT '0',
  `FSYNC_WAITS` bigint unsigned NOT NULL DEFAULT '0'
) ENGINE=MEMORY DEFAULT CHARSET=utf8mb3
SHOW CREATE TABLE information_schema.TP_THREAD_GROUP_STATE;
Table	Create Table
TP_THREAD_GROUP_STATE	CREATE TEMPORARY TABLE `TP_THREAD_GROUP_STATE` (
  `TP_GROUP_ID` int unsigned NOT NULL DEFAULT '0',
  `CONSUMER_THREADS` int unsigned NOT NULL DEFAULT '0',
  `RESERVE_THREADS` int unsigned NOT NULL DEFAULT '0',
  `CONNECT_THREAD_COUNT` int unsigned NOT NULL DEFAULT '0',
  `CONNECTION_COUNT` int unsigned NOT NULL DEFAULT '0',
  `QUEUED_QUERIES` int unsigned NOT NULL DEFAULT '0',
  `QUEUED_TRANSACTIONS` int unsigned NOT NULL DEFAULT '0',
  `STALL_LIMIT` int unsigned NOT NULL DEFAULT '0',
  `PRIO_KICKUP_TIMER` int unsigned NOT NULL DEFAULT '0',
  `ALGORITHM` varchar(20) NOT NULL DEFAULT '',
  `THREAD_COUNT` int unsigned NOT NULL DEFAULT '0',
  `ACTIVE_THREAD_COUNT` int unsigned NOT NULL DEFAULT '0',
  `STALLED_THREAD_COUNT` int unsigned NOT NULL DEFAULT '0',
  `WAITING_THREAD_NUMBER` int unsigned DEFAULT NULL,
  `OLDEST_QUEUED` bigint unsigned DEFAULT NULL,
  `MAX_THREAD_IDS_IN_GROUP` int unsigned NOT NULL DEFAULT '0'
) ENGINE=MEMORY DEFAULT CHARSET=utf8mb3
SHOW CREATE TABLE information_schema.TP_THREAD_STATE;
Table	Create Table
TP_THREAD_STATE	CREATE TEMPORARY TABLE `TP_THREAD_STATE` (
  `TP_GROUP_ID` int unsigned NOT NULL DEFAULT '0',
  `TP_THREAD_NUMBER` int unsigned NOT NULL DEFAULT '0',
  `PROCESS_COUNT` bigint unsigned NOT NULL DEFAULT '0',
  `WAIT_TYPE` varchar(30) DEFAULT NULL,
  `TP_THREAD_TYPE` varchar(32) NOT NULL DEFAULT '',
  `THREAD_ID` bigint unsigned DEFAULT NULL
) ENGINE=MEMORY DEFAULT CHARSET=utf8mb3
# 3. Show the columns of these tables how they are reported within
#    information_schema.columns.
SELECT TABLE_NAME, COLUMN_NAME,COLUMN_DEFAULT,IS_NULLABLE,DATA_TYPE,
CHARACTER_MAXIMUM_LENGTH,CHARACTER_OCTET_LENGTH,NUMERIC_PRECISION,
NUMERIC_SCALE,CHARACTER_SET_NAME,COLLATION_NAME,COLUMN_TYPE,EXTRA,
PRIVILEGES,COLUMN_COMMENT
FROM information_schema.columns
WHERE table_schema = 'information_schema'
  AND table_name IN
('TP_THREAD_GROUP_STATS','TP_THREAD_GROUP_STATE','TP_THREAD_STATE')
ORDER BY table_name,column_name;
