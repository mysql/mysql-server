CREATE TABLE mysqltest.statistics
LIKE mysqltest.start_statistics;
ALTER TABLE mysqltest.statistics
DROP COLUMN WHAT,
ADD COLUMN prio_kickup_timer BIGINT,
ADD COLUMN first_counter BIGINT,
ADD COLUMN second_counter BIGINT;
SET @@SESSION.lock_wait_timeout = 10;
LOCK TABLES mysqltest.to_lock WRITE;
INSERT INTO mysqltest.to_lock VALUES(1);
KILL QUERY <id>;
ERROR 70100: Query execution was interrupted
UNLOCK TABLES;
SET @first_high_priority_connection = 1, @second_high_priority_connection = 0;
SET @first_size =               'small', @second_size =               'small';
SET @first_transaction =              0, @second_transaction =              0;
SET @first_prepared =                 0, @second_prepared =                 0;
SELECT COUNT(*),worker_type,high_priority_connection,task_size,task_transaction,task_prepared
FROM mysqltest.book_keeping
GROUP BY worker_type;
COUNT(*)	worker_type	high_priority_connection	task_size	task_transaction	task_prepared
5	first	1	small	0	0
5	second	0	small	0	0
SELECT AVG(first_counter), AVG(second_counter),
AVG(PRIO_KICKUPS),  AVG(BECOME_WAITING_THREAD)
INTO @first_counter_0, @second_counter_0,
@PRIO_KICKUPS_0, @BECOME_WAITING_THREAD_0
FROM mysqltest.statistics
WHERE prio_kickup_timer = 0
GROUP BY prio_kickup_timer;
SELECT AVG(first_counter), AVG(second_counter),
AVG(PRIO_KICKUPS),  AVG(BECOME_WAITING_THREAD)
INTO @first_counter_1, @second_counter_1,
@PRIO_KICKUPS_1, @BECOME_WAITING_THREAD_1
FROM mysqltest.statistics
WHERE prio_kickup_timer = 1
GROUP BY prio_kickup_timer;
SELECT AVG(first_counter), AVG(second_counter),
AVG(PRIO_KICKUPS),  AVG(BECOME_WAITING_THREAD)
INTO @first_counter_512, @second_counter_512,
@PRIO_KICKUPS_512, @BECOME_WAITING_THREAD_512
FROM mysqltest.statistics
WHERE prio_kickup_timer = 512
GROUP BY prio_kickup_timer;
SELECT AVG(first_counter), AVG(second_counter),
AVG(PRIO_KICKUPS),  AVG(BECOME_WAITING_THREAD)
INTO @first_counter_4096, @second_counter_4096,
@PRIO_KICKUPS_4096, @BECOME_WAITING_THREAD_4096
FROM mysqltest.statistics
WHERE prio_kickup_timer = 4096
GROUP BY prio_kickup_timer;
