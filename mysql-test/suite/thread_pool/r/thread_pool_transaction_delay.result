# Basic testing
SHOW VARIABLES LIKE 'thread_pool_transaction_delay';
Variable_name	Value
thread_pool_transaction_delay	0
SET GLOBAL thread_pool_transaction_delay = -1;
ERROR 42000: Variable 'thread_pool_transaction_delay' can't be set to the value of '-1'
SET GLOBAL thread_pool_transaction_delay = 10;
SELECT @@GLOBAL.thread_pool_transaction_delay;
@@GLOBAL.thread_pool_transaction_delay
10
CREATE TABLE t1(i INT);
INSERT INTO t1 VALUES (0), (1), (2);
BEGIN WORK;
SELECT * FROM t1 LIMIT 1;
i
0
SELECT * FROM t1;
i
0
1
2
COMMIT WORK;
SELECT * FROM t1 LIMIT 2;
i
0
1
DROP TABLE t1;
# Verify that the time taken to to run transactions increases as
# expected, when setting thread_pool_transaction_delay
SET GLOBAL thread_pool_transaction_delay = 0;
CREATE TABLE t1(ts TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP);
# No second level diff expected here
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
SELECT (MAX(ts) - MIN(ts)) <= 5 FROM t1;
(MAX(ts) - MIN(ts)) <= 5
1
DELETE FROM t1;
SET GLOBAL  thread_pool_transaction_delay = 5000;
# Verify that there is now at least 5 second diff between the statements
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
SELECT (MAX(ts) - MIN(ts)) >= 5 FROM t1;
(MAX(ts) - MIN(ts)) >= 5
1
DELETE FROM t1;
# Verify that the each new statement (autocommit) is delayed
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
SELECT (MAX(ts) - MIN(ts)) >= (6 * 5) FROM t1;
(MAX(ts) - MIN(ts)) >= (6 * 5)
1
# Verify that no delay is added for statements that are part of a
# transaction
DELETE FROM t1;
BEGIN WORK;
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
COMMIT WORK;
SELECT MAX(ts) - MIN(ts) <= 5 FROM t1;
MAX(ts) - MIN(ts) <= 5
1
DELETE FROM t1;
# Verify that BEGIN WORK is delayed
INSERT INTO t1 VALUES();
BEGIN WORK;
INSERT INTO t1 VALUES();
COMMIT;
SELECT max(ts) - MIN(ts) >= 5 FROM t1;
max(ts) - MIN(ts) >= 5
1
DELETE FROM t1;
# Verify that no delay is added when using admin connection
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
SELECT MAX(ts) - MIN(ts) <= 5 FROM t1;
MAX(ts) - MIN(ts) <= 5
1
DELETE FROM t1;
# Verify that no delay is added when thread_pool_transaction_delay
# is set to DEFAULT value.
SET GLOBAL thread_pool_transaction_delay = DEFAULT;
INSERT INTO t1 VALUES ();
INSERT INTO t1 VALUES ();
SELECT (MAX(ts) - MIN(ts)) <= 5 FROM t1;
(MAX(ts) - MIN(ts)) <= 5
1
DROP TABLE t1;
SET GLOBAL thread_pool_transaction_delay = 0;
