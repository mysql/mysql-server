INSTALL COMPONENT "file://component_test_mysql_command_services";

--echo # Test : sending no arguments.
SELECT test_mysql_command_services_udf();

--echo # Test : should return '2' the output of SELECT 1+1;
SELECT test_mysql_command_services_udf("select 1+1");

--echo # Test : should return '2.5' the output of SELECT 1.3+1.2;
SELECT test_mysql_command_services_udf("select 1.3+1.2");

--echo # Test : should return TIMESTAMP
SELECT test_mysql_command_services_udf("SELECT TIMESTAMP('2003-12-31')");

--echo # Test : should return DATE
SELECT test_mysql_command_services_udf("SELECT FROM_DAYS(730669)");

--echo # Test : should return TIME
--disable_result_log
SELECT test_mysql_command_services_udf("SELECT CURTIME()");
--enable_result_log

CREATE TABLE test.t1 (c1 int, c2 char(13));
INSERT INTO test.t1 VALUES (1, "foo"), (2, "bar"), (3, "zap");
SELECT * FROM test.t1;
SELECT test_mysql_command_services_udf("SELECT * FROM test.t1");

CREATE TABLE test.t2 (c1 int, c2 float);
INSERT INTO test.t2 VALUES (1, 1.1), (2, 2.2), (3, 3.3);
SELECT * FROM test.t2;
SELECT test_mysql_command_services_udf("SELECT * FROM test.t2");

CREATE TABLE test.t3 (c1 int, c2 double);
INSERT INTO test.t3 VALUES (1, 1.11), (2, 2.22), (3, 3.33);
SELECT * FROM test.t3;
SELECT test_mysql_command_services_udf("SELECT * FROM test.t3");

CREATE TABLE test.t4 (c1 int, c2 decimal(5,3));
INSERT INTO test.t4 VALUES (1, 1.111), (2, 2.222), (3, 3.333);
SELECT * FROM test.t4;
SELECT test_mysql_command_services_udf("SELECT * FROM test.t4");

--echo The output is truncated to MAX_FIELD_WIDTH size, this is
--echo because the udf buffer is of that size.
CREATE TABLE test.t5 (c1 int, c2 varchar(1000));
INSERT INTO test.t5 VALUES (1, repeat('a',1000));
SELECT * FROM test.t5;
SELECT test_mysql_command_services_udf("SELECT * FROM test.t5");

--echo # Test : should return error message
--error ER_COMMAND_SERVICE_BACKEND_FAILED
SELECT test_mysql_command_services_udf("SELECT * FROM mysql.plugin ORDER BY name");

--echo # Test : should return error message BUG#34035897
--error ER_COMMAND_SERVICE_BACKEND_FAILED
SELECT test_mysql_command_services_udf("SELECT * FROM information_schema.innodb_tables");

--disable_result_log
SELECT test_mysql_command_services_udf("SELECT * FROM information_schema.COLLATION_CHARACTER_SET_APPLICABILITY");
--enable_result_log

--echo # Test : should return NULL field value if exits BUG#34026180
CREATE TABLE test.t6(c1 int, c2 text);
INSERT INTO test.t6 VALUES(1, 'FOO');
SELECT test_mysql_command_services_udf("INSERT INTO test.t6(c2) VALUES('BAR')");
SELECT test_mysql_command_services_udf("SELECT c1,c2 FROM test.t6");

--echo # Test : command-service rows preserve SQL NULL and binary string lengths
SELECT test_mysql_command_services_row_semantics_udf();

--echo # Test: reusing the same connection to run several queries should not crash
SELECT test_mysql_command_services_udf("SELECT 1");
SELECT test_mysql_command_services_udf("SELECT 1", 2);

SELECT test_mysql_command_services_apis_udf();
SELECT test_mysql_command_services_apis_udf("SELECT 1+1");
--echo The test.my_demo_transaction table is created inside above udf function
DROP TABLE test.my_demo_transaction;

DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t3;
DROP TABLE t4;
DROP TABLE t5;
DROP TABLE t6;

--echo # Test : sql_errno() should get the error code (1146) BUG#38178087
# Set debug trap
--source include/have_debug.inc
SET @@GLOBAL.DEBUG = '+d, mysql_command_services_component_test_errno';
# Should return the error code: 1146
SELECT test_mysql_command_services_error_code_udf("SELECT * FROM test.no_such_table");
SET @@GLOBAL.DEBUG = '-d, mysql_command_services_component_test_errno';

--echo # Test : a row execution error after metadata leaves the handle reusable
CREATE TABLE test.mcs_invalid_json(value VARCHAR(32));
INSERT INTO test.mcs_invalid_json VALUES ('not-json');
CREATE VIEW test.no_such_table AS
  SELECT JSON_EXTRACT(value, '$') AS value FROM test.mcs_invalid_json;
GRANT SELECT ON test.no_such_table TO 'mysql.session'@'localhost';
SELECT test_mysql_command_session_error_info_success_clears_udf();
REVOKE SELECT ON test.no_such_table FROM 'mysql.session'@'localhost';
DROP VIEW test.no_such_table;
DROP TABLE test.mcs_invalid_json;

--echo # Test : failing connect() when running in an initialized thread; cleanup (cmd_factory->close() + cmd_thread->end()) must not leak the session
SELECT test_mysql_command_services_explicit_connect_fail_cleanup_udf();

--echo # Test : MYSQL_COMMAND_CLIENT_FLAGS should switch UPDATE affected rows to found rows
CREATE TABLE test.mcs_client_flags(c1 INT PRIMARY KEY);
INSERT INTO test.mcs_client_flags VALUES (1);
SELECT test_mysql_command_services_client_flags_udf() AS client_flags_switch_update_affected_rows;
DROP TABLE test.mcs_client_flags;

# Authenticated command-service connections use the normal classic protocol.
CREATE USER 'mcs_auth_ok'@'localhost'
  IDENTIFIED BY 'Mcs_auth-39817209!';
CREATE USER 'mcs_auth_empty'@'localhost' IDENTIFIED BY '';
CREATE USER 'mcs_auth_locked'@'localhost'
  IDENTIFIED BY 'Mcs_auth-39817209!' ACCOUNT LOCK;
CREATE USER 'mcs_auth_expired'@'localhost'
  IDENTIFIED BY 'Mcs_auth-39817209!' PASSWORD EXPIRE;
CREATE USER 'mcs_auth_plugin'@'localhost'
  IDENTIFIED WITH caching_sha2_password BY 'Mcs_auth-39817209!';
CREATE USER 'mcs_auth_tcp'@'localhost'
  IDENTIFIED BY 'Mcs_auth-39817209!';
CREATE USER 'mcs_auth_tcp'@'127.0.0.1'
  IDENTIFIED BY 'Mcs_auth-39817209!';
CREATE USER 'mcs_auth_tcp'@'::1'
  IDENTIFIED BY 'Mcs_auth-39817209!';

--echo # Test : authenticated local connection returns canonical CURRENT_USER()
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket)
  AS authenticated_current_user;

--echo # Test : an explicitly empty password selects authenticated mode
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_empty', '', 'localhost', @@port, @@socket)
  AS empty_password_current_user;

--echo # Test : wrong, nonexistent, locked, and expired accounts fail authentication
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'wrong-password', 'localhost', @@port, @@socket)
  AS wrong_password_error;
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_missing', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket)
  AS nonexistent_account_error;
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_locked', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket)
  AS locked_account_error;
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_expired', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket)
  AS expired_password_error;

--echo # Test : authenticated attempts require a newly initialized handle
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket,
  'retry_validation')
  AS validation_failure_retry_error;
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket,
  'retry_authentication')
  AS authentication_failure_retry_error;

--echo # Test : authenticated mode restores normal client methods
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'wrong-password', 'localhost', @@port, @@socket,
  'after_embedded_failure')
  AS authentication_after_embedded_failure_error;

--echo # Test : explicitly selected authentication plugin uses normal negotiation
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_plugin', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket)
  AS authentication_plugin_current_user;

--echo # Test : loopback TCP connects only to the current server port
SELECT test_mysql_command_services_authenticate_udf(
         'mcs_auth_tcp', 'Mcs_auth-39817209!', '127.0.0.1', @@port, NULL)
       IN ('mcs_auth_tcp@localhost', 'mcs_auth_tcp@127.0.0.1')
  AS authenticated_loopback_tcp;

--echo # Test : wildcard bind permits authenticated IPv6 loopback TCP
let $check_ipv6_just_check = 1;
--source include/check_ipv6.inc
if ($check_ipv6_supported)
{
  let $authenticated_ipv6_loopback = `SELECT
    test_mysql_command_services_authenticate_udf(
      'mcs_auth_tcp', 'Mcs_auth-39817209!', '::1', @@port, NULL)
    IN ('mcs_auth_tcp@localhost', 'mcs_auth_tcp@::1')`;
  if (!$authenticated_ipv6_loopback)
  {
    die Authenticated IPv6 loopback connection failed;
  }
}

SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_tcp', 'Mcs_auth-39817209!', '192.0.2.1', @@port, NULL)
  AS remote_endpoint_error;
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_tcp', 'Mcs_auth-39817209!', '127.0.0.1',
  IF(@@port = 65535, @@port - 1, @@port + 1), NULL)
  AS wrong_loopback_port_error;
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'Mcs_auth-39817209!', 'localhost', @@port,
  CONCAT(@@socket, '.other'))
  AS wrong_local_endpoint_error;

--echo # Test : authenticated mode rejects embedded-backend-only options
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket,
  'local_thd')
  AS authenticated_local_thd_error;
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket,
  'consumer')
  AS authenticated_consumer_error;
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket,
  'no_lock')
  AS authenticated_no_lock_error;

--echo # Test : earlier authentication failures do not affect later connections
SELECT test_mysql_command_services_authenticate_udf(
  'mcs_auth_ok', 'Mcs_auth-39817209!', 'localhost', @@port, @@socket)
  AS authenticated_after_failures;
SELECT test_mysql_command_services_udf('SELECT 1')
  AS embedded_after_authenticated_failures;

DROP USER 'mcs_auth_ok'@'localhost';
DROP USER 'mcs_auth_empty'@'localhost';
DROP USER 'mcs_auth_locked'@'localhost';
DROP USER 'mcs_auth_expired'@'localhost';
DROP USER 'mcs_auth_plugin'@'localhost';
DROP USER 'mcs_auth_tcp'@'localhost';
DROP USER 'mcs_auth_tcp'@'127.0.0.1';
DROP USER 'mcs_auth_tcp'@'::1';

# Error-log must not contain: [ERROR] [MY-010470] [Server] Closed forcefully 1 session left opened by plugin server_service

UNINSTALL COMPONENT "file://component_test_mysql_command_services";
