INSTALL COMPONENT "file://component_test_mysql_current_thread_reader";

let $log_error_= `SELECT @@GLOBAL.log_error`;
if($log_error_ == "stderr")
{
  let $log_error_ = $MYSQLTEST_VARDIR/log/mysqld.1.err;
}
let SEARCH_FILE=$log_error_;

--echo # Test : must return the same as current_user;
SELECT test_thd_reader_current_user();

CREATE USER 'test_account_locked'@'localhost' ACCOUNT LOCK;
--echo # Test account lock state from a looked-up security context.
SELECT test_security_context_account_locked();
ALTER USER 'test_account_locked'@'localhost' ACCOUNT UNLOCK;
SELECT test_security_context_account_locked();
DROP USER 'test_account_locked'@'localhost';

UNINSTALL COMPONENT "file://component_test_mysql_current_thread_reader";
