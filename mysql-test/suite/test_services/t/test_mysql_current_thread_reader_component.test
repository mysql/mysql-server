INSTALL COMPONENT "file://component_test_mysql_current_thread_reader";

let $log_error_= `SELECT @@GLOBAL.log_error`;
if($log_error_ == "stderr")
{
  let $log_error_ = $MYSQLTEST_VARDIR/log/mysqld.1.err;
}
let SEARCH_FILE=$log_error_;

--echo # Test : must return the same as current_user;
SELECT test_thd_reader_current_user();

CREATE USER 'test_account_locked'@'localhost' ACCOUNT LOCK;
--echo # Test account lock state from a looked-up security context.
SELECT test_security_context_account_locked();
ALTER USER 'test_account_locked'@'localhost' ACCOUNT UNLOCK;
SELECT test_security_context_account_locked();
DROP USER 'test_account_locked'@'localhost';

--echo # Test whether the current statement is a Server substatement
SELECT test_thd_is_substatement();

CREATE FUNCTION test_is_substatement_function()
RETURNS INTEGER NO SQL
RETURN test_thd_is_substatement();
SELECT test_is_substatement_function();
DROP FUNCTION test_is_substatement_function;

CREATE TABLE test_is_substatement_trigger (value INTEGER);
CREATE TRIGGER test_is_substatement_before_insert
BEFORE INSERT ON test_is_substatement_trigger
FOR EACH ROW SET NEW.value = test_thd_is_substatement();
INSERT INTO test_is_substatement_trigger VALUES (0);
SELECT value FROM test_is_substatement_trigger;
DROP TRIGGER test_is_substatement_before_insert;
DROP TABLE test_is_substatement_trigger;

UNINSTALL COMPONENT "file://component_test_mysql_current_thread_reader";
