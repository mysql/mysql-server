INSTALL COMPONENT "file://component_test_mysql_command_services";

RESET BINARY LOGS AND GTIDS;
CREATE TABLE test.tg (c INT);

--echo # Test : GTID tracker data is exposed through mysql_command_session_state
--replace_regex /[0-9a-f-]+:[0-9]+/<GTID>/
SELECT test_mysql_command_session_state_sequence_udf("SET @@session.session_track_gtids='OWN_GTID'", "SET @test_mysql_command_services_gtid=1", "INSERT INTO test.tg VALUES (1)", "SESSION_TRACK_GTIDS");

DROP TABLE test.tg;

UNINSTALL COMPONENT "file://component_test_mysql_command_services";
