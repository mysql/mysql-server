# ==== Purpose ====
#
# When the in-memory relay log cannot delete a committed transaction's spill
# file at run time, the applier stops with ER_REPLICA_RELAY_LOG_READ_FAILURE,
# as it does when the relay log cannot purge a relay log file. The file no
# longer counts in the spill status values, and START REPLICA SQL_THREAD
# starts the applier again.
#
# ==== Requirements ====
#
# R1. The failed delete is logged as a warning naming the file and the error.
# R2. The applier stops with ER_REPLICA_RELAY_LOG_READ_FAILURE; the receiver
#     keeps running.
# R3. The transaction whose file could not be deleted is applied.
# R4. SPILL_FILE_COUNT and SPILL_BYTES_USED read 0, and the file stays on disk.
# R5. START REPLICA SQL_THREAD starts the applier again, and it applies new
#     transactions.
# R6. A server restart purges the leftover orphan spill file through the startup
#     cleanup (FR28), and the already-applied rows survive.
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with the in-memory relay log and the minimum 8 MiB
#      spill threshold.
#   2. Lock the table on the replica, so the applier cannot commit, and send
#      one transaction larger than the threshold. Wait until the replica has
#      received it and its spill file exists.
#   3. Make the spill directory read-only and unlock the table. The transaction
#      commits and its file cannot be deleted. Check R1 to R4.
#   4. Make the directory writable again, start the applier and replicate a
#      small transaction (R5).
#   5. Restart the replica server and assert the leftover orphan is purged by
#      the startup cleanup and the applied rows survive (R6).
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.

# CSA is row-based only.
--source include/have_binlog_format_row.inc
# A compressed 12 MiB transaction would not reach the spill threshold.
--source include/not_binlog_transaction_compression_on.inc
# The delete fails through directory permissions, which root and Windows
# ignore.
--source include/not_windows.inc
--source include/not_as_root.inc
# SPILL_FILE_COUNT and SPILL_BYTES_USED.
--source include/have_component_replication_applier_metrics.inc

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--echo
--echo # 1. A CSA channel with the in-memory relay log and an 8 MiB spill
--echo #    threshold.
--echo

--source include/rpl/connection_replica.inc
CALL mtr.add_suppression("\\[In-memory relay log\\] could not delete spill file");
CALL mtr.add_suppression("Relay log read failure: could not delete an in-memory relay log spill file");
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;

# <relay-log dir>/#in_memory_relaylog_temp_files
--let $spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`
INSTALL COMPONENT 'file://component_replication_applier_metrics';
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
--source include/rpl/sync_to_replica.inc

--echo
--echo # 2. Block the applier with a table lock and send one spill transaction.
--echo

--connect(replica_lock, 127.0.0.1, root,, test, $SLAVE_MYPORT,)
LOCK TABLES t1 WRITE;

--source include/rpl/connection_source.inc
BEGIN;
--disable_query_log
--let $i= 1
while ($i <= 12)
{
  --eval INSERT INTO t1 VALUES ($i, REPEAT('x', 1048576))
  --inc $i
}
--enable_query_log
COMMIT;
--source include/rpl/sync_to_replica_received.inc

--source include/rpl/connection_replica.inc
--echo # The received transaction has one spill file.
--replace_regex /imr_sp_[0-9a-f]+/imr_sp_<ID>/
--list_files $spill_dir imr_sp_*

--echo
--echo # 3. Make the spill directory read-only and release the lock.
--echo

--chmod 0500 $spill_dir
--connection replica_lock
UNLOCK TABLES;
--disconnect replica_lock

--source include/rpl/connection_replica.inc
# R2: the applier stops with the relay log read failure.
--let $slave_sql_errno= convert_error(ER_REPLICA_RELAY_LOG_READ_FAILURE)
--source include/rpl/wait_for_applier_error.inc
--chmod 0750 $spill_dir

--let $sql_error= query_get_value(SHOW REPLICA STATUS, Last_SQL_Error, 1)
--let $assert_text= Last_SQL_Error names the failed spill file delete
--let $assert_cond= "$sql_error" LIKE "Relay log read failure: could not delete an in-memory relay log spill file%"
--source include/assert.inc

--let $io_running= query_get_value(SHOW REPLICA STATUS, Replica_IO_Running, 1)
--let $assert_text= The receiver keeps running
--let $assert_cond= "$io_running" = "Yes"
--source include/assert.inc

# R1: the warning names the file and the error.
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: rpl_gtid.rpl_csa_imr_spill_delete_failure
--let $assert_select= \[Warning\] .*\[In-memory relay log\] could not delete spill file '.*#in_memory_relaylog_temp_files/imr_sp_[0-9a-f]+' \(errno 13 - .*\); it is left for the purge at the next server start
--let $assert_count= 1
--let $assert_text= The failed delete is logged with the file and the error
--source include/assert_grep.inc

# R3: the transaction is applied.
--let $assert_text= The spill transaction is applied
--let $assert_cond= [SELECT COUNT(*) FROM t1] = 12
--source include/assert.inc

# R4: the file no longer counts, but stays on disk.
--let $assert_text= SPILL_FILE_COUNT reads 0
--let $assert_cond= [SELECT SPILL_FILE_COUNT FROM performance_schema.replication_applier_metrics WHERE CHANNEL_NAME = ""] = 0
--source include/assert.inc
--let $assert_text= SPILL_BYTES_USED reads 0
--let $assert_cond= [SELECT SPILL_BYTES_USED FROM performance_schema.replication_applier_metrics WHERE CHANNEL_NAME = ""] = 0
--source include/assert.inc
--echo # The file that could not be deleted is still on disk.
--replace_regex /imr_sp_[0-9a-f]+/imr_sp_<ID>/
--list_files $spill_dir imr_sp_*

--echo
--echo # 4. START REPLICA SQL_THREAD starts the applier again (R5).
--echo

--source include/rpl/start_applier.inc

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (100, 'small');
--source include/rpl/sync_to_replica.inc
--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len FROM t1 ORDER BY id
--source include/rpl/diff.inc

--echo
--echo # 5. A server restart purges the leftover orphan spill file through the
--echo #    startup cleanup (FR28); the already-applied rows survive (R6).
--echo

--source include/rpl/connection_replica.inc
--source include/rpl/stop_replica.inc

--let $rpl_server_number= 2
--source include/rpl/restart_server.inc

--source include/rpl/connection_replica.inc
--echo # The orphan spill file is gone after the startup cleanup.
--list_files $spill_dir imr_sp_*

--let $assert_text= The applied rows survived the restart
--let $assert_cond= [SELECT COUNT(*) FROM t1] = 13
--source include/assert.inc

# Cleanup. Both threads are stopped after the restart.
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 16777216;
UNINSTALL COMPONENT 'file://component_replication_applier_metrics';
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--source include/rpl/deinit.inc
