# ==== Purpose ====
#
# Verify that a coordinator or worker failure to open a spill file, in the
# window between Trx_envelope_queue::enqueue() publishing the envelope and the
# receiver's provisioning check in open_transaction(), is not taken for a
# provisioning failure.
#
# Before the fix the receiver's check read the batch's shared error status,
# which the consumer's open failure had set: the receiver logged "failed to
# admit incoming transaction", stopped with ER_REPLICA_RELAY_LOG_WRITE_FAILURE
# (13122), and closed the envelope neither sealed nor truncated. The writer now
# has its own error state, which a reader failure does not touch.
#
# ==== Requirements ====
#
# R1. A reader open failure inside the publish window stops only the applier,
#     with ER_REPLICA_RELAY_LOG_READ_FAILURE (13121).
# R2. The receiver does not stop: no 13122, no "failed to admit incoming
#     transaction" in the error log, and it receives the whole transaction.
# R3. After the cause is removed, START REPLICA SQL_THREAD applies the
#     transaction, and no spill file is left behind.
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with IMR enabled and the minimum 8 MiB spill
#      threshold; keep both threads running.
#   2. Add imr_force_spill_reader_open_failure (every coordinator and worker
#      open of a spill file fails) and imr_pause_after_enqueue_publish (the
#      receiver parks after enqueue() published the envelope and before the
#      provisioning check). The source commits a >8 MiB transaction. Wait for
#      the receiver to park, then for a worker to fail with 13121; release the
#      receiver; wait for the applier to stop with 13121.
#   3. Assert the receiver has no error, is running, received the
#      transaction's GTID, and did not log a provisioning failure; the
#      worker's 13121 error names the forced open failure.
#   4. Remove the reader point, START REPLICA SQL_THREAD, sync, compare the
#      data, and wait until no spill file remains.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# CSA (Change Stream Applier): WL#10500.

# CSA is row-based only.
--source include/have_binlog_format_row.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
# A compressed payload would stay below the spill threshold.
--source include/not_binlog_transaction_compression_on.inc

--echo
--echo # 1. Set up a CSA channel with IMR enabled (8 MiB spill threshold).
--echo

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;

CALL mtr.add_suppression("Relay log read failure");
CALL mtr.add_suppression("The replica coordinator and worker threads are stopped");
CALL mtr.add_suppression("Change Stream Applier channel stopped because of error");
CALL mtr.add_suppression("Error running query, replica SQL thread aborted");

--let $spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`

--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
--source include/rpl/sync_to_replica.inc

--echo
--echo # 2. Fail every spill reader open and park the receiver between the
--echo #    enqueue publish and the provisioning check; a worker fails to open
--echo #    the spill file meanwhile (R1).
--echo

--let $debug_point= imr_force_spill_reader_open_failure
--source include/add_debug_point.inc
--let $debug_point= imr_pause_after_enqueue_publish
--source include/add_debug_point.inc

--source include/rpl/connection_source.inc
# One transaction larger than 8 MiB: 12 rows x ~1 MiB = ~12 MiB > threshold.
BEGIN;
--disable_query_log
--let $i= 1
while ($i <= 12)
{
  --eval INSERT INTO t1 VALUES ($i, REPEAT('x', 1048576))
  --inc $i
}
--enable_query_log
COMMIT;
--let $source_gtids= `SELECT @@GLOBAL.gtid_executed`

--source include/rpl/connection_replica.inc
SET DEBUG_SYNC = 'now WAIT_FOR receiver_reached_after_enqueue_publish';
--let $debug_point= imr_pause_after_enqueue_publish
--source include/remove_debug_point.inc

--let $read_failure_errno= convert_error(ER_REPLICA_RELAY_LOG_READ_FAILURE)
--let $wait_condition= SELECT COUNT(*) >= 1 FROM performance_schema.replication_applier_status_by_worker WHERE LAST_ERROR_NUMBER = $read_failure_errno
--source include/wait_condition.inc
if (!$success)
{
  --die The worker did not fail to open the spill file
}

# Release the receiver: it now runs the provisioning check with the batch's
# reader error already set.
SET DEBUG_SYNC = 'now SIGNAL receiver_continue_after_enqueue_publish';
--let $slave_sql_errno= $read_failure_errno
--source include/rpl/wait_for_applier_error.inc
SET DEBUG_SYNC = 'RESET';

--echo
--echo # 3. The receiver did not stop and received the whole transaction (R2).
--echo

# Either the receiver received the transaction's GTID (it is recorded only
# after the terminal event) or it stopped with an error.
--let $wait_condition= SELECT LAST_ERROR_NUMBER <> 0 OR GTID_SUBSET('$source_gtids', RECEIVED_TRANSACTION_SET) FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = ''
--source include/wait_condition.inc

--let $io_errno= query_get_value(SELECT LAST_ERROR_NUMBER AS e FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = '', e, 1)
--let $assert_text= The receiver has no error after a reader failure in the publish window
--let $assert_cond= $io_errno = 0
--source include/assert.inc

--let $io_running= query_get_value(SHOW REPLICA STATUS, Replica_IO_Running, 1)
--let $assert_text= The receiver is still running
--let $assert_cond= "$io_running" = "Yes"
--source include/assert.inc

# query_get_value() cannot hold the comma in GTID_SUBSET(a, b).
--let $received= `SELECT GTID_SUBSET('$source_gtids', RECEIVED_TRANSACTION_SET) FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = ''`
--let $assert_text= The receiver received the whole transaction
--let $assert_cond= $received = 1
--source include/assert.inc

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: rpl_gtid.rpl_csa_imr_spill_reader_error_publish_window
--let $assert_select= \[In-memory relay log\] failed to admit incoming transaction
--let $assert_count= 0
--let $assert_text= The reader failure was not logged as a provisioning failure
--source include/assert_grep.inc

--let $assert_select= Relay log read failure: Spill event set: could not open spill file: .*: forced spill reader open failure
--let $assert_count=
--let $assert_count_condition= >= 1
--let $assert_text= The worker's 13121 error names the forced spill reader open failure
--source include/assert_grep.inc

--echo
--echo # 4. Remove the cause; START REPLICA SQL_THREAD applies the transaction
--echo #    (R3).
--echo

--let $debug_point= imr_force_spill_reader_open_failure
--source include/remove_debug_point.inc

--source include/rpl/start_applier.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--let $applied= query_get_value(SELECT COUNT(*) AS c FROM t1 WHERE id BETWEEN 1 AND 12, c, 1)
--let $assert_text= The spill-path transaction is applied in full
--let $assert_cond= $applied = 12
--source include/assert.inc

--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len FROM t1 ORDER BY id
--source include/rpl/diff.inc

--source include/rpl/connection_replica.inc
--let $spill_dir_to_check= $spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc

--echo
--echo # 5. Cleanup.
--echo

--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--source include/rpl/deinit.inc
