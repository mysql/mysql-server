# ==== Purpose ====
#
# STOP REPLICA, RESET REPLICA and START REPLICA on a CSA (Change Stream
# Applier) channel whose in-memory relay log (IMR) holds received but
# unapplied transactions, on both the memory path and the spill path.
#
# RESET REPLICA needs both threads stopped, and the full STOP REPLICA before
# it already resets the IMR queue: it drops the queued transactions and
# their spill files and clears the received set. So RESET REPLICA never sees a
# live queue. The test checks the queue reset right after STOP REPLICA, then
# that RESET REPLICA keeps that empty state, the channel configuration and
# gtid_executed, and that START REPLICA fetches every dropped transaction
# again by GTID auto-positioning: none is lost and none is applied twice.
#
# ==== Requirements ====
#
# R1. After a full STOP REPLICA, In_Memory_Queue_Length and
#     In_Memory_Relay_Log_Space are 0, Retrieved_Gtid_Set and
#     RECEIVED_TRANSACTION_SET are empty, and no spill file of the dropped
#     transactions remains.
# R2. After RESET REPLICA, the state of R1 holds and gtid_executed is
#     unchanged.
# R3. RESET REPLICA keeps the channel on CSA with IMR enabled.
# R4. After START REPLICA every dropped transaction is fetched again and
#     applied once; the replica matches the source.
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with IMR and the minimum 8 MiB spill threshold, and
#      apply two transactions.
#   2. With the applier stopped, queue two memory-path transactions and one
#      spill-path transaction (~12 MiB); check that they are queued and that
#      one spill file exists.
#   3. STOP REPLICA; check R1.
#   4. RESET REPLICA; check R2 and R3.
#   5. START REPLICA; check R4.
#
# Runs in the default, CSA and CSA-with-IMR passes: the test sets
# APPLIER_VERSION = 2 and IN_MEMORY_RELAYLOG_ENABLED = ON itself.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.

# CSA is row-based only.
--source include/have_binlog_format_row.inc
# Compressed, the spill-path payload below would not reach the threshold.
--source include/not_binlog_transaction_compression_on.inc

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--echo
--echo # 1. Set up a CSA channel with IMR and an 8 MiB spill threshold, and
--echo #    apply two transactions.
--echo

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
# Derive the channel's spill directory:
#   <relay-log dir>/#in_memory_relaylog_temp_files
--let $spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
INSERT INTO t1 VALUES (1, 'applied-a');
--source include/rpl/sync_to_replica.inc

--echo
--echo # 2. With the applier stopped, queue two memory-path transactions and one
--echo #    spill-path transaction.
--echo

--source include/rpl/stop_applier.inc
--let $qlen_before= query_get_value(SHOW REPLICA STATUS, In_Memory_Queue_Length, 1)
--let $executed_before= `SELECT @@GLOBAL.gtid_executed`

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (10, 'memory-a');
# One transaction above the threshold: 12 rows x 1 MiB.
BEGIN;
--disable_query_log
--let $i= 100
while ($i < 112)
{
  --eval INSERT INTO t1 VALUES ($i, REPEAT('x', 1048576))
  --inc $i
}
--enable_query_log
COMMIT;
INSERT INTO t1 VALUES (20, 'memory-b');
--source include/rpl/sync_to_replica_received.inc

--source include/rpl/connection_replica.inc
--let $qlen= query_get_value(SHOW REPLICA STATUS, In_Memory_Queue_Length, 1)
--let $assert_text= The three received transactions are queued
--let $assert_cond= $qlen - $qlen_before = 3
--source include/assert.inc
--let $assert_text= None of them is applied
--let $assert_cond= [SELECT COUNT(*) FROM t1] = 1
--source include/assert.inc
--echo # The spill-path transaction is held in one spill file:
--replace_regex /imr_sp_[0-9a-f]+/imr_sp_<ID>/
--list_files $spill_dir imr_sp_*

--echo
--echo # 3. A full STOP REPLICA resets the queue: it drops the queued
--echo #    transactions, the spill file and the received set.
--echo

--source include/rpl/stop_replica.inc

--echo # No spill file remains:
--list_files $spill_dir imr_sp_*

--let $qlen= query_get_value(SHOW REPLICA STATUS, In_Memory_Queue_Length, 1)
--let $space= query_get_value(SHOW REPLICA STATUS, In_Memory_Relay_Log_Space, 1)
--let $assert_text= In_Memory_Queue_Length and In_Memory_Relay_Log_Space are 0
--let $assert_cond= $qlen = 0 AND $space = 0
--source include/assert.inc
--let $retrieved= query_get_value(SHOW REPLICA STATUS, Retrieved_Gtid_Set, 1)
--let $assert_text= Retrieved_Gtid_Set is empty
--let $assert_cond= "$retrieved" = ""
--source include/assert.inc
--let $assert_text= RECEIVED_TRANSACTION_SET is empty
--let $assert_cond= [SELECT COUNT(*) FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = "" AND RECEIVED_TRANSACTION_SET = ""] = 1
--source include/assert.inc

--echo
--echo # 4. RESET REPLICA keeps the empty state, the channel configuration
--echo #    and gtid_executed.
--echo

RESET REPLICA;

--echo # No spill file remains:
--list_files $spill_dir imr_sp_*

--let $qlen= query_get_value(SHOW REPLICA STATUS, In_Memory_Queue_Length, 1)
--let $space= query_get_value(SHOW REPLICA STATUS, In_Memory_Relay_Log_Space, 1)
--let $assert_text= In_Memory_Queue_Length and In_Memory_Relay_Log_Space are still 0
--let $assert_cond= $qlen = 0 AND $space = 0
--source include/assert.inc
--let $retrieved= query_get_value(SHOW REPLICA STATUS, Retrieved_Gtid_Set, 1)
--let $assert_text= Retrieved_Gtid_Set is still empty
--let $assert_cond= "$retrieved" = ""
--source include/assert.inc
--let $assert_text= RECEIVED_TRANSACTION_SET is still empty
--let $assert_cond= [SELECT COUNT(*) FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = "" AND RECEIVED_TRANSACTION_SET = ""] = 1
--source include/assert.inc
--let $assert_text= gtid_executed is unchanged
--let $assert_cond= GTID_SUBSET("$executed_before", @@GLOBAL.gtid_executed) AND GTID_SUBSET(@@GLOBAL.gtid_executed, "$executed_before")
--source include/assert.inc
--let $assert_text= The channel is still on CSA with IMR enabled
--let $assert_cond= [SELECT COUNT(*) FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = "" AND APPLIER_VERSION = 2 AND IN_MEMORY_RELAYLOG_ENABLED = "YES"] = 1
--source include/assert.inc

--echo
--echo # 5. START REPLICA fetches the dropped transactions again and applies
--echo #    each one once.
--echo

--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (30, 'after-reset');
--source include/rpl/sync_to_replica.inc

--let $assert_text= All transactions are applied, none twice
--let $assert_cond= [SELECT COUNT(*) FROM t1] = 16
--source include/assert.inc
--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len, SHA2(data, 256) AS digest FROM t1 ORDER BY id
--source include/rpl/diff.inc
--let $spill_dir_to_check= $spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc

--echo
--echo # Cleanup.
--echo

--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--source include/rpl/deinit.inc
