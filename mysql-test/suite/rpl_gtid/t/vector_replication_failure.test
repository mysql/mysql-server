# Test support for replication of Cloudsql Vector columns
# Replication command failure and retries by SQL thread

--source include/have_debug.inc

--source include/rpl/init_source_replica.inc

--connection master
--let $table_name=t1
--source suite/vector_index/include/vector_data.inc
CREATE VECTOR INDEX vec_index_1 ON test.t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared;

--source include/rpl/sync_to_replica.inc
SELECT * FROM information_schema.innodb_vector_indexes;

# Add suppression for expected warnings in slaves error log
call mtr.add_suppression("Failed during replica I/O thread initialization");
call mtr.add_suppression("Replica SQL.*Failed during replica thread initialization.* MY-013117");

--source include/rpl/stop_replica.inc
RESET REPLICA;

# Set debug flags on slave to force errors to occur
--let $debug_point= simulate_io_replica_error_on_init
--source include/add_debug_point.inc
--let $debug_point= simulate_sql_replica_error_on_init
--source include/add_debug_point.inc

--disable_query_log
--replace_regex /[0-9]{4}/####/
eval CHANGE REPLICATION SOURCE TO SOURCE_USER='root',
                        SOURCE_CONNECT_RETRY=1,
                        SOURCE_HOST='127.0.0.1',
                        SOURCE_PORT=$SERVER_MYPORT_1;
--enable_query_log

START REPLICA;

#
# slave is going to stop because of emulated failures
# but there won't be any crashes nor asserts hit.
#

# Wait for the SQL thread error
--let $slave_sql_errno= convert_error(ER_REPLICA_FATAL_ERROR)
--let $show_slave_sql_error= 1
--source include/rpl/wait_for_applier_error.inc

# Wait for the I/O thread error
--let $slave_io_errno= convert_error(ER_REPLICA_FATAL_ERROR)
--let $show_slave_io_error= 1
--source include/rpl/wait_for_receiver_error.inc

--connection master
DROP INDEX vec_index_1 ON test.t1;

--connection slave
# Remove debug points
--let $debug_point= simulate_io_replica_error_on_init
--source include/remove_debug_point.inc
--let $debug_point= simulate_sql_replica_error_on_init
--source include/remove_debug_point.inc

--source include/rpl/start_replica.inc

--connection master
SELECT * FROM information_schema.innodb_vector_indexes;

--source include/rpl/sync_to_replica.inc
# Vector index on test.t1 table is dropped in replica, since the replication thread is fixed after removing debug_points
SELECT * FROM information_schema.innodb_vector_indexes;

# Cleanup
--connection master
DROP TABLE test.t1;

--source include/rpl/deinit.inc
