# ==== Purpose ====
#
# Two replica servers whose relay logs are in the same directory, with
# different relay log basenames, each use a Change Stream Applier (CSA)
# channel with the in-memory relay log (IMR). Each server has its own spill
# directory, named after its relay log basename, so the startup purge of one
# server does not delete the queued spill files of the other.
#
# ==== Requirements ====
#
# R1. Each server's spill directory is
#     "<relay log directory>/#in_memory_relaylog_temp_files.<leaf>", where
#     <leaf> is the file-name part of relay_log_basename, and it exists after
#     startup.
# R2. A restart purges stale spill files from the restarted server's own
#     spill directory.
# R3. The restart leaves the other server's queued spill file in place, and
#     that server's receiver keeps running.
# R4. That server then applies the spilled transaction without an applier
#     error, the data matches on all servers, and the spill file is deleted.
# R5. The two servers have different spill directories.
#
# ==== Implementation ====
#
# 0. Set up 1->2,1->3 with the replicas stopped; both replicas use the CSA
#    with IMR.
# 1. Restart server_2 with --relay-log=SHARED/a-relay and server_3 with
#    --relay-log=SHARED/b-relay. Each server's spill directory exists (R1).
# 2. Start both replicas. With server_2's applier stopped, replicate a 12 MiB
#    transaction, which server_2 spills to disk.
# 3. Plant a stale spill file in server_3's spill directory and restart
#    server_3. The stale file is gone (R2); server_2's spill file is still
#    there and its receiver is running (R3).
# 4. Start server_2's applier and server_3's replica. The data matches, server_2
#    has no applier error and its spill file is deleted (R4). The spill
#    directories differ (R5).
# 5. Clean up: restore the default relay log options.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.

# CSA is row-based only.
--source include/have_binlog_format_row.inc

--echo
--echo # 0. Set up 1->2,1->3; both replicas use the CSA with IMR.
--echo
--let $rpl_skip_start_slave= 1
--let $rpl_topology= 1->2,1->3
--let $rpl_applier_version= 2:2,3:2
--let $rpl_in_memory_relaylog= ON
--source include/rpl/init.inc

--let $shared_dir= $MYSQL_TMP_DIR/imr_shared_relay_log_dir
--mkdir $shared_dir
--let $rpl_omit_print_server_parameters= 1

--echo
--echo # 1. Move both relay logs into SHARED, with different basenames. Each
--echo #    server's spill directory exists (R1).
--echo
--let $rpl_server_number= 2
--let $rpl_server_parameters= --relay-log=$shared_dir/a-relay --relay-log-index=$shared_dir/a-relay.index
--source include/rpl/restart_server.inc
--let $rpl_connection_name= server_2
--source include/connection.inc
--source include/rpl/get_imr_spill_dir.inc
--let $a_spill_dir= $spill_dir
--replace_result $shared_dir SHARED
--eval SELECT @@GLOBAL.relay_log_basename AS relay_log_basename, '$a_spill_dir' AS spill_dir
--file_exists $a_spill_dir
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;

# Unlike server_2, server_3 starts its replica at startup by default.
--let $rpl_server_number= 3
--let $b_server_parameters= --relay-log=$shared_dir/b-relay --relay-log-index=$shared_dir/b-relay.index --skip-replica-start
--let $rpl_server_parameters= $b_server_parameters
--source include/rpl/restart_server.inc
--let $rpl_connection_name= server_3
--source include/connection.inc
--source include/rpl/get_imr_spill_dir.inc
--let $b_spill_dir= $spill_dir
--replace_result $shared_dir SHARED
--eval SELECT @@GLOBAL.relay_log_basename AS relay_log_basename, '$b_spill_dir' AS spill_dir
--file_exists $b_spill_dir

# mysqltest variable names are case-insensitive, so this name must differ from
# $a_spill_dir.
--let SERVER_2_SPILL_DIR= $a_spill_dir

--echo
--echo # 2. With server_2's applier stopped, replicate a 12 MiB transaction,
--echo #    which server_2 spills to disk.
--echo
--source include/rpl/start_all_replicas.inc
--let $rpl_connection_name= server_1
--source include/connection.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
--source include/rpl/sync.inc

--let $rpl_connection_name= server_2
--source include/connection.inc
--source include/rpl/stop_applier.inc

--let $rpl_connection_name= server_1
--source include/connection.inc
--let $gtids_before= `SELECT @@GLOBAL.gtid_executed`
BEGIN;
--disable_query_log
--let $i= 1
while ($i <= 12)
{
  --eval INSERT INTO t1 VALUES ($i, REPEAT('x', 1048576))
  --inc $i
}
--enable_query_log
COMMIT;
--let $big_gtid= `SELECT GTID_SUBTRACT(@@GLOBAL.gtid_executed, '$gtids_before')`
--let $sync_slave_connection= server_3
--source include/rpl/sync_to_replica.inc

--let $rpl_connection_name= server_2
--source include/connection.inc
# The GTID is added to the received set once the whole transaction is queued.
--let $wait_condition= SELECT GTID_SUBSET('$big_gtid', RECEIVED_TRANSACTION_SET) FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = ''
--source include/wait_condition.inc
--perl
my @files = glob("$ENV{SERVER_2_SPILL_DIR}/imr_sp_*");
print "Spill files of server_2: ", scalar(@files), "\n";
EOF

--echo
--echo # 3. Plant a stale spill file in server_3's spill directory and restart
--echo #    server_3. The stale file is gone (R2); server_2's spill file is still
--echo #    there and its receiver is running (R3).
--echo
--write_file $b_spill_dir/imr_sp_orphan
stale spill payload
EOF
--let $rpl_server_number= 3
--let $rpl_server_parameters= $b_server_parameters
--source include/rpl/restart_server.inc
--let $rpl_connection_name= server_3
--source include/connection.inc
--error 1
--file_exists $b_spill_dir/imr_sp_orphan

--let $rpl_connection_name= server_2
--source include/connection.inc
--perl
my @files = glob("$ENV{SERVER_2_SPILL_DIR}/imr_sp_*");
print "Spill files of server_2: ", scalar(@files), "\n";
EOF
--let $assert_text= R3: server_2's receiver is still running
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "Yes"
--source include/assert.inc

--echo
--echo # 4. Start server_2's applier and server_3's replica. The data matches,
--echo #    server_2 applies the transaction and its spill file is deleted (R4).
--echo
--source include/rpl/start_applier.inc
--let $rpl_connection_name= server_3
--source include/connection.inc
--source include/rpl/start_replica.inc
--let $rpl_connection_name= server_1
--source include/connection.inc
--source include/rpl/sync.inc

--let $rpl_connection_name= server_2
--source include/connection.inc
--let $assert_text= R4: server_2's applier has no error
--let $assert_cond= [SHOW REPLICA STATUS, Last_SQL_Errno, 1] = 0
--source include/assert.inc
--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len FROM t1 ORDER BY id
--source include/rpl/diff.inc
--let $spill_dir_to_check= $a_spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc
# Checked last, so that a shared directory fails the applier steps above first.
--let $assert_text= R5: the servers have different spill directories
--let $assert_cond= "$a_spill_dir" != "$b_spill_dir"
--source include/assert.inc

--echo
--echo # 5. Clean up: restore the default relay log options.
--echo
--source include/rpl/stop_all_replicas.inc
--let $rpl_server_parameters=
--let $rpl_server_number= 2
--source include/rpl/restart_server.inc
--let $rpl_server_number= 3
--source include/rpl/restart_server.inc
--let $rpl_connection_name= server_2
--source include/connection.inc
RESET REPLICA;
--let $rpl_connection_name= server_3
--source include/connection.inc
--source include/rpl/stop_replica.inc
RESET REPLICA;
--source include/rpl/start_all_replicas.inc
--let $rpl_connection_name= server_1
--source include/connection.inc
DROP TABLE t1;
--source include/rpl/sync.inc
--force-rmdir $shared_dir
--source include/rpl/deinit.inc
