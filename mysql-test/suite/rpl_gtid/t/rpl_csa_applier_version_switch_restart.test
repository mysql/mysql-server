# ==== PURPOSE ====
#
# Reproduce the SQL-thread restart path where replication switches from
# `APPLIER_VERSION=1` (MTA) to `APPLIER_VERSION=2` (CSA) while relay-log work
# remains pending in an existing relay-log file.
#
# ==== IMPLEMENTATION ====
#
# Test steps
# 1. Set up source/replica replication with GTID and row-format requirements
#    compatible with CSA, while initially running with `APPLIER_VERSION=1`.
# 2. Apply enough transactions to move the replica SQL thread beyond the
#    relay-log file header in the current file.
# 3. Stop only the replica SQL thread, generate more transactions on the
#    source, and wait for the replica IO thread to receive them.
# 4. Change the channel to `APPLIER_VERSION=2` and restart only the SQL thread.
# 5. Verify replication resumes and applies the pending transactions.
#
# Test pass conditions
# 1. Restarting the SQL thread after switching to CSA is successful.
# 2. The replica catches up with the pending transactions received while the
#    SQL thread was stopped.
# 3. Replicated data matches the source after the restart.
#
# ==== REFERENCES ====
#
# WL#10500 MTA: Optimized and generic change stream applier
#

--source include/have_binlog_format_row.inc
--source include/have_mta.inc

--let $rpl_gtid_utils= 1
--let $rpl_skip_start_slave= 1
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 1, REQUIRE_ROW_FORMAT = 1, GTID_ONLY = 1;
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE test.t1 (id INT PRIMARY KEY, payload VARCHAR(32)) ENGINE=InnoDB;
INSERT INTO test.t1 VALUES (1, 'a');
INSERT INTO test.t1 VALUES (2, 'b');
INSERT INTO test.t1 VALUES (3, 'c');
--source include/rpl/save_server_position.inc

--source include/rpl/connection_replica.inc
--source include/rpl/sync_with_saved.inc

--let $relay_log_pos_before_stop= query_get_value(SHOW REPLICA STATUS, Relay_Log_Pos, 1)
--let $assert_text= Replica SQL thread should already be positioned after the initial relay-log header
--let $assert_cond= $relay_log_pos_before_stop > 4
--source include/assert.inc

--source include/rpl/stop_applier.inc

--source include/rpl/connection_source.inc
INSERT INTO test.t1 VALUES (4, 'd');
INSERT INTO test.t1 VALUES (5, 'e');
INSERT INTO test.t1 VALUES (6, 'f');
INSERT INTO test.t1 VALUES (7, 'g');
INSERT INTO test.t1 VALUES (8, 'h');
--source include/rpl/save_server_position.inc

--source include/rpl/connection_replica.inc
--source include/rpl/sync_received_with_saved.inc

CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 2;
--source include/rpl/start_applier.inc
--source include/rpl/sync_with_saved.inc

--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc

SELECT COUNT(*), SUM(id) FROM test.t1;

--source include/rpl/connection_source.inc
DROP TABLE test.t1;
--source include/rpl/sync_to_replica.inc

--source include/rpl/connection_replica.inc
--source include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 1, REQUIRE_ROW_FORMAT = 0, GTID_ONLY = 0;

--let $rpl_only_running_threads= 1
--source include/rpl/deinit.inc
