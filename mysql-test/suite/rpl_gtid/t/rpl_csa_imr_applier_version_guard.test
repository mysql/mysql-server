# ==== Purpose ====
#
# On a channel that uses the in-memory relay log (IMR), CHANGE REPLICATION
# SOURCE TO APPLIER_VERSION must require both replication threads to be
# stopped. APPLIER_VERSION is an applier option, so it normally needs only the
# SQL thread stopped. But on an IMR channel, switching to MTA deactivates IMR
# and removes the in-memory queue, which a running receiver still writes to;
# the IMR setting is kept.
#
# ==== Requirements ====
#
# R1. On an IMR channel with only the SQL thread stopped, APPLIER_VERSION = 1
#     and APPLIER_VERSION = 2 fail with ER_REPLICA_CHANNEL_MUST_STOP, and the
#     channel configuration is unchanged.
# R2. On an IMR channel with only the IO thread stopped, both statements fail
#     with ER_REPLICA_CHANNEL_MUST_STOP.
# R3. After the rejected statements, the receiver keeps queuing into the
#     in-memory relay log and the applier applies everything once restarted.
# R4. With both threads stopped, APPLIER_VERSION = 1 succeeds, keeps the IMR
#     setting, and the channel then replicates through the disk relay log.
# R5. With the setting ON, APPLIER_VERSION = 2 fails with
#     ER_REPLICA_CHANNEL_MUST_STOP while the IO thread runs. With both threads
#     stopped it succeeds, and the receiver queues into the in-memory relay log
#     again. (The OFF-then-switch path is covered by
#     rpl_csa_applier_version_switch_restart.)
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).

# CSA requires row-based replication.
--source include/have_binlog_format_row.inc

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--echo
--echo # 1. Enable IMR on the CSA channel and replicate some data.
--echo

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, v VARCHAR(50));
INSERT INTO t1 VALUES (1, 'a');
--source include/rpl/sync_to_replica.inc

--echo
--echo # 2. R1: stop only the SQL thread. Both APPLIER_VERSION values are
--echo #    rejected while the receiver runs.
--echo

--source include/rpl/stop_applier.inc

--error ER_REPLICA_CHANNEL_MUST_STOP
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 1;
--error ER_REPLICA_CHANNEL_MUST_STOP
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 2;

--let $count= `SELECT COUNT(*) FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = '' AND APPLIER_VERSION = 2 AND IN_MEMORY_RELAYLOG_ENABLED = 'YES'`
--let $assert_text= The rejected statements left CSA and IMR enabled
--let $assert_cond= $count = 1
--source include/assert.inc

--echo
--echo # 3. R3: the receiver still queues into the in-memory relay log while the
--echo #    applier is stopped, and the applier catches up once restarted.
--echo

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (2, 'b');
INSERT INTO t1 VALUES (3, 'c');
--source include/rpl/save_server_position.inc

--source include/rpl/connection_replica.inc
--source include/rpl/sync_received_with_saved.inc

--let $imr_qlen= query_get_value(SHOW REPLICA STATUS, In_Memory_Queue_Length, 1)
--let $assert_text= The receiver queued the new transactions in memory
--let $assert_cond= $imr_qlen > 0
--source include/assert.inc

--source include/rpl/start_applier.inc
--source include/rpl/sync_with_saved.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc

--echo
--echo # 4. R2: stop only the IO thread. Both APPLIER_VERSION values are
--echo #    rejected while the applier runs.
--echo

--source include/rpl/stop_receiver.inc

--error ER_REPLICA_CHANNEL_MUST_STOP
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 1;
--error ER_REPLICA_CHANNEL_MUST_STOP
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 2;

--source include/rpl/start_receiver.inc

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (4, 'd');
--source include/rpl/sync_to_replica.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc

--echo
--echo # 5. R4: with both threads stopped, APPLIER_VERSION = 1 succeeds, keeps the
--echo #    IMR setting, and the channel replicates through the disk relay log.
--echo

--source include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 1;

--let $count= `SELECT COUNT(*) FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = '' AND APPLIER_VERSION = 1 AND IN_MEMORY_RELAYLOG_ENABLED = 'YES'`
--let $assert_text= The channel is on MTA and keeps the IMR setting
--let $assert_cond= $count = 1
--source include/assert.inc

--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (5, 'e');
--source include/rpl/sync_to_replica.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc

--let $imr_qlen= query_get_value(SHOW REPLICA STATUS, In_Memory_Queue_Length, 1)
--let $imr_space= query_get_value(SHOW REPLICA STATUS, In_Memory_Relay_Log_Space, 1)
--let $assert_text= The in-memory relay log columns read 0 after switching to MTA
--let $assert_cond= $imr_qlen = 0 AND $imr_space = 0
--source include/assert.inc

--echo
--echo # 6. R5: with the setting ON, APPLIER_VERSION = 2 is rejected while the IO
--echo #    thread runs; with both threads stopped it succeeds and IMR is active again.
--echo

--source include/rpl/stop_applier.inc
--error ER_REPLICA_CHANNEL_MUST_STOP
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 2;
--source include/rpl/stop_receiver.inc
CHANGE REPLICATION SOURCE TO APPLIER_VERSION = 2;

--let $count= `SELECT COUNT(*) FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = '' AND APPLIER_VERSION = 2 AND IN_MEMORY_RELAYLOG_ENABLED = 'YES'`
--let $assert_text= Back on CSA, the saved IMR setting is in effect
--let $assert_cond= $count = 1
--source include/assert.inc

--source include/rpl/start_receiver.inc

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (6, 'f');
--source include/rpl/save_server_position.inc

--source include/rpl/connection_replica.inc
--let $ignore_gtids_on_sync= 1
--source include/rpl/sync_received_with_saved.inc
--let $ignore_gtids_on_sync=
--let $imr_qlen= query_get_value(SHOW REPLICA STATUS, In_Memory_Queue_Length, 1)
--let $assert_text= The receiver queues into the in-memory relay log again
--let $assert_cond= $imr_qlen >= 1
--source include/assert.inc
--source include/rpl/start_applier.inc
--source include/rpl/sync_with_saved.inc
--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc

--echo
--echo # Cleanup.
--echo

--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--source include/rpl/deinit.inc
