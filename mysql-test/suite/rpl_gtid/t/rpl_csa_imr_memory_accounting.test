# ==== Purpose ====
#
# The in-memory relay log (IMR) memory limit is a resource registered on the
# channel's CSA resource monitor. This test checks that the resource follows
# the channel's lifecycle:
#
#   - a CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_LIMIT change rebuilds the
#     runtime and the new limit is the one enforced after the restart;
#   - STOP REPLICA SQL_THREAD with the receiver still running leaves the runtime
#     in place, so every outstanding reservation survives the applier stop.
#
# ==== Requirements ====
#
# R1. After raising IN_MEMORY_RELAYLOG_LIMIT from 32 MiB to 64 MiB and
#     restarting, a saturating workload fills the queue past the OLD limit and
#     stays within the NEW one.
# R2. STOP REPLICA SQL_THREAD, issued while a worker is mid-transaction and
#     further transactions are queued behind it, leaves In_Memory_Relay_Log_Space
#     unchanged: none of those transactions committed, so none of their
#     reservations were released or dropped.
# R3. START REPLICA SQL_THREAD then applies everything and the memory usage
#     returns to 0 (no leaked reservation).
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with IMR at a 32 MiB limit and an 8 MiB spill
#      threshold (so ~1 MiB transactions stay on the memory path).
#   2. Raise the limit to 64 MiB, restart, pause the applier, and send ~70 MiB.
#      Wait for the queue to pass the old limit and saturate the new one.
#   3. Arm pause_csa_before_releasing_event_memory, send one transaction with a
#      > 3000-byte row (the worker parks mid-transaction) and several small ones
#      behind it. Record the memory usage, stop the SQL thread, and compare.
#   4. Start the SQL thread, sync, and check the usage drains to 0.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# Back-pressure mirrors rpl_csa_imr_memory_limit.test; the mid-transaction stop
# mirrors include/rpl/csa_stop_sql_thread_mid_trx.inc.

# CSA is row-based only.
--source include/have_binlog_format_row.inc
# Memory accounting is driven by the transaction's on-the-wire byte length; with
# binlog transaction compression on, the compressible payload would not fill the
# limit.
--source include/not_binlog_transaction_compression_on.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

--let $rpl_skip_start_slave= 1
--let $rpl_extra_connections_per_server= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--echo
--echo # 1. Enable IMR at a 32 MiB limit with an 8 MiB spill threshold and start.
--echo

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_LIMIT = 33554432,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;

# Stopping the applier mid-transaction (step 3) kills clean worker sessions;
# suppress the expected diagnostics.
CALL mtr.add_suppression("Replica SQL thread .* killed");
CALL mtr.add_suppression("Worker .* stopped");

--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, data LONGBLOB);
--source include/rpl/sync_to_replica.inc

--echo
--echo # 2. Raise the limit to 64 MiB and restart. With the applier paused, ~70 MiB
--echo #    of ~1 MiB transactions fill the queue past the old 32 MiB limit and the
--echo #    receiver parks at the new one.
--echo

--source include/rpl/connection_replica.inc
--source include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_LIMIT = 67108864;
--source include/rpl/start_replica.inc

--let $count= `SELECT COUNT(*) FROM performance_schema.replication_applier_configuration WHERE IN_MEMORY_RELAYLOG_LIMIT = 67108864`
--let $assert_text= The channel's configured IN_MEMORY_RELAYLOG_LIMIT is now 64 MiB
--let $assert_cond= $count = 1
--source include/assert.inc

--source include/rpl/stop_applier.inc

--source include/rpl/connection_source.inc
--let $trx_count= 70
--disable_query_log
--let $i= 1
while ($i <= $trx_count)
{
  --eval INSERT INTO t1 (data) VALUES (REPEAT('x', 1048576))
  --inc $i
}
--enable_query_log

--source include/rpl/connection_replica.inc

# Poll until the queue saturates near the NEW limit. If the resource still had
# the old 32 MiB limit, usage would stop below this watermark and the loop would
# time out. Numeric compare: unquoted operands.
--let $old_limit= 33554432
--let $new_limit= 67108864
--let $watermark= 62914560
--let $space= 0
--let $iter= 0
while (`SELECT $space < $watermark`)
{
  --sleep 0.2
  --let $space= query_get_value(SHOW REPLICA STATUS, In_Memory_Relay_Log_Space, 1)
  --inc $iter
  if ($iter > 300)
  {
    --die Timed out waiting for the in-memory queue to fill past the old limit toward the new one
  }
}

# R1: the usage passed the old limit and stays within the new one.
--let $assert_text= In_Memory_Relay_Log_Space is above the old 32 MiB limit and within the new 64 MiB limit
--let $assert_cond= $space > $old_limit AND $space <= $new_limit
--source include/assert.inc

--let $qlen= query_get_value(SHOW REPLICA STATUS, In_Memory_Queue_Length, 1)
--let $assert_text= Back-pressure at the new limit kept fewer than the whole workload queued
--let $assert_cond= $qlen < $trx_count
--source include/assert.inc

--source include/rpl/start_applier.inc

--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--source include/rpl/connection_replica.inc
--let $slave_param= In_Memory_Relay_Log_Space
--let $slave_param_value= 0
--source include/rpl/wait_for_replica_status.inc

--echo
--echo # 3. STOP REPLICA SQL_THREAD with the receiver running. A worker parks in
--echo #    the middle of one transaction and more transactions are queued behind
--echo #    it. Stopping the applier must leave every reservation in place.
--echo

# Arm the pause point: a worker parks right after applying an event larger than
# 3000 bytes. Only the first transaction below has such an event, so exactly
# one worker parks.
--source include/rpl/connection_replica.inc
--let $debug_point= pause_csa_before_releasing_event_memory
--source include/add_debug_point.inc

--source include/rpl/connection_source.inc
--let $gtids_before= `SELECT @@GLOBAL.gtid_executed`
INSERT INTO t1 (data) VALUES (REPEAT('p', 4000));
--let $small_count= 5
--disable_query_log
--let $i= 1
while ($i <= $small_count)
{
  --eval INSERT INTO t1 (data) VALUES (REPEAT('q', 100))
  --inc $i
}
--enable_query_log
--let $gtids_after= `SELECT @@GLOBAL.gtid_executed`

--source include/rpl/connection_replica.inc
SET DEBUG_SYNC= 'now WAIT_FOR paused_csa_before_releasing_event_memory TIMEOUT 30';

# Wait until the receiver has queued all six transactions; nothing behind the
# parked one can commit before it (replica_preserve_commit_order is ON by
# default). sync_to_replica_received is not usable here: an IMR channel clears
# its Retrieved_Gtid_Set on a full stop (step 2), and transactions applied
# before that stop are never re-sent, so the set cannot cover the source's whole
# gtid_executed. Wait for just the GTIDs sent in this step instead.
--let $wait_condition= SELECT GTID_SUBSET(GTID_SUBTRACT('$gtids_after', '$gtids_before'), RECEIVED_TRANSACTION_SET) FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = ''
--source include/wait_condition.inc

--let $space_before= query_get_value(SHOW REPLICA STATUS, In_Memory_Relay_Log_Space, 1)
--let $assert_text= Outstanding reservations are held while the worker is parked mid-transaction
--let $assert_cond= $space_before > 0
--source include/assert.inc

# STOP blocks until the applier is down, so send it on a second session.
--source include/rpl/connection_replica1.inc
--send STOP REPLICA SQL_THREAD

# Release the parked worker so STOP can complete. Remove the pause point first
# so the replay after START does not park again.
--source include/rpl/connection_replica.inc
--let $debug_point= pause_csa_before_releasing_event_memory
--source include/remove_debug_point.inc
SET DEBUG_SYNC= 'now SIGNAL signal_continue_csa_releasing_event_memory';

--source include/rpl/connection_replica1.inc
--reap

--source include/rpl/connection_replica.inc
SET DEBUG_SYNC= 'RESET';
--source include/rpl/assert_replica_no_error.inc

# None of the interrupted or queued transactions committed.
--let $pending= `SELECT COUNT(*) FROM t1 WHERE data LIKE 'p%' OR data LIKE 'q%'`
--let $assert_text= None of the interrupted or queued transactions was applied while the applier was stopped
--let $assert_cond= $pending = 0
--source include/assert.inc

# R2: the applier stop released and dropped no reservation.
--let $space_after= query_get_value(SHOW REPLICA STATUS, In_Memory_Relay_Log_Space, 1)
--let $assert_text= In_Memory_Relay_Log_Space is unchanged across STOP REPLICA SQL_THREAD
--let $assert_cond= $space_after = $space_before
--source include/assert.inc

--let $io_running= query_get_value(SHOW REPLICA STATUS, Replica_IO_Running, 1)
--let $assert_text= The receiver kept running across the applier stop
--let $assert_cond= "$io_running" = "Yes"
--source include/assert.inc

--echo
--echo # 4. START REPLICA SQL_THREAD applies everything and the usage drains to 0.
--echo

--source include/rpl/start_applier.inc

--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len FROM t1 ORDER BY id
--source include/rpl/diff.inc

--source include/rpl/connection_replica.inc
--let $expected= `SELECT $trx_count + 1 + $small_count`
--let $count= `SELECT COUNT(*) FROM t1`
--let $assert_text= All transactions were applied on the replica
--let $assert_cond= $count = $expected
--source include/assert.inc

# R3: no reservation is left behind.
--let $slave_param= In_Memory_Relay_Log_Space
--let $slave_param_value= 0
--source include/rpl/wait_for_replica_status.inc

# Cleanup.
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--source include/rpl/deinit.inc
