# ==== Purpose ====
#
# A compressed transaction (binlog_transaction_compression = ON on the source)
# whose compressed size is above IN_MEMORY_RELAYLOG_SPILL_THRESHOLD takes the
# spill path of the in-memory relay log (IMR) on a CSA (Change Stream Applier)
# channel, and is applied in full: the spill reader decompresses the
# Transaction_payload event it reads back from the spill file.
#
# ==== Requirements ====
#
# R1. The spill decision uses the transaction length from the GTID event, which
#     for a compressed transaction is its compressed size: a transaction whose
#     compressed size is above the threshold spills.
# R2. The spilled compressed transaction applies with the same data as on the
#     source, both when it is queued while the applier is stopped and when it
#     is received with the applier running (the test does not force the
#     applier to read the spill file while it is still written).
# R3. The spill file is removed after the transaction commits.
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with IMR, the minimum 8 MiB spill threshold and the
#      applier metrics component.
#   2. With the applier stopped, the source commits a compressed ~12 MiB
#      transaction of random (incompressible) bytes. Its compressed size is
#      above the threshold and it is held in one spill file (R1).
#   3. Start the applier: the data matches the source, SPILL_TRANSACTIONS_COUNT
#      is 1 and the spill file is removed (R2, R3).
#   4. With the applier running, a second compressed transaction of the same
#      size spills and applies (R1, R2, R3).
#
# Runs in the default, CSA and CSA-with-IMR passes: the test sets
# APPLIER_VERSION = 2 and IN_MEMORY_RELAYLOG_ENABLED = ON itself.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.

# CSA is row-based only.
--source include/have_binlog_format_row.inc
--source include/have_component_replication_applier_metrics.inc

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--echo
--echo # 1. Set up a CSA channel with IMR, an 8 MiB spill threshold and the
--echo #    metrics component.
--echo

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
INSTALL COMPONENT 'file://component_replication_applier_metrics';
--let $from_ch= FROM performance_schema.replication_applier_metrics WHERE CHANNEL_NAME = ''
# Derive the channel's spill directory:
#   <relay-log dir>/#in_memory_relaylog_temp_files
--let $spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
--source include/rpl/sync_to_replica.inc

--source include/rpl/connection_source.inc
SET SESSION binlog_transaction_compression = ON;
# One row is 1000 x 1 KiB of random bytes.
SET SESSION group_concat_max_len = 2097152;
--let $compressed_bytes= SELECT IFNULL(SUM(COMPRESSED_BYTES_COUNTER), 0) FROM performance_schema.binary_log_transaction_compression_stats WHERE LOG_TYPE = 'BINARY' AND COMPRESSION_TYPE = 'ZSTD'

--echo
--echo # 2. With the applier stopped, a compressed transaction larger than the
--echo #    threshold is held in a spill file.
--echo

--source include/rpl/connection_replica.inc
--source include/rpl/stop_applier.inc

--source include/rpl/connection_source.inc
--let $bytes_before= `$compressed_bytes`
# 12 rows x ~1 MiB of random bytes: ~12 MiB, after compression too.
BEGIN;
--disable_query_log
--let $i= 1
while ($i <= 12)
{
  --eval INSERT INTO t1 WITH RECURSIVE seq (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 1000) SELECT $i, GROUP_CONCAT(RANDOM_BYTES(1024) SEPARATOR '') FROM seq
  --inc $i
}
--enable_query_log
COMMIT;
--let $bytes_after= `$compressed_bytes`
--let $assert_text= The source logged the transaction compressed, above the 8 MiB threshold
--let $assert_cond= $bytes_after - $bytes_before > 8388608
--source include/assert.inc
--source include/rpl/sync_to_replica_received.inc

--source include/rpl/connection_replica.inc
--echo # The compressed transaction is held in one spill file:
--replace_regex /imr_sp_[0-9a-f]+/imr_sp_<ID>/
--list_files $spill_dir imr_sp_*

--echo
--echo # 3. Start the applier: the data matches, the transaction is counted as
--echo #    spilled, and its spill file is removed.
--echo

--source include/rpl/start_applier.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len, SHA2(data, 256) AS digest FROM t1 ORDER BY id
--source include/rpl/diff.inc

--source include/rpl/connection_replica.inc
# The counter is updated at commit; wait for it rather than race the commit.
--let $wait_condition= SELECT SPILL_TRANSACTIONS_COUNT = 1 $from_ch
--source include/wait_condition.inc
--let $spill_dir_to_check= $spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc

--echo
--echo # 4. With the applier running, a second compressed transaction spills and
--echo #    applies.
--echo

--source include/rpl/connection_source.inc
--let $bytes_before= `$compressed_bytes`
BEGIN;
--disable_query_log
--let $i= 101
while ($i <= 112)
{
  --eval INSERT INTO t1 WITH RECURSIVE seq (n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 1000) SELECT $i, GROUP_CONCAT(RANDOM_BYTES(1024) SEPARATOR '') FROM seq
  --inc $i
}
--enable_query_log
COMMIT;
--let $bytes_after= `$compressed_bytes`
--let $assert_text= The second transaction is compressed above the threshold too
--let $assert_cond= $bytes_after - $bytes_before > 8388608
--source include/assert.inc
--source include/rpl/sync_to_replica.inc

--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len, SHA2(data, 256) AS digest FROM t1 ORDER BY id
--source include/rpl/diff.inc

--source include/rpl/connection_replica.inc
--let $wait_condition= SELECT SPILL_TRANSACTIONS_COUNT = 2 $from_ch
--source include/wait_condition.inc
--let $spill_dir_to_check= $spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc

--echo
--echo # Cleanup.
--echo

--source include/rpl/connection_source.inc
SET SESSION binlog_transaction_compression = DEFAULT;
SET SESSION group_concat_max_len = DEFAULT;
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc
UNINSTALL COMPONENT 'file://component_replication_applier_metrics';

--source include/rpl/deinit.inc
