# ==== Purpose ====
#
# Verify that in a line topology 1->2->3, where server_2's channel uses the
# Change Stream Applier (CSA) with the in-memory relay log (IMR), server_2
# keeps working as a source while its receiver (IO thread) is paused while
# adding a received GTID to Retrieved_Gtid_Set: server_2 commits local
# transactions and server_3 replicates from server_2.
#
# This is the IMR counterpart of rpl_gtid.rpl_line_topology_block_receiver,
# which skips on IMR. On disk the receiver adds the GTID before the terminal
# event is visible to the applier, so the paused transaction is not applied
# while the receiver waits. On IMR the terminal event seals the transaction
# and hands it to the applier first; the receiver then adds the GTID in
# after_write_to_in_memory_relay_log(). So while the receiver is paused the
# applier commits the paused transaction.
#
# ==== Requirements ====
#
# R1. While server_2's IMR receiver is paused at the debug sync point
#     updating_received_transaction_set, server_2 commits a local
#     transaction.
# R2. server_3 starts replicating from server_2 and syncs to server_2's
#     gtid_executed, including the paused transaction and the local one.
# R3. After the receiver continues, server_2's received transaction set
#     contains the paused GTID and server_3 syncs again.
#
# ==== Implementation ====
#
#   0. Set up 1->2,2->3 with the replicas stopped. server_2's channel uses the
#      CSA with IMR on every pass; server_3 uses the default applier. Assert
#      that server_2's channel uses IMR.
#   1. Create t1 and insert 1 on server_1, start server_2's replica, sync.
#   2. Add the debug point updating_received_transaction_set on server_2.
#   3. Insert 2 on server_1 and wait until server_2's receiver reaches the
#      sync point.
#   4. Commit a local transaction (insert 3) on server_2 (R1). Wait until
#      server_2's gtid_executed contains the paused transaction and the local
#      one, then assert that t1 has 3 rows.
#   5. Start server_3's replica and sync it with server_2 (R2).
#   6. Remove the debug point and let the receiver continue. Wait until the
#      received transaction set contains the paused GTID, then sync server_3
#      again (R3).
#   7. Cleanup.
#
# While the receiver is paused it holds the channel's data_lock, so the test
# reads no replica status or replication performance_schema table on
# server_2 between steps 3 and 6.
#
# ==== References ====
#
# WL#8599: Reduce contention in IO and SQL threads.
# rpl_gtid.rpl_line_topology_block_receiver (same scenario on disk).
# rpl_gtid.rpl_multi_source_block_receiver (paused receiver, no downstream
# replica).

# CSA is row-based only.
--source include/have_binlog_format_row.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc

--echo
--echo # 0. Set up 1->2,2->3; server_2 uses the CSA with IMR.
--echo

--let $rpl_gtid_utils= 1
--let $rpl_skip_start_slave= 1
--let $rpl_topology= 1->2,2->3
# List every replica: the topology helper applies the whole value to a replica
# that is not listed. server_3 uses the default applier.
--let $rpl_applier_version= 2:2,3:1
--let $rpl_applier_worker_count= 2:4
--let $rpl_in_memory_relaylog= ON
--source include/rpl/init.inc

--let $rpl_connection_name= server_2
--source include/connection.inc
--let $count= `SELECT COUNT(*) FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = '' AND IN_MEMORY_RELAYLOG_ENABLED = 'YES'`
--let $assert_text= server_2's channel uses the in-memory relay log
--let $assert_cond= $count = 1
--source include/assert.inc

--echo
--echo # 1. Create and populate t1 on server_1; server_2 replicates it.
--echo

--let $rpl_connection_name= server_1
--source include/connection.inc
--let $master1_uuid= `SELECT @@GLOBAL.server_uuid`
CREATE TABLE t1 (c1 INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

--let $rpl_connection_name= server_2
--source include/connection.inc
--source include/rpl/start_replica.inc

--let $rpl_connection_name= server_1
--source include/connection.inc
--let $sync_slave_connection= server_2
--source include/rpl/sync_to_replica.inc

--echo
--echo # 2. Pause server_2's receiver when it adds a received GTID.
--echo

--let $debug_point= updating_received_transaction_set
--source include/add_debug_point.inc

--echo
--echo # 3. Insert on server_1; server_2's receiver reaches the sync point.
--echo

--let $rpl_connection_name= server_1
--source include/connection.inc
INSERT INTO t1 VALUES (2);

--let $rpl_connection_name= server_2
--source include/connection.inc
SET DEBUG_SYNC = "now WAIT_FOR reached_updating_received_transaction_set";

--echo
--echo # 4. Commit a local transaction on server_2 (R1).
--echo

SET GTID_NEXT = 'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1';
INSERT INTO t1 VALUES (3);
SET GTID_NEXT = AUTOMATIC;

# IMR hands the paused transaction to the applier when the terminal event
# seals it, before the receiver adds its GTID to Retrieved_Gtid_Set. So the
# applier commits it while the receiver waits: t1 has 3 rows and
# gtid_executed contains server_1's GTIDs 1-3.
# Wait on gtid_executed, not on the row count: binlog group commit commits in
# the engine before it adds the GTIDs to gtid_executed, so the row can be
# visible before the GTID is. Once the GTID is in gtid_executed the row is
# visible too.
--let $wait_condition= SELECT GTID_IS_EQUAL(@@GLOBAL.GTID_EXECUTED, "$master1_uuid:1-3,aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1")
--source include/wait_condition_or_abort.inc

--let $assert_text= server_2 has the 3 rows
--let $assert_cond= [SELECT COUNT(*) FROM t1] = 3
--source include/assert.inc

--echo
--echo # 5. server_3 replicates from server_2 while server_2's receiver is
--echo #    paused (R2).
--echo

--let $rpl_connection_name= server_3
--source include/connection.inc
--source include/rpl/start_replica.inc

--let $rpl_connection_name= server_2
--source include/connection.inc
--let $sync_slave_connection= server_3
--source include/rpl/sync_to_replica.inc

--let $assert_text= server_3 has the 3 rows
--let $assert_cond= [SELECT COUNT(*) FROM t1] = 3
--source include/assert.inc

--let $assert_text= server_3 executed the same GTIDs as server_2
--let $assert_cond= GTID_IS_EQUAL(@@GLOBAL.GTID_EXECUTED, "$master1_uuid:1-3,aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa:1")
--source include/assert.inc

--echo
--echo # 6. Let server_2's receiver continue; the received set gets the paused
--echo #    GTID and server_3 syncs again (R3).
--echo

--let $rpl_connection_name= server_2
--source include/connection.inc
--let $debug_point= updating_received_transaction_set
--source include/remove_debug_point.inc
SET DEBUG_SYNC = "now SIGNAL continue_updating_received_transaction_set";

--let $wait_condition= SELECT GTID_SUBSET('$master1_uuid:3', RECEIVED_TRANSACTION_SET) FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = ''
--source include/wait_condition_or_abort.inc

--let $sync_slave_connection= server_3
--source include/rpl/sync_to_replica.inc

--echo
--echo # 7. Cleanup.
--echo

--let $rpl_connection_name= server_2
--source include/connection.inc
SET DEBUG_SYNC = 'RESET';

--let $rpl_connection_name= server_1
--source include/connection.inc
DROP TABLE t1;
--source include/rpl/sync.inc

--let $use_gtids= 1
--source include/rpl/deinit.inc
