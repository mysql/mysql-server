# ==== Purpose ====
#
# Test that the replica fails to connect to the source with
# SOURCE_AUTO_POSITION=1 if the replica is missing some transactions
# that the source has purged.
#
# ==== Implementation ====
#
# 1) Create a source-replica setup.
# 2) Create a table on source, sync it, stop the replica threads and dump thread
#    on source.
# 3) On source, generate a transaction, flush the binary log and execute PURGE
#    BINARY LOGS TO command so that only remaining binlog only contains
#    transaction UUID:3.
# 4) Verify that the replica fails if it tries to connect using CHANGE REPLICATION SOURCE TO
#    SOURCE_AUTO_POSITION=1.
# 5) Verify that appropriate messages are logged into source's and replica's
#    error log.
# 6) Verify that replication succeeds after missing GTIDs are
#    skipped.
# 7) Cleanup.
#
# ==== References ====
#
# WL#3584 - Global Transaction Identifiers
# Bug#29769293 - ERROR 1236 "MASTER HAS PURGED BINARY LOGS CONTAINING GTIDS":
#                GTID NOT LOGGED

--source include/not_group_replication_plugin.inc
--source include/have_debug.inc
--let $rpl_gtid_utils= 1

--echo #
--echo # 1) Create a source-replica setup.
--echo #
--source include/rpl/init_source_replica.inc

--let $source_uuid= `SELECT @@SERVER_UUID`

--echo #
--echo # 2) Create a table on source, sync it, stop the replica threads and dump
--echo #    thread on source.
--echo #
CREATE TABLE t1 (a INT) ENGINE = InnoDB;
--source include/rpl/sync_to_replica.inc
--source include/rpl/stop_replica.inc

--source include/rpl/connection_source.inc
# Need to kill the dump thread explicitly: stop replica does not do
# that, and if the dump thread is slow, it will still be reading from
# the old binlog at the time we do PURGE BINARY LOGS below. That would
# prevent PURGE BINARY LOGS from purging the log.
--source include/rpl/stop_dump_threads.inc

--echo #
--echo # 3) On source, generate a transaction, flush the binary log and execute
--echo #    PURGE BINARY LOGS TO command so that only remaining binlog only contains
--echo #    transaction UUID:3.
--echo #
INSERT INTO t1 VALUES (1);

FLUSH LOGS;
--let $source_file= query_get_value(SHOW BINARY LOG STATUS, File, 1)
INSERT INTO t1 VALUES (2);

--eval PURGE BINARY LOGS TO '$source_file'

--let $assert_cond= "[SHOW BINARY LOG STATUS, File, 1]" = "$source_file"
--let $assert_text= PURGE BINARY LOGS successfully removed all but the latest file
--source include/assert.inc

--echo #
--echo # 4) Verify that the replica fails if it tries to connect using CHANGE
--echo #    REPLICATION SOURCE TO SOURCE_AUTO_POSITION=1.
--echo #
--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO SOURCE_AUTO_POSITION = 1;

START REPLICA;

# BUG#13727933 causes this test to fail sporadically on the following line
# apparently the binlog is not always purged on the source (?)
--let $slave_io_errno= 13114 # ER_SOURCE_FATAL_ERROR_READING_BINLOG
--source include/rpl/wait_for_receiver_error.inc
--source include/rpl/stop_applier.inc

# Testing with long set of gtids
--source include/rpl/connection_source.inc
SET @saved_debug= @@GLOBAL.DEBUG;
SET GLOBAL DEBUG= '+d,simulate_long_missing_gtids';
--source include/rpl/connection_replica.inc
START REPLICA;

--let $slave_io_errno= 13114 # ER_SOURCE_FATAL_ERROR_READING_BINLOG
--source include/rpl/wait_for_receiver_error.inc
--source include/rpl/stop_applier.inc
--source include/rpl/connection_source.inc
SET GLOBAL DEBUG= @saved_debug;
--source include/rpl/connection_replica.inc

--echo #
--echo # 5) Verify that appropriate messages are logged into source's and
--echo #    replica's error log.
--echo #

# Verify that an error about long gtids are logged into the replica's error log.
--let $assert_file=$MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_match= .*The GTID sets and the missing purged transactions are too long to print in this message.*
--let $assert_select= The GTID sets and the missing purged transactions are too long to print in this message.
--let $assert_text= Found a message about the long GTIDs in the replica error log.
--source include/assert_grep.inc

--echo #
--echo # 6) Verify that replication succeeds after missing GTIDs are
--echo #    skipped
--echo #

--replace_result $source_uuid UUID
--eval SET GTID_NEXT="$source_uuid:1"
COMMIT;
--replace_result $source_uuid UUID
--eval SET GTID_NEXT="$source_uuid:2"
COMMIT;

SET GTID_NEXT=AUTOMATIC;

--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--let $assert_text= t1 should contain only one row with t he value 2
--let $assert_cond= "[SELECT COUNT(*) FROM t1]" = "1" AND "[SELECT * FROM t1]" = "2"
--source include/assert.inc
--source include/rpl/stop_replica.inc

# Verify that warning about the missing transactions are logged into the source's error log.
--let $assert_file=$MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_match= .*Cannot replicate to server with server_uuid.*The missing transactions are '.*:2'.*
--let $assert_select= Cannot replicate to server with server_uuid
--let $assert_text= Found warning containing lost GTIDs in the source error log.
--source include/assert_grep.inc

# Verify that an error about the missing transactions are logged into the replica's error log.
--let $assert_file=$MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_match= .*Replicate the missing transactions from elsewhere, or provision a new replica from backup.*the missing transactions are '.*:2'.*
--let $assert_select= Replicate the missing transactions from elsewhere, or provision a new replica from backup
--let $assert_text= Found warning containing lost GTIDs in the replica error log.
--source include/assert_grep.inc

# Suppress the error on source.
--source include/rpl/connection_source.inc
CALL mtr.add_suppression("Cannot replicate to server.*server has purged required binary logs.*");

# Suppress the error on replica.
--source include/rpl/connection_replica.inc
CALL mtr.add_suppression("Got fatal error 1236 from source.*Replicate the missing transactions from elsewhere");

--echo #
--echo # 7) Cleanup.
--echo #
--source include/rpl/connection_replica.inc
RESET BINARY LOGS AND GTIDS;
RESET REPLICA;
--source include/rpl/connection_source.inc
RESET BINARY LOGS AND GTIDS;
--source include/rpl/connection_replica.inc
--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc
--source include/rpl/deinit.inc
