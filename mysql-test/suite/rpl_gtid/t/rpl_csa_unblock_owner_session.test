# ==== PURPOSE ====
#
# With replica_preserve_commit_order=ON, a commit-order stall of 10 s makes
# the CSA scheduler dispatch the stalled transaction's commit task on a
# helper thread while its owner is still in prepare. The helper must not
# detach the owner's session or run its failure handling; doing so crashed
# the server when the stall ended with a final apply failure or with
# STOP REPLICA.
#
# On final failure, independent transactions prepared behind the failed
# one must not commit, as that breaks the commit order; they are rolled
# back, and the channel keeps the original error.
#
# ==== IMPLEMENTATION ====
#
# For each trigger, a replica client holds the row lock the replicated
# INSERT needs, the helper is dispatched after 10 s, and then:
#   1. final failure: four independent INSERTs follow the blocked one;
#      innodb_lock_wait_timeout=30 with one retry; expect
#      ER_LOCK_WAIT_TIMEOUT and exactly one channel-stop error line; before
#      restarting, check that none of the source GTIDs from the blocked
#      transaction onward and none of the later rows is on the replica;
#   2. STOP REPLICA during the stall.
# Then release the lock, restart, sync, run FLUSH TABLES (a damaged table
# cache crashes here) and compare the tables.
#
# ==== REFERENCES ====
#
# WL#10500 MTA: Optimized and generic change stream applier
--source include/big_test.inc
--source include/have_binlog_format_row.inc
# Test scenario is constructed assuming replica_preserve_commit_order=1
--source include/have_replica_preserve_commit_order.inc
--let $rpl_applier_version=2:2
--let $rpl_applier_worker_count=2:4
--source include/rpl/init_source_replica.inc

CREATE TABLE t1 (id INT PRIMARY KEY);
--source include/rpl/sync_to_replica.inc

--source include/rpl/connection_replica.inc
CALL mtr.add_suppression("Change Stream Applier channel stopped because of error");
CALL mtr.add_suppression("The replica coordinator and worker threads are stopped");
CALL mtr.add_suppression("Worker .* failed executing transaction");
CALL mtr.add_suppression("Error 'Lock wait timeout exceeded");
CALL mtr.add_suppression("Replica worker has stopped after at least one previous worker encountered an error");

--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err

#
# ---------------------------------------------------------------------------
# Trigger 1: final apply failure.
# ---------------------------------------------------------------------------
#
--source include/rpl/connection_replica.inc
--source include/rpl/stop_applier.inc
SET @saved_innodb_lock_wait_timeout = @@GLOBAL.innodb_lock_wait_timeout;
SET @saved_replica_transaction_retries = @@GLOBAL.replica_transaction_retries;
SET GLOBAL innodb_lock_wait_timeout = 30;
SET GLOBAL replica_transaction_retries = 1;
--source include/rpl/start_applier.inc

# Count error log lines from this trigger only.
--exec echo "CSA-TEST-MARKER failure trigger" >> $assert_file

# Block the replicated transaction on a row lock.
--connection slave1
BEGIN;
INSERT INTO t1 VALUES (1);

--source include/rpl/connection_source.inc
--let $gtids_before = `SELECT @@GLOBAL.gtid_executed`
INSERT INTO t1 VALUES (1);
# Independent transactions that prepare behind the blocked one.
INSERT INTO t1 VALUES (11);
INSERT INTO t1 VALUES (12);
INSERT INTO t1 VALUES (13);
INSERT INTO t1 VALUES (14);
--let $new_gtids = `SELECT GTID_SUBTRACT(@@GLOBAL.gtid_executed, '$gtids_before')`

# Times out, retries once and fails (about 60 s).
--source include/rpl/connection_replica.inc
--let $slave_sql_errno = 1205
--source include/rpl/wait_for_applier_error.inc

SELECT "server alive after failure trigger" AS status;
--let $assert_text = No source GTID from the blocked transaction onward is applied
--let $assert_cond = [SELECT GTID_SUBTRACT("$new_gtids", @@GLOBAL.gtid_executed) = "$new_gtids"]
--source include/assert.inc
--let $assert_text = No row of the later transactions is applied
--let $assert_cond = [SELECT COUNT(*) FROM t1 WHERE id > 10] = 0
--source include/assert.inc
--let $assert_text = The channel keeps the original error
--let $assert_cond = "[SHOW REPLICA STATUS, Last_SQL_Errno, 1]" = "1205"
--source include/assert.inc

--let $assert_text = Exactly one CSA channel-stop error line for the failure trigger
--let $assert_select = Change Stream Applier channel stopped because of error
--let $assert_only_after = CSA-TEST-MARKER failure trigger
--let $assert_count = 1
--source include/assert_grep.inc

--connection slave1
ROLLBACK;
--source include/rpl/connection_replica.inc
SET GLOBAL innodb_lock_wait_timeout = @saved_innodb_lock_wait_timeout;
SET GLOBAL replica_transaction_retries = @saved_replica_transaction_retries;
--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--source include/rpl/connection_replica.inc
FLUSH TABLES;

--let $diff_tables = master:t1, slave:t1
--source include/diff_tables.inc

#
# ---------------------------------------------------------------------------
# Trigger 2: STOP REPLICA during the stall.
# ---------------------------------------------------------------------------
#
# Block the replicated transaction on a row lock.
--source include/rpl/connection_replica.inc
--connection slave1
BEGIN;
INSERT INTO t1 VALUES (2);

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (2);

# Let the 10 s channel monitor dispatch the helper, then stop.
--source include/rpl/connection_replica.inc
--sleep 22
--source include/rpl/stop_replica.inc

SELECT "server alive after stop trigger" AS status;

--connection slave1
ROLLBACK;
--source include/rpl/connection_replica.inc
--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--source include/rpl/connection_replica.inc
FLUSH TABLES;

--let $diff_tables = master:t1, slave:t1
--source include/diff_tables.inc

#
# ---------------------------------------------------------------------------
# Cleanup
# ---------------------------------------------------------------------------
#
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc
--source include/rpl/deinit.inc
