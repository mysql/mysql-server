# Test support for replication of Cloudsql Vector columns

--source include/rpl/init_source_replica.inc
--source include/elide_costs.inc

--connection master

let $datadir = `SELECT @@DATADIR`;
let $binlog_file= query_get_value(SHOW BINARY LOG STATUS, File, 1);

--let $table_name=t1
--source suite/vector_index/include/vector_data.inc
--echo Initial Data inserted

--echo # create vector index
CREATE VECTOR INDEX vec_index_1 ON test.t1(j) USING TREE QUANTIZER=SQ8 DISTANCE_MEASURE=l2_squared;
UPDATE t1 SET j = string_to_vector("[2.0, 2.0, 2.0]") WHERE i = 1;

--copy_file $datadir/$binlog_file $MYSQLTEST_VARDIR/tmp/binlog_file


--echo #Test: Replay binary logs to make sure index API works fine

# Stop slave
--source include/rpl/sync_to_replica.inc
--source include/rpl/stop_replica.inc

# Cleanup to start from a clean slate
DROP INDEX vec_index_1 ON test.t1;
DROP TABLE t1;
RESET BINARY LOGS AND GTIDS;
RESET REPLICA;

# Replay binlog on master
--let $rpl_connection_name = master
--source include/connection.inc

# Cleanup to start from a clean slate
DROP INDEX vec_index_1 ON test.t1;
DROP TABLE t1;
RESET BINARY LOGS AND GTIDS;

--echo # Replay binlog on master
--exec $MYSQL_BINLOG $MYSQLTEST_VARDIR/tmp/binlog_file | $MYSQL --user=root --host=127.0.0.1

# Start slave
--let $rpl_connection_name = slave
--source include/connection.inc
--source include/rpl/start_replica.inc


--let $rpl_connection_name = master
--source include/connection.inc

SELECT count(*) FROM t1;
SELECT * FROM information_schema.innodb_vector_indexes;
SELECT i, vector_to_string(j) FROM t1 ORDER BY APPROX_DISTANCE(j, string_to_vector('[1.0,2.0,3.0]'), 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
--replace_regex $elide_costs_and_rows
EXPLAIN format=tree SELECT i, vector_to_string(j) FROM t1 ORDER BY APPROX_DISTANCE(j, string_to_vector('[1.0,2.0,3.0]'), 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;

--source include/rpl/sync_to_replica.inc
SELECT count(*) FROM t1;
SELECT * FROM information_schema.innodb_vector_indexes;
SELECT i, vector_to_string(j) FROM t1 ORDER BY APPROX_DISTANCE(j, string_to_vector('[1.0,2.0,3.0]'), 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;
--replace_regex $elide_costs_and_rows
EXPLAIN format=tree SELECT i, vector_to_string(j) FROM t1 ORDER BY APPROX_DISTANCE(j, string_to_vector('[1.0,2.0,3.0]'), 'DISTANCE_MEASURE=L2_SQUARED') LIMIT 5;

--echo # cleanup
--connection master
DROP TABLE t1;

--remove_file $MYSQLTEST_VARDIR/tmp/binlog_file
--source include/rpl/deinit.inc
