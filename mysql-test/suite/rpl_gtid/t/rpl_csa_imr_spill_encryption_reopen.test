# ==== Purpose ====
#
# Test that an encrypted in-memory relay log (IMR) spill file is read again
# from the start, through the keyring, when a CSA worker retries the
# transaction and when the applier re-dispatches it after STOP REPLICA
# SQL_THREAD. Every attempt opens the spill file again and decrypts the
# file password with the master key from the keyring.
#
# ==== Requirements ====
#
# R1. A spilled transaction in an encrypted spill file that hits a lock wait
#     timeout is retried, and applies once the lock is released.
# R2. A spilled transaction in an encrypted spill file that is interrupted by
#     STOP REPLICA SQL_THREAD mid-transaction is rolled back, kept in the
#     queue, and applies in full after START REPLICA SQL_THREAD; its file is
#     then deleted.
#
# ==== Implementation ====
#
#   1. Load the keyring on the replica, enable binlog_encryption and IMR with
#      an 8 MiB spill threshold, start. innodb_lock_wait_timeout = 5 and
#      replica_transaction_retries = 50 on the replica.
#   2. R1: a second replica session locks a row; the source commits a
#      spilled transaction that ends with an update of that row; assert the
#      spill file is encrypted; wait for a retry; release the lock; sync.
#   3. R2: park a worker mid-transaction with
#      pause_csa_before_releasing_event_memory on an encrypted spilled
#      transaction; assert the spill file is encrypted; STOP REPLICA
#      SQL_THREAD; START REPLICA SQL_THREAD; sync; no spill files.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# Mechanisms from rpl_csa_xa_retry and rpl_csa_imr_stop_sql_thread_mid_trx.
# WL#10957: Binary log encryption at rest.
# CSA (Change Stream Applier): WL#10500.

--source include/have_component_keyring_file.inc
--source include/have_debug.inc
--source include/have_debug_sync.inc
# CSA requires row-based replication.
--source include/have_binlog_format_row.inc
# The plaintext check needs uncompressed transaction payloads.
--source include/not_binlog_transaction_compression_on.inc

--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source suite/component_keyring_file/inc/rpl_setup_component.inc

--echo
--echo # 1. Load the keyring on the replica, enable binlog_encryption and IMR.
--echo

--let $rpl_server_number= 2
--let $rpl_server_parameters= $RPL_PLUGIN_DIR_OPT
--let $rpl_omit_print_server_parameters= 1
--source include/rpl/restart_server.inc

--source include/rpl/connection_replica.inc
SET GLOBAL binlog_encryption = ON;
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;

# Stopping the applier mid-transaction kills a clean worker session.
CALL mtr.add_suppression("Replica SQL thread .* killed");
CALL mtr.add_suppression("Worker .* stopped");

let $sysvars_to_save = [
  "GLOBAL.replica_transaction_retries",
  "GLOBAL.innodb_lock_wait_timeout"
];
--source include/save_sysvars.inc
SET @@GLOBAL.replica_transaction_retries = 50;
SET @@GLOBAL.innodb_lock_wait_timeout = 5;
--source include/rpl/start_replica.inc

--let $sef_spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`
--let $sef_marker= IMR_SPILL_ENCRYPTION_MARKER
--let $key_1= `SELECT CONCAT('MySQLReplicationKey_', @@GLOBAL.server_uuid, '_1')`

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
INSERT INTO t1 VALUES (1000, 'source');
--source include/rpl/sync_to_replica.inc

--echo
--echo # 2. Worker retry on an encrypted spill file (R1).
--echo

--source include/rpl/connection_replica1.inc
BEGIN;
UPDATE t1 SET data = 'replica' WHERE id = 1000;

# One transaction larger than 8 MiB (9 rows x ~1 MiB) that ends with an update
# of the row the replica session holds.
--source include/rpl/connection_source.inc
BEGIN;
--disable_query_log
--let $i= 1
while ($i <= 9)
{
  --eval INSERT INTO t1 VALUES ($i, CONCAT('IMR_SPILL_ENCRYPTION_MARKER', REPEAT('x', 1048576)))
  --inc $i
}
--enable_query_log
UPDATE t1 SET data = 'retried' WHERE id = 1000;
COMMIT;
--source include/rpl/sync_to_replica_received.inc

--source include/rpl/connection_replica.inc
--source suite/rpl_gtid/t/rpl_csa_imr_spill_encryption_files.inc
--let $assert_text= The retried transaction's spill file is encrypted with master key _1 and holds no plaintext
--let $assert_cond= $sef_count = 1 AND "$sef_magic_1" = "encrypted" AND "$sef_key_1" = "$key_1" AND $sef_marker_1 = 0
--source include/assert.inc

# Wait until the worker has retried the transaction at least once.
--let $wait_condition= SELECT COUNT(*) > 0 FROM performance_schema.replication_applier_status_by_worker WHERE APPLYING_TRANSACTION_RETRIES_COUNT > 0
--source include/wait_condition.inc

--let $lock_wait_timeout_errno= convert_error(ER_LOCK_WAIT_TIMEOUT)
--let $actual_transient_errno= query_get_value(SELECT APPLYING_TRANSACTION_LAST_TRANSIENT_ERROR_NUMBER FROM performance_schema.replication_applier_status_by_worker WHERE APPLYING_TRANSACTION_RETRIES_COUNT > 0, APPLYING_TRANSACTION_LAST_TRANSIENT_ERROR_NUMBER, 1)
--let $assert_text= The worker retried the spilled transaction after a lock wait timeout
--let $assert_cond= "$actual_transient_errno" = "$lock_wait_timeout_errno"
--source include/assert.inc

--source include/rpl/connection_replica1.inc
ROLLBACK;

--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len, LEFT(data, 32) AS head FROM t1 ORDER BY id
--source include/rpl/diff.inc

--source include/rpl/connection_replica.inc
--let $spill_dir_to_check= $sef_spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc

--echo
--echo # 3. Re-dispatch after STOP REPLICA SQL_THREAD mid-transaction (R2).
--echo

# A worker parks right after it applies an event larger than 3000 bytes, in
# the middle of the transaction.
--let $debug_point= pause_csa_before_releasing_event_memory
--source include/add_debug_point.inc

--source include/rpl/connection_source.inc
BEGIN;
--disable_query_log
--let $i= 200
while ($i <= 211)
{
  --eval INSERT INTO t1 VALUES ($i, CONCAT('IMR_SPILL_ENCRYPTION_MARKER', REPEAT('y', 1048576)))
  --inc $i
}
--enable_query_log
COMMIT;

--source include/rpl/connection_replica.inc
SET DEBUG_SYNC= 'now WAIT_FOR paused_csa_before_releasing_event_memory TIMEOUT 30';

--source suite/rpl_gtid/t/rpl_csa_imr_spill_encryption_files.inc
--let $assert_text= The interrupted transaction's spill file is encrypted with master key _1 and holds no plaintext
--let $assert_cond= $sef_count = 1 AND "$sef_magic_1" = "encrypted" AND "$sef_key_1" = "$key_1" AND $sef_marker_1 = 0
--source include/assert.inc

# STOP blocks until the applier is down, so send it on a second session.
--source include/rpl/connection_replica1.inc
--send STOP REPLICA SQL_THREAD

--source include/rpl/connection_replica.inc
--let $debug_point= pause_csa_before_releasing_event_memory
--source include/remove_debug_point.inc
SET DEBUG_SYNC= 'now SIGNAL signal_continue_csa_releasing_event_memory';
--source include/rpl/connection_replica1.inc
--reap
--source include/rpl/connection_replica.inc
SET DEBUG_SYNC= 'RESET';
--source include/rpl/assert_replica_no_error.inc

--let $wait_condition= SELECT COUNT(*) = 0 FROM t1 WHERE id BETWEEN 200 AND 211
--source include/wait_condition.inc
--let $assert_text= The interrupted transaction rolled back, not partially applied
--let $assert_cond= [SELECT COUNT(*) FROM t1 WHERE id BETWEEN 200 AND 211] = 0
--source include/assert.inc

--source include/rpl/start_applier.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc

--source include/rpl/connection_replica.inc
--let $assert_text= The transaction applied in full after START REPLICA SQL_THREAD
--let $assert_cond= [SELECT COUNT(*) FROM t1 WHERE id BETWEEN 200 AND 211] = 12
--source include/assert.inc

--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len, LEFT(data, 32) AS head FROM t1 ORDER BY id
--source include/rpl/diff.inc

--let $spill_dir_to_check= $sef_spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc

# Cleanup.
--source include/rpl/stop_replica.inc
--source include/restore_sysvars.inc
SET GLOBAL binlog_encryption = OFF;
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--source suite/component_keyring_file/inc/rpl_teardown_component.inc
