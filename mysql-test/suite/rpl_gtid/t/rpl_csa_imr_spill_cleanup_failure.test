# ==== Purpose ====
#
# When the startup purge cannot delete a stale spill file, the server logs it
# and refuses to start channels that use the in-memory relay log, until
# it is restarted with the file removed. Other channels are not affected.
#
# ==== Requirements ====
#
# R1. Each stale spill file that cannot be deleted at startup is logged as
#     ER_BINLOG_CANT_DELETE_FILE, followed by a summary error, and the file
#     stays on disk. The server itself starts.
# R2. The startup start of an in-memory relay log channel (no client session)
#     is refused: both replication threads stay stopped.
# R3. START REPLICA, START REPLICA IO_THREAD and START REPLICA SQL_THREAD on
#     the channel fail with ER_REPLICA_IN_MEMORY_RELAYLOG_SPILL_STORAGE_UNUSABLE.
# R4. With the in-memory relay log disabled, the same channel starts and
#     replicates. Enabling it again is refused again until a restart.
# R5. After a restart in which the purge succeeds, the channel starts with the
#     in-memory relay log and replicates.
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with the in-memory relay log and replicate a table.
#   2. Stop the replica and plant a stale "imr_sp_" file in the spill directory.
#   3. Restart the replica with replica start enabled and the debug point
#      imr_force_spill_purge_delete_failure, which makes each delete in the
#      purge fail and leave the file. Check R1 and R2.
#   4. Check R3.
#   5. Disable the in-memory relay log, replicate, re-enable it, and check that
#      START is refused again (R4).
#   6. Restart without the debug point, then start and replicate (R5).
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.

# CSA is row-based only.
--source include/have_binlog_format_row.inc
--source include/have_debug.inc

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--echo
--echo # 1. A CSA channel with the in-memory relay log replicates a table.
--echo

--source include/rpl/connection_replica.inc
CALL mtr.add_suppression("Failed to delete file .*imr_sp_stale");
CALL mtr.add_suppression("\\[In-memory relay log\\] stale spill files could not be removed at startup");
CALL mtr.add_suppression("Failed to start replica threads for channel");
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;

# <relay-log dir>/#in_memory_relaylog_temp_files
--let $spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`

--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (a INT PRIMARY KEY);
INSERT INTO t1 VALUES (1);
--source include/rpl/sync_to_replica.inc

--echo
--echo # 2. Plant a stale spill file, as a crash would leave it.
--echo

--source include/rpl/stop_replica.inc
--write_file $spill_dir/imr_sp_stale
stale spill payload
EOF

--echo
--echo # 3. Restart with replica start enabled and every purge delete failing.
--echo

--let $rpl_server_number= 2
--let $rpl_server_parameters= --skip-replica-start=0 --debug=+d,imr_force_spill_purge_delete_failure
--source include/rpl/restart_server.inc
--source include/rpl/connection_replica.inc

--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: rpl_gtid.rpl_csa_imr_spill_cleanup_failure
--let $assert_select= Failed to delete file '.*imr_sp_stale'
--let $assert_count= 1
--let $assert_text= The undeletable stale spill file is logged as ER_BINLOG_CANT_DELETE_FILE
--source include/assert_grep.inc

--let $assert_select= \[In-memory relay log\] stale spill files could not be removed at startup
--let $assert_text= The purge failure summary is logged
--source include/assert_grep.inc

--echo # The stale file is still on disk (R1).
--file_exists $spill_dir/imr_sp_stale

--let $assert_select= Failed to start replica threads for channel ''
--let $assert_text= The startup start of the channel is refused (R2)
--source include/assert_grep.inc

--let $assert_text= Both replication threads are stopped after the restart (R2)
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "No" AND "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "No"
--source include/assert.inc

--echo
--echo # 4. Every START form is refused (R3).
--echo

--error ER_REPLICA_IN_MEMORY_RELAYLOG_SPILL_STORAGE_UNUSABLE
START REPLICA;
--error ER_REPLICA_IN_MEMORY_RELAYLOG_SPILL_STORAGE_UNUSABLE
START REPLICA IO_THREAD;
--error ER_REPLICA_IN_MEMORY_RELAYLOG_SPILL_STORAGE_UNUSABLE
START REPLICA SQL_THREAD;

--let $assert_text= Both replication threads are still stopped
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "No" AND "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "No"
--source include/assert.inc

--echo
--echo # 5. Without the in-memory relay log the channel replicates. Enabling it
--echo #    again is refused again (R4).
--echo

CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (2);
--source include/rpl/sync_to_replica.inc

--source include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
--error ER_REPLICA_IN_MEMORY_RELAYLOG_SPILL_STORAGE_UNUSABLE
START REPLICA;

--echo
--echo # 6. After a restart in which the purge succeeds, the channel starts with
--echo #    the in-memory relay log and replicates (R5).
--echo

--let $rpl_server_parameters=
--source include/rpl/restart_server.inc
--source include/rpl/connection_replica.inc

--echo # The purge removed the stale file.
--error 1
--file_exists $spill_dir/imr_sp_stale

--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (3);
--source include/rpl/sync_to_replica.inc
--let $rpl_diff_statement= SELECT * FROM t1 ORDER BY a
--source include/rpl/diff.inc

# Cleanup.
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--source include/rpl/deinit.inc
