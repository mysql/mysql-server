# ==== Purpose ====
#
# Test that ALTER INSTANCE ROTATE BINLOG MASTER KEY, while the CSA workers of
# an in-memory relay log (IMR) channel apply a backlog from a source with
# binlog_checksum = NONE, leaves every transaction decoded and applied
# correctly.
#
# Each queued transaction is decoded with a read-only snapshot of the
# receiver's Format_description event. The receiver's own object is written
# into the new relay-log file by the key rotation, and
# Format_description_log_event::write() switches its checksum algorithm from
# OFF to CRC32 while it does. A worker that decoded with that object in the
# switched state would cut 4 bytes off each event: BEGIN would become 'B' and
# the applier would stop with ER_PARSE_ERROR.
#
# The switch lasts only a few instructions, so this test does not reach it
# reliably on its own; it checks the scenario end to end. The window was
# widened with a temporary debug sleep to validate the snapshot (not part of
# this test).
#
# ==== Requirements ====
#
# R1. Key rotations during apply do not stop the applier: Replica_SQL_Running
#     stays Yes and Last_SQL_Errno is 0.
# R2. The replica data equals the source data, for uncompressed and compressed
#     memory-path transactions.
#
# ==== Implementation ====
#
#   0. Load the keyring on the replica; source binlog_checksum = NONE; replica
#      binlog_encryption = ON, IMR ON with a 256 MiB limit; start replication.
#   1. Stop the applier; the source commits 300 small uncompressed and 100
#      compressed transactions; wait until all are received.
#   2. Start the applier and run ALTER INSTANCE ROTATE BINLOG MASTER KEY three
#      times while it applies.
#   3. R1, R2: sync; assert the applier is running with no error; diff.
#   4. Clean up.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.
# WL#10957: Binary log encryption at rest.
# CSA (Change Stream Applier): WL#10500.
--source include/have_component_keyring_file.inc
# CSA requires row-based replication.
--source include/have_binlog_format_row.inc
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source suite/component_keyring_file/inc/rpl_setup_component.inc
--echo
--echo # 0. Load the keyring on the replica, source binlog_checksum = NONE,
--echo #    replica binlog_encryption = ON and IMR ON.
--echo
--let $rpl_server_number= 2
--let $rpl_server_parameters= $RPL_PLUGIN_DIR_OPT
--let $rpl_omit_print_server_parameters= 1
--source include/rpl/restart_server.inc
--source include/rpl/connection_source.inc
--let $saved_binlog_checksum= `SELECT @@GLOBAL.binlog_checksum`
SET GLOBAL binlog_checksum = NONE;
FLUSH BINARY LOGS;
--source include/rpl/connection_replica.inc
SET GLOBAL binlog_encryption = ON;
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_LIMIT = 268435456;
--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, payload VARBINARY(2048));
--source include/rpl/sync_to_replica.inc
--echo
--echo # 1. Queue a backlog of memory-path transactions with the applier
--echo #    stopped.
--echo
--source include/rpl/stop_applier.inc
--source include/rpl/connection_source.inc
SET SESSION binlog_transaction_compression = OFF;
--disable_query_log
--let $i= 1
while ($i <= 300)
{
  INSERT INTO t1 (payload) VALUES (REPEAT(_binary'ab', 512));
  --inc $i
}
--enable_query_log
SET SESSION binlog_transaction_compression = ON;
--disable_query_log
--let $i= 1
while ($i <= 100)
{
  INSERT INTO t1 (payload) VALUES (REPEAT(_binary'ab', 512));
  --inc $i
}
--enable_query_log
SET SESSION binlog_transaction_compression = DEFAULT;
--source include/rpl/sync_to_replica_received.inc
--echo
--echo # 2. Rotate the binary log master key while the applier applies.
--echo
--source include/rpl/start_applier.inc
--let $i= 1
while ($i <= 3)
{
  ALTER INSTANCE ROTATE BINLOG MASTER KEY;
  --inc $i
}
--echo
--echo # 3. The applier applied every transaction without error (R1, R2).
--echo
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc
--let $sql_running= query_get_value(SHOW REPLICA STATUS, Replica_SQL_Running, 1)
--let $sql_errno= query_get_value(SHOW REPLICA STATUS, Last_SQL_Errno, 1)
--let $assert_text= The applier is running with no error after the key rotations
--let $assert_cond= "$sql_running" = "Yes" AND $sql_errno = 0
--source include/assert.inc
--let $rpl_diff_statement= SELECT id, LENGTH(payload) AS len, CRC32(payload) AS crc FROM t1 ORDER BY id
--source include/rpl/diff.inc
--echo
--echo # 4. Clean up.
--echo
--source include/rpl/connection_replica.inc
--source include/rpl/stop_replica.inc
SET GLOBAL binlog_encryption = OFF;
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
DROP TABLE t1;
--disable_query_log
--eval SET GLOBAL binlog_checksum = $saved_binlog_checksum
--enable_query_log
--source include/rpl/sync_to_replica.inc
--source suite/component_keyring_file/inc/rpl_teardown_component.inc
