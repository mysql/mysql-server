# ==== Purpose ====
#
# Verify that STOP REPLICA [SQL_THREAD] issued right after START REPLICA ends
# promptly on a CSA (Change Stream Applier) channel with the in-memory relay
# log (IMR), while the receiver (IO thread) runs.
#
# START REPLICA returns before the SQL thread enters Csa_service::run(), which
# registers the channel. A STOP in that window only sets abort_slave and the
# queue's applier stop flag: Csa_service::stop() finds no channel. Before the
# fix the IMR reader ignored abort_slave, so the coordinator busy-spun and the
# STOP failed after rpl_stop_replica_timeout.
#
# ==== Requirements ====
#
# R1. START REPLICA then STOP REPLICA at once ends without an error and stops
#     both threads.
# R2. With the IO thread running, START REPLICA SQL_THREAD then STOP REPLICA
#     SQL_THREAD at once ends without an error and stops the SQL thread.
# R3. The channel replicates after the next START.
#
# ==== Implementation ====
#
#   0. Set up a CSA channel with IMR. Lower rpl_stop_replica_timeout to 10
#      seconds so a regression fails instead of hanging, and set
#      init_replica = 'DO SLEEP(1)' so the SQL thread stays in the window.
#   1. START REPLICA; STOP REPLICA (R1).
#   2. START REPLICA IO_THREAD; START REPLICA SQL_THREAD; STOP REPLICA
#      SQL_THREAD (R2).
#   3. Restore the variables, start the applier, replicate one transaction
#      (R3).
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).

# CSA is row-based only.
--source include/have_binlog_format_row.inc

--echo
--echo # 0. Set up a CSA channel with IMR enabled.
--echo

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;

SET @saved_stop_timeout = @@GLOBAL.rpl_stop_replica_timeout;
SET @saved_init_replica = @@GLOBAL.init_replica;
SET GLOBAL rpl_stop_replica_timeout = 10;
SET GLOBAL init_replica = 'DO SLEEP(1)';

--echo
--echo # 1. START REPLICA then STOP REPLICA at once (R1).
--echo

START REPLICA;
STOP REPLICA;

--let $assert_text= 1: both threads are stopped
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "No" AND "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "No"
--source include/assert.inc

--echo
--echo # 2. With the IO thread running, START REPLICA SQL_THREAD then STOP
--echo #    REPLICA SQL_THREAD at once (R2).
--echo

--source include/rpl/start_receiver.inc
START REPLICA SQL_THREAD;
STOP REPLICA SQL_THREAD;

--let $assert_text= 2: the SQL thread is stopped, the IO thread runs
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "No" AND "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "Yes"
--source include/assert.inc
--let $count= `SELECT COUNT(*) FROM performance_schema.replication_applier_configuration WHERE CHANNEL_NAME = '' AND IN_MEMORY_RELAYLOG_ENABLED = 'YES'`
--let $assert_text= 2: the channel uses the in-memory relay log
--let $assert_cond= $count = 1
--source include/assert.inc

--echo
--echo # 3. Restore the variables and replicate one transaction (R3).
--echo

SET GLOBAL init_replica = @saved_init_replica;
SET GLOBAL rpl_stop_replica_timeout = @saved_stop_timeout;
--source include/rpl/start_applier.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY);
INSERT INTO t1 VALUES (1);
--source include/rpl/sync_to_replica.inc
--let $assert_text= 3: the row was replicated
--let $assert_cond= [SELECT COUNT(*) FROM t1 WHERE id = 1] = 1
--source include/assert.inc

--echo
--echo # Cleanup.
--echo

--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc

--source include/rpl/deinit.inc
