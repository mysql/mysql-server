# ==== Purpose ====
#
# The in-memory relay log (IMR) is incompatible with semi-synchronous
# replication: semisync acknowledges a transaction to the source only after it
# is durably written to the relay log, which the memory path never does. The
# server therefore rejects starting the receiver (IO thread) on an IMR-enabled
# CSA channel while the semisync replica plugin is enabled.
#
# ==== Requirements ====
#
# R1. With IMR enabled on a CSA channel and the replica-side semisync enabled,
#     START REPLICA IO_THREAD is rejected with
#     ER_REPLICA_IN_MEMORY_RELAYLOG_INCOMPATIBLE_CONFIGURATION.
# R2. START REPLICA (both threads) is rejected for the same reason (the gate is
#     on the receiver and is evaluated before any thread starts).
# R3. Disabling IMR clears the incompatibility: the channel then starts normally
#     even with the semisync replica plugin still enabled.
# R4. When the IMR channel auto-starts at server start with semisync enabled,
#     the receiver stops before its binlog dump request with
#     ER_REPLICA_IN_MEMORY_RELAYLOG_INCOMPATIBLE_CONFIGURATION; the applier
#     keeps running.
# R5. When semisync is enabled while the IMR receiver runs, the receiver stops
#     with the same error on its next reconnect, without retrying.
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with the applier stopped; install and enable the
#      replica-side semisync plugin (threads stopped).
#   2. Enable IMR on the channel.
#   3. START REPLICA IO_THREAD is rejected (R1).
#   4. START REPLICA (both) is rejected (R2).
#   5. Disable IMR; the channel starts normally (R3).
#   6. Enable IMR, restart the replica with semisync enabled and replica start
#      on; the receiver stops with the error (R4). Turn semisync off, start the
#      receiver and replicate a transaction.
#   7. Enable semisync with the receiver running, kill the source's dump
#      thread; the receiver reconnects and stops with the error (R5).
#   8. Cleanup.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.
# CSA (Change Stream Applier): WL#10500.

# CSA requires row-based replication.
--source include/have_binlog_format_row.inc
# The semisync replica plugin must be available (needs the plugin dir set by the
# companion -master.opt / -slave.opt files).
--source include/have_semisync_plugin.inc

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc

# Step 5 starts a semisync-enabled replica against a non-semisync source, which
# logs a benign fallback-to-async warning.
CALL mtr.add_suppression("Plugin semisync reported.*Source server does not support semi-sync.*");

--echo
--echo # 1. Install and enable the replica-side semisync plugin (threads stopped).
--echo

--replace_regex /\.dll/.so/
--eval INSTALL PLUGIN rpl_semi_sync_replica SONAME '$SEMISYNC_REPLICA_PLUGIN'
SET GLOBAL rpl_semi_sync_replica_enabled = 1;

--echo
--echo # 2. Enable IMR on the CSA channel.
--echo

CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;

--echo
--echo # 3. START REPLICA IO_THREAD is rejected (R1).
--echo

--error ER_REPLICA_IN_MEMORY_RELAYLOG_INCOMPATIBLE_CONFIGURATION
START REPLICA IO_THREAD;

--echo
--echo # 4. START REPLICA (both threads) is rejected for the same reason (R2).
--echo

--error ER_REPLICA_IN_MEMORY_RELAYLOG_INCOMPATIBLE_CONFIGURATION
START REPLICA;

--echo
--echo # 5. Disabling IMR clears the incompatibility: the channel starts even
--echo #    with the semisync replica plugin still enabled (R3).
--echo

CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
--source include/rpl/start_replica.inc
--source include/rpl/stop_replica.inc

--echo
--echo # 6. Restart with semisync enabled and the IMR channel auto-starting: the
--echo #    receiver stops before the dump request, the applier runs (R4).
--echo

CALL mtr.add_suppression("The in-memory relay log is incompatible with semi-synchronous replication");
# Step 7 kills the source's dump thread.
CALL mtr.add_suppression("Error reading packet from server for channel .*Lost connection to MySQL server during query");
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;

--let $rpl_server_number= 2
--let $rpl_server_parameters= --skip-replica-start=0 --rpl-semi-sync-replica-enabled=1
--source include/rpl/restart_server.inc
--source include/rpl/connection_replica.inc

--let $slave_io_errno= convert_error(ER_REPLICA_IN_MEMORY_RELAYLOG_INCOMPATIBLE_CONFIGURATION)
--source include/rpl/wait_for_receiver_error.inc

--let $assert_text= Last_IO_Errno is the IMR incompatibility error after restart
--let $assert_cond= [SHOW REPLICA STATUS, Last_IO_Errno, 1] = $slave_io_errno
--source include/assert.inc
--let $assert_text= The applier keeps running after restart
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "Yes"
--source include/assert.inc

SET GLOBAL rpl_semi_sync_replica_enabled = 0;
--source include/rpl/start_receiver.inc
--source include/rpl/connection_source.inc
CREATE TABLE t1 (c1 INT PRIMARY KEY);
INSERT INTO t1 VALUES (1);
--source include/rpl/sync_to_replica.inc
--let $assert_text= The transaction is replicated after semisync is turned off
--let $assert_cond= [SELECT COUNT(*) FROM t1] = 1
--source include/assert.inc

--echo
--echo # 7. Enable semisync with the receiver running and force a reconnect: the
--echo #    receiver stops before the dump request, the applier runs (R5).
--echo

SET GLOBAL rpl_semi_sync_replica_enabled = 1;
--source include/rpl/connection_source.inc
--source include/rpl/stop_dump_threads.inc
--source include/rpl/connection_replica.inc

--source include/rpl/wait_for_receiver_error.inc

--let $assert_text= Last_IO_Errno is the IMR incompatibility error after reconnect
--let $assert_cond= [SHOW REPLICA STATUS, Last_IO_Errno, 1] = $slave_io_errno
--source include/assert.inc
--let $assert_text= The applier keeps running after reconnect
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "Yes"
--source include/assert.inc

--echo
--echo # 8. Cleanup.
--echo

SET GLOBAL rpl_semi_sync_replica_enabled = 0;
--source include/rpl/start_receiver.inc
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc
--source include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;

UNINSTALL PLUGIN rpl_semi_sync_replica;

--source include/rpl/deinit.inc
