# ==== Purpose ====
#
# Test that an in-memory relay log (IMR) CSA channel does not create or write
# relay-log files while it replicates.
#
# An IMR channel keeps its classic relay log open, but the relay-log files
# carry no transaction data. Before the fix, every Rotate from the source (a
# real one at each source binary log rotation, and the fake one at each
# connect) rotated the relay log, and the receiver wrote "Rotate to source
# position" events into it for each source Previous_gtids event and for
# heartbeats that advance the position. The relay-log index and
# Relay_Log_Space then grew without bound.
#
# ==== Requirements ====
#
# R1. Source binary log rotations do not create relay-log files and do not
#     write into the last one.
# R2. Restarting the receiver does not create or write relay-log files.
# R3. A reconnect inside the same receiver thread (the source kills the dump
#     thread) does not create or write relay-log files.
# R4. A heartbeat that advances the source position (the source skips a
#     transaction the replica already has) does not write into the relay log.
# R5. max_relay_log_size never rotates the relay log of an IMR channel.
# R6. When the source changes its checksum algorithm, the relay log is not
#     rotated but gets the source's Format_description event, so every
#     relay-log file verifies with mysqlbinlog --verify-binlog-checksum.
#     Transactions received afterwards carry the source's new
#     Format_description event (checksum OFF). Replica restarts read the
#     relay log without errors or warnings, and the channel replicates
#     correctly.
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with IMR enabled and max_relay_log_size at its
#      minimum (R5 is checked by every snapshot below). Save a snapshot: the
#      relay-log index file count, the last file name and size, and
#      Relay_Log_Space.
#   2. R1: three source FLUSH BINARY LOGS, each followed by a transaction.
#   3. R2: STOP/START REPLICA IO_THREAD.
#   4. R3: KILL the dump thread on the source; the receiver reconnects.
#   5. R4: the replica commits the GTID the source assigns next; after a
#      receiver restart the dump thread skips that transaction and sends a
#      heartbeat.
#      After each of steps 2-5 the snapshot must be unchanged.
#   6. R6: source binlog_checksum = NONE. No new relay-log file, and every
#      relay-log file verifies. The spill file of a large transaction queued
#      with the applier stopped starts with a Format_description event with
#      checksum OFF. Then two clean replica restarts, each followed by START
#      REPLICA and a replicated transaction: no relay-log read warnings, and
#      every relay-log file verifies. Restore the checksum.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.
# CSA (Change Stream Applier): WL#10500.

# CSA requires row-based replication.
--source include/have_binlog_format_row.inc
# Section 6 needs a transaction above the spill threshold; compressed, the
# test payload would not reach it.
--source include/not_binlog_transaction_compression_on.inc

--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--echo
--echo # 1. Set up a CSA channel with IMR enabled and save a snapshot.
--echo

--source include/rpl/connection_replica.inc
CALL mtr.add_suppression("Replica I/O for channel '': .*Lost connection to MySQL server during query.*");
CALL mtr.add_suppression("Replica I/O for channel '': .*error reconnecting to source.*");
CALL mtr.add_suppression("Replica I/O for channel '': .*Error reading packet from server.*");

--let $saved_connect_retry= query_get_value(SELECT CONNECTION_RETRY_INTERVAL AS v FROM performance_schema.replication_connection_configuration WHERE CHANNEL_NAME = '', v, 1)
--let $saved_max_relay_log_size= `SELECT @@GLOBAL.max_relay_log_size`
SET GLOBAL max_relay_log_size = 4096;
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608, SOURCE_CONNECT_RETRY = 1;
# The channel's spill directory: <relay-log dir>/#in_memory_relaylog_temp_files
--let $spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`
--source include/rpl/start_replica.inc

--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY);
CREATE TABLE t2 (id INT PRIMARY KEY, data LONGBLOB);
INSERT INTO t1 VALUES (1);
--source include/rpl/sync_to_replica.inc

--let $rlf_mode= save
--source suite/rpl_gtid/t/rpl_csa_imr_relay_log_files.inc
--let $rlf_mode= assert

--echo
--echo # 2. Source binary log rotations (R1, R5).
--echo

--let $i= 1
while ($i <= 3)
{
  --source include/rpl/connection_source.inc
  FLUSH BINARY LOGS;
  --let $row= `SELECT MAX(id) + 1 FROM t1`
  --eval INSERT INTO t1 VALUES ($row)
  --source include/rpl/sync_to_replica.inc
  --inc $i
}

--let $rlf_what= after source binary log rotations
--source suite/rpl_gtid/t/rpl_csa_imr_relay_log_files.inc

--echo
--echo # 3. Receiver restart (R2).
--echo

--source include/rpl/stop_receiver.inc
--source include/rpl/start_receiver.inc

--source include/rpl/connection_source.inc
--let $row= `SELECT MAX(id) + 1 FROM t1`
--eval INSERT INTO t1 VALUES ($row)
--source include/rpl/sync_to_replica.inc

--let $rlf_what= after a receiver restart
--source suite/rpl_gtid/t/rpl_csa_imr_relay_log_files.inc

--echo
--echo # 4. Reconnect inside the same receiver thread (R3).
--echo

--source include/rpl/connection_source.inc
--let $dump_id= `SELECT ID FROM performance_schema.processlist WHERE COMMAND LIKE 'Binlog Dump%'`
--replace_result $dump_id DUMP_ID
--eval KILL $dump_id
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.processlist WHERE COMMAND LIKE 'Binlog Dump%' AND ID <> $dump_id
--source include/wait_condition.inc

--let $row= `SELECT MAX(id) + 1 FROM t1`
--eval INSERT INTO t1 VALUES ($row)
--source include/rpl/sync_to_replica.inc

--let $rlf_what= after a reconnect
--source suite/rpl_gtid/t/rpl_csa_imr_relay_log_files.inc

--echo
--echo # 5. A heartbeat that advances the source position (R4).
--echo

--source include/rpl/connection_source.inc
--let $row= `SELECT MAX(id) + 1 FROM t1`

# The GTID uses a UUID that is not the source's: a replica that has more
# GTIDs of the source's own UUID than the source is refused at connect.
--let $skipped_gtid= 11111111-1111-1111-1111-111111111111:1

--echo # The replica commits the transaction the source commits next, with the
--echo # same GTID.
--source include/rpl/connection_replica.inc
--eval SET GTID_NEXT = '$skipped_gtid'
--eval INSERT INTO t1 VALUES ($row)
SET GTID_NEXT = AUTOMATIC;

--echo # Reconnect, so that the dump thread excludes that GTID.
--source include/rpl/stop_receiver.inc
--source include/rpl/start_receiver.inc

--echo # The dump thread skips the first transaction and sends a heartbeat
--echo # before the second.
--source include/rpl/connection_source.inc
--eval SET GTID_NEXT = '$skipped_gtid'
--eval INSERT INTO t1 VALUES ($row)
SET GTID_NEXT = AUTOMATIC;
--inc $row
--eval INSERT INTO t1 VALUES ($row)
--source include/rpl/sync_to_replica.inc

--let $rlf_what= after a heartbeat that advances the source position
--source suite/rpl_gtid/t/rpl_csa_imr_relay_log_files.inc

--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc

--echo
--echo # 6. Source checksum change and replica restarts (R6).
--echo

--source include/rpl/connection_source.inc
--let $saved_binlog_checksum= `SELECT @@GLOBAL.binlog_checksum`
SET GLOBAL binlog_checksum = NONE;
--let $row= `SELECT MAX(id) + 1 FROM t1`
--eval INSERT INTO t1 VALUES ($row)
--source include/rpl/sync_to_replica.inc

--echo # The relay log is not rotated, and every relay-log file verifies.
--let $rlf_mode= verify
--let $rlf_what= after the source checksum change
--source suite/rpl_gtid/t/rpl_csa_imr_relay_log_files.inc
--let $assert_text= The source checksum change created no relay-log file
--let $assert_cond= $rlf_count = $rlf_saved_count AND "$relay_log_file" = "$rlf_saved_file"
--source include/assert.inc

--echo # A transaction received after the change carries the source's new
--echo # Format_description event: its spill file starts with it.
--source include/rpl/stop_applier.inc
--source include/rpl/connection_source.inc
--let $gtids_before= `SELECT @@GLOBAL.gtid_executed`
--disable_query_log
INSERT INTO t2 VALUES (1, REPEAT('x', 9437184));
--enable_query_log
--let $gtids_after= `SELECT @@GLOBAL.gtid_executed`
--source include/rpl/connection_replica.inc
# Wait for the new transaction only: the source's own GTID set also holds
# the transaction the dump thread skipped in section 5, which the replica
# never received.
--let $wait_condition= SELECT GTID_SUBSET(GTID_SUBTRACT('$gtids_after', '$gtids_before'), RECEIVED_TRANSACTION_SET) FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME = ''
--source include/wait_condition.inc
--let $fde_file= $spill_dir/imr_sp_*
--source suite/rpl_gtid/t/rpl_csa_imr_fde_checksum_alg.inc
--let $assert_text= The spill file's Format_description event has checksum OFF
--let $assert_cond= "$fde_checksum_alg" = "OFF"
--source include/assert.inc
--source include/rpl/start_applier.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc
--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len, CRC32(data) AS crc FROM t2 ORDER BY id
--source include/rpl/diff.inc

# Two restarts. Each opens a relay-log file with the replica's own checksum
# algorithm; at START the source's Format_description event is written to
# it. At the second restart that file is closed with a Stop event.
--let $restart= 1
while ($restart <= 2)
{
  --let $rpl_server_number= 2
  --source include/rpl/restart_server.inc
  --source include/rpl/connection_replica.inc

  --let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
  --let $assert_text= The replica initialized the channel's relay log
  --let $assert_select= MY-010606
  --let $assert_count= 0
  --source include/assert_grep.inc

  --let $assert_text= The replica read its relay log at startup without warnings
  --let $assert_select= MY-010818|MY-010820
  --let $assert_count= 0
  --source include/assert_grep.inc

  --source include/rpl/start_replica.inc

  --source include/rpl/connection_source.inc
  --let $row= `SELECT MAX(id) + 1 FROM t1`
  --eval INSERT INTO t1 VALUES ($row)
  --source include/rpl/sync_to_replica.inc

  --let $diff_tables= master:test.t1, slave:test.t1
  --source include/diff_tables.inc

  --let $rlf_mode= verify
  --let $rlf_what= after restart $restart
  --source suite/rpl_gtid/t/rpl_csa_imr_relay_log_files.inc
  --inc $restart
}

--source include/rpl/connection_source.inc
--eval SET GLOBAL binlog_checksum = $saved_binlog_checksum
--let $row= `SELECT MAX(id) + 1 FROM t1`
--eval INSERT INTO t1 VALUES ($row)
--source include/rpl/sync_to_replica.inc

--let $diff_tables= master:test.t1, slave:test.t1
--source include/diff_tables.inc

# Cleanup.
--source include/rpl/connection_source.inc
DROP TABLE t1, t2;
--source include/rpl/sync_to_replica.inc

--source include/rpl/connection_replica.inc
--source include/rpl/stop_replica.inc
--eval SET GLOBAL max_relay_log_size = $saved_max_relay_log_size
--replace_result $saved_connect_retry SAVED_CONNECT_RETRY
--eval CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF, SOURCE_CONNECT_RETRY = $saved_connect_retry
--source include/rpl/start_replica.inc

--source include/rpl/deinit.inc
