# ==== Purpose ====
#
# On a CSA (Change Stream Applier) channel with the in-memory relay log (IMR)
# enabled, spill files go to the spill directory under the relay_log_basename
# directory, which the server creates at startup. The directory of the
# channel's saved relay log position is not used: after a restart that moves
# --relay-log but keeps the relay log index, that position can still name a
# file in the old directory, which may have no spill directory.
#
# ==== Requirements ====
#
# R1. After a restart that moves --relay-log to a new directory and keeps the
#     relay log index, a spill-path transaction is written to the spill
#     directory under the new relay_log_basename directory, and none under the
#     directory of the saved relay log position.
# R2. The receiver keeps running when the old directory has no spill
#     directory, and the transaction is applied.
#
# ==== Implementation ====
#
# 1. Move the replica's relay log to OLD, with an absolute relay log index in
#    OLD.
# 2. Restart with --relay-log in NEW, the index kept in OLD and
#    relay_log_purge = OFF, so the saved position stays in OLD. Remove OLD's
#    spill directory while the server is down.
# 3. With the applier stopped, replicate a 12 MiB transaction: the receiver
#    keeps running and the spill file is in NEW's spill directory only (R1, R2).
# 4. Start the applier: the data matches and no spill file is left (R2).
# 5. Clean up: restore the default relay log options.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.

# CSA is row-based only.
--source include/have_binlog_format_row.inc
--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
--let $source_uuid= `SELECT @@GLOBAL.server_uuid`

--let $old_dir= $MYSQL_TMP_DIR/imr_relay_log_old
--let $new_dir= $MYSQL_TMP_DIR/imr_relay_log_new
--mkdir $old_dir
--mkdir $new_dir
--let OLD_SPILL_DIR= $old_dir/#in_memory_relaylog_temp_files
--let NEW_SPILL_DIR= $new_dir/#in_memory_relaylog_temp_files
--let $rpl_server_number= 2
--let $rpl_omit_print_server_parameters= 1

--echo
--echo # 1. Move the relay log to OLD, with an absolute relay log index in OLD.
--echo
--let $rpl_server_parameters= --relay-log=$old_dir/relay-bin --relay-log-index=$old_dir/relay-bin.index
--source include/rpl/restart_server.inc
--source include/rpl/connection_replica.inc
--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc
--source include/rpl/stop_replica.inc

--echo
--echo # 2. Restart with --relay-log in NEW, the index kept in OLD and
--echo #    relay_log_purge = OFF. Remove OLD's spill directory while the server
--echo #    is down.
--echo
--let $rpl_server_parameters= --relay-log=$new_dir/relay-bin --relay-log-index=$old_dir/relay-bin.index --relay-log-purge=0
--source include/rpl/stop_server.inc
--force-rmdir $OLD_SPILL_DIR
--source include/rpl/start_server.inc
--source include/rpl/connection_replica.inc
--echo The saved relay log position is in OLD, relay_log_basename is in NEW:
--replace_result $old_dir OLD $new_dir NEW
SELECT @@GLOBAL.relay_log_basename AS relay_log_basename, Relay_log_name
  FROM mysql.slave_relay_log_info;

--echo
--echo # 3. With the applier stopped, replicate a 12 MiB transaction. The
--echo #    receiver keeps running and the spill file is in NEW only.
--echo
--source include/rpl/start_receiver.inc
--source include/rpl/connection_source.inc
BEGIN;
--disable_query_log
--let $i= 1
while ($i <= 12)
{
  --eval INSERT INTO t1 VALUES ($i, REPEAT('x', 1048576))
  --inc $i
}
--enable_query_log
COMMIT;
--source include/rpl/connection_replica.inc
# The restart cleared the volatile Retrieved_Gtid_Set, so it holds only the
# 12 MiB transaction once it is fully received.
--let $slave_param= Retrieved_Gtid_Set
--let $slave_param_value= $source_uuid:2
--source include/rpl/wait_for_replica_status.inc
--let $assert_text= R2: the receiver is still running
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "Yes"
--source include/assert.inc
--perl
my @old = glob("$ENV{OLD_SPILL_DIR}/imr_sp_*");
my @new = glob("$ENV{NEW_SPILL_DIR}/imr_sp_*");
print "OLD spill directory exists: ", (-d $ENV{OLD_SPILL_DIR} ? 1 : 0), "\n";
print "Spill files in OLD: ", scalar(@old), "\n";
print "Spill files in NEW: ", scalar(@new), "\n";
EOF

--echo
--echo # 4. Start the applier: the data matches and no spill file is left.
--echo
--source include/rpl/start_applier.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc
--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len FROM t1 ORDER BY id
--source include/rpl/diff.inc
--source include/rpl/connection_replica.inc
--let $spill_dir_to_check= $NEW_SPILL_DIR
--source include/rpl/wait_for_no_imr_spill_files.inc

--echo
--echo # 5. Clean up: restore the default relay log options.
--echo
--source include/rpl/stop_replica.inc
--let $rpl_server_parameters=
--source include/rpl/restart_server.inc
--source include/rpl/connection_replica.inc
RESET REPLICA;
--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc
--force-rmdir $old_dir
--force-rmdir $new_dir
--source include/rpl/deinit.inc
