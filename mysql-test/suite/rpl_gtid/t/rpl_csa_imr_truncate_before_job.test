# ==== Purpose ====
#
# Verify that an in-memory relay log (IMR) CSA channel survives a receiver
# truncation that lands after the coordinator dispatched a transaction and
# before it built the transaction's job.
#
# The coordinator checks that a transaction is live (not committed, not
# truncated) in sweep_and_dispatch() under the queue lock, and builds the
# Job_applier after it released the lock. The receiver can truncate the
# transaction in between (here: a reconnect, whose fake Rotate truncates the
# open group). Before the fix, the job constructor's reset_fetching() cleared
# the truncation flag, so the job looked live:
#   - if the replica had not executed the GTID, the worker applied the partial
#     transaction, then waited forever for events that never came, holding the
#     GTID, so the resent copy was never applied and STOP REPLICA SQL_THREAD
#     hung;
#   - if the replica had already executed the GTID, the worker skipped the
#     transaction and its commit hook, no longer seeing the truncation, called
#     commit() on an envelope the sweep had already freed.
# Truncation is now sticky (a consumer reset keeps it), and the coordinator
# drops a job whose transaction is truncated before any worker sees it.
#
# ==== Requirements ====
#
# R1. If the replica has not executed the GTID, the resent copy is applied in
#     full: no GTID is owned, no worker is left applying, no lock is left on
#     the table, Last_SQL_Errno is 0, and STOP REPLICA SQL_THREAD returns.
# R2. If the replica already executed the GTID, no worker is left applying,
#     the following transactions and the final DROP TABLE replicate, and the
#     truncated transaction's rows are not applied.
# R3. R1 and R2 hold for the memory path (transaction <= spill threshold).
# R4. R1 and R2 hold for the spill path (transaction > spill threshold), and no
#     spill file is left behind.
#
# ==== Implementation ====
#
#   1. Set up a CSA channel with IMR enabled, the minimum 8 MiB spill
#      threshold, and SOURCE_CONNECT_RETRY = 1.
#   2. Memory path, GTID not executed (R1, R3).
#   3. Memory path, GTID already executed (R2, R3).
#   4. Spill path, GTID not executed (R1, R4).
#   5. Spill path, GTID already executed (R2, R4).
#   6. Cleanup.
#
# Each step runs rpl_csa_imr_truncate_before_job.inc: it pauses the receiver
# after the GTID event and the coordinator at imr_pause_before_job_build,
# makes the receiver reconnect, waits until the fake Rotate truncated the
# transaction, and then lets the coordinator build the job.
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.
# CSA is row-based only.
--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/have_binlog_format_row.inc
# Compressed, a transaction is a single payload event: there is no window in
# the middle of its stream, and the test payload would not reach the spill
# threshold.
--source include/not_binlog_transaction_compression_on.inc
--echo
--echo # 1. Set up a CSA channel with IMR enabled.
--echo
--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc
--source include/rpl/connection_source.inc
--let $source_uuid= `SELECT @@GLOBAL.server_uuid`
--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608,
  SOURCE_CONNECT_RETRY = 1;
--let $spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`
--source include/rpl/start_replica.inc
--source include/rpl/connection_source.inc
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
--source include/rpl/sync_to_replica.inc
--echo
--echo # 2. Memory path, GTID not executed on the replica (R1, R3).
--echo
--let $f6_case= A
--let $first_id= 1
--let $row_count= 3
--let $row_size= 10
--source suite/rpl_gtid/t/rpl_csa_imr_truncate_before_job.inc
--echo
--echo # 3. Memory path, GTID already executed on the replica (R2, R3).
--echo
--let $f6_case= B
--let $first_id= 10
--let $row_count= 3
--let $row_size= 10
--source suite/rpl_gtid/t/rpl_csa_imr_truncate_before_job.inc
--echo
--echo # 4. Spill path, GTID not executed on the replica (R1, R4).
--echo
--let $f6_case= A
--let $first_id= 100
--let $row_count= 12
--let $row_size= 1048576
--source suite/rpl_gtid/t/rpl_csa_imr_truncate_before_job.inc
--echo
--echo # 5. Spill path, GTID already executed on the replica (R2, R4).
--echo
--let $f6_case= B
--let $first_id= 200
--let $row_count= 12
--let $row_size= 1048576
--source suite/rpl_gtid/t/rpl_csa_imr_truncate_before_job.inc
--let $spill_dir_to_check= $spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc
--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len FROM t1 ORDER BY id
--source include/rpl/diff.inc
--echo
--echo # 6. Cleanup.
--echo
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc
--source include/rpl/deinit.inc
