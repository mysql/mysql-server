# ==== Purpose ====
#
# START REPLICA UNTIL SQL_BEFORE_GTIDS / SQL_AFTER_GTIDS on a CSA (Change
# Stream Applier) channel with the in-memory relay log (IMR) enabled: the
# applier stops at the UNTIL point, a transaction it declines stays queued,
# and the next START applies it first.
#
# ==== Requirements ====
#
# R1. SQL_BEFORE_GTIDS stops the applier before the first target transaction,
#     on the memory path and on the spill path.
# R2. SQL_AFTER_GTIDS stops the applier after the target, holding back the
#     next queued transaction.
# R3. SQL_AFTER_GTIDS stops the applier when the queue is empty and the
#     target is executed.
# R4. The stop is clean (no SQL error, receiver keeps running), it is logged
#     once in the error log, and the queue keeps the transactions after the
#     UNTIL point.
# R5. A plain START after the UNTIL stops applies everything; the replica
#     matches the source and no spill file is left.
#
# ==== Implementation ====
#
#   0. Set up CSA with IMR (8 MiB spill threshold), create t1, stop the
#      applier and queue five small transactions (S:2-S:6).
#   A. UNTIL SQL_BEFORE_GTIDS = S:4: S:1-3 applied, S:4-6 queued (R1, R4).
#   B. UNTIL SQL_AFTER_GTIDS = S:5: S:4-5 applied, S:6 held back (R2, R4).
#   C. UNTIL SQL_AFTER_GTIDS = S:6: empty-queue stop, nothing else applied
#      (R3, R4).
#   D. Queue a >8 MiB spilled transaction (S:7) and a small one (S:8);
#      UNTIL SQL_BEFORE_GTIDS = S:7 declines the spilled transaction, which
#      keeps its spill file (R1, R4).
#   E. Plain START: all applied, data matches, no spill file left (R5).
#
# ==== References ====
#
# In-memory relay log for the Change Stream Applier (feature 684).
# See design/replication/684-in-memory-relaylog.
# CSA (Change Stream Applier): WL#10500.

# CSA is row-based only.
--source include/have_binlog_format_row.inc
# A compressed 12 MiB payload of repeated bytes would stay under the 8 MiB
# spill threshold.
--source include/not_binlog_transaction_compression_on.inc
--let $rpl_skip_start_slave= 1
--let $rpl_applier_version= 2:2
--let $rpl_applier_worker_count= 2:4
--source include/rpl/init_source_replica.inc

--source include/rpl/connection_replica.inc
CHANGE REPLICATION SOURCE TO
  IN_MEMORY_RELAYLOG_ENABLED = ON,
  IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
--let $spill_dir= `SELECT CONCAT(LEFT(@@GLOBAL.relay_log_basename, LENGTH(@@GLOBAL.relay_log_basename) - LOCATE('/', REVERSE(@@GLOBAL.relay_log_basename))), '/#in_memory_relaylog_temp_files')`
--source include/rpl/start_replica.inc

--echo
--echo # 0. Create t1, stop the applier and queue S:2-S:6.
--echo
--source include/rpl/connection_source.inc
--let $source_uuid= query_get_value(SELECT @@SERVER_UUID AS u, u, 1)
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
--source include/rpl/sync_to_replica.inc
--source include/rpl/stop_applier.inc

--source include/rpl/connection_source.inc
INSERT INTO t1 VALUES (2, 'a');
INSERT INTO t1 VALUES (3, 'b');
INSERT INTO t1 VALUES (4, 'c');
INSERT INTO t1 VALUES (5, 'd');
INSERT INTO t1 VALUES (6, 'e');
--source include/rpl/sync_to_replica_received.inc

--echo
--echo # A. SQL_BEFORE_GTIDS on a memory-path target.
--echo
--source include/rpl/connection_replica.inc
--replace_result $source_uuid SOURCE_UUID
--eval START REPLICA SQL_THREAD UNTIL SQL_BEFORE_GTIDS = '$source_uuid:4'
--let $g_in= $source_uuid:1-3
--let $g_out= $source_uuid:4
--let $msg= SQL_BEFORE_GTIDS $source_uuid:4
--source include/rpl/wait_for_applier_to_stop.inc
--let $assert_text= A: applier stopped without error, receiver running
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "No" AND "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "Yes" AND [SHOW REPLICA STATUS, Last_SQL_Errno, 1] = 0
--source include/assert.inc
--let $assert_text= A: transactions up to the UNTIL point applied
--let $assert_cond= GTID_SUBSET("$g_in", @@GLOBAL.gtid_executed) = 1
--source include/assert.inc
--let $assert_text= A: transaction after the UNTIL point not applied
--let $assert_cond= GTID_SUBSET("$g_out", @@GLOBAL.gtid_executed) = 0
--source include/assert.inc
--let $slave_param= In_Memory_Queue_Length
--let $slave_param_value= 3
--source include/rpl/wait_for_replica_status.inc
--let $assert_text= A: one UNTIL stop message in the error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: rpl_gtid.rpl_csa_imr_until_gtids
--let $assert_select= Replica SQL thread stopped because it reached UNTIL $msg
--let $assert_count= 1
--source include/assert_grep.inc
--let $assert_text= A: two rows applied
--let $assert_cond= [SELECT COUNT(*) FROM t1] = 2
--source include/assert.inc

--echo
--echo # B. SQL_AFTER_GTIDS with the next transaction held back.
--echo
--replace_result $source_uuid SOURCE_UUID
--eval START REPLICA SQL_THREAD UNTIL SQL_AFTER_GTIDS = '$source_uuid:5'
--let $g_in= $source_uuid:1-5
--let $g_out= $source_uuid:6
--let $msg= SQL_AFTER_GTIDS $source_uuid:5
--source include/rpl/wait_for_applier_to_stop.inc
--let $assert_text= B: applier stopped without error, receiver running
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "No" AND "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "Yes" AND [SHOW REPLICA STATUS, Last_SQL_Errno, 1] = 0
--source include/assert.inc
--let $assert_text= B: transactions up to the UNTIL point applied
--let $assert_cond= GTID_SUBSET("$g_in", @@GLOBAL.gtid_executed) = 1
--source include/assert.inc
--let $assert_text= B: transaction after the UNTIL point not applied
--let $assert_cond= GTID_SUBSET("$g_out", @@GLOBAL.gtid_executed) = 0
--source include/assert.inc
--let $slave_param= In_Memory_Queue_Length
--let $slave_param_value= 1
--source include/rpl/wait_for_replica_status.inc
--let $assert_text= B: one UNTIL stop message in the error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: rpl_gtid.rpl_csa_imr_until_gtids
--let $assert_select= Replica SQL thread stopped because it reached UNTIL $msg
--let $assert_count= 1
--source include/assert_grep.inc

--echo
--echo # C. SQL_AFTER_GTIDS with nothing after it (empty-queue check).
--echo
--replace_result $source_uuid SOURCE_UUID
--eval START REPLICA SQL_THREAD UNTIL SQL_AFTER_GTIDS = '$source_uuid:6'
--let $g_in= $source_uuid:1-6
--let $msg= SQL_AFTER_GTIDS $source_uuid:6
--source include/rpl/wait_for_applier_to_stop.inc
--let $assert_text= C: applier stopped without error, receiver running
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "No" AND "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "Yes" AND [SHOW REPLICA STATUS, Last_SQL_Errno, 1] = 0
--source include/assert.inc
--let $assert_text= C: transactions up to the UNTIL point applied
--let $assert_cond= GTID_SUBSET("$g_in", @@GLOBAL.gtid_executed) = 1
--source include/assert.inc
--let $assert_text= C: nothing applied beyond the target
--let $assert_cond= GTID_SUBSET(@@GLOBAL.gtid_executed, "$source_uuid:1-6") = 1
--source include/assert.inc
--let $slave_param= In_Memory_Queue_Length
--let $slave_param_value= 0
--source include/rpl/wait_for_replica_status.inc
--let $assert_text= C: one UNTIL stop message in the error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: rpl_gtid.rpl_csa_imr_until_gtids
--let $assert_select= Replica SQL thread stopped because it reached UNTIL $msg
--let $assert_count= 1
--source include/assert_grep.inc

--echo
--echo # D. SQL_BEFORE_GTIDS on a >8 MiB spilled target.
--echo
--source include/rpl/connection_source.inc
BEGIN;
--disable_query_log
--let $i= 11
while ($i <= 22)
{
  --eval INSERT INTO t1 VALUES ($i, REPEAT('x', 1048576))
  --inc $i
}
--enable_query_log
COMMIT;
INSERT INTO t1 VALUES (100, 'small');
--source include/rpl/sync_to_replica_received.inc

--source include/rpl/connection_replica.inc
--replace_regex /imr_sp_[0-9a-f]+/imr_sp_<ID>/
--list_files $spill_dir imr_sp_*
--replace_result $source_uuid SOURCE_UUID
--eval START REPLICA SQL_THREAD UNTIL SQL_BEFORE_GTIDS = '$source_uuid:7'
--let $g_in= $source_uuid:1-6
--let $g_out= $source_uuid:7
--let $msg= SQL_BEFORE_GTIDS $source_uuid:7
--source include/rpl/wait_for_applier_to_stop.inc
--let $assert_text= D: applier stopped without error, receiver running
--let $assert_cond= "[SHOW REPLICA STATUS, Replica_SQL_Running, 1]" = "No" AND "[SHOW REPLICA STATUS, Replica_IO_Running, 1]" = "Yes" AND [SHOW REPLICA STATUS, Last_SQL_Errno, 1] = 0
--source include/assert.inc
--let $assert_text= D: transactions up to the UNTIL point applied
--let $assert_cond= GTID_SUBSET("$g_in", @@GLOBAL.gtid_executed) = 1
--source include/assert.inc
--let $assert_text= D: transaction after the UNTIL point not applied
--let $assert_cond= GTID_SUBSET("$g_out", @@GLOBAL.gtid_executed) = 0
--source include/assert.inc
--let $slave_param= In_Memory_Queue_Length
--let $slave_param_value= 2
--source include/rpl/wait_for_replica_status.inc
--let $assert_text= D: one UNTIL stop message in the error log
--let $assert_file= $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_only_after= CURRENT_TEST: rpl_gtid.rpl_csa_imr_until_gtids
--let $assert_select= Replica SQL thread stopped because it reached UNTIL $msg
--let $assert_count= 1
--source include/assert_grep.inc
--echo # The declined transaction keeps its spill file.
--replace_regex /imr_sp_[0-9a-f]+/imr_sp_<ID>/
--list_files $spill_dir imr_sp_*

--echo
--echo # E. Plain START applies everything.
--echo
--source include/rpl/start_applier.inc
--source include/rpl/connection_source.inc
--source include/rpl/sync_to_replica.inc
--let $rpl_diff_statement= SELECT id, LENGTH(data) AS len FROM t1 ORDER BY id
--source include/rpl/diff.inc
--source include/rpl/connection_replica.inc
--let $spill_dir_to_check= $spill_dir
--source include/rpl/wait_for_no_imr_spill_files.inc

--echo
--echo # Cleanup.
--echo
--source include/rpl/connection_source.inc
DROP TABLE t1;
--source include/rpl/sync_to_replica.inc
--source include/rpl/deinit.inc
