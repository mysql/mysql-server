include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. Enable IMR with an 8 MiB spill threshold, then restart the replica
#    with a 5 MiB relay_log_space_limit (read-only startup variable). On
#    restart the channel reconciles and its queue captures the 5 MiB soft
#    spill disk bound.

[connection slave]
CHANGE REPLICATION SOURCE TO
IN_MEMORY_RELAYLOG_ENABLED = ON,
IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
include/rpl/restart_server.inc [server_number=2 parameters: --relay_log_space_limit=5242880]
[connection slave]
INSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, data LONGBLOB);
include/rpl/sync_to_replica.inc

# 2. Pause the applier and send 5 x ~10 MiB transactions. Each is above
#    the 8 MiB spill threshold (so it spills) and above the 5 MiB disk
#    limit (so it is "oversized"). The first is admitted even though it
#    alone exceeds the limit (soft bound, no deadlock); usage then sits
#    over the limit and the receiver blocks, so fewer than 5 are queued.

[connection slave]
include/rpl/stop_applier.inc
[connection master]
[connection slave]
include/assert.inc [An oversized spill transaction is admitted (SPILL_FILE_COUNT >= 1) but back-pressure blocks the rest (< 5)]
[connection slave1]
SET GLOBAL max_relay_log_size = 8192;
[connection slave]
[connection slave1]
[connection slave]

# 3. Resume the applier: it drains committed spill files below the limit,
#    the receiver unblocks, and all transactions apply (forward progress).
#    The live spill gauges return to 0.

include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/assert.inc [All 5 transactions applied on the replica (forward progress past the soft limit)]
include/assert.inc [SPILL_BYTES_USED returns to 0 once the queue drains]

# 4. Stop the applier, fill the spill disk limit, STOP the receiver while
#    it waits (R6), restart and sync.

include/rpl/stop_applier.inc
[connection master]
[connection slave]
include/rpl/stop_receiver.inc
include/assert.inc [A stop in admission reports no IO error (Last_IO_Errno = 0)]
include/assert_grep.inc [A stop in admission logs no relay log write failure]
include/assert_grep.inc [A stop in admission logs one INFORMATION line]
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc

# 5. Cleanup.

[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
[connection slave]
UNINSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/deinit.inc
