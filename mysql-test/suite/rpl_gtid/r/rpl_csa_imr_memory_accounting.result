include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. Enable IMR at a 32 MiB limit with an 8 MiB spill threshold and start.

[connection slave]
CHANGE REPLICATION SOURCE TO
IN_MEMORY_RELAYLOG_ENABLED = ON,
IN_MEMORY_RELAYLOG_LIMIT = 33554432,
IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
CALL mtr.add_suppression("Replica SQL thread .* killed");
CALL mtr.add_suppression("Worker .* stopped");
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, data LONGBLOB);
include/rpl/sync_to_replica.inc

# 2. Raise the limit to 64 MiB and restart. With the applier paused, ~70 MiB
#    of ~1 MiB transactions fill the queue past the old 32 MiB limit and the
#    receiver parks at the new one.

[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_LIMIT = 67108864;
include/rpl/start_replica.inc
include/assert.inc [The channel's configured IN_MEMORY_RELAYLOG_LIMIT is now 64 MiB]
include/rpl/stop_applier.inc
[connection master]
[connection slave]
include/assert.inc [In_Memory_Relay_Log_Space is above the old 32 MiB limit and within the new 64 MiB limit]
include/assert.inc [Back-pressure at the new limit kept fewer than the whole workload queued]
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/wait_for_replica_status.inc [In_Memory_Relay_Log_Space]

# 3. STOP REPLICA SQL_THREAD with the receiver running. A worker parks in
#    the middle of one transaction and more transactions are queued behind
#    it. Stopping the applier must leave every reservation in place.

[connection slave]
# Adding debug point 'pause_csa_before_releasing_event_memory' to @@GLOBAL.debug
[connection master]
INSERT INTO t1 (data) VALUES (REPEAT('p', 4000));
[connection slave]
SET DEBUG_SYNC= 'now WAIT_FOR paused_csa_before_releasing_event_memory TIMEOUT 30';
include/assert.inc [Outstanding reservations are held while the worker is parked mid-transaction]
[connection slave1]
STOP REPLICA SQL_THREAD;
[connection slave]
# Removing debug point 'pause_csa_before_releasing_event_memory' from @@GLOBAL.debug
SET DEBUG_SYNC= 'now SIGNAL signal_continue_csa_releasing_event_memory';
[connection slave1]
[connection slave]
SET DEBUG_SYNC= 'RESET';
include/rpl/assert_replica_no_error.inc
include/assert.inc [None of the interrupted or queued transactions was applied while the applier was stopped]
include/assert.inc [In_Memory_Relay_Log_Space is unchanged across STOP REPLICA SQL_THREAD]
include/assert.inc [The receiver kept running across the applier stop]

# 4. START REPLICA SQL_THREAD applies everything and the usage drains to 0.

include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/assert.inc [All transactions were applied on the replica]
include/rpl/wait_for_replica_status.inc [In_Memory_Relay_Log_Space]
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
