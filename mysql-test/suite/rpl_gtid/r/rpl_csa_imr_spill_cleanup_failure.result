include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. A CSA channel with the in-memory relay log replicates a table.

[connection slave]
CALL mtr.add_suppression("Failed to delete file .*imr_sp_stale");
CALL mtr.add_suppression("\\[In-memory relay log\\] stale spill files could not be removed at startup");
CALL mtr.add_suppression("Failed to start replica threads for channel");
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (a INT PRIMARY KEY);
INSERT INTO t1 VALUES (1);
include/rpl/sync_to_replica.inc

# 2. Plant a stale spill file, as a crash would leave it.

include/rpl/stop_replica.inc

# 3. Restart with replica start enabled and every purge delete failing.

include/rpl/restart_server.inc [server_number=2 parameters: --skip-replica-start=0 --debug=+d,imr_force_spill_purge_delete_failure]
[connection slave]
include/assert_grep.inc [The undeletable stale spill file is logged as ER_BINLOG_CANT_DELETE_FILE]
include/assert_grep.inc [The purge failure summary is logged]
# The stale file is still on disk (R1).
include/assert_grep.inc [The startup start of the channel is refused (R2)]
include/assert.inc [Both replication threads are stopped after the restart (R2)]

# 4. Every START form is refused (R3).

START REPLICA;
ERROR HY000: The in-memory relay log cannot be used on channel '': stale spill files could not be deleted at server startup. Check the error log.
START REPLICA IO_THREAD;
ERROR HY000: The in-memory relay log cannot be used on channel '': stale spill files could not be deleted at server startup. Check the error log.
START REPLICA SQL_THREAD;
ERROR HY000: The in-memory relay log cannot be used on channel '': stale spill files could not be deleted at server startup. Check the error log.
include/assert.inc [Both replication threads are still stopped]

# 5. Without the in-memory relay log the channel replicates. Enabling it
#    again is refused again (R4).

CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
include/rpl/start_replica.inc
[connection master]
INSERT INTO t1 VALUES (2);
include/rpl/sync_to_replica.inc
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
START REPLICA;
ERROR HY000: The in-memory relay log cannot be used on channel '': stale spill files could not be deleted at server startup. Check the error log.

# 6. After a restart in which the purge succeeds, the channel starts with
#    the in-memory relay log and replicates (R5).

include/rpl/restart_server.inc [server_number=2]
[connection slave]
# The purge removed the stale file.
include/rpl/start_replica.inc
[connection master]
INSERT INTO t1 VALUES (3);
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
