include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. A CSA channel with the in-memory relay log and an 8 MiB spill
#    threshold.

[connection slave]
CALL mtr.add_suppression("\\[In-memory relay log\\] could not delete spill file");
CALL mtr.add_suppression("Relay log read failure: could not delete an in-memory relay log spill file");
CHANGE REPLICATION SOURCE TO
IN_MEMORY_RELAYLOG_ENABLED = ON,
IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
INSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
include/rpl/sync_to_replica.inc

# 2. Block the applier with a table lock and send one spill transaction.

LOCK TABLES t1 WRITE;
[connection master]
BEGIN;
COMMIT;
include/rpl/sync_to_replica_received.inc
[connection slave]
# The received transaction has one spill file.
imr_sp_<ID>

# 3. Make the spill directory read-only and release the lock.

UNLOCK TABLES;
[connection slave]
include/rpl/wait_for_applier_error.inc [errno=13121]
include/assert.inc [Last_SQL_Error names the failed spill file delete]
include/assert.inc [The receiver keeps running]
include/assert_grep.inc [The failed delete is logged with the file and the error]
include/assert.inc [The spill transaction is applied]
include/assert.inc [SPILL_FILE_COUNT reads 0]
include/assert.inc [SPILL_BYTES_USED reads 0]
# The file that could not be deleted is still on disk.
imr_sp_<ID>

# 4. START REPLICA SQL_THREAD starts the applier again (R5).

include/rpl/start_applier.inc
[connection master]
INSERT INTO t1 VALUES (100, 'small');
include/rpl/sync_to_replica.inc
include/rpl/diff.inc

# 5. A server restart purges the leftover orphan spill file through the
#    startup cleanup (FR28); the already-applied rows survive (R6).

[connection slave]
include/rpl/stop_replica.inc
include/rpl/restart_server.inc [server_number=2]
[connection slave]
# The orphan spill file is gone after the startup cleanup.
include/assert.inc [The applied rows survived the restart]
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 16777216;
UNINSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/start_replica.inc
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
