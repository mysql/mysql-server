include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY);
include/rpl/sync_to_replica.inc
CALL mtr.add_suppression("Change Stream Applier channel stopped because of error");
CALL mtr.add_suppression("The replica coordinator and worker threads are stopped");
CALL mtr.add_suppression("Worker .* failed executing transaction");
CALL mtr.add_suppression("Error 'Lock wait timeout exceeded");
CALL mtr.add_suppression("Replica worker has stopped after at least one previous worker encountered an error");
SET @saved_debug = @@GLOBAL.debug;
SET @saved_innodb_lock_wait_timeout = @@GLOBAL.innodb_lock_wait_timeout;
SET @saved_replica_transaction_retries = @@GLOBAL.replica_transaction_retries;
#
# Scenario 1: the owner marks the failure before the helper registers.
#
[connection slave]
include/rpl/stop_applier.inc
CHANGE REPLICATION SOURCE TO APPLIER_WORKER_COUNT = 4;
SET GLOBAL innodb_lock_wait_timeout = 30;
SET GLOBAL replica_transaction_retries = 0;
include/rpl/start_applier.inc
SET GLOBAL debug = '+d,csa_helper_before_register,csa_owner_after_cleanup';
BEGIN;
INSERT INTO t1 VALUES (10);
[connection master]
INSERT INTO t1 VALUES (10);
INSERT INTO t1 VALUES (10 + 1);
INSERT INTO t1 VALUES (10 + 2);
INSERT INTO t1 VALUES (10 + 3);
INSERT INTO t1 VALUES (10 + 4);
[connection slave]
SET GLOBAL debug = '-d,csa_helper_before_register';
SELECT "server alive with the owner paused" AS status;
status
server alive with the owner paused
include/assert.inc [No source GTID is applied while the owner is paused]
include/assert.inc [No row of the later transactions is applied]
SET GLOBAL debug = '-d,csa_owner_after_cleanup';
include/rpl/wait_for_applier_error.inc [errno=1205]
include/assert.inc [The channel keeps the original error]
ROLLBACK;
[connection slave]
SET GLOBAL debug = @saved_debug;
SET GLOBAL innodb_lock_wait_timeout = @saved_innodb_lock_wait_timeout;
SET GLOBAL replica_transaction_retries = @saved_replica_transaction_retries;
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc
FLUSH TABLES;
include/diff_tables.inc [master:t1, slave:t1]
#
# Scenario 2: the helper sees the job done before the owner's cleanup.
#
[connection slave]
include/rpl/stop_applier.inc
CHANGE REPLICATION SOURCE TO APPLIER_WORKER_COUNT = 2;
SET GLOBAL innodb_lock_wait_timeout = 30;
SET GLOBAL replica_transaction_retries = 0;
include/rpl/start_applier.inc
SET GLOBAL debug = '+d,csa_helper_after_register,csa_owner_after_fatal';
BEGIN;
INSERT INTO t1 VALUES (20);
[connection master]
INSERT INTO t1 VALUES (20);
INSERT INTO t1 VALUES (20 + 1);
INSERT INTO t1 VALUES (20 + 2);
INSERT INTO t1 VALUES (20 + 3);
INSERT INTO t1 VALUES (20 + 4);
[connection slave]
SET GLOBAL debug = '-d,csa_helper_after_register';
SELECT "server alive with the owner paused" AS status;
status
server alive with the owner paused
include/assert.inc [No source GTID is applied while the owner is paused]
include/assert.inc [No row of the later transactions is applied]
SET GLOBAL debug = '-d,csa_owner_after_fatal';
include/rpl/wait_for_applier_error.inc [errno=1205]
include/assert.inc [The channel keeps the original error]
ROLLBACK;
[connection slave]
SET GLOBAL debug = @saved_debug;
SET GLOBAL innodb_lock_wait_timeout = @saved_innodb_lock_wait_timeout;
SET GLOBAL replica_transaction_retries = @saved_replica_transaction_retries;
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc
FLUSH TABLES;
include/diff_tables.inc [master:t1, slave:t1]
#
# Scenario 3: later transactions wait behind the failed one.
#
[connection slave]
include/rpl/stop_applier.inc
CHANGE REPLICATION SOURCE TO APPLIER_WORKER_COUNT = 4;
SET GLOBAL innodb_lock_wait_timeout = 30;
SET GLOBAL replica_transaction_retries = 0;
include/rpl/start_applier.inc
SET GLOBAL debug = '+d,csa_helper_after_register,csa_owner_after_cleanup';
BEGIN;
INSERT INTO t1 VALUES (30);
[connection master]
INSERT INTO t1 VALUES (30);
INSERT INTO t1 VALUES (30 + 1);
INSERT INTO t1 VALUES (30 + 2);
INSERT INTO t1 VALUES (30 + 3);
INSERT INTO t1 VALUES (30 + 4);
[connection slave]
SET GLOBAL debug = '-d,csa_helper_after_register';
SELECT "server alive with the owner paused" AS status;
status
server alive with the owner paused
include/assert.inc [No source GTID is applied while the owner is paused]
include/assert.inc [No row of the later transactions is applied]
SET GLOBAL debug = '-d,csa_owner_after_cleanup';
include/rpl/wait_for_applier_error.inc [errno=1205]
include/assert.inc [The channel keeps the original error]
ROLLBACK;
[connection slave]
SET GLOBAL debug = @saved_debug;
SET GLOBAL innodb_lock_wait_timeout = @saved_innodb_lock_wait_timeout;
SET GLOBAL replica_transaction_retries = @saved_replica_transaction_retries;
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc
FLUSH TABLES;
include/diff_tables.inc [master:t1, slave:t1]
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
