include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CREATE TABLE t1 (c1 INT PRIMARY KEY);
include/rpl/sync_to_replica.inc

# 1. On the replica: Stop the applier. On the source: Execute 4 inserts
#    with GTID_NEXT=AUTOMATIC:tag1

[connection slave]
include/rpl/stop_applier.inc
[connection master]
SET gtid_next = 'AUTOMATIC:tag1';
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);
INSERT INTO t1 VALUES (4);
SET gtid_next = 'AUTOMATIC';
include/rpl/sync_to_replica_received.inc

# 2. On the replica: START REPLICA SQL_THREAD UNTIL
#    SQL_AFTER_GTIDS=UUID:tag1:1-2 and assert that only 2 rows are applied

START REPLICA SQL_THREAD UNTIL SQL_AFTER_GTIDS = 'UUID:tag1:1-2';
include/rpl/wait_for_applier_to_stop.inc
include/assert.inc [Applier stopped exactly after tag1:1-2]
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc

# 3. On the replica: Stop the applier. On the source: Execute 4 CREATE TABLE
#    with GTID_NEXT=AUTOMATIC:tag2

[connection slave]
include/rpl/stop_applier.inc
[connection master]
SET gtid_next = 'AUTOMATIC:tag2';
CREATE TABLE v1 (a INT);
CREATE TABLE v2 (a INT);
CREATE TABLE v3 (a INT);
CREATE TABLE v4 (a INT);
SET gtid_next = 'AUTOMATIC';
include/rpl/sync_to_replica_received.inc

# 4. On the replica: START REPLICA SQL_THREAD UNTIL
#    SQL_AFTER_GTIDS=UUID:tag2:1-2 and assert that only 2 tables are created

START REPLICA SQL_THREAD UNTIL SQL_AFTER_GTIDS = 'UUID:tag2:1-2';
include/rpl/wait_for_applier_to_stop.inc
include/assert.inc [Applier stopped exactly after tag2:1-2]
include/rpl/start_applier.inc

# 5. Clean up

[connection master]
DROP TABLE t1, v1, v2, v3, v4;
include/rpl/deinit.inc
