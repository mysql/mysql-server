include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. Enable IMR on the CSA channel, install the metrics component, and
#    start the replica.

[connection slave]
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
INSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/start_replica.inc

# 2. A workload replicates; once drained, IN_MEMORY_BYTES_USED is 0, the
#    gauges agree with SHOW REPLICA STATUS, and the cumulative counters
#    are non-zero.

[connection master]
CREATE TABLE t1 (a INT PRIMARY KEY, b VARCHAR(50));
INSERT INTO t1 VALUES (1, 'one'), (2, 'two'), (3, 'three');
BEGIN;
INSERT INTO t1 VALUES (4, 'four'), (5, 'five');
UPDATE t1 SET b = 'ONE' WHERE a = 1;
COMMIT;
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/wait_for_replica_status.inc [In_Memory_Relay_Log_Space]
include/assert.inc [IN_MEMORY_BYTES_USED is 0 once everything is applied]
include/assert.inc [IN_MEMORY_TRANSACTIONS_COUNT is non-zero after a memory-path workload]
include/assert.inc [IN_MEMORY_TRANSACTIONS_BYTES is non-zero after a memory-path workload]
include/rpl/stop_applier.inc
include/assert.inc [IN_MEMORY_QUEUE_LENGTH matches SHOW REPLICA STATUS In_Memory_Queue_Length]

# 3. With the applier stopped, queued transactions make the gauges
#    non-zero, while the cumulative counters read 0 (the applier is not
#    running). The restarted applier counts exactly the transactions it
#    applies (R3).

[connection slave]
include/assert.inc [IN_MEMORY_TRANSACTIONS_COUNT / _BYTES read 0 while the applier is stopped]
[connection master]
include/rpl/sync_to_replica_received.inc
include/assert.inc [IN_MEMORY_QUEUE_LENGTH grew by exactly 10 while the applier was stopped]
include/assert.inc [IN_MEMORY_QUEUE_LENGTH matches In_Memory_Queue_Length while queued]
include/assert.inc [IN_MEMORY_BYTES_USED is non-zero while transactions are queued]
include/assert.inc [IN_MEMORY_BYTES_USED matches In_Memory_Relay_Log_Space while queued]
include/assert.inc [IN_MEMORY_TRANSACTIONS_COUNT does not count queued, unapplied transactions]
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/rpl/wait_for_replica_status.inc [In_Memory_Relay_Log_Space]
include/assert.inc [IN_MEMORY_TRANSACTIONS_COUNT is exactly the 10 transactions the restarted applier applied]
include/assert.inc [IN_MEMORY_TRANSACTIONS_BYTES is non-zero after the applier applied them]

# 4. Transactions received, discarded at a full channel stop, and
#    re-fetched are counted once, when applied (R5).

[connection slave]
include/rpl/stop_applier.inc
[connection master]
include/rpl/sync_to_replica_received.inc
[connection slave]
include/rpl/stop_receiver.inc
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/assert.inc [IN_MEMORY_TRANSACTIONS_COUNT counts each re-fetched transaction once]

# 5. A channel that does not use the in-memory relay log reports 0 for
#    all four columns. Disable IMR on the channel and restart it.

[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
include/rpl/start_replica.inc
include/assert.inc [IN_MEMORY_BYTES_USED is 0 for a non-IMR channel]
include/assert.inc [IN_MEMORY_QUEUE_LENGTH is 0 for a non-IMR channel]
include/assert.inc [IN_MEMORY_TRANSACTIONS_COUNT is 0 for a non-IMR channel]
include/assert.inc [IN_MEMORY_TRANSACTIONS_BYTES is 0 for a non-IMR channel]

# 6. Cleanup.

[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
[connection slave]
UNINSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/deinit.inc
