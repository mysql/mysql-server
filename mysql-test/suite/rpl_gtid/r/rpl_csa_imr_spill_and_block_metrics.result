include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. Enable IMR at the 32 MiB limit floor with an 8 MiB spill threshold,
#    install the metrics component, and start.

[connection slave]
CHANGE REPLICATION SOURCE TO
IN_MEMORY_RELAYLOG_ENABLED = ON,
IN_MEMORY_RELAYLOG_LIMIT = 33554432,
IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
INSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY AUTO_INCREMENT, data LONGBLOB);
include/rpl/sync_to_replica.inc
[connection slave]
include/assert.inc [SPILL_TRANSACTIONS_COUNT is 0 before any spilled transaction]

# 2. Memory-limit back-pressure. Pause the applier and run ~40 MiB of
#    ~1 MiB memory-path transactions (below the 8 MiB spill threshold),
#    which exceeds the 32 MiB limit, so the receiver blocks (R1).

[connection slave]
include/rpl/stop_applier.inc
[connection master]
[connection slave]
include/assert.inc [IN_MEMORY_BYTES_USED matches In_Memory_Relay_Log_Space while the receiver is blocked]
include/assert.inc [In_Memory_Relay_Log_Space is within one transaction of IN_MEMORY_RELAYLOG_LIMIT and not above it while blocked]
include/assert.inc [IN_MEMORY_QUEUE_LENGTH matches In_Memory_Queue_Length while the receiver is blocked]
include/assert.inc [Spill columns and the cumulative counters are 0 while the receiver is blocked with the applier stopped]
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/wait_for_replica_status.inc [In_Memory_Relay_Log_Space]
include/assert.inc [IN_MEMORY_TRANSACTIONS_COUNT counts exactly the 40 applied memory-path transactions, SPILL_TRANSACTIONS_COUNT none]

# 3. Spill path. With the applier stopped, send 3 transactions above the
#    8 MiB threshold (spill) and 2 below it (memory). While they sit on
#    disk the live gauges show 3 files and > 0 bytes, but nothing is
#    counted yet; once applied, the counters show exactly the 3 spilled
#    and 2 memory-path transactions, and the live gauges return to 0 (R2).

[connection slave]
include/rpl/stop_applier.inc
[connection master]
INSERT INTO t1 (data) VALUES (REPEAT('s', 10 * 1024 * 1024));
INSERT INTO t1 (data) VALUES (REPEAT('s', 10 * 1024 * 1024));
INSERT INTO t1 (data) VALUES (REPEAT('s', 10 * 1024 * 1024));
INSERT INTO t1 (data) VALUES (REPEAT('y', 100));
INSERT INTO t1 (data) VALUES (REPEAT('z', 100));
include/rpl/sync_to_replica_received.inc
[connection slave]
include/assert.inc [SPILL_FILE_COUNT shows the 3 spill files currently on disk]
include/assert.inc [SPILL_BYTES_USED exceeds 3 * the spill threshold while the files are on disk]
include/assert.inc [SPILL_TRANSACTIONS_COUNT does not count received, unapplied spill-path transactions]
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/assert.inc [SPILL_TRANSACTIONS_COUNT counts exactly the 3 applied above-threshold transactions]
include/assert.inc [SPILL_TRANSACTIONS_BYTES exceeds 3 * the spill threshold]
include/assert.inc [IN_MEMORY_TRANSACTIONS_COUNT counts exactly the 2 applied below-threshold transactions]
include/assert.inc [SPILL_BYTES_USED returns to 0 once every spill file is unlinked]

# 4. The cumulative counters read 0 while the applier is stopped and
#    restart from 0 when it restarts (R3).

[connection slave]
include/rpl/stop_applier.inc
include/assert.inc [The cumulative counters read 0 while the applier is stopped]
include/rpl/start_applier.inc
include/assert.inc [The cumulative counters restart from 0 with the applier]

# 5. A channel that does not use the in-memory relay log reports 0 for all
#    of these columns. Disable IMR on the channel and restart it (R4).

[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
include/rpl/start_replica.inc
include/assert.inc [All spill columns are 0 for a non-IMR channel]

# 6. Cleanup.

[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
[connection slave]
UNINSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/deinit.inc
