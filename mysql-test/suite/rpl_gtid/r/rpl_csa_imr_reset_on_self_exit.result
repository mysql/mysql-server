include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
[connection slave]
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
CALL mtr.add_suppression("Duplicate entry");
CALL mtr.add_suppression("The replica coordinator and worker threads are stopped");
CALL mtr.add_suppression("Worker .* failed executing transaction");
CALL mtr.add_suppression("Change Stream Applier channel stopped because of error");
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY);
include/rpl/sync_to_replica.inc

# 1. R1: the SQL thread stops on an apply error; the IO thread keeps
#    the queue.

SET SESSION sql_log_bin= 0;
INSERT INTO t1 VALUES (2);
SET SESSION sql_log_bin= 1;
[connection master]
INSERT INTO t1 VALUES (1);
INSERT INTO t1 VALUES (2);
INSERT INTO t1 VALUES (3);
include/rpl/sync_to_replica_received.inc
include/rpl/wait_for_applier_error.inc [errno=1062]
include/assert.inc [The queue keeps the unapplied transactions while the IO thread runs]

# 2. R2: the IO thread is killed and, as the last role out, resets the
#    queue.

KILL IO_THREAD;
include/rpl/wait_for_receiver_to_stop.inc
include/rpl/wait_for_replica_status.inc [In_Memory_Queue_Length]
include/rpl/wait_for_replica_status.inc [Retrieved_Gtid_Set]
include/assert.inc [The IO thread's exit reset the queue and the Retrieved_Gtid_Set]

# 3. R3: CHANGE REPLICATION SOURCE rebuilds the runtime; START REPLICA
#    fetches and applies everything again.

CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_LIMIT = 67108864;
SET SESSION sql_log_bin= 0;
DELETE FROM t1 WHERE id = 2;
SET SESSION sql_log_bin= 1;
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]

# Cleanup.

[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_LIMIT = 134217728;
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
include/rpl/start_replica.inc
include/rpl/deinit.inc
