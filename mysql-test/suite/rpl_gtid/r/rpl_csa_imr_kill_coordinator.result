
# 0. Set up a CSA channel with IMR enabled.

include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
[connection slave]
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, data VARCHAR(16));
include/rpl/sync_to_replica.inc

# 1. KILL the coordinator on an idle channel (R1).

KILL SQL_THREAD;
include/rpl/wait_for_applier_to_stop.inc
include/assert.inc [1: the KILL raises no applier error]
include/assert.inc [1: the IO thread keeps running]
[connection master]
INSERT INTO t1 VALUES (1, 'a');
INSERT INTO t1 VALUES (2, 'b');
include/rpl/sync_to_replica_received.inc
include/assert.inc [1: the stopped applier applied nothing]
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/assert.inc [1: the transactions are applied after START]

# 2. KILL the coordinator while a worker waits for the rest of a
#    transaction that is still being received (R2).

SET GLOBAL debug = '+d,pause_on_queue_event_after_write_buffer';
[connection master]
BEGIN;
INSERT INTO t1 VALUES (10, 'x');
INSERT INTO t1 VALUES (11, 'y');
COMMIT;
[connection slave]
SET DEBUG_SYNC = 'now WAIT_FOR receiver_reached_pause_on_queue_event';
SET DEBUG_SYNC = 'now SIGNAL receiver_continue_queuing_event';
SET DEBUG_SYNC = 'now WAIT_FOR receiver_reached_pause_on_queue_event';
SET DEBUG_SYNC = 'now SIGNAL receiver_continue_queuing_event';
SET DEBUG_SYNC = 'now WAIT_FOR receiver_reached_pause_on_queue_event';
SET DEBUG_SYNC = 'now SIGNAL receiver_continue_queuing_event';
SET DEBUG_SYNC = 'now WAIT_FOR receiver_reached_pause_on_queue_event';
KILL SQL_THREAD;
include/rpl/wait_for_applier_to_stop.inc
include/assert.inc [2: the KILL raises no applier error]
include/assert.inc [2: the queue keeps the stalled transaction]
include/assert.inc [2: the stalled transaction holds no lock on t1]
include/assert.inc [2: the stalled transaction was rolled back]
SET GLOBAL debug = '-d,pause_on_queue_event_after_write_buffer';
SET DEBUG_SYNC = 'now SIGNAL receiver_continue_queuing_event';
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
SET DEBUG_SYNC = 'RESET';
include/rpl/diff.inc

# 3. Cleanup.

[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
