include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
[connection slave]
CHANGE REPLICATION SOURCE TO
IN_MEMORY_RELAYLOG_ENABLED = ON,
IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);

# 1. Move the relay log to OLD, with an absolute relay log index in OLD.

include/rpl/restart_server.inc [server_number=2]
[connection slave]
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/stop_replica.inc

# 2. Restart with --relay-log in NEW, the index kept in OLD and
#    relay_log_purge = OFF. Remove OLD's spill directory while the server
#    is down.

include/rpl/stop_server.inc [server_number=2]
include/rpl/start_server.inc [server_number=2]
[connection slave]
The saved relay log position is in OLD, relay_log_basename is in NEW:
SELECT @@GLOBAL.relay_log_basename AS relay_log_basename, Relay_log_name
FROM mysql.slave_relay_log_info;
relay_log_basename	Relay_log_name
NEW/relay-bin	OLD/relay-bin.000001

# 3. With the applier stopped, replicate a 12 MiB transaction. The
#    receiver keeps running and the spill file is in NEW only.

include/rpl/start_receiver.inc
[connection master]
BEGIN;
COMMIT;
[connection slave]
include/rpl/wait_for_replica_status.inc [Retrieved_Gtid_Set]
include/assert.inc [R2: the receiver is still running]
OLD spill directory exists: 0
Spill files in OLD: 0
Spill files in NEW: 1

# 4. Start the applier: the data matches and no spill file is left.

include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/rpl/wait_for_no_imr_spill_files.inc
# No spill files remain in the in-memory relay log temp directory.

# 5. Clean up: restore the default relay log options.

include/rpl/stop_replica.inc
include/rpl/restart_server.inc [server_number=2]
[connection slave]
RESET REPLICA;
include/rpl/start_replica.inc
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
