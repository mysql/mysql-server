include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. Set up a CSA channel with IMR, an 8 MiB spill threshold and the
#    metrics component.

[connection slave]
CHANGE REPLICATION SOURCE TO
IN_MEMORY_RELAYLOG_ENABLED = ON,
IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
INSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
include/rpl/sync_to_replica.inc
[connection master]
SET SESSION binlog_transaction_compression = ON;
SET SESSION group_concat_max_len = 2097152;

# 2. With the applier stopped, a compressed transaction larger than the
#    threshold is held in a spill file.

[connection slave]
include/rpl/stop_applier.inc
[connection master]
BEGIN;
COMMIT;
include/assert.inc [The source logged the transaction compressed, above the 8 MiB threshold]
include/rpl/sync_to_replica_received.inc
[connection slave]
# The compressed transaction is held in one spill file:
imr_sp_<ID>

# 3. Start the applier: the data matches, the transaction is counted as
#    spilled, and its spill file is removed.

include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/rpl/wait_for_no_imr_spill_files.inc
# No spill files remain in the in-memory relay log temp directory.

# 4. With the applier running, a second compressed transaction spills and
#    applies.

[connection master]
BEGIN;
COMMIT;
include/assert.inc [The second transaction is compressed above the threshold too]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/rpl/wait_for_no_imr_spill_files.inc
# No spill files remain in the in-memory relay log temp directory.

# Cleanup.

[connection master]
SET SESSION binlog_transaction_compression = DEFAULT;
SET SESSION group_concat_max_len = DEFAULT;
DROP TABLE t1;
include/rpl/sync_to_replica.inc
UNINSTALL COMPONENT 'file://component_replication_applier_metrics';
include/rpl/deinit.inc
