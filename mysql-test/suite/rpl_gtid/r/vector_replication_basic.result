[connection master]
Initial Data inserted for table t1
Initial Data inserted for table t2
# create vector index
CREATE VECTOR INDEX vec_index ON t1(j) DISTANCE_MEASURE=cosine;
CREATE VECTOR INDEX vec_index_2 ON t2(j) DISTANCE_MEASURE=l2_squared;
#Test: Basic testing to make sure the index is replicated
include/rpl/sync_to_replica.inc
SELECT table_name, index_name, index_type, dist_measure, status FROM information_schema.innodb_vector_indexes;
table_name	index_name	index_type	dist_measure	status
test.t2	vec_index_2	TREE_SQ	L2_SQUARED	Ready
test.t1	vec_index	TREE_SQ	COSINE	Ready
#Test: Using session variables, do DMLs on the base tables, make sure the data is replicated and inserted and available on index
SET @new_j = string_to_vector("[2.0, 2.0, 2.0]");
UPDATE t1 SET j = @new_j WHERE i = 1;
INSERT INTO t1 values(1001, @new_j);
include/rpl/sync_to_replica.inc
SELECT i, vector_to_string(j) FROM t1 ORDER BY APPROX_DISTANCE(j, string_to_vector('[1,2,3]'), 'distance_measure=cosine') LIMIT 3;
i	vector_to_string(j)
114	[2.72599e-01,5.40020e-01,7.25321e-01]
929	[2.02220e-01,3.91113e-01,5.82769e-01]
312	[3.12909e-01,6.90011e-01,8.38601e-01]
SELECT i, vector_to_string(j) FROM t1 WHERE i = 1;
i	vector_to_string(j)
1	[2.00000e+00,2.00000e+00,2.00000e+00]
SELECT COUNT(*) FROM t1;
COUNT(*)
1001
