DROP INDEX vec_index_2 ON t2;
include/rpl/sync_to_replica.inc
#Test: On Replica, customers can create indexes directly.
# create vector index
CREATE VECTOR INDEX vec_index ON t1(j) DISTANCE_MEASURE=cosine;
