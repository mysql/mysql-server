include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. Enable IMR on the CSA channel, start replication, apply W1.

[connection slave]
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
include/rpl/start_replica.inc
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, v VARCHAR(50));
INSERT INTO t1 VALUES (1, 'w1-a'), (2, 'w1-b'), (3, 'w1-c');
include/rpl/sync_to_replica.inc

# 2. A CHANGE REPLICATION SOURCE or START that keeps the runtime keeps
#    Retrieved_Gtid_Set (R2).

include/rpl/stop_applier.inc
[connection master]
INSERT INTO t1 VALUES (4, 'r2-a');
INSERT INTO t1 VALUES (5, 'r2-b');
include/rpl/sync_to_replica_received.inc
CHANGE REPLICATION SOURCE TO SOURCE_DELAY = 0;
include/assert.inc [CHANGE REPLICATION SOURCE that keeps the runtime keeps Retrieved_Gtid_Set]
include/rpl/start_applier.inc
include/assert.inc [START REPLICA that keeps the runtime keeps Retrieved_Gtid_Set]
[connection master]
include/rpl/sync_to_replica.inc

# 3. Restart with queued-but-unapplied transactions and a source binary
#    log rotation in between (R1, R3).


# Variant 1: clean restart.

# 3.1. Stop the applier; queue 2 transactions, rotate the source
#      binary log, queue 1 more.
[connection slave]
include/rpl/stop_applier.inc
[connection master]
INSERT INTO t1 VALUES (6, 'queued-before-rotate-a');
INSERT INTO t1 VALUES (7, 'queued-before-rotate-b');
[connection slave]
[connection master]
FLUSH BINARY LOGS;
INSERT INTO t1 VALUES (8, 'queued-after-rotate');
[connection slave]
# 3.2. Restart the replica; the in-memory queue is lost.
include/rpl/restart_server.inc [server_number=2]
[connection slave]
# 3.3. The new runtime starts with an empty Retrieved_Gtid_Set (R1).
include/assert.inc [Retrieved_Gtid_Set is empty after the restart]
include/assert.inc [In_Memory_Queue_Length is 0 after the restart]
include/assert.inc [In_Memory_Relay_Log_Space is 0 after the restart]
# 3.4. START REPLICA fetches the lost transactions again (R3).
include/rpl/start_replica.inc
include/assert.inc [The replica applies the source's gtid_executed within 60 seconds]
include/assert.inc [gtid_executed on the replica equals the source's]
include/diff_tables.inc [master:test.t1, slave:test.t1]

# Variant 2: crash restart (kill -9).

# 3.1. Stop the applier; queue 2 transactions, rotate the source
#      binary log, queue 1 more.
[connection slave]
include/rpl/stop_applier.inc
[connection master]
INSERT INTO t1 VALUES (9, 'queued-before-rotate-a');
INSERT INTO t1 VALUES (10, 'queued-before-rotate-b');
[connection slave]
[connection master]
FLUSH BINARY LOGS;
INSERT INTO t1 VALUES (11, 'queued-after-rotate');
[connection slave]
# 3.2. Restart the replica; the in-memory queue is lost.
include/rpl/restart_server.inc [server_number=2]
[connection slave]
# 3.3. The new runtime starts with an empty Retrieved_Gtid_Set (R1).
include/assert.inc [Retrieved_Gtid_Set is empty after the restart]
include/assert.inc [In_Memory_Queue_Length is 0 after the restart]
include/assert.inc [In_Memory_Relay_Log_Space is 0 after the restart]
# 3.4. START REPLICA fetches the lost transactions again (R3).
include/rpl/start_replica.inc
include/assert.inc [The replica applies the source's gtid_executed within 60 seconds]
include/assert.inc [gtid_executed on the replica equals the source's]
include/diff_tables.inc [master:test.t1, slave:test.t1]
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
include/rpl/start_replica.inc
include/rpl/deinit.inc
