#
# 1) Create a source-replica setup.
#
include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
#
# 2) Create a table on source, sync it, stop the replica threads and dump
#    thread on source.
#
CREATE TABLE t1 (a INT) ENGINE = InnoDB;
include/rpl/sync_to_replica.inc
include/rpl/stop_replica.inc
[connection master]
include/rpl/stop_dump_threads.inc
#
# 3) On source, generate a transaction, flush the binary log and execute
#    PURGE BINARY LOGS TO command so that only remaining binlog only contains
#    transaction UUID:3.
#
INSERT INTO t1 VALUES (1);
FLUSH LOGS;
INSERT INTO t1 VALUES (2);
PURGE BINARY LOGS TO 'master-bin.000002';
include/assert.inc [PURGE BINARY LOGS successfully removed all but the latest file]
#
# 4) Verify that the replica fails if it tries to connect using CHANGE
#    REPLICATION SOURCE TO SOURCE_AUTO_POSITION=1.
#
[connection slave]
CHANGE REPLICATION SOURCE TO SOURCE_AUTO_POSITION = 1;
START REPLICA;
include/rpl/wait_for_receiver_error.inc [errno=13114 # ER_SOURCE_FATAL_ERROR_READING_BINLOG]
include/rpl/stop_applier.inc
[connection master]
SET @saved_debug= @@GLOBAL.DEBUG;
SET GLOBAL DEBUG= '+d,simulate_long_missing_gtids';
[connection slave]
START REPLICA;
include/rpl/wait_for_receiver_error.inc [errno=13114 # ER_SOURCE_FATAL_ERROR_READING_BINLOG]
include/rpl/stop_applier.inc
[connection master]
SET GLOBAL DEBUG= @saved_debug;
[connection slave]
#
# 5) Verify that appropriate messages are logged into source's and
#    replica's error log.
#
include/assert_grep.inc [Found a message about the long GTIDs in the replica error log.]
#
# 6) Verify that replication succeeds after missing GTIDs are
#    skipped
#
SET GTID_NEXT="UUID:1";
COMMIT;
SET GTID_NEXT="UUID:2";
COMMIT;
SET GTID_NEXT=AUTOMATIC;
include/rpl/start_replica.inc
[connection master]
include/rpl/sync_to_replica.inc
include/assert.inc [t1 should contain only one row with t he value 2]
include/rpl/stop_replica.inc
include/assert_grep.inc [Found warning containing lost GTIDs in the source error log.]
include/assert_grep.inc [Found warning containing lost GTIDs in the replica error log.]
[connection master]
CALL mtr.add_suppression("Cannot replicate to server.*server has purged required binary logs.*");
[connection slave]
CALL mtr.add_suppression("Got fatal error 1236 from source.*Replicate the missing transactions from elsewhere");
#
# 7) Cleanup.
#
[connection slave]
RESET BINARY LOGS AND GTIDS;
RESET REPLICA;
[connection master]
RESET BINARY LOGS AND GTIDS;
[connection slave]
include/rpl/start_replica.inc
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
include/rpl/deinit.inc
