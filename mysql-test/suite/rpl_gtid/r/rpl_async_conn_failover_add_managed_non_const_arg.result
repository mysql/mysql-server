[connection master]
CREATE TABLE t (ch CHAR(8), mt CHAR(16), mn CHAR(36), hn CHAR(20),
ns CHAR(10), pt INT, pw INT, sw INT) CHARACTER SET latin1;
INSERT INTO t VALUES ('chcol', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', 'hostcol',
'nscol', 3310, 80, 60);
#
# 1. Arguments dereferenced during init: a non-constant or NULL value
#    used to crash the server and must be rejected.
#
# Non-constant managed type of length 16.
SELECT asynchronous_connection_failover_add_managed('ch1', mt,
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, 60)
FROM t;
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify managed type.
# Non-constant managed name of length 36.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
mn, '127.0.0.1', 3310, '', 80, 60)
FROM t;
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify managed name.
# NULL literal managed type and managed name.
SELECT asynchronous_connection_failover_add_managed('ch1', NULL,
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify managed type.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
NULL, '127.0.0.1', 3310, '', 80, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify managed name.
#
# 1b. The init function runs before the SUPER / REPLICATION_SLAVE_ADMIN
#     check, so an account without those privileges reaches it: the
#     non-constant calls must be rejected there, and a well-formed call
#     must still be refused by the privilege check.
#
CREATE USER acf_unpriv@localhost;
GRANT SELECT ON test.t TO acf_unpriv@localhost;
SELECT asynchronous_connection_failover_add_managed('ch1', mt,
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, 60)
FROM t;
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify managed type.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
mn, '127.0.0.1', 3310, '', 80, 60)
FROM t;
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify managed name.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, 60);
ERROR 42000: Access denied; you need (at least one of) the SUPER or REPLICATION_SLAVE_ADMIN privilege(s) for this operation
[connection master]
DROP USER acf_unpriv@localhost;
#
# 2. Integer arguments: a non-constant or NULL value is rejected.
#
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', pt, '', 80, 60)
FROM t;
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: The port argument should be integer between 1-65535.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', pw, 60)
FROM t;
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: The primary_weight argument should be integer between 1-100.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, sw)
FROM t;
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: The secondary_weight argument should be integer between 1-100.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', NULL, '', 80, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: The port argument should be integer between 1-65535.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', NULL, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: The primary_weight argument should be integer between 1-100.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, NULL);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: The secondary_weight argument should be integer between 1-100.
#
# 3. Wrong argument types and a NULL hostname are rejected.
#
SELECT asynchronous_connection_failover_add_managed(1, 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify channel name.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', 127, 3310, '', 80, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify hostname.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', '3310', '', 80, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: The port argument should be integer between 1-65535.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, 0, 80, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify a string value for network_namespace.
SELECT asynchronous_connection_failover_add_managed('ch1', 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', NULL, 3310, '', 80, 60);
ERROR HY000: Can't initialize function 'asynchronous_connection_failover_add_managed'; Wrong arguments: You need to specify hostname.
# Nothing was configured by the rejected calls and the server is up.
SELECT 1 AS server_alive;
server_alive
1
include/assert.inc [No managed sender is configured after the rejected calls]
#
# 4. Arguments read per row in the UDF body accept non-constant values,
#    a NULL channel selects the default channel and a NULL
#    network_namespace is accepted (the argument is reserved).
#
SELECT asynchronous_connection_failover_add_managed(ch, 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, 60)
FROM t;
asynchronous_connection_failover_add_managed(ch, 'GroupReplication',
'aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa', '127.0.0.1', 3310, '', 80, 60)
The UDF asynchronous_connection_failover_add_managed() executed successfully.
