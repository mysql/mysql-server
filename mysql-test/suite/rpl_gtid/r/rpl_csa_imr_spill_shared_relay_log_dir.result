
# 0. Set up 1->2,1->3; both replicas use the CSA with IMR.

include/rpl/init.inc [topology=1->2,1->3]
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.

# 1. Move both relay logs into SHARED, with different basenames. Each
#    server's spill directory exists (R1).

include/rpl/restart_server.inc [server_number=2]
[connection server_2]
SELECT @@GLOBAL.relay_log_basename AS relay_log_basename, 'SHARED/#in_memory_relaylog_temp_files.a-relay' AS spill_dir;
relay_log_basename	spill_dir
SHARED/a-relay	SHARED/#in_memory_relaylog_temp_files.a-relay
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
include/rpl/restart_server.inc [server_number=3]
[connection server_3]
SELECT @@GLOBAL.relay_log_basename AS relay_log_basename, 'SHARED/#in_memory_relaylog_temp_files.b-relay' AS spill_dir;
relay_log_basename	spill_dir
SHARED/b-relay	SHARED/#in_memory_relaylog_temp_files.b-relay

# 2. With server_2's applier stopped, replicate a 12 MiB transaction,
#    which server_2 spills to disk.

include/rpl/start_all_replicas.inc
[connection server_1]
CREATE TABLE t1 (id INT PRIMARY KEY, data LONGBLOB);
include/rpl/sync.inc
[connection server_2]
include/rpl/stop_applier.inc
[connection server_1]
BEGIN;
COMMIT;
include/rpl/sync_to_replica.inc
[connection server_2]
Spill files of server_2: 1

# 3. Plant a stale spill file in server_3's spill directory and restart
#    server_3. The stale file is gone (R2); server_2's spill file is still
#    there and its receiver is running (R3).

include/rpl/restart_server.inc [server_number=3]
[connection server_3]
[connection server_2]
Spill files of server_2: 1
include/assert.inc [R3: server_2's receiver is still running]

# 4. Start server_2's applier and server_3's replica. The data matches,
#    server_2 applies the transaction and its spill file is deleted (R4).

include/rpl/start_applier.inc
[connection server_3]
include/rpl/start_replica.inc
[connection server_1]
include/rpl/sync.inc
[connection server_2]
include/assert.inc [R4: server_2's applier has no error]
include/rpl/diff.inc
include/rpl/wait_for_no_imr_spill_files.inc
# No spill files remain in the in-memory relay log temp directory.
include/assert.inc [R5: the servers have different spill directories]

# 5. Clean up: restore the default relay log options.

include/rpl/stop_all_replicas.inc
include/rpl/restart_server.inc [server_number=2]
include/rpl/restart_server.inc [server_number=3]
[connection server_2]
RESET REPLICA;
[connection server_3]
include/rpl/stop_replica.inc
RESET REPLICA;
include/rpl/start_all_replicas.inc
[connection server_1]
DROP TABLE t1;
include/rpl/sync.inc
include/rpl/deinit.inc
