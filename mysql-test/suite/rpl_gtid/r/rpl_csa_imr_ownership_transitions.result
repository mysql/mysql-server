include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]

# 1. Create: enable IMR ON with explicit bounds. A runtime is created and
#    cached on the channel's rli; replication proceeds correctly.

[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON, IN_MEMORY_RELAYLOG_LIMIT = 134217728, IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 16777216;
include/rpl/start_replica.inc
include/assert.inc [IMR is ON after the create transition]
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, v VARCHAR(50));
INSERT INTO t1 VALUES (1, 'create-a'), (2, 'create-b');
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]

# 2. Rebuild: change the memory bounds. The runtime is rebuilt to the new
#    bounds; replication stays correct.

[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_LIMIT = 268435456, IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 33554432;
include/rpl/start_replica.inc
include/assert.inc [The rebuilt runtime carries the new persisted bounds]
[connection master]
INSERT INTO t1 VALUES (3, 'rebuild-a'), (4, 'rebuild-b');
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]

# 3. Destroy: disable IMR. The runtime is destroyed and the cached pointer
#    cleared; the IMR SHOW REPLICA STATUS columns read 0.

[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
include/rpl/start_replica.inc
include/assert.inc [In_Memory_Relay_Log_Space is 0 after the destroy transition]
include/assert.inc [In_Memory_Queue_Length is 0 after the destroy transition]
[connection master]
INSERT INTO t1 VALUES (5, 'destroy-a'), (6, 'destroy-b');
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]
[connection slave]
include/assert.inc [Relay_Log_Space is greater than 0 while IMR is OFF]
include/assert.inc [In_Memory_Relay_Log_Space is 0 after a workload with IMR OFF]
include/assert.inc [In_Memory_Queue_Length is 0 after a workload with IMR OFF]

# 4. Create again: re-enable IMR. A fresh runtime is created.

[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = ON;
include/rpl/start_replica.inc
include/assert.inc [IMR is ON again after the second create transition]
[connection master]
INSERT INTO t1 VALUES (7, 'create2-a'), (8, 'create2-b');
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]

# 5. Teardown + recreate: RESET REPLICA ALL removes the channel and its
#    runtime from the service. Recreate the channel with IMR ON (it reuses
#    the recycled channel_instance_id) and confirm it reconciles a fresh
#    runtime and replicates correctly.

[connection slave]
include/rpl/stop_replica.inc
RESET REPLICA ALL;
include/assert.inc [RESET REPLICA ALL cleared the channel row]
CHANGE REPLICATION SOURCE TO SOURCE_HOST='127.0.0.1', SOURCE_PORT=MASTER_PORT, SOURCE_USER='root', SOURCE_AUTO_POSITION=1, REQUIRE_ROW_FORMAT=1, GTID_ONLY=1, APPLIER_VERSION=2, IN_MEMORY_RELAYLOG_ENABLED=ON;
Warnings:
Note	1759	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	1760	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
include/rpl/start_replica.inc
include/assert.inc [IMR is ON on the recreated channel]
[connection master]
INSERT INTO t1 VALUES (9, 'recreate-a'), (10, 'recreate-b');
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1, slave:test.t1]

# Cleanup.

[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
include/rpl/start_replica.inc
include/rpl/deinit.inc
