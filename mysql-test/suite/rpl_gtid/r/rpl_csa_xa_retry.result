[connection master]
[connection slave]
include/save_sysvars.inc [
"GLOBAL.replica_transaction_retries",
"GLOBAL.innodb_lock_wait_timeout",
"GLOBAL.replica_preserve_commit_order",
"GLOBAL.replica_parallel_workers"
]
include/rpl/stop_applier.inc
SET @@GLOBAL.replica_transaction_retries = 50;
SET @@GLOBAL.innodb_lock_wait_timeout = 5;
SET @@GLOBAL.replica_preserve_commit_order = ON;
SET @@GLOBAL.replica_parallel_workers = 4;
include/rpl/start_applier.inc
[connection master]
CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
include/rpl/sync_to_replica.inc
[connection slave1]
BEGIN;
INSERT INTO t1 VALUES (10, 11);
[connection master]
XA START 'xa1';
INSERT INTO t1 VALUES (10, 1);
XA END 'xa1';
XA PREPARE 'xa1';
[connection slave]
include/assert.inc [CSA retry path reports lock wait timeout as the transient error]
[connection slave1]
ROLLBACK;
[connection master]
XA COMMIT 'xa1';
include/rpl/sync_to_replica.inc
include/diff_tables.inc [master:test.t1,slave:test.t1]
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/stop_applier.inc
include/restore_sysvars.inc
