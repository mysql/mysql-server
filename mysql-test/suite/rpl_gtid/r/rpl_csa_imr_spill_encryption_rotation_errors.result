# Setup
include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
[connection slave]
# Creating local configuration file for keyring component: component_keyring_file
# Creating manifest file for current MySQL server instance
[connection master]
# ----------------------------------------------------------------------

# 0. Load the keyring on the replica, enable binlog_encryption and IMR.

include/rpl/restart_server.inc [server_number=2]
[connection slave]
SET GLOBAL binlog_encryption = ON;
CHANGE REPLICATION SOURCE TO
IN_MEMORY_RELAYLOG_ENABLED = ON,
IN_MEMORY_RELAYLOG_SPILL_THRESHOLD = 8388608;
include/rpl/start_replica.inc
# Key check source: pfs
[connection master]
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, c LONGBLOB);
include/rpl/sync_to_replica.inc

# 1. A header that cannot be written fails the rotation and keeps the
#    old key (R1).

include/rpl/stop_applier.inc
[connection master]
INSERT INTO t1 (c) VALUES (CONCAT('IMR_SPILL_ENCRYPTION_MARKER', REPEAT('x', 9437184)));
include/rpl/sync_to_replica_received.inc
[connection slave]
include/assert.inc [One spill file, encrypted with _1]
# Adding debug point 'imr_spill_reencrypt_fail_write' to @@SESSION.debug
ALTER INSTANCE ROTATE BINLOG MASTER KEY;
ERROR HY000: Failed to re-encrypt in-memory relay log file '<spill file>': could not write the new header (errno 5). A new binary log master key was generated and will be used to encrypt new binary and relay log files. There may still exist binary or relay log files using the previous binary log master key.
SHOW WARNINGS;
Level	Code	Message
Error	3809	Failed to re-encrypt in-memory relay log file '<spill file>': could not write the new header (errno 5). A new binary log master key was generated and will be used to encrypt new binary and relay log files. There may still exist binary or relay log files using the previous binary log master key.
# Removing debug point 'imr_spill_reencrypt_fail_write' from @@SESSION.debug
include/assert.inc [The replica binary log names _2]
include/assert.inc [The spill file is unchanged and names _1]
include/assert.inc [_1 is listed]
ALTER INSTANCE ROTATE BINLOG MASTER KEY;
include/assert.inc [The retried rotation succeeds with no warning]
include/assert.inc [The spill file names _3]
include/assert.inc [_1 is gone]
include/assert.inc [_2 is gone]
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/wait_for_no_imr_spill_files.inc
# No spill files remain in the in-memory relay log temp directory.

# 2. A file deleted after the listing is skipped and not re-created
#    (R2).

include/rpl/stop_applier.inc
[connection master]
INSERT INTO t1 (c) VALUES (CONCAT('IMR_SPILL_ENCRYPTION_MARKER', REPEAT('x', 9437184)));
include/rpl/sync_to_replica_received.inc
[connection slave]
include/assert.inc [One spill file, encrypted with _3]
SET SESSION debug = '+d,imr_spill_reencrypt_after_list';
ALTER INSTANCE ROTATE BINLOG MASTER KEY;
[connection slave]
SET DEBUG_SYNC = 'now WAIT_FOR imr_reencrypt_listed';
include/rpl/start_applier.inc
[connection master]
include/rpl/sync_to_replica.inc
[connection slave]
include/rpl/wait_for_no_imr_spill_files.inc
# No spill files remain in the in-memory relay log temp directory.
SET DEBUG_SYNC = 'now SIGNAL imr_reencrypt_go';
include/assert.inc [The rotation succeeds with no warning]
SET SESSION debug = '-d,imr_spill_reencrypt_after_list';
[connection slave]
include/assert.inc [No spill file was re-created, not even an empty one]
include/assert.inc [_3 is gone]
SET DEBUG_SYNC = 'RESET';

# 3. Without an IMR runtime the rotation touches no spill file and
#    purges every older key (R3).

include/rpl/stop_replica.inc
CHANGE REPLICATION SOURCE TO IN_MEMORY_RELAYLOG_ENABLED = OFF;
include/rpl/start_replica.inc
include/assert.inc [The file names _4]
# Adding debug point 'verify_unusable_encryption_keys_are_purged' to @@SESSION.debug
ALTER INSTANCE ROTATE BINLOG MASTER KEY;
# Removing debug point 'verify_unusable_encryption_keys_are_purged' from @@SESSION.debug
include/assert.inc [The rotation succeeds with no warning]
include/assert.inc [The file is unchanged]
include/assert.inc [_4 is gone]
[connection master]
include/rpl/sync_to_replica.inc
include/rpl/diff.inc
[connection slave]
include/rpl/stop_replica.inc
SET GLOBAL binlog_encryption = OFF;
include/rpl/start_replica.inc
[connection master]
DROP TABLE t1;
include/rpl/sync_to_replica.inc
