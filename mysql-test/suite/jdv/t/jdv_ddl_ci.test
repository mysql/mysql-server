--echo #################################################################

--echo # Requirement-13: Restrictions for creation options of JSON DUALITY VIEW:
--echo # 13.1 The ALGORITHM = TEMPTABLE option is not supported and must
--echo # result into a semantic error if used.

--error ER_JDV_ALGO_TEMPTABLE_NOT_SUPPORTED
CREATE ALGORITHM = TEMPTABLE JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1,
    "C2"  : C2
)
FROM T1;

CREATE OR REPLACE ALGORITHM = UNDEFINED JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1,
    "C2"  : C2
)
FROM T1;

CREATE OR REPLACE ALGORITHM = MERGE JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1,
    "C2"  : C2
)
FROM T1;

--echo # 13.2 The [WITH [CASCADED | LOCAL] CHECK OPTION] clause is not
--echo # supported and must report a semantic error if used.

--error ER_JDV_WITH_CHECK_OPTION_NOT_SUPPORTED
CREATE OR REPLACE JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1,
    "C2"  : C2
)
FROM T1
WITH CHECK OPTION;

--error ER_JDV_WITH_CHECK_OPTION_NOT_SUPPORTED
CREATE OR REPLACE JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1,
    "C2"  : C2
)
FROM T1
WITH CASCADED CHECK OPTION;

--error ER_JDV_WITH_CHECK_OPTION_NOT_SUPPORTED
CREATE OR REPLACE JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1,
    "C2"  : C2
)
FROM T1
WITH LOCAL CHECK OPTION;

--echo #################################################################

--echo # Requirement-14: Existence Check for JSON Duality Views in the ALTER Statement
--echo # During the execution of ALTER statement, if view_name does not
--echo # exist or isn't a duality view, a syntax error should be generated.

--error ER_NO_SUCH_TABLE
ALTER JSON DUALITY VIEW non_existent_view
AS SELECT JSON_DUALITY_OBJECT(
    "_id" : C1
) FROM T1;

--echo #################################################################

--echo # Requirement-15: Restrictions on the ALTER Statement for Duality Views

--echo # 15.1 The ALTER statement for JSON duality views does not support
--echo # specifying a column list.

--error ER_JDV_INVALID_DEFINITION_COLUMN_LIST_NOT_SUPPORTED
ALTER JSON DUALITY VIEW dv1 (data)
AS SELECT JSON_DUALITY_OBJECT(
    "_id" : C1
) FROM T1;

--echo # 15.2 ALTER-ing a JSON DUALITY VIEW with a normal VIEW definition
--echo # and vice versa is not supported, and must result into an error
--echo # if attempted.

--error ER_JDV_ALTER_OR_REPLACE_NOT_SUPPORTED
ALTER VIEW dv1 AS
SELECT * FROM T1;

--error ER_JDV_ALTER_OR_REPLACE_NOT_SUPPORTED
ALTER JSON DUALITY VIEW V1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1
) FROM T1;

--error ER_WRONG_OBJECT
ALTER JSON DUALITY VIEW T1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1
) FROM T1;

--error ER_WRONG_OBJECT
ALTER JSON DUALITY VIEW T4 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1
) FROM T1;

--echo #################################################################

--echo # Requirement-16: Compliance of json_duality_select_statement with Defined
--echo # Syntax and Semantic Rules (Since codepath taken by both CREATE
--echo # and ALTER for syntax/semantic check is same, they should work
--echo # out of the box for ALTER)

--error ER_JDV_INVALID_DEFINITION_DUPLICATE_KEYS_NOT_SUPPORTED
ALTER JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(
    "_id" : C1,
    "C2"  : C2,
    "C2"  : C2
) FROM T1;

--error ER_JDV_INVALID_DEFINITION_ID_KEY_NOT_USED_BY_ROOT_TABLE
ALTER JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(
    "C1" : C1
) FROM T1;

--echo #################################################################

--echo # Requirement-17: Requirements for SHOW CREATE TABLE/VIEW
--echo # The statement SHOW CREATE VIEW view_name must return the
--echo # CREATE JSON DUALITY VIEW statement that was used to create the
--echo # specified view. The output must contain table annotations
--echo # specified in the duality view definition.

SHOW CREATE VIEW dv1;

CREATE OR REPLACE JSON DUALITY VIEW dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH (INSERT, UPDATE, DELETE)
       "_id": T2.C1,
       "C2":  T2.C2,
       "T2": (
              SELECT JSON_DUALITY_OBJECT(WITH (INSERT, UPDATE)
                     "C1": T1.C1,
                     "C2": T1.C2
              )
              FROM T1
              WHERE T1.C1 = T2.C1
       )
) FROM T2;

SHOW CREATE VIEW dv1;

--echo #################################################################
--echo # Successful CREATE scenario

CREATE TABLE T6 (C1 INT PRIMARY KEY, C2 INT);
ALTER TABLE T2 ADD C4 INT REFERENCES T6(C1);

CREATE OR REPLACE
ALGORITHM = MERGE
DEFINER = current_user()
SQL SECURITY DEFINER
JSON RELATIONAL DUALITY VIEW dv1
AS SELECT JSON_DUALITY_OBJECT(
    WITH (INSERT, UPDATE, DELETE)
    "_id" : C1,
    "C2"  : C2,
    "T2"  : (
                SELECT JSON_ARRAYAGG(
                            JSON_DUALITY_OBJECT(
                                "C1" : C1,
                                "C2" : C2,
                                "T6" : (
                                            SELECT JSON_DUALITY_OBJECT(
                                                WITH (INSERT, UPDATE)
                                                "C1" : C1,
                                                "C2" : C2
                                            )
                                            FROM T6
                                            WHERE T6.C1 = T2.C4
                                       )
                            )
                )
                FROM T2
                WHERE T1.C1 = T2.C2
            )
)
FROM T1;

--echo #################################################################

--echo # Requirement-18: Requirements for INFORMATION_SCHEMA.VIEWS

# Test I_S views for JSON duality views created with
# upper case schema name. Output from I_S will differ:
# LCTN=2 will retain case of schema name, LCTN=1 will not.
# Using replace_regex to mask win/mac difference.

CREATE SCHEMA Sch;

CREATE TABLE Sch.EMPLOYEE (
    ID INT PRIMARY KEY,
    NAME VARCHAR(20),
    CITY VARCHAR(20),
    MANAGER INT REFERENCES EMPLOYEE(ID)
);

CREATE OR REPLACE JSON DUALITY VIEW Sch.DV AS
SELECT JSON_DUALITY_OBJECT(
  "_id": e.ID,
  "NAME": e.NAME,
  "CITY": e.CITY,
  "MANAGER": (
    SELECT JSON_DUALITY_OBJECT(
      "ID": m.ID,
      "NAME": m.NAME,
      "CITY": m.CITY
    )
    FROM Sch.EMPLOYEE m
    WHERE e.MANAGER = m.ID
  )
)
FROM Sch.EMPLOYEE e;
SHOW CREATE VIEW Sch.DV;

CREATE VIEW Sch.Vv AS SELECT * FROM Sch.EMPLOYEE;
SHOW CREATE VIEW Sch.Vv;

if (!$on_case_sensitive_file_system)
{
  --replace_regex /Sch/sch/
}
SELECT * FROM INFORMATION_SCHEMA.VIEW_TABLE_USAGE WHERE TABLE_SCHEMA = 'Sch' ORDER BY VIEW_NAME;
if (!$on_case_sensitive_file_system)
{
  --replace_regex /Sch/sch/
}
SELECT * FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEWS ORDER BY TABLE_NAME;
if (!$on_case_sensitive_file_system)
{
  --replace_regex /Sch/sch/
}
SELECT * FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES ORDER BY TABLE_NAME;
if (!$on_case_sensitive_file_system)
{
  --replace_regex /Sch/sch/
}
SELECT * FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS ORDER BY TABLE_NAME;
if (!$on_case_sensitive_file_system)
{
  --replace_regex /Sch/sch/
}
SELECT * FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_LINKS ORDER BY TABLE_NAME;

DROP VIEW Sch.Vv;
DROP VIEW Sch.DV;
DROP TABLE Sch.EMPLOYEE;
DROP SCHEMA Sch;

--echo #################################################################

--echo # Requirement-19: Requirements for DROP VIEW

--echo # 19.1 If a duality view with the view_name is present, regardless
--echo # of whether IF EXISTS clause is there or not, the statement
--echo # DROP VIEW must drop the view.

DROP VIEW V1;
DROP VIEW IF EXISTS dv1, dv2;

--echo # 19.2 If duality view with the view_name is not present and
--echo # IF EXISTS flag:
--echo # 19.2.1 is supplied, the statement must succeed with warning.

# warning ER_BAD_TABLE_ERROR
DROP VIEW IF EXISTS non_existent_view;

--echo # 18.2.2 is not supplied, the statement must report an error.

--error ER_BAD_TABLE_ERROR
DROP VIEW non_existent_view;

--echo #################################################################

DROP TABLE T1, T2, T3, T4, T5, T6, T1_TEMP, T2_TEMP, T3_TEMP;

--echo #################################################################

--echo #################################################################
--echo # WL#17054: granular table and column annotations
--echo #################################################################

--echo # Shared tables for DDL and metadata tests.
--echo #

CREATE TABLE gct_base (
  id INT PRIMARY KEY,
  check_value INT,
  no_check_value INT,
  update_value INT,
  no_update_value INT,
  default_value INT DEFAULT 700
);

CREATE TABLE gct_singleton (
  id INT PRIMARY KEY,
  check_value INT,
  no_check_value INT,
  update_value INT,
  no_update_value INT
);

CREATE TABLE gct_parent (
  id INT PRIMARY KEY,
  singleton_id INT,
  check_value INT,
  no_check_value INT,
  FOREIGN KEY (singleton_id) REFERENCES gct_singleton(id)
);

CREATE TABLE gct_nested (
  id INT PRIMARY KEY,
  parent_id INT,
  check_value INT,
  no_check_value INT,
  FOREIGN KEY (parent_id) REFERENCES gct_parent(id)
);

INSERT INTO gct_base VALUES (1, 10, 20, 30, 40, 50);
INSERT INTO gct_singleton VALUES (10, 100, 200, 300, 400);
INSERT INTO gct_parent VALUES (1, 10, 1000, 2000);
INSERT INTO gct_nested VALUES (100, 1, 10000, 20000),
                              (101, 1, 10001, 20001);

--echo #
--echo # 20.1. Table-level CHECK and NO CHECK tags
--echo #

--echo # 20.1.1: explicit CHECK is accepted on a root table.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH CHECK
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;

--echo # The explicit root CHECK setting is visible in table metadata.
SELECT TABLE_NAME, REFERENCED_TABLE_NAME, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view';

DROP VIEW gct_view;

--echo # 20.1.1: explicit CHECK is accepted independently on root,
--echo # singleton, and nested tables.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH CHECK
  "_id" : p.id,
  "check_value" : p.check_value,
  "singleton" : (
    SELECT JSON_DUALITY_OBJECT(
      WITH CHECK
      "id" : s.id,
      "check_value" : s.check_value
    )
    FROM gct_singleton AS s
    WHERE s.id = p.singleton_id
  ),
  "nested" : (
    SELECT JSON_ARRAYAGG(
      JSON_DUALITY_OBJECT(
        WITH CHECK
        "id" : n.id,
        "check_value" : n.check_value
      )
    )
    FROM gct_nested AS n
    WHERE n.parent_id = p.id
  )
)
FROM gct_parent AS p;

--echo # Recording the document verifies that all three annotated levels are usable.
SELECT data FROM gct_view;

--echo # Table metadata records CHECK for all projected levels.
SELECT REFERENCED_TABLE_NAME, ALLOW_CHECK, IS_ROOT_TABLE
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY REFERENCED_TABLE_NAME;

DROP VIEW gct_view;

--echo # 20.1.2: explicit NO CHECK is accepted independently on root and
--echo # child tables.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH NO CHECK
  "_id" : p.id,
  "check_value" : p.check_value,
  "singleton" : (
    SELECT JSON_DUALITY_OBJECT(
      WITH (UPDATE, NO CHECK)
      "id" : s.id,
      "check_value" : s.check_value
    )
    FROM gct_singleton AS s
    WHERE s.id = p.singleton_id
  ),
  "nested" : (
    SELECT JSON_ARRAYAGG(
      JSON_DUALITY_OBJECT(
        WITH (INSERT, UPDATE, DELETE, NO CHECK)
        "id" : n.id,
        "check_value" : n.check_value
      )
    )
    FROM gct_nested AS n
    WHERE n.parent_id = p.id
  )
)
FROM gct_parent AS p;

--echo # Table metadata records NO CHECK for all projected levels.
SELECT REFERENCED_TABLE_NAME, ALLOW_CHECK, IS_ROOT_TABLE
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY REFERENCED_TABLE_NAME;

DROP VIEW gct_view;

--echo # 20.1.3: omitting a table CHECK tag defaults its columns to CHECK.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;

--echo # The default CHECK value is visible at both table and column level.
SELECT 'TABLE' AS OBJECT_TYPE, REFERENCED_TABLE_NAME AS OBJECT_NAME,
       ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
UNION ALL
SELECT 'COLUMN', JSON_KEY_NAME, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY OBJECT_TYPE, OBJECT_NAME;

DROP VIEW gct_view;

--echo # 20.1.3: omitted table and column CHECK tags default to CHECK at
--echo # root, singleton-child, and nested-child levels.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : p.id,
  "check_value" : p.check_value,
  "singleton" : (
    SELECT JSON_DUALITY_OBJECT(
      "id" : s.id,
      "check_value" : s.check_value
    )
    FROM gct_singleton AS s
    WHERE s.id = p.singleton_id
  ),
  "nested" : (
    SELECT JSON_ARRAYAGG(
      JSON_DUALITY_OBJECT(
        "id" : n.id,
        "check_value" : n.check_value
      )
    )
    FROM gct_nested AS n
    WHERE n.parent_id = p.id
  )
)
FROM gct_parent AS p;

SELECT REFERENCED_TABLE_NAME, ALLOW_CHECK, IS_ROOT_TABLE
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY REFERENCED_TABLE_NAME;

SELECT REFERENCED_TABLE_NAME, JSON_KEY_NAME, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY REFERENCED_TABLE_NAME, JSON_KEY_NAME;

DROP VIEW gct_view;

--echo # 20.1.4: a single CHECK tag is accepted without parentheses.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH CHECK
  "_id" : id
)
FROM gct_base;
DROP VIEW gct_view;

--echo # A single CHECK tag is accepted with parentheses.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (CHECK)
  "_id" : id
)
FROM gct_base;
DROP VIEW gct_view;

--echo # A single NO CHECK tag is accepted without parentheses.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH NO CHECK
  "_id" : id
)
FROM gct_base;
DROP VIEW gct_view;

--echo # A single NO CHECK tag is accepted with parentheses.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (NO CHECK)
  "_id" : id
)
FROM gct_base;
DROP VIEW gct_view;

--echo # 20.1.5: CHECK can appear first in a valid table-tag group.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (CHECK, INSERT, NO UPDATE, NO DELETE)
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;
SELECT ALLOW_INSERT, ALLOW_UPDATE, ALLOW_DELETE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view';
DROP VIEW gct_view;

--echo # CHECK can appear in the middle of a valid table-tag group.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT, CHECK, NO UPDATE, NO DELETE)
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;
SELECT ALLOW_INSERT, ALLOW_UPDATE, ALLOW_DELETE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view';
DROP VIEW gct_view;

--echo # NO CHECK can appear last in a valid table-tag group.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT, NO UPDATE, NO DELETE, NO CHECK)
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;
SELECT ALLOW_INSERT, ALLOW_UPDATE, ALLOW_DELETE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view';
DROP VIEW gct_view;

--echo # 20.1.6: multiple table tags without parentheses are rejected
--echo # with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH CHECK, UPDATE
  "_id" : id
)
FROM gct_base;

--echo # A missing comma in a table-tag group fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (CHECK UPDATE)
  "_id" : id
)
FROM gct_base;

--echo # An extra comma in a table-tag group fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (CHECK,, UPDATE)
  "_id" : id
)
FROM gct_base;

--echo # A trailing comma in a table-tag group fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (CHECK,)
  "_id" : id
)
FROM gct_base;

--echo # An empty table-tag group fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH ()
  "_id" : id
)
FROM gct_base;

--echo # A restrictive table tag without a space fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH NOCHECK
  "_id" : id
)
FROM gct_base;

--echo # Table-level NOUPDATE without a space fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH NOUPDATE
  "_id" : id
)
FROM gct_base;

--echo # A repeated table-level WITH keyword fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH WITH CHECK
  "_id" : id
)
FROM gct_base;

--echo # 20.1.7: a duplicate CHECK table tag is rejected with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (CHECK, CHECK)
  "_id" : id
)
FROM gct_base;

--echo # Duplicate NO CHECK fails with ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (NO CHECK, NO CHECK)
  "_id" : id
)
FROM gct_base;

--echo # Duplicate INSERT fails with ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT, INSERT)
  "_id" : id
)
FROM gct_base;

--echo # Duplicate UPDATE fails with ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, UPDATE)
  "_id" : id
)
FROM gct_base;

--echo # Duplicate DELETE fails with ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (DELETE, DELETE)
  "_id" : id
)
FROM gct_base;

--echo # 20.1.8: CHECK followed by NO CHECK is rejected as conflicting
--echo # with ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (CHECK, NO CHECK)
  "_id" : id
)
FROM gct_base;

--echo # Conflicting NO CHECK, CHECK fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (NO CHECK, CHECK)
  "_id" : id
)
FROM gct_base;

--echo # Conflicting INSERT, NO INSERT fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT, NO INSERT)
  "_id" : id
)
FROM gct_base;

--echo # Conflicting NO UPDATE, UPDATE fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (NO UPDATE, UPDATE)
  "_id" : id
)
FROM gct_base;

--echo # Conflicting DELETE, NO DELETE fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (DELETE, NO DELETE)
  "_id" : id
)
FROM gct_base;

--echo # 20.1.9: raw table annotations are rejected in a standalone SELECT
--echo # with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
SELECT id FROM gct_base WITH CHECK;

--echo # Raw table annotations in a regular view fail with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE VIEW gct_regular_view AS
SELECT * FROM gct_base WITH CHECK;

--echo # Raw table annotations in CTAS fail with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE TABLE gct_bad_ctas AS SELECT id FROM gct_base WITH CHECK;

--echo # Raw annotations inside JSON_OBJECT fail with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
SELECT JSON_OBJECT(WITH CHECK "id": id) FROM gct_base;

--echo # 20.1.10: a syntactically valid tagged JSON_DUALITY_OBJECT is rejected in a
--echo # standalone SELECT with ER_JDV_INVALID_JSON_DUALITY_OBJECT_USAGE.
--error ER_JDV_INVALID_JSON_DUALITY_OBJECT_USAGE
SELECT JSON_DUALITY_OBJECT(
  WITH CHECK
  "_id" : id
)
FROM gct_base;

--echo # Tagged JSON_DUALITY_OBJECT in a regular view fails with
--echo # ER_JDV_INVALID_JSON_DUALITY_OBJECT_USAGE.
--error ER_JDV_INVALID_JSON_DUALITY_OBJECT_USAGE
CREATE VIEW gct_regular_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH CHECK
  "_id" : id
)
FROM gct_base;

--echo # 20.1.11: CHECK does not relax the existing rule that forbids DELETE on a
--echo # singleton child joined through the child's primary key.
--echo # ER_JDV_INVALID_TABLE_ANNOTATIONS_FOR_SINGLETON_OBJ is expected.
--error ER_JDV_INVALID_TABLE_ANNOTATIONS_FOR_SINGLETON_OBJ
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH UPDATE
  "_id" : p.id,
  "singleton" : (
    SELECT JSON_DUALITY_OBJECT(
      WITH (INSERT, UPDATE, DELETE, CHECK)
      "id" : s.id,
      "check_value" : s.check_value
    )
    FROM gct_singleton AS s
    WHERE s.id = p.singleton_id
  )
)
FROM gct_parent AS p;

--echo # 20.1.12: ALTER can replace a default table setting with NO CHECK.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;

ALTER JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH NO CHECK
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;

--echo # Metadata reflects the replacement definition after ALTER.
SELECT REFERENCED_TABLE_NAME, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view';

--disable_query_log
SELECT JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
  INTO @alter_table_no_check_etag
FROM gct_view;
--enable_query_log

--echo # The altered NO CHECK definition ignores direct value changes in ETAG.
UPDATE gct_base SET check_value = 11 WHERE id = 1;
SELECT @alter_table_no_check_etag =
       JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
       AS altered_table_no_check_keeps_etag
FROM gct_view;

--echo # The altered default NO UPDATE permission rejects JDV DML with
--echo # ER_JDV_MISSING_UPDATE_TAG.
--error ER_JDV_MISSING_UPDATE_TAG
UPDATE gct_view
SET data = JSON_SET(data, '$.check_value', 12)
WHERE data->>'$._id' = 1;

--echo # ALTER can reverse NO CHECK to CHECK while retaining UPDATE.
ALTER JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;

SELECT REFERENCED_TABLE_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view';

--disable_query_log
SELECT JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
  INTO @alter_table_check_etag
FROM gct_view;
--enable_query_log

--echo # The altered UPDATE permission allows JDV DML, and CHECK changes ETAG.
UPDATE gct_view
SET data = JSON_SET(data, '$.check_value', 12)
WHERE data->>'$._id' = 1;

SELECT @alter_table_check_etag <>
       JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
       AS altered_table_check_changes_etag
FROM gct_view;
SELECT id, check_value FROM gct_base;

--echo # ALTER can remove the explicit CHECK tag and restore default CHECK.
ALTER JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH UPDATE
  "_id" : id,
  "check_value" : check_value
)
FROM gct_base;

SHOW CREATE VIEW gct_view;
SELECT REFERENCED_TABLE_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view';

DROP VIEW gct_view;

--echo #
--echo # 20.2. Column-level CHECK, NO CHECK, UPDATE, and NO UPDATE tags
--echo #

--echo # 20.2.1: all four supported column tags are accepted on non-PK
--echo # projections.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id WITH NO CHECK,
  "checked" : check_value WITH CHECK,
  "not_checked" : no_check_value WITH NO CHECK,
  "updatable" : update_value WITH UPDATE,
  "not_updatable" : no_update_value WITH NO UPDATE
)
FROM gct_base;

--echo # Column metadata records the effective setting of every projection.
SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;

DROP VIEW gct_view;

--echo # Parenthesized single column tags are accepted.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id WITH (CHECK),
  "checked" : check_value WITH (CHECK),
  "not_checked" : no_check_value WITH (NO CHECK),
  "updatable" : update_value WITH (UPDATE),
  "not_updatable" : no_update_value WITH (NO UPDATE)
)
FROM gct_base;
DROP VIEW gct_view;

--echo # 20.2.2: untagged columns inherit NO CHECK and NO UPDATE from
--echo # their table.
--echo # 20.2.3: explicit column tags override both inherited settings.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (NO UPDATE, NO CHECK)
  "_id" : id,
  "inherited" : check_value,
  "overridden" : update_value WITH (UPDATE, CHECK)
)
FROM gct_base;

SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;

DROP VIEW gct_view;

--echo # Untagged non-PK columns inherit UPDATE and CHECK from their table.
--echo # Explicit NO UPDATE and NO CHECK override both inherited settings.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id,
  "inherited" : check_value,
  "overridden" : no_check_value WITH (NO UPDATE, NO CHECK)
)
FROM gct_base;

SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;

DROP VIEW gct_view;

--echo # 20.2.4: valid column-tag groups are order agnostic.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id,
  "first_order" : check_value WITH (CHECK, UPDATE),
  "second_order" : no_check_value WITH (UPDATE, CHECK),
  "restrictive_order" : no_update_value WITH (NO CHECK, NO UPDATE)
)
FROM gct_base;

SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;

DROP VIEW gct_view;

--echo # 20.2.5: multiple column tags without parentheses are rejected
--echo # with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH CHECK, UPDATE
)
FROM gct_base;

--echo # A missing comma in a column-tag group fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (CHECK UPDATE)
)
FROM gct_base;

--echo # An extra comma in a column-tag group fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (CHECK,, UPDATE)
)
FROM gct_base;

--echo # A trailing comma in a column-tag group fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (CHECK,)
)
FROM gct_base;

--echo # An empty column-tag group fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH ()
)
FROM gct_base;

--echo # Column-level NOUPDATE without a space fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH NOUPDATE
)
FROM gct_base;

--echo # Column-level NOCHECK without a space fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH NOCHECK
)
FROM gct_base;

--echo # A repeated column-level WITH keyword fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH WITH CHECK
)
FROM gct_base;

--echo # 20.2.6: INSERT is not a supported column annotation and fails
--echo # with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH INSERT
)
FROM gct_base;

--echo # Column-level NO INSERT fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH NO INSERT
)
FROM gct_base;

--echo # Column-level DELETE fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH DELETE
)
FROM gct_base;

--echo # Column-level NO DELETE fails with ER_PARSE_ERROR.
--error ER_PARSE_ERROR
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH NO DELETE
)
FROM gct_base;

--echo # 20.2.7: a duplicate CHECK column tag is rejected with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (CHECK, CHECK)
)
FROM gct_base;

--echo # Duplicate column NO UPDATE fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (NO UPDATE, NO UPDATE)
)
FROM gct_base;

--echo # Duplicate column NO CHECK fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (NO CHECK, NO CHECK)
)
FROM gct_base;

--echo # Duplicate column UPDATE fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (UPDATE, UPDATE)
)
FROM gct_base;

--echo # 20.2.8: CHECK and NO CHECK are conflicting column annotations and
--echo # fail with ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (CHECK, NO CHECK)
)
FROM gct_base;

--echo # Conflicting column NO CHECK, CHECK fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (NO CHECK, CHECK)
)
FROM gct_base;

--echo # Conflicting column NO UPDATE, UPDATE fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (NO UPDATE, UPDATE)
)
FROM gct_base;

--echo # Conflicting column UPDATE, NO UPDATE fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH (UPDATE, NO UPDATE)
)
FROM gct_base;

--echo # 20.2.9: column annotations cannot be attached to a singleton
--echo # child subquery; ER_JDV_COLUMN_TAG_NOT_SUPPORTED_FOR_SUBQUERY is expected.
--error ER_JDV_COLUMN_TAG_NOT_SUPPORTED_FOR_SUBQUERY
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : p.id,
  "singleton" : (
    SELECT JSON_DUALITY_OBJECT(
      "id" : s.id
    )
    FROM gct_singleton AS s
    WHERE s.id = p.singleton_id
  ) WITH CHECK
)
FROM gct_parent AS p;

--echo # A nested-subquery column tag fails with
--echo # ER_JDV_COLUMN_TAG_NOT_SUPPORTED_FOR_SUBQUERY.
--error ER_JDV_COLUMN_TAG_NOT_SUPPORTED_FOR_SUBQUERY
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : p.id,
  "nested" : (
    SELECT JSON_ARRAYAGG(
      JSON_DUALITY_OBJECT(
        "id" : n.id
      )
    )
    FROM gct_nested AS n
    WHERE n.parent_id = p.id
  ) WITH NO CHECK
)
FROM gct_parent AS p;

--echo # 20.2.10: column annotations cannot be attached to a computed scalar;
--echo # ER_JDV_INVALID_DEFINITION_WRONG_FIELD_TYPE is expected.
--error ER_JDV_INVALID_DEFINITION_WRONG_FIELD_TYPE
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "computed" : (check_value + 1) WITH CHECK
)
FROM gct_base;

--echo # A column annotation on a literal fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_FIELD_TYPE.
--error ER_JDV_INVALID_DEFINITION_WRONG_FIELD_TYPE
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "literal" : 1 WITH NO CHECK
)
FROM gct_base;

--echo # A column annotation on a function result fails with
--echo # ER_JDV_INVALID_DEFINITION_WRONG_FIELD_TYPE.
--error ER_JDV_INVALID_DEFINITION_WRONG_FIELD_TYPE
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "function_result" : ABS(check_value) WITH NO UPDATE
)
FROM gct_base;

--echo # 20.2.11: UPDATE on the root PK fails with
--echo # ER_JDV_UPDATE_COLUMN_TAG_NOT_SUPPORTED_FOR_PK.
--error ER_JDV_UPDATE_COLUMN_TAG_NOT_SUPPORTED_FOR_PK
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH UPDATE
  "_id" : id WITH UPDATE,
  "value" : check_value
)
FROM gct_base;

--echo # 20.2.12: UPDATE on a child PK fails with
--echo # ER_JDV_UPDATE_COLUMN_TAG_NOT_SUPPORTED_FOR_PK.
--error ER_JDV_UPDATE_COLUMN_TAG_NOT_SUPPORTED_FOR_PK
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH UPDATE
  "_id" : p.id,
  "singleton" : (
    SELECT JSON_DUALITY_OBJECT(
      WITH UPDATE
      "id" : s.id WITH (UPDATE, CHECK),
      "value" : s.check_value
    )
    FROM gct_singleton AS s
    WHERE s.id = p.singleton_id
  )
)
FROM gct_parent AS p;

--echo # UPDATE on a nested-child PK fails with
--echo # ER_JDV_UPDATE_COLUMN_TAG_NOT_SUPPORTED_FOR_PK.
--error ER_JDV_UPDATE_COLUMN_TAG_NOT_SUPPORTED_FOR_PK
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH UPDATE
  "_id" : p.id,
  "nested" : (
    SELECT JSON_ARRAYAGG(
      JSON_DUALITY_OBJECT(
        WITH UPDATE
        "id" : n.id WITH UPDATE,
        "value" : n.check_value
      )
    )
    FROM gct_nested AS n
    WHERE n.parent_id = p.id
  )
)
FROM gct_parent AS p;

--echo # 20.2.13: CHECK, NO CHECK, and NO UPDATE remain valid on PKs.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH UPDATE
  "_id" : p.id WITH (NO UPDATE, NO CHECK),
  "singleton" : (
    SELECT JSON_DUALITY_OBJECT(
      WITH UPDATE
      "id" : s.id WITH (NO UPDATE, CHECK),
      "value" : s.check_value
    )
    FROM gct_singleton AS s
    WHERE s.id = p.singleton_id
  )
)
FROM gct_parent AS p;

--echo # PK metadata confirms NO UPDATE while retaining each requested CHECK setting.
SELECT REFERENCED_TABLE_NAME, JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
  AND JSON_KEY_NAME IN ('_id', 'id')
ORDER BY REFERENCED_TABLE_NAME, JSON_KEY_NAME;

DROP VIEW gct_view;

--echo # 20.2.14: JSON_DUALITY_OBJECT with column tags in a regular view
--echo # fails with ER_JDV_INVALID_JSON_DUALITY_OBJECT_USAGE.
--error ER_JDV_INVALID_JSON_DUALITY_OBJECT_USAGE
CREATE VIEW gct_regular_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "value" : check_value WITH CHECK
)
FROM gct_base;

--echo # 20.2.15: ALTER can add and reverse column-level overrides.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (NO UPDATE, NO CHECK)
  "_id" : id,
  "value" : check_value
)
FROM gct_base;

ALTER JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id,
  "value" : check_value WITH (NO UPDATE, NO CHECK)
)
FROM gct_base;

--echo # Column metadata reflects the replacement definition after ALTER.
SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;

--disable_query_log
SELECT JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
  INTO @alter_column_no_check_etag
FROM gct_view;
--enable_query_log

--echo # The altered column NO CHECK override preserves ETAG on direct change.
UPDATE gct_base SET check_value = 13 WHERE id = 1;
SELECT @alter_column_no_check_etag =
       JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
       AS altered_column_no_check_keeps_etag
FROM gct_view;

--echo # The altered column NO UPDATE override rejects JDV DML with
--echo # ER_JDV_MISSING_UPDATE_TAG.
--error ER_JDV_MISSING_UPDATE_TAG
UPDATE gct_view
SET data = JSON_SET(data, '$.value', 14)
WHERE data->>'$._id' = 1;

--echo # ALTER can remove the column override and restore table inheritance.
ALTER JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id,
  "value" : check_value
)
FROM gct_base;

SHOW CREATE VIEW gct_view;
SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;

--disable_query_log
SELECT JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
  INTO @alter_column_check_etag
FROM gct_view;
--enable_query_log

--echo # Removing the override restores UPDATE and CHECK behavior.
UPDATE gct_view
SET data = JSON_SET(data, '$.value', 14)
WHERE data->>'$._id' = 1;

SELECT @alter_column_check_etag <>
       JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
       AS altered_column_check_changes_etag
FROM gct_view;
SELECT id, check_value FROM gct_base;

DROP VIEW gct_view;

--echo # Shared DDL tables are no longer needed.
DROP TABLE gct_nested;
DROP TABLE gct_parent;
DROP TABLE gct_singleton;
DROP TABLE gct_base;

--echo #

--echo # 20.3. SHOW CREATE version comments and semantic round trips
--echo #

CREATE TABLE gct_show (
  id INT PRIMARY KEY,
  value_check INT,
  value_no_check INT,
  value_update INT,
  value_no_update INT,
  value_update_check INT,
  value_update_no_check INT,
  value_no_update_check INT,
  value_no_update_no_check INT
);

INSERT INTO gct_show VALUES (1, 10, 20, 30, 40, 50, 60, 70, 80);

--echo # 20.3.1: standalone table CHECK is emitted as the complete
--echo # versioned clause /*!261000 WITH (CHECK) */.
CREATE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH CHECK
  "_id" : id,
  "value" : value_check
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.1: standalone table NO CHECK is emitted as the complete
--echo # versioned clause /*!261000 WITH (NO CHECK) */.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH NO CHECK
  "_id" : id,
  "value" : value_no_check
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.2: when CHECK follows a positive CRUD tag, only CHECK and
--echo # its connecting comma are inside the version comment.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT, CHECK)
  "_id" : id,
  "value" : value_check
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.2: when CHECK precedes a restrictive CRUD tag, its trailing
--echo # connecting comma is inside the version comment.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (CHECK, NO INSERT)
  "_id" : id,
  "value" : value_check
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.2: CHECK between positive and restrictive tags keeps valid
--echo # SQL when the versioned fragment is removed.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT, CHECK, NO UPDATE)
  "_id" : id,
  "value" : value_check
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.2: NO CHECK after a positive CRUD tag versions its leading
--echo # connecting comma with the tag.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT, NO CHECK)
  "_id" : id,
  "value" : value_no_check
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.2: NO CHECK before a restrictive CRUD tag versions its
--echo # trailing connecting comma with the tag.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (NO CHECK, NO INSERT)
  "_id" : id,
  "value" : value_no_check
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.2: NO CHECK between positive and restrictive tags keeps
--echo # valid SQL when the versioned fragment is removed.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT, NO CHECK, NO UPDATE)
  "_id" : id,
  "value" : value_no_check
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.3: every standalone and grouped column tag is versioned as
--echo # one complete column WITH clause.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "check" : value_check WITH CHECK,
  "no_check" : value_no_check WITH NO CHECK,
  "update" : value_update WITH UPDATE,
  "no_update" : value_no_update WITH NO UPDATE,
  "update_check" : value_update_check WITH (UPDATE, CHECK),
  "update_no_check" : value_update_no_check WITH (UPDATE, NO CHECK),
  "no_update_check" : value_no_update_check WITH (NO UPDATE, CHECK),
  "no_update_no_check" : value_no_update_no_check
                             WITH (NO UPDATE, NO CHECK)
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.4: existing table UPDATE remains ordinary SQL while the
--echo # accompanying CHECK tag alone is version-commented.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id,
  "value" : value_update
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

--echo # 20.3.4: existing table NO UPDATE likewise remains ordinary SQL
--echo # while only NO CHECK is version-commented.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (NO UPDATE, NO CHECK)
  "_id" : id,
  "value" : value_no_update
)
FROM gct_show;

SHOW CREATE VIEW gct_show_view;

DROP VIEW gct_show_view;
DROP TABLE gct_show;

--echo # 20.3.5: create a mixed-tag source view for an executable
--echo # SHOW CREATE version-comment round trip.
CREATE TABLE gct_roundtrip (
  id INT PRIMARY KEY,
  mutable_value INT,
  protected_value INT
);

INSERT INTO gct_roundtrip VALUES (1, 10, 20);

CREATE JSON DUALITY VIEW gct_roundtrip_source AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id,
  "mutable_value" : mutable_value WITH (UPDATE, CHECK),
  "protected_value" : protected_value WITH (NO UPDATE, NO CHECK)
)
FROM gct_roundtrip;

--echo # Record the canonical version comments emitted for the source.
SHOW CREATE VIEW gct_roundtrip_source;

--echo # Execute that canonical annotation structure under a second name.
--echo # Removing every /*!261000 ... */ fragment leaves pre-WL valid SQL.
--let $roundtrip_ddl = query_get_value(SHOW CREATE VIEW gct_roundtrip_source, Create View, 1)
--let $roundtrip_select = `SELECT SUBSTR("$roundtrip_ddl", INSTR("$roundtrip_ddl", ' as select ') + CHAR_LENGTH(' as '))`
--eval CREATE JSON DUALITY VIEW gct_roundtrip_copy AS $roundtrip_select

SHOW CREATE VIEW gct_roundtrip_copy;

--echo # Source and recreated views produce the same document and ETAG.
SELECT data FROM gct_roundtrip_source;
SELECT data FROM gct_roundtrip_copy;

--echo # Source and recreated columns have identical effective permissions.
SELECT source.JSON_KEY_NAME,
       source.ALLOW_CHECK = copy.ALLOW_CHECK AS same_allow_check,
       source.ALLOW_UPDATE = copy.ALLOW_UPDATE AS same_allow_update
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS AS source
JOIN INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS AS copy
  ON copy.TABLE_SCHEMA = source.TABLE_SCHEMA
 AND copy.JSON_KEY_NAME = source.JSON_KEY_NAME
 AND copy.TABLE_NAME = 'gct_roundtrip_copy'
WHERE source.TABLE_SCHEMA = DATABASE()
  AND source.TABLE_NAME = 'gct_roundtrip_source'
ORDER BY source.JSON_KEY_NAME;

--echo # An allowed mutable update succeeds through the source definition.
UPDATE gct_roundtrip_source
SET data = JSON_SET(data, '$.mutable_value', 11)
WHERE data->>'$._id' = 1;

SELECT id, mutable_value, protected_value FROM gct_roundtrip;
UPDATE gct_roundtrip SET mutable_value = 10 WHERE id = 1;

--echo # The equivalent mutable update succeeds through the recreated view.
UPDATE gct_roundtrip_copy
SET data = JSON_SET(data, '$.mutable_value', 11)
WHERE data->>'$._id' = 1;

SELECT id, mutable_value, protected_value FROM gct_roundtrip;
UPDATE gct_roundtrip SET mutable_value = 10 WHERE id = 1;

--echo # The source rejects a protected change with ER_JDV_MISSING_UPDATE_TAG.
--error ER_JDV_MISSING_UPDATE_TAG
UPDATE gct_roundtrip_source
SET data = JSON_SET(data, '$.protected_value', 21)
WHERE data->>'$._id' = 1;

--echo # The recreated view rejects the protected change with
--echo # ER_JDV_MISSING_UPDATE_TAG.
--error ER_JDV_MISSING_UPDATE_TAG
UPDATE gct_roundtrip_copy
SET data = JSON_SET(data, '$.protected_value', 21)
WHERE data->>'$._id' = 1;

--disable_query_log
SELECT JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
  INTO @roundtrip_source_etag
FROM gct_roundtrip_source;
SELECT JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
  INTO @roundtrip_copy_etag
FROM gct_roundtrip_copy;
--enable_query_log

--echo # A direct NO CHECK change preserves ETAG in both definitions.
UPDATE gct_roundtrip SET protected_value = 21 WHERE id = 1;

SELECT @roundtrip_source_etag =
       JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
       AS source_no_check_keeps_etag
FROM gct_roundtrip_source;
SELECT @roundtrip_copy_etag =
       JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
       AS copy_no_check_keeps_etag
FROM gct_roundtrip_copy;

DROP VIEW gct_roundtrip_copy;
DROP VIEW gct_roundtrip_source;

--echo # 20.3.6: SHOW CREATE for an untagged view does not inject an
--echo # explicit CHECK clause, while effective CHECK still defaults to 1.
CREATE JSON DUALITY VIEW gct_untagged_source AS
SELECT JSON_DUALITY_OBJECT(
  "_id" : id,
  "mutable_value" : mutable_value,
  "protected_value" : protected_value
)
FROM gct_roundtrip;

SHOW CREATE VIEW gct_untagged_source;

--echo # Recreate the emitted untagged definition under a second name.
--let $untagged_ddl = query_get_value(SHOW CREATE VIEW gct_untagged_source, Create View, 1)
--let $untagged_select = `SELECT SUBSTR("$untagged_ddl", INSTR("$untagged_ddl", ' as select ') + CHAR_LENGTH(' as '))`
--eval CREATE JSON DUALITY VIEW gct_untagged_copy AS $untagged_select

--echo # Both untagged definitions retain default CHECK semantics and output.
SELECT TABLE_NAME, JSON_KEY_NAME, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE()
  AND TABLE_NAME IN ('gct_untagged_source', 'gct_untagged_copy')
ORDER BY TABLE_NAME, JSON_KEY_NAME;

SELECT data FROM gct_untagged_source;
SELECT data FROM gct_untagged_copy;

DROP VIEW gct_untagged_copy;
DROP VIEW gct_untagged_source;
DROP TABLE gct_roundtrip;

--echo # 20.4: failed CREATE OR REPLACE and ALTER leave an existing JDV intact.
CREATE TABLE gct_atomicity (
  id INT PRIMARY KEY,
  mutable_value INT
);

INSERT INTO gct_atomicity VALUES (1, 10);

CREATE JSON DUALITY VIEW gct_atomicity_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK)
  "_id" : id,
  "mutable_value" : mutable_value
)
FROM gct_atomicity;

--echo # A duplicate CHECK annotation prevents CREATE OR REPLACE.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
CREATE OR REPLACE JSON DUALITY VIEW gct_atomicity_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK, CHECK)
  "_id" : id,
  "mutable_value" : mutable_value
)
FROM gct_atomicity;

--echo # The same new annotation violation prevents ALTER.
--error ER_JDV_INVALID_DEFINITION_WRONG_ANNOTATIONS
ALTER JSON DUALITY VIEW gct_atomicity_view AS
SELECT JSON_DUALITY_OBJECT(
  WITH (UPDATE, CHECK, CHECK)
  "_id" : id,
  "mutable_value" : mutable_value
)
FROM gct_atomicity;

--echo # The original definition and its UPDATE behavior remain intact.
SHOW CREATE VIEW gct_atomicity_view;

UPDATE gct_atomicity_view
SET data = JSON_SET(data, '$.mutable_value', 11)
WHERE data->>'$._id' = 1;

SELECT id, mutable_value FROM gct_atomicity;

DROP VIEW gct_atomicity_view;
DROP TABLE gct_atomicity;

--echo ###############################################################################
