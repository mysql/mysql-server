--echo #
--echo # Bug#39566804: FK constraints may be violated when update deletes from
--echo # nested child base table.
--echo #

CREATE TABLE course (
  id INT UNSIGNED NOT NULL AUTO_INCREMENT,
  name VARCHAR(75) NOT NULL,
  address VARCHAR(75) NOT NULL,
  address2 VARCHAR(75) DEFAULT NULL,
  city VARCHAR(50) NOT NULL,
  state VARCHAR(2) NOT NULL,
  zip VARCHAR(10) NOT NULL,
  phone VARCHAR(14) NOT NULL,
  abbrev VARCHAR(6) DEFAULT NULL,
  PRIMARY KEY (id)
);

CREATE TABLE hole_group (
  id INT UNSIGNED NOT NULL AUTO_INCREMENT,
  name VARCHAR(75) NOT NULL,
  sort_order INT NOT NULL DEFAULT '0',
  slope DECIMAL(10,2) NOT NULL DEFAULT '113.00',
  rating DECIMAL(10,2) NOT NULL DEFAULT '72.00',
  course_id INT UNSIGNED DEFAULT NULL,
  PRIMARY KEY (id),
  KEY holegroup_course_id_index (course_id),
  KEY holegroup_sort_order_index (sort_order),
  CONSTRAINT holegroup_course_id_fk FOREIGN KEY (course_id) REFERENCES course (id)
);

CREATE TABLE hole (
  id INT UNSIGNED NOT NULL AUTO_INCREMENT,
  number INT NOT NULL DEFAULT '0',
  handicap INT NOT NULL DEFAULT '0',
  par INT NOT NULL DEFAULT '0',
  hole_group_id INT UNSIGNED DEFAULT NULL,
  PRIMARY KEY (id),
  KEY hole_hole_group_id_index (hole_group_id),
  KEY hole_number_index (number),
  CONSTRAINT hole_holegroup_id_fk FOREIGN KEY (hole_group_id) REFERENCES hole_group (id)
);

CREATE
ALGORITHM=UNDEFINED SQL SECURITY INVOKER
JSON RELATIONAL DUALITY VIEW course_dv AS
SELECT JSON_DUALITY_OBJECT(
  WITH (INSERT,UPDATE,DELETE)
  '_id': course.id,
  'name': course.name,
  'address': course.address,
  'address2': course.address2,
  'city': course.city,
  'state': course.state,
  'zip': course.zip,
  'phone': course.phone,
  'abbrev': course.abbrev,
  'holeGroups':(
    SELECT JSON_ARRAYAGG(
      JSON_DUALITY_OBJECT(
        WITH (INSERT,UPDATE,DELETE)
        'id': hole_group.id,
        'name': hole_group.name,
        'sort_order': hole_group.sort_order,
        'slope': hole_group.slope,
        'rating': hole_group.rating,
        'course_id': hole_group.course_id,
        'holes':(
          SELECT JSON_ARRAYAGG(
            JSON_DUALITY_OBJECT(
              WITH (INSERT,UPDATE,DELETE)
              'id': hole.id,
              'number': hole.number,
              'handicap': hole.handicap,
              'par': hole.par,
              'hole_group_id': hole.hole_group_id))
          FROM hole WHERE (hole.hole_group_id = hole_group.id))))
    FROM hole_group WHERE (hole_group.course_id = course.id))) AS Name_exp_1
FROM course;


