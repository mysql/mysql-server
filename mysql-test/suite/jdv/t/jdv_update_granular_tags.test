#
# Test file contains cases to verify update operations on JSON duality view with
# granular table tags.
#

--echo #################################################################################
--echo # Verify warning messages aggregation for JSON duality view object update.

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f3 INT PRIMARY KEY, f4 INT);

INSERT INTO p_t1 VALUES (1, 1);
INSERT INTO p_t2 VALUES (1, 1);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
              "_id" : f3,
              "f4" : f4,
              "ChildNode" : (SELECT JSON_DUALITY_OBJECT(WITH UPDATE
                                               "f1" : f1,
                                               "f2" : f2)
                            FROM p_t1
                            WHERE p_t1.f1 = p_t2.f3)
            ) FROM p_t2 ;

SELECT * FROM p_dv1;
UPDATE p_dv1 SET data = ' { "_id" : 1, "f4" : 4, "ChildNode" : {"f1" : 1, "f2" : 4 }, "_metadata": {"etag": "1ec721700727fedd824e5146fad497e5"} }';
SELECT * FROM p_dv1;

UPDATE p_dv1 SET data = JSON_SET(data, '$.f4', 5);
SELECT * FROM p_dv1;

SET @orig_sql_mode = @@sql_mode;
SET sql_mode = 0;
UPDATE p_dv1 SET data = ' { "_id" : 1, "f4" : "123abcd", "ChildNode" : {"f1" : 1, "f2" : "123abcd" }, "_metadata": {"etag": "5b02ec9cc10b96a4e4d9cfa3fe12d718"} }';
SET @@sql_mode = @orig_sql_mode;

SELECT * FROM p_dv1;

DROP TABLE p_t1;
DROP TABLE p_t2;

--echo ################################################################################

--echo # Updating new Root object. (No Sub-object for view)
--echo # Root object - Primary key   Table annotations: READ_ONLY

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);

INSERT INTO p_t1 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(
                    WITH (NO INSERT, NO UPDATE, NO DELETE)
                    "_id" : f1,
                    "f2" : f2
                  ) FROM p_t1;

--error ER_JDV_MISSING_UPDATE_TAG
UPDATE p_dv1 SET data = '{ "_id" : 1, "f2" : 1 } ';

DROP TABLE p_t1;

--echo ################################################################################

--echo # Updating new Root object.
--echo # Root object - Primary key   Table annotations: UPDATE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);

INSERT INTO p_t1 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
                    "_id" : f1,
                    "f2" : f2
                  ) FROM p_t1 ;

--error ER_JDV_PRIMARY_KEY_MUST_BE_PROVIDED
UPDATE p_dv1 SET data = '{}';
SELECT * FROM p_dv1;

--error ER_JDV_NULL_UPDATE_VALUE
UPDATE p_dv1 SET data = NULL;
SELECT * FROM p_dv1;

UPDATE p_dv1 SET data = '{ "_id" : 1, "f2" : 1, "_metadata": {"etag": "c05bfee044e2572d142725a5bf6e8bf4"} } ';
SELECT * FROM p_dv1;

DROP TABLE p_t1;

--echo ################################################################################

--echo # Updating Root Object's Primary Key column.
--echo # Root object - Foreign Key  Table annotations: UPDATE
--echo # Sub-object - Primary Key   Table annotations: UPDATE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY REFERENCES p_t1(f1), f12 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
    '_id' : f11,
    'f12' : f12,
    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH UPDATE
                        'f1' : f1,
                        'f2' : f2
                        )) FROM p_t1
                        WHERE p_t1.f1 = p_t2.f11)
) FROM p_t2 ;

SELECT * FROM p_dv1;

--error ER_JDV_JOIN_CONDITION_NOT_SATISFIED
UPDATE p_dv1 SET data = ' {
    "_id" : 4,
    "f12" : 2,
    "childN" : [{
                "f1" : 1,
                "f2" : 30
               }]
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ################################################################################

--echo # Updating Root Object's non-primary Key columns. No changes to Sub-object.
--echo # Root object - Foreign Key  Table annotations: UPDATE
--echo # Sub-object - Primary Key   Table annotations: UPDATE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY REFERENCES p_t1(f1), f12 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
    '_id' : f11,
    'f12' : f12,
    'childN' : (SELECT JSON_DUALITY_OBJECT(WITH UPDATE
                        'f1' : f1,
                        'f2' : f2
                    ) FROM p_t1  WHERE p_t1.f1 = p_t2.f11)
) FROM p_t2 ;

SELECT * FROM p_dv1;

UPDATE p_dv1 SET data = ' {
    "_id" : 1,
    "f12" : 3,
    "childN" : {
                "f1" : 1,
                "f2" : 2
               },
    "_metadata": {"etag": "fc4814ef839b66d33df1a52c8dc67d60"}
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ################################################################################

--echo # Updating Root Object's and Sub-object's non-primary Key columns.

--echo ## Root object - Foreign Key  Table annotations: UPDATE
--echo ## Sub-object - Primary Key   Table annotations: READ_ONLY

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY REFERENCES p_t1(f1), f12 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
    '_id' : f11,
    'f12' : f12,
    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(
                        WITH (NO INSERT, NO UPDATE, NO DELETE)
                        'f1' : f1,
                        'f2' : f2
                        )) FROM p_t1 WHERE p_t1.f1 = p_t2.f11)
) FROM p_t2 ;

SELECT * FROM p_dv1;

--error ER_JDV_MISSING_UPDATE_TAG
UPDATE p_dv1 SET data = ' {
    "_id" : 1,
    "f12" : 3,
    "childN" : [{
                "f1" : 1,
                "f2" : 333
               }]
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ## Root object - Foreign Key  Table annotations: UPDATE
--echo ## Sub-object - Primary Key   Table annotations: UPDATE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY REFERENCES p_t1(f1), f12 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
    '_id' : f11,
    'f12' : f12,
    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH UPDATE
                        'f1' : f1,
                        'f2' : f2
                        )) FROM p_t1
                        WHERE p_t1.f1 = p_t2.f11)
) FROM p_t2 ;

SELECT * FROM p_dv1;

UPDATE p_dv1 SET data = ' {
    "_id" : 1,
    "f12" : 3,
    "childN" : [{
                "f1" : 1,
                "f2" : 333
               }],
    "_metadata": {"etag": "8a7cd20305686a6f0127bbf08749fcfe"}
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ## Root object - Foreign Key  Table annotations: READ ONLY
--echo ## Sub-object - Primary Key   Table annotations: UPDATE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY REFERENCES p_t1(f1), f12 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(
    '_id' : f11,
    'f12' : f12,
    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH UPDATE
                        'f1' : f1,
                        'f2' : f2
                        )) FROM p_t1
                        WHERE p_t1.f1 = p_t2.f11)
) FROM p_t2 ;

SELECT * FROM p_dv1;

UPDATE p_dv1 SET data = ' {
    "_id" : 1,
    "f12" : 2,
    "childN" : [{
                "f1" : 1,
                "f2" : 333
               }],
    "_metadata": {"etag": "8a7cd20305686a6f0127bbf08749fcfe"}
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ################################################################################

--echo # Updating Root Object and inserting Sub-object.

--echo ## Root object - Primary Key  Table annotations: UPDATE
--echo ## Sub-object - Primary Key   Table annotations: READ ONLY

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT);

INSERT INTO p_t1 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
    '_id' : f1,
    'f2' : f2,
    'childN' : (SELECT JSON_DUALITY_OBJECT(
                        WITH (NO INSERT, NO UPDATE, NO DELETE)
                        'f11' : f11,
                        'f12' : f12
                    ) FROM p_t2 WHERE p_t1.f1 = p_t2.f11)
) FROM p_t1 ;

SELECT * FROM p_dv1;

--error ER_JDV_MISSING_INSERT_TAG
UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 222,
      "childN" : {"f11" : 1, "f12" : 1 }
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ## Root object - Primary Key  Table annotations: UPDATE
--echo ## Sub-object - Primary Key   Table annotations: INSERT

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT);

INSERT INTO p_t1 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
    '_id' : f1,
    'f2' : f2,
    'childN' : (SELECT JSON_DUALITY_OBJECT(WITH INSERT
                        'f11' : f11,
                        'f12' : f12
                    ) FROM p_t2  WHERE p_t1.f1 = p_t2.f11)
) FROM p_t1 ;

SELECT * FROM p_dv1;

UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 222,
      "childN" : {"f11" : 1, "f12" : 1 },
      "_metadata": {"etag": "6c529e2adb31bc08ce63c57af35ffae4"}
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;


--echo ################################################################################

--echo # Updating Root Object and no changes to Sub-object.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: NO INSERT, NO UPDATE, NO DELETE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY REFERENCES p_t1(f1), f12 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH (NO INSERT, NO UPDATE, NO DELETE)
                                                'f11' : f11,
                                                'f12' : f12
                                            )) FROM p_t2  WHERE p_t2.f11 = p_t1.f1
                                )
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 333,
      "childN" : [{"f11" : 1, "f12":2}],
      "_metadata": {"etag": "073a8c14e558c59d028bc2a64d9aad2d"}
} ';


SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ################################################################################

--echo # Updating Root Object and Inserting Sub-object.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: READ ONLY

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT REFERENCES p_t1(f1), f13 INT);

INSERT INTO p_t1 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(
                                                WITH (NO INSERT, NO UPDATE, NO DELETE)
                                                'f11' : f11,
                                                'f13' : f13
                                            )) FROM p_t2 WHERE p_t2.f12 = p_t1.f1)
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

--error ER_JDV_MISSING_INSERT_TAG
UPDATE p_dv1 SET data = ' {
     "_id" : 1,
     "f2" : 222,
     "childN" : [ {"f11" : 1, "f13":333} ]
} ';


SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ################################################################################
--echo # Updating Root Object and Inserting Sub-object.

--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: INSERT

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT REFERENCES p_t1(f1), f13 INT);

INSERT INTO p_t1 VALUES (1, 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH INSERT
                                                'f11' : f11,
                                                'f13' : f13
                                            )) FROM p_t2  WHERE p_t2.f12 = p_t1.f1)
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

UPDATE p_dv1 SET data = ' {
     "_id" : 1,
     "f2" : 222,
     "childN" : [ {"f11" : 1, "f13":333} ],
     "_metadata": {"etag": "6c529e2adb31bc08ce63c57af35ffae4"}
} ';


SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;

--echo ################################################################################

--echo # Updating Root Object, inserting Sub-object and existing Sub-object elements
--echo # are not modified.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: INSERT

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT REFERENCES p_t1(f1), f13 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 1, 1);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH INSERT
                                                'f11' : f11,
                                                'f13' : f13
                                            )) FROM p_t2  WHERE p_t2.f12 = p_t1.f1)
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 222,
      "childN" : [ {"f11" : 1, "f13":1 }, {"f11" : 2, "f13" : 2 } ],
      "_metadata": {"etag": "70237a28cb5ac90c8fef4f093eb6bd4d"}
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;


--echo ################################################################################

--echo # Updating Root Object, inserting Sub-object, deleting Sub-object element
--echo # and remaining Sub-object elements are not modified.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: INSERT, DELETE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT REFERENCES p_t1(f1), f13 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 1, 1);
INSERT INTO p_t2 VALUES (2, 1, 11);
INSERT INTO p_t2 VALUES (3, 1, 111);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH (INSERT, DELETE)
                                                'f11' : f11,
                                                'f13' : f13
                                            )) FROM p_t2  WHERE p_t2.f12 = p_t1.f1)
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 222,
      "childN" : [ {"f11" : 2, "f13":11}, {"f11" : 3, "f13":111}, {"f11" : 4, "f13" : 1111} ],
      "_metadata": {"etag": "e5cb81a89db490b991f6ac00d3755ef6"}
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;


--echo ################################################################################

--echo # Updating Root Object, inserting Sub-object, deleting Sub-object element
--echo # modifying sub-object element and remaining Sub-object elements are not modified.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: INSERT, UPDATE, DELETE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT REFERENCES p_t1(f1), f13 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 1, 1);
INSERT INTO p_t2 VALUES (2, 1, 11);
INSERT INTO p_t2 VALUES (3, 1, 111);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH (INSERT, UPDATE, DELETE)
                                                'f11' : f11,
                                                'f13' : f13
                                            )) FROM p_t2  WHERE p_t2.f12 = p_t1.f1)
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 222,
      "childN" : [ {"f11" : 2, "f13":99}, {"f11" : 3, "f13":111}, {"f11" : 4, "f13" : 1111} ],
      "_metadata": {"etag": "e5cb81a89db490b991f6ac00d3755ef6"}
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;


--echo ################################################################################

--echo # Updating Root Object and inserting Sub-objects with same PK value and
--echo # different non-PK values.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: INSERT

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT REFERENCES p_t1(f1), f13 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 1, 1);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH INSERT
                                                'f11' : f11,
                                                'f13' : f13
                                            )) FROM p_t2  WHERE p_t2.f12 = p_t1.f1)
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

--error ER_JDV_PK_DUPLICATES_NOT_IDENTICAL
UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 222,
      "childN" : [ {"f11" : 1, "f13":222}, {"f11" : 1, "f13":111} ]
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;


--echo ################################################################################

--echo # Updating Root Object and inserting Sub-objects with same PK value and
--echo # same non-PK values.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: INSERT

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT REFERENCES p_t1(f1), f13 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 1, 1);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH INSERT
                                                'f11' : f11,
                                                'f13' : f13
                                            )) FROM p_t2  WHERE p_t2.f12 = p_t1.f1)
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

--error ER_JDV_MISSING_UPDATE_TAG
UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 222,
      "childN" : [ {"f11" : 1, "f13":222}, {"f11" : 1, "f13":222} ],
      "_metadata": {"etag": "70237a28cb5ac90c8fef4f093eb6bd4d"}
} ';

SELECT * FROM p_dv1;

DROP TABLE p_t2;
DROP TABLE p_t1;


--echo ################################################################################

--echo # Updating Root Object, inserting Sub-object, deleting Sub-object element
--echo # modifying sub-object element and remaining Sub-object elements are not modified.
--echo # Test verifies trigger execution.
--echo # Triggers:
--echo #     For UPDATE event on Root table.
--echo #     For INSERT, UPDATE, DELETE event on Sub-object's  table.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: INSERT, UPDATE, DELETE

CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f11 INT PRIMARY KEY, f12 INT REFERENCES p_t1(f1), f13 INT);

INSERT INTO p_t1 VALUES (1, 2);
INSERT INTO p_t2 VALUES (1, 1, 1);
INSERT INTO p_t2 VALUES (2, 1, 11);
INSERT INTO p_t2 VALUES (3, 1, 111);

CREATE TABLE p_t1_trigger_tbl(msg VARCHAR(500));
CREATE TRIGGER p_t1_trigger1 BEFORE UPDATE ON p_t1
     FOR EACH ROW INSERT INTO p_t1_trigger_tbl VALUES("BEFORE UPDATE EVENT");
CREATE TRIGGER p_t1_trigger2 AFTER UPDATE ON p_t1
     FOR EACH ROW INSERT INTO p_t1_trigger_tbl VALUES("AFTER UPDATE EVENT");

CREATE TABLE p_t2_trigger_tbl(msg VARCHAR(500));
CREATE TRIGGER p_t2_trigger1 BEFORE INSERT ON p_t2
     FOR EACH ROW INSERT INTO p_t2_trigger_tbl VALUES("BEFORE INSERT EVENT");
CREATE TRIGGER p_t2_trigger2 AFTER INSERT ON p_t2
     FOR EACH ROW INSERT INTO p_t2_trigger_tbl VALUES("AFTER INSERT EVENT");
CREATE TRIGGER p_t2_trigger3 BEFORE UPDATE ON p_t2
     FOR EACH ROW INSERT INTO p_t2_trigger_tbl VALUES("BEFORE UPDATE EVENT");
CREATE TRIGGER p_t2_trigger4 AFTER UPDATE ON p_t2
     FOR EACH ROW INSERT INTO p_t2_trigger_tbl VALUES("AFTER UPDATE EVENT");
CREATE TRIGGER p_t2_trigger5 BEFORE DELETE ON p_t2
     FOR EACH ROW INSERT INTO p_t2_trigger_tbl VALUES("BEFORE DELETE EVENT");
CREATE TRIGGER p_t2_trigger6 AFTER DELETE ON p_t2
     FOR EACH ROW INSERT INTO p_t2_trigger_tbl VALUES("AFTER DELETE EVENT");

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
      JSON_DUALITY_OBJECT(WITH UPDATE
                    '_id' : f1,
                    'f2'  : f2,
                    'childN' : (SELECT JSON_ARRAYAGG(JSON_DUALITY_OBJECT(WITH (INSERT, UPDATE, DELETE)
                                                'f11' : f11,
                                                'f13' : f13
                                            )) FROM p_t2  WHERE p_t2.f12 = p_t1.f1)
            ) FROM p_t1 ;

SELECT * FROM  p_dv1;

UPDATE p_dv1 SET data = ' {
     "_id" : 1,
      "f2" : 222,
      "childN" : [ {"f11" : 2, "f13":99}, {"f11" : 3, "f13":111}, {"f11" : 4, "f13" : 1111} ],
      "_metadata": {"etag": "e5cb81a89db490b991f6ac00d3755ef6"}
} ';

