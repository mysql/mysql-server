--echo ################################################################################

--echo # Updating Root table and replacing sub-object with an existing object.
--echo # Root object - Primary Key  Table annotations: INSERT, UPDATE, DELETE
--echo # Sub-object - Foreign Key   Table annotations: NO INSERT, NO UPDATE, NO DELETE

CREATE TABLE p_department(dept_id INT PRIMARY KEY, dname VARCHAR(100));
CREATE TABLE p_student(suid INT PRIMARY KEY, sname VARCHAR(100), dept_id INT REFERENCES p_department(dept_id));

INSERT INTO p_department VALUES (1, 'ENGLISH');
INSERT INTO p_department VALUES (2, 'MATHS');

INSERT INTO p_student VALUES (101, 'Manu', 1);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS SELECT
JSON_DUALITY_OBJECT(WITH (INSERT, UPDATE, DELETE)
       '_id' : suid,
       'name' : sname,
       'department': (SELECT JSON_DUALITY_OBJECT(
                                WITH (NO INSERT, NO UPDATE, NO DELETE)
                                'dept_id'  : dept_id,
                                'dname' : dname
                                  ) FROM p_department WHERE p_department.dept_id = p_student.dept_id
                     )
     ) FROM p_student ;
SELECT * FROM p_dv1;
SELECT * FROM p_student;

--echo # Replacing department to MATHS from ENGLISH.
UPDATE p_dv1 SET data = '
 {
   "_id" : 101,
   "name" : "Manu",
   "_metadata": {"etag": "0e7e5ac91ef6886a02a3798ecb2dc3f2"},
   "department" : { "dept_id" : 2, "dname" : "MATHS" }
 } ';

SELECT * FROM p_dv1;
SELECT * FROM p_student;

DROP TABLE p_student;
DROP TABLE p_department;

--echo ################################################################################

--echo # Updating root object and Sub object using table with self referencing FK.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: UPDATE

CREATE TABLE p_employee (empid INT PRIMARY KEY,
                         name VARCHAR(100),
                         mgrid INT REFERENCES p_employee(empid));

INSERT INTO p_employee VALUES(1, "M1", NULL);
INSERT INTO p_employee VALUES(2, "Mgr", 1);
INSERT INTO p_employee VALUES(10, "FirstEmployee", 2);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
            '_id' : empid,
            'name' : name,
            'mgr' : (SELECT JSON_DUALITY_OBJECT(WITH UPDATE
                                   'empid': empid,
                                   'name' : name,
                                   'mgr' : (SELECT JSON_DUALITY_OBJECT(WITH UPDATE
                                                          'empid' : empid,
                                                          'name'  : name
                                                         ) FROM p_employee MM  WHERE MM.empid = M.mgrid)
                                 ) FROM p_employee M  WHERE M.empid = emp.mgrid)
            ) FROM p_employee emp ;

SELECT * FROM p_dv1;

UPDATE p_dv1 SET data = '
{
  "_id" : 10,
  "name"  : "Manu",
  "_metadata": {"etag": "c751d860368bbae08179c07e686f2d07"},
  "mgr"   : {
              "empid" : 2,
              "name"  : "Manager",
              "mgr"   : {
                           "empid" : 1,
                           "name"  : "SeniorManager"
                        }
            }
} ' WHERE JSON_EXTRACT(data, "$._id") = 10;

SELECT * FROM p_dv1;
SELECT * FROM p_employee;

DROP TABLE p_employee;


--echo ################################################################################

--echo # Updating Root object and Sub object using table with circular referecing.
--echo # Root object - Primary Key  Table annotations: UPDATE
--echo # Sub-object - Foreign Key   Table annotations: UPDATE

CREATE TABLE p_department (deptid INT PRIMARY KEY,
                           name varchar(100),
                           mgrid INT);
CREATE TABLE p_employee (empid INT PRIMARY KEY,
                         name VARCHAR(100),
                         deptid INT REFERENCES p_department(deptid));

INSERT INTO p_department VALUES(888, 'IMPACT', 1);
INSERT INTO p_employee VALUES(1, "M1", NULL), (10, "FirstEmployee", 888);

CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH UPDATE
  '_id' : empid,
  'name' : name,
  'dept' : (SELECT JSON_DUALITY_OBJECT(WITH UPDATE
                          'deptid' : deptid,
                          'name'   : name,
                          'dept_mgr' : (SELECT JSON_DUALITY_OBJECT(WITH UPDATE
                                                      'empid' : empid,
                                                      'name'  : name
                                               ) FROM p_employee DM
                                          WHERE DM.empid = D.mgrid)
                   ) FROM p_department D  where D.deptid = E.deptid)
) FROM p_employee E ;

SELECT * FROM p_dv1;
SELECT * FROM p_department;
SELECT * FROM p_employee;

UPDATE p_dv1 SET data =
' {
    "_id" : 10,
    "name" : "Manu",
    "dept" : { "deptid" : 888,
               "name"   : "ACT",
               "dept_mgr" : {
                              "empid" : 1,
                              "name"  : "SeniorManager"
                            }
              }
    }' WHERE JSON_EXTRACT(data, '$._id') = 10;

SELECT * FROM p_dv1;
SELECT * FROM p_department;
SELECT * FROM p_employee;

DROP TABLE p_employee;
DROP TABLE p_department;

