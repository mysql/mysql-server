################################################################################
# Updating Root Object and updating Sub-object.
# Root object - Primary Key  Table annotations: INSERT, UPDATE, DELETE
# Sub-object - Primary Key   Table annotations: INSERT, UPDATE
# Join_condition - Root object.non_pk_column = sub_object.PK
################################################################################
CREATE TABLE p_t1 (f1 INT PRIMARY KEY, f2 INT);
CREATE TABLE p_t2 (f3 INT PRIMARY KEY, f4 INT, f5 INT);
INSERT INTO p_t1 VALUES (1, 1);
INSERT INTO p_t2 VALUES (1, 1, 1);
CREATE OR REPLACE JSON DUALITY VIEW p_dv1 AS
SELECT JSON_DUALITY_OBJECT(WITH (INSERT, UPDATE, DELETE)
"_id" : f3,
"f4" : f4,
"f5" : f5,
"ChildNode" : (SELECT JSON_DUALITY_OBJECT(WITH (INSERT, UPDATE)
"f1" : f1,
"f2" : f2
) FROM p_t1
WHERE p_t1.f1 = p_t2.f4)
) FROM p_t2 ;
