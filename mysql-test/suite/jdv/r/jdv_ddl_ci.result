#
# 20.3. SHOW CREATE version comments and semantic round trips
#
CREATE TABLE gct_show (
id INT PRIMARY KEY,
value_check INT,
value_no_check INT,
value_update INT,
value_no_update INT,
value_update_check INT,
value_update_no_check INT,
value_no_update_check INT,
value_no_update_no_check INT
);
INSERT INTO gct_show VALUES (1, 10, 20, 30, 40, 50, 60, 70, 80);
# 20.3.1: standalone table CHECK is emitted as the complete
# versioned clause /*!261000 WITH (CHECK) */.
CREATE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
WITH CHECK
"_id" : id,
"value" : value_check
)
FROM gct_show;
SHOW CREATE VIEW gct_show_view;
