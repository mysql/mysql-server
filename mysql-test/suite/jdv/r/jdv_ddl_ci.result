#################################################################
# WL#17054: granular table and column annotations
#################################################################
# Shared tables for DDL and metadata tests.
#
CREATE TABLE gct_base (
id INT PRIMARY KEY,
check_value INT,
no_check_value INT,
update_value INT,
no_update_value INT,
default_value INT DEFAULT 700
);
CREATE TABLE gct_singleton (
id INT PRIMARY KEY,
check_value INT,
no_check_value INT,
update_value INT,
no_update_value INT
);
CREATE TABLE gct_parent (
id INT PRIMARY KEY,
singleton_id INT,
check_value INT,
no_check_value INT,
FOREIGN KEY (singleton_id) REFERENCES gct_singleton(id)
);
CREATE TABLE gct_nested (
id INT PRIMARY KEY,
parent_id INT,
check_value INT,
no_check_value INT,
FOREIGN KEY (parent_id) REFERENCES gct_parent(id)
);
INSERT INTO gct_base VALUES (1, 10, 20, 30, 40, 50);
INSERT INTO gct_singleton VALUES (10, 100, 200, 300, 400);
INSERT INTO gct_parent VALUES (1, 10, 1000, 2000);
INSERT INTO gct_nested VALUES (100, 1, 10000, 20000),
(101, 1, 10001, 20001);
#
# 20.1. Table-level CHECK and NO CHECK tags
#
# 20.1.1: explicit CHECK is accepted on a root table.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
WITH CHECK
"_id" : id,
"check_value" : check_value
)
FROM gct_base;
# The explicit root CHECK setting is visible in table metadata.
SELECT TABLE_NAME, REFERENCED_TABLE_NAME, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view';
TABLE_NAME	REFERENCED_TABLE_NAME	ALLOW_CHECK
gct_view	gct_base	1
DROP VIEW gct_view;
# 20.1.1: explicit CHECK is accepted independently on root,
# singleton, and nested tables.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
WITH CHECK
"_id" : p.id,
"check_value" : p.check_value,
"singleton" : (
SELECT JSON_DUALITY_OBJECT(
WITH CHECK
"id" : s.id,
"check_value" : s.check_value
)
FROM gct_singleton AS s
WHERE s.id = p.singleton_id
),
"nested" : (
SELECT JSON_ARRAYAGG(
JSON_DUALITY_OBJECT(
WITH CHECK
"id" : n.id,
"check_value" : n.check_value
)
)
FROM gct_nested AS n
WHERE n.parent_id = p.id
)
)
FROM gct_parent AS p;
# Recording the document verifies that all three annotated levels are usable.
SELECT data FROM gct_view;
data
{"_id": 1, "nested": [{"id": 100, "check_value": 10000}, {"id": 101, "check_value": 10001}], "_metadata": {"etag": "609e5a4c4ed49a4936d42a8cbbf7e902"}, "singleton": {"id": 10, "check_value": 100}, "check_value": 1000}
# Table metadata records CHECK for all projected levels.
SELECT REFERENCED_TABLE_NAME, ALLOW_CHECK, IS_ROOT_TABLE
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY REFERENCED_TABLE_NAME;
REFERENCED_TABLE_NAME	ALLOW_CHECK	IS_ROOT_TABLE
gct_nested	1	0
gct_parent	1	1
gct_singleton	1	0
DROP VIEW gct_view;
# 20.1.2: explicit NO CHECK is accepted independently on root and
# child tables.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
WITH NO CHECK
"_id" : p.id,
"check_value" : p.check_value,
"singleton" : (
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, NO CHECK)
"id" : s.id,
"check_value" : s.check_value
)
FROM gct_singleton AS s
WHERE s.id = p.singleton_id
),
"nested" : (
SELECT JSON_ARRAYAGG(
JSON_DUALITY_OBJECT(
WITH (INSERT, UPDATE, DELETE, NO CHECK)
"id" : n.id,
"check_value" : n.check_value
)
)
FROM gct_nested AS n
WHERE n.parent_id = p.id
)
)
FROM gct_parent AS p;
# Table metadata records NO CHECK for all projected levels.
SELECT REFERENCED_TABLE_NAME, ALLOW_CHECK, IS_ROOT_TABLE
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY REFERENCED_TABLE_NAME;
REFERENCED_TABLE_NAME	ALLOW_CHECK	IS_ROOT_TABLE
gct_nested	0	0
gct_parent	0	1
gct_singleton	0	0
DROP VIEW gct_view;
# 20.1.3: omitting a table CHECK tag defaults its columns to CHECK.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
"_id" : id,
"check_value" : check_value
)
FROM gct_base;
# The default CHECK value is visible at both table and column level.
SELECT 'TABLE' AS OBJECT_TYPE, REFERENCED_TABLE_NAME AS OBJECT_NAME,
ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_TABLES
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
UNION ALL
SELECT 'COLUMN', JSON_KEY_NAME, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY OBJECT_TYPE, OBJECT_NAME;
