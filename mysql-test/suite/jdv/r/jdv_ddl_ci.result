gct_show_view	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER JSON RELATIONAL DUALITY VIEW `gct_show_view` AS select json_duality_object( WITH (UPDATE /*!261000 , CHECK */) '_id':`gct_show`.`id`,'value':`gct_show`.`value_update`) AS `Name_exp_1` from `gct_show`	utf8mb4	utf8mb4_0900_ai_ci
# 20.3.4: existing table NO UPDATE likewise remains ordinary SQL
# while only NO CHECK is version-commented.
CREATE OR REPLACE JSON DUALITY VIEW gct_show_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (NO UPDATE, NO CHECK)
"_id" : id,
"value" : value_no_update
)
FROM gct_show;
SHOW CREATE VIEW gct_show_view;
View	Create View	character_set_client	collation_connection
gct_show_view	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER JSON RELATIONAL DUALITY VIEW `gct_show_view` AS select json_duality_object( WITH (/*!261000 NO CHECK, */ NO UPDATE) '_id':`gct_show`.`id`,'value':`gct_show`.`value_no_update`) AS `Name_exp_1` from `gct_show`	utf8mb4	utf8mb4_0900_ai_ci
DROP VIEW gct_show_view;
DROP TABLE gct_show;
# 20.3.5: create a mixed-tag source view for an executable
# SHOW CREATE version-comment round trip.
CREATE TABLE gct_roundtrip (
id INT PRIMARY KEY,
mutable_value INT,
protected_value INT
);
INSERT INTO gct_roundtrip VALUES (1, 10, 20);
CREATE JSON DUALITY VIEW gct_roundtrip_source AS
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, CHECK)
"_id" : id,
"mutable_value" : mutable_value WITH (UPDATE, CHECK),
"protected_value" : protected_value WITH (NO UPDATE, NO CHECK)
)
FROM gct_roundtrip;
# Record the canonical version comments emitted for the source.
SHOW CREATE VIEW gct_roundtrip_source;
View	Create View	character_set_client	collation_connection
gct_roundtrip_source	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER JSON RELATIONAL DUALITY VIEW `gct_roundtrip_source` AS select json_duality_object( WITH (UPDATE /*!261000 , CHECK */) '_id':`gct_roundtrip`.`id`,'mutable_value':`gct_roundtrip`.`mutable_value` /*!261000 WITH (UPDATE,CHECK) */,'protected_value':`gct_roundtrip`.`protected_value` /*!261000 WITH (NO UPDATE,NO CHECK) */) AS `Name_exp_1` from `gct_roundtrip`	utf8mb4	utf8mb4_0900_ai_ci
# Execute that canonical annotation structure under a second name.
# Removing every /*!261000 ... */ fragment leaves pre-WL valid SQL.
CREATE JSON DUALITY VIEW gct_roundtrip_copy AS select json_duality_object( WITH (UPDATE /*!261000 , CHECK */) '_id':`gct_roundtrip`.`id`,'mutable_value':`gct_roundtrip`.`mutable_value` /*!261000 WITH (UPDATE,CHECK) */,'protected_value':`gct_roundtrip`.`protected_value` /*!261000 WITH (NO UPDATE,NO CHECK) */) AS `Name_exp_1` from `gct_roundtrip`;
SHOW CREATE VIEW gct_roundtrip_copy;
View	Create View	character_set_client	collation_connection
gct_roundtrip_copy	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER JSON RELATIONAL DUALITY VIEW `gct_roundtrip_copy` AS select json_duality_object( WITH (UPDATE /*!261000 , CHECK */) '_id':`gct_roundtrip`.`id`,'mutable_value':`gct_roundtrip`.`mutable_value` /*!261000 WITH (UPDATE,CHECK) */,'protected_value':`gct_roundtrip`.`protected_value` /*!261000 WITH (NO UPDATE,NO CHECK) */) AS `Name_exp_1` from `gct_roundtrip`	utf8mb4	utf8mb4_0900_ai_ci
# Source and recreated views produce the same document and ETAG.
SELECT data FROM gct_roundtrip_source;
data
{"_id": 1, "_metadata": {"etag": "0356056dcbd132a717f580dface86c13"}, "mutable_value": 10, "protected_value": 20}
SELECT data FROM gct_roundtrip_copy;
data
{"_id": 1, "_metadata": {"etag": "0356056dcbd132a717f580dface86c13"}, "mutable_value": 10, "protected_value": 20}
# Source and recreated columns have identical effective permissions.
SELECT source.JSON_KEY_NAME,
source.ALLOW_CHECK = copy.ALLOW_CHECK AS same_allow_check,
source.ALLOW_UPDATE = copy.ALLOW_UPDATE AS same_allow_update
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS AS source
JOIN INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS AS copy
ON copy.TABLE_SCHEMA = source.TABLE_SCHEMA
AND copy.JSON_KEY_NAME = source.JSON_KEY_NAME
AND copy.TABLE_NAME = 'gct_roundtrip_copy'
WHERE source.TABLE_SCHEMA = DATABASE()
AND source.TABLE_NAME = 'gct_roundtrip_source'
ORDER BY source.JSON_KEY_NAME;
JSON_KEY_NAME	same_allow_check	same_allow_update
_id	1	1
mutable_value	1	1
protected_value	1	1
# An allowed mutable update succeeds through the source definition.
UPDATE gct_roundtrip_source
SET data = JSON_SET(data, '$.mutable_value', 11)
WHERE data->>'$._id' = 1;
SELECT id, mutable_value, protected_value FROM gct_roundtrip;
id	mutable_value	protected_value
1	11	20
UPDATE gct_roundtrip SET mutable_value = 10 WHERE id = 1;
# The equivalent mutable update succeeds through the recreated view.
UPDATE gct_roundtrip_copy
SET data = JSON_SET(data, '$.mutable_value', 11)
WHERE data->>'$._id' = 1;
SELECT id, mutable_value, protected_value FROM gct_roundtrip;
id	mutable_value	protected_value
1	11	20
UPDATE gct_roundtrip SET mutable_value = 10 WHERE id = 1;
# The source rejects a protected change with ER_JDV_MISSING_UPDATE_TAG.
UPDATE gct_roundtrip_source
SET data = JSON_SET(data, '$.protected_value', 21)
WHERE data->>'$._id' = 1;
ERROR HY000: Missing UPDATE tag on `test`.`gct_roundtrip`.protected_value, path '$.protected_value'.
# The recreated view rejects the protected change with
# ER_JDV_MISSING_UPDATE_TAG.
UPDATE gct_roundtrip_copy
SET data = JSON_SET(data, '$.protected_value', 21)
WHERE data->>'$._id' = 1;
ERROR HY000: Missing UPDATE tag on `test`.`gct_roundtrip`.protected_value, path '$.protected_value'.
# A direct NO CHECK change preserves ETAG in both definitions.
UPDATE gct_roundtrip SET protected_value = 21 WHERE id = 1;
SELECT @roundtrip_source_etag =
JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
AS source_no_check_keeps_etag
FROM gct_roundtrip_source;
source_no_check_keeps_etag
1
SELECT @roundtrip_copy_etag =
JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
AS copy_no_check_keeps_etag
FROM gct_roundtrip_copy;
copy_no_check_keeps_etag
1
DROP VIEW gct_roundtrip_copy;
DROP VIEW gct_roundtrip_source;
# 20.3.6: SHOW CREATE for an untagged view does not inject an
# explicit CHECK clause, while effective CHECK still defaults to 1.
CREATE JSON DUALITY VIEW gct_untagged_source AS
SELECT JSON_DUALITY_OBJECT(
"_id" : id,
"mutable_value" : mutable_value,
"protected_value" : protected_value
)
FROM gct_roundtrip;
SHOW CREATE VIEW gct_untagged_source;
View	Create View	character_set_client	collation_connection
gct_untagged_source	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER JSON RELATIONAL DUALITY VIEW `gct_untagged_source` AS select json_duality_object('_id':`gct_roundtrip`.`id`,'mutable_value':`gct_roundtrip`.`mutable_value`,'protected_value':`gct_roundtrip`.`protected_value`) AS `Name_exp_1` from `gct_roundtrip`	utf8mb4	utf8mb4_0900_ai_ci
# Recreate the emitted untagged definition under a second name.
CREATE JSON DUALITY VIEW gct_untagged_copy AS select json_duality_object('_id':`gct_roundtrip`.`id`,'mutable_value':`gct_roundtrip`.`mutable_value`,'protected_value':`gct_roundtrip`.`protected_value`) AS `Name_exp_1` from `gct_roundtrip`;
# Both untagged definitions retain default CHECK semantics and output.
SELECT TABLE_NAME, JSON_KEY_NAME, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE()
AND TABLE_NAME IN ('gct_untagged_source', 'gct_untagged_copy')
ORDER BY TABLE_NAME, JSON_KEY_NAME;
TABLE_NAME	JSON_KEY_NAME	ALLOW_CHECK
gct_untagged_copy	_id	1
gct_untagged_copy	mutable_value	1
gct_untagged_copy	protected_value	1
gct_untagged_source	_id	1
gct_untagged_source	mutable_value	1
gct_untagged_source	protected_value	1
SELECT data FROM gct_untagged_source;
data
{"_id": 1, "_metadata": {"etag": "e9231fd9f80509a13bb187e955c89ace"}, "mutable_value": 10, "protected_value": 21}
SELECT data FROM gct_untagged_copy;
data
{"_id": 1, "_metadata": {"etag": "e9231fd9f80509a13bb187e955c89ace"}, "mutable_value": 10, "protected_value": 21}
DROP VIEW gct_untagged_copy;
DROP VIEW gct_untagged_source;
DROP TABLE gct_roundtrip;
# 20.4: failed CREATE OR REPLACE and ALTER leave an existing JDV intact.
CREATE TABLE gct_atomicity (
id INT PRIMARY KEY,
mutable_value INT
);
INSERT INTO gct_atomicity VALUES (1, 10);
CREATE JSON DUALITY VIEW gct_atomicity_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, CHECK)
"_id" : id,
"mutable_value" : mutable_value
)
FROM gct_atomicity;
# A duplicate CHECK annotation prevents CREATE OR REPLACE.
CREATE OR REPLACE JSON DUALITY VIEW gct_atomicity_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, CHECK, CHECK)
"_id" : id,
"mutable_value" : mutable_value
)
FROM gct_atomicity;
ERROR HY000: Invalid JSON duality view definition: Invalid, Duplicate or Conflicting annotations for the JSON field.
# The same new annotation violation prevents ALTER.
ALTER JSON DUALITY VIEW gct_atomicity_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, CHECK, CHECK)
"_id" : id,
"mutable_value" : mutable_value
)
FROM gct_atomicity;
ERROR HY000: Invalid JSON duality view definition: Invalid, Duplicate or Conflicting annotations for the JSON field.
# The original definition and its UPDATE behavior remain intact.
SHOW CREATE VIEW gct_atomicity_view;
View	Create View	character_set_client	collation_connection
gct_atomicity_view	CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER JSON RELATIONAL DUALITY VIEW `gct_atomicity_view` AS select json_duality_object( WITH (UPDATE /*!261000 , CHECK */) '_id':`gct_atomicity`.`id`,'mutable_value':`gct_atomicity`.`mutable_value`) AS `Name_exp_1` from `gct_atomicity`	utf8mb4	utf8mb4_0900_ai_ci
UPDATE gct_atomicity_view
SET data = JSON_SET(data, '$.mutable_value', 11)
WHERE data->>'$._id' = 1;
SELECT id, mutable_value FROM gct_atomicity;
id	mutable_value
1	11
DROP VIEW gct_atomicity_view;
DROP TABLE gct_atomicity;
