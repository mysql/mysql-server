#
# 20.2. Column-level CHECK, NO CHECK, UPDATE, and NO UPDATE tags
#
# 20.2.1: all four supported column tags are accepted on non-PK
# projections.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, CHECK)
"_id" : id WITH NO CHECK,
"checked" : check_value WITH CHECK,
"not_checked" : no_check_value WITH NO CHECK,
"updatable" : update_value WITH UPDATE,
"not_updatable" : no_update_value WITH NO UPDATE
)
FROM gct_base;
# Column metadata records the effective setting of every projection.
SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;
JSON_KEY_NAME	ALLOW_UPDATE	ALLOW_CHECK
_id	0	0
checked	1	1
not_checked	1	0
not_updatable	0	1
updatable	1	1
DROP VIEW gct_view;
# Parenthesized single column tags are accepted.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, CHECK)
"_id" : id WITH (CHECK),
"checked" : check_value WITH (CHECK),
"not_checked" : no_check_value WITH (NO CHECK),
"updatable" : update_value WITH (UPDATE),
"not_updatable" : no_update_value WITH (NO UPDATE)
)
FROM gct_base;
DROP VIEW gct_view;
# 20.2.2: untagged columns inherit NO CHECK and NO UPDATE from
# their table.
# 20.2.3: explicit column tags override both inherited settings.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (NO UPDATE, NO CHECK)
"_id" : id,
"inherited" : check_value,
"overridden" : update_value WITH (UPDATE, CHECK)
)
FROM gct_base;
SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;
JSON_KEY_NAME	ALLOW_UPDATE	ALLOW_CHECK
_id	0	0
inherited	0	0
overridden	1	1
DROP VIEW gct_view;
# Untagged non-PK columns inherit UPDATE and CHECK from their table.
# Explicit NO UPDATE and NO CHECK override both inherited settings.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, CHECK)
"_id" : id,
"inherited" : check_value,
"overridden" : no_check_value WITH (NO UPDATE, NO CHECK)
)
FROM gct_base;
SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;
JSON_KEY_NAME	ALLOW_UPDATE	ALLOW_CHECK
_id	0	1
inherited	1	1
overridden	0	0
DROP VIEW gct_view;
# 20.2.4: valid column-tag groups are order agnostic.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
WITH (UPDATE, CHECK)
"_id" : id,
"first_order" : check_value WITH (CHECK, UPDATE),
"second_order" : no_check_value WITH (UPDATE, CHECK),
"restrictive_order" : no_update_value WITH (NO CHECK, NO UPDATE)
)
FROM gct_base;
SELECT JSON_KEY_NAME, ALLOW_UPDATE, ALLOW_CHECK
FROM INFORMATION_SCHEMA.JSON_DUALITY_VIEW_COLUMNS
WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'gct_view'
ORDER BY JSON_KEY_NAME;
JSON_KEY_NAME	ALLOW_UPDATE	ALLOW_CHECK
_id	0	1
first_order	1	1
restrictive_order	0	0
second_order	1	1
DROP VIEW gct_view;
# 20.2.5: multiple column tags without parentheses are rejected
# with ER_PARSE_ERROR.
CREATE JSON DUALITY VIEW gct_view AS
SELECT JSON_DUALITY_OBJECT(
"_id" : id,
"value" : check_value WITH CHECK, UPDATE
