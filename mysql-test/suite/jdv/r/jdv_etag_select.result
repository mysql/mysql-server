# 3.5: adding a CHECK grandchild below a NO CHECK intermediate changes
# ETAG, exercising recursive checked-subtree detection.
INSERT INTO gct_recursive_checked_leaf VALUES (301, 30, 3001);
SELECT data FROM gct_membership_view;
data
{"_id": 1, "_metadata": {"etag": "4cd371b71e0ab94049b576d2d325d040"}, "checked_children": [{"id": 10, "checked_value": 100}], "recursive_children": [{"id": 30, "unchecked_value": 300, "checked_grandchildren": [{"id": 300, "checked_value": 3000}, {"id": 301, "checked_value": 3001}], "unchecked_grandchildren": [{"id": 400, "unchecked_value": 4000}]}], "unchecked_children": [{"id": 20, "unchecked_value": 200}]}
SELECT @etag_before_checked_grandchild_add <>
JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
AS checked_grandchild_add_changes_etag
FROM gct_membership_view;
checked_grandchild_add_changes_etag
1
# 3.5: removing that recursively checked grandchild changes ETAG again.
DELETE FROM gct_recursive_checked_leaf WHERE id = 301;
SELECT data FROM gct_membership_view;
data
{"_id": 1, "_metadata": {"etag": "b84c7a1d9dc0c3f9e8077695d94781c0"}, "checked_children": [{"id": 10, "checked_value": 100}], "recursive_children": [{"id": 30, "unchecked_value": 300, "checked_grandchildren": [{"id": 300, "checked_value": 3000}], "unchecked_grandchildren": [{"id": 400, "unchecked_value": 4000}]}], "unchecked_children": [{"id": 20, "unchecked_value": 200}]}
SELECT @etag_before_checked_grandchild_remove <>
JSON_UNQUOTE(JSON_EXTRACT(data, '$._metadata.etag'))
AS checked_grandchild_remove_changes_etag
FROM gct_membership_view;
checked_grandchild_remove_changes_etag
