--source include/have_mysql_rest_service_component.inc

# Verify that restart preserves the installer context even when it cancels the
# initial backend before account provisioning begins.

--source include/have_debug.inc
--source include/not_solaris.inc

--echo
--echo
--echo ## I. Restart before initial account provisioning
--echo #

--disable_query_log
SET @@GLOBAL.DEBUG =
  '+d, mrs_component_pause_before_account_provisioning';
--enable_query_log

--connect(component_mrs_init, localhost, root,,)
--let $skip_schema_init=1
--let $init_does_mrs_bootstrap=1
--source ../include/cmrs/initialize.inc
--disconnect component_mrs_init
--connection default

--source ../../router/include/mrs/initialize_schema.inc

--let $fixed_accounts = `SELECT COUNT(*) FROM mysql.user WHERE User IN ('mysql_mrs_metadata', 'mysql_mrs_data') AND Host = 'localhost'`
--let $assert_text = account provisioning remains pending before restart
--let $assert_cond = $fixed_accounts = 0
--source include/assert.inc

# The current backend retains its captured pause. Disable the keyword so the
# replacement backend started by restart does not pause.
--disable_query_log
SET @@GLOBAL.DEBUG =
  '-d, mrs_component_pause_before_account_provisioning';
--enable_query_log

SELECT mysql_rest_service_restart();

--let $wait_timeout=60
--let $wait_condition=SELECT COUNT(*) = 2 FROM mysql.user WHERE User IN ('mysql_mrs_metadata', 'mysql_mrs_data') AND Host = 'localhost'
--source include/wait_condition.inc

--source ../include/cmrs/wait_mrs_read_metadata.inc

--let $mrs_state = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mysql_rest_service.state';`
--let $assert_text = state reports READY after the interrupted provisioning resumes
--let $assert_cond = "$mrs_state" = "READY"
--source include/assert.inc

--source ../include/cmrs/cleanup.inc
