--source include/have_mysql_rest_service_component.inc

# Verify that MRS provisions its internal accounts when its installation was
# deferred until the metadata schema was deployed and the service is restarted
# by a caller without account-provisioning privileges.

--source include/not_solaris.inc

--echo
--echo
--echo ## I. Restart MRS immediately after metadata schema deployment
--echo #

# Install the component without the schema. The initial startup defers account
# provisioning because the provider roles do not exist yet.
--connect(component_mrs_init, localhost, root,,)
--let $skip_schema_init=1
--let $init_does_mrs_bootstrap=1
--source ../include/cmrs/initialize.inc
--disconnect component_mrs_init
--connection default

--let $wait_log_pattern = Provider role \'mysql_rest_service_meta_provider\'@\'%\' is not available yet
--let $wait_log_expected_count=1
--source ../include/cmrs/compare_log_timeout.inc

--let $wait_condition=SELECT VARIABLE_VALUE = 'WAITING_FOR_METADATA' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mysql_rest_service.state'
--source include/wait_condition.inc

--let $mrs_state = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mysql_rest_service.state';`
--let $assert_text = state reports WAITING_FOR_METADATA before schema deployment
--let $assert_cond = "$mrs_state" = "WAITING_FOR_METADATA"
--source include/assert.inc

--disable_query_log
--disable_result_log
CREATE USER 'mrs_restart_caller'@'localhost';
GRANT MYSQL_REST_SERVICE_ADMIN ON *.* TO
  'mrs_restart_caller'@'localhost';
--enable_result_log
--enable_query_log

--source ../../router/include/mrs/initialize_schema.inc

--connect(mrs_restart_caller, localhost, mrs_restart_caller,,)
SELECT mysql_rest_service_restart();
--connection default
--disconnect mrs_restart_caller

--let $wait_timeout=60
--let $wait_condition=SELECT COUNT(*) = 2 FROM mysql.user WHERE User IN ('mysql_mrs_metadata', 'mysql_mrs_data') AND Host = 'localhost'
--source include/wait_condition.inc

--source ../include/cmrs/wait_mrs_read_metadata.inc

--let $mrs_state = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'mysql_rest_service.state';`
--let $assert_text = state reports READY after deferred account provisioning
--let $assert_cond = "$mrs_state" = "READY"
--source include/assert.inc

--disable_query_log
--disable_result_log
DROP USER 'mrs_restart_caller'@'localhost';
--enable_result_log
--enable_query_log

--source ../include/cmrs/cleanup.inc
