

## I. Confirm component metadata registry (default)
#
# 1. Confirm the metadata is populated accordingly in the default case
# 2. Confirm the metadata is updated when the hostname or port changes
# 3. Confirm a registration uniqueness conflict is recoverable
#
# MySQL Rest Service schema created.
# MySQL REST Service component installed.

#
## I. 1. Confirm the metadata is populated accordingly in the default case
include/assert.inc [Router ID must be 1]
include/assert.inc [router_name must be @@hostname:http_port]
include/assert.inc [address must be @@hostname]
include/assert.inc [product_name must be 'MySQL Rest Service Component']
include/assert.inc [version must be @@version]
include/assert.inc [mrs_metadata_accounts[0] must match]
include/assert.inc [mrs_data_accounts[0] must match]
include/assert.inc [server_uuid must match]
include/assert.inc [options must be {}]

#
## I. 2. Confirm the metadata is updated when the hostname or port changes
mysql_rest_service_restart()
0
include/assert.inc [Router ID must be 1]
include/assert.inc [router_name must be @@hostname:http_port+1]
include/assert.inc [address must be @@hostname]
include/assert.inc [product_name must be 'MySQL Rest Service Component']
include/assert.inc [version must be @@version]
include/assert.inc [mrs_metadata_accounts[0] must match]
include/assert.inc [mrs_data_accounts[0] must match]
include/assert.inc [server_uuid must match]
include/assert.inc [options must be {}]

#
## I. 3. Confirm a registration uniqueness conflict is recoverable
mysql_rest_service_restart()
0
include/assert.inc [router_name must remain unchanged after a uniqueness conflict]
include/assert.inc [address must remain unchanged after a uniqueness conflict]
mysql_rest_service_start()
0
include/assert.inc [router_name must update after resolving the uniqueness conflict]
include/assert.inc [address must update after resolving the uniqueness conflict]

#
# Cleanup
DROP SCHEMA mysql_rest_service_metadata;
DROP ROLE mysql_rest_service_admin;
DROP ROLE mysql_rest_service_schema_admin;
DROP ROLE mysql_rest_service_meta_provider;
DROP ROLE mysql_rest_service_data_provider;
DROP ROLE mysql_rest_service_dev;
