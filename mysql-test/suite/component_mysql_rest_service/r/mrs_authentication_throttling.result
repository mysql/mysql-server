# MySQL Rest Service schema created.
# MySQL REST Service component installed.
# DB `basic_schema` - created
CREATE USER 'mrs_throttle_1'@'%' IDENTIFIED BY 'secret1';
CREATE USER 'mrs_throttle_2'@'%' IDENTIFIED BY 'secret2';
# Registred SERVICE at path: /throttle
# Registred DB_SCHEMA at path: /throttle/db
# Registred DB_OBJECT at path: /throttle/db/items
# Registred AUTH APP at path: /throttle
# Registred AUTH APP at path: /throttle
# Registred MRS USER: "mrs_throttle_1"
# Registred MRS USER: "mrs_throttle_2"
# Registred AUTH APP at path: NULL

# Per-host maximum rate counts successful and failed MySQL attempts.
UPDATE mysql_rest_service_metadata.config SET data =
'{"authentication":{"throttling":{"perHost":{"maximumAttemptsPerMinute":2},"blockWhenAttemptsExceededInSeconds":2}}}';
SELECT mysql_rest_service_restart();
mysql_rest_service_restart()
0
# Per-host rate limiting also applies to MRS/SCRAM requests.
SELECT mysql_rest_service_restart();
mysql_rest_service_restart()
0
# OAuth2 authorization initiations use the same per-host limiter.
SELECT mysql_rest_service_restart();
mysql_rest_service_restart()
0

# Per-account limiting isolates MySQL and MRS account keys.
UPDATE mysql_rest_service_metadata.config SET data =
'{"authentication":{"throttling":{"perAccount":{"maximumAttemptsPerMinute":2},"blockWhenAttemptsExceededInSeconds":2}}}';
SELECT mysql_rest_service_restart();
mysql_rest_service_restart()
0

# Minimum interval blocks immediately and expires after its bounded delay.
UPDATE mysql_rest_service_metadata.config SET data =
'{"authentication":{"throttling":{"perHost":{"minimumTimeBetweenRequestsInMs":1000}}}}';

# Cleanup
DROP USER 'mrs_throttle_1'@'%', 'mrs_throttle_2'@'%';
UNINSTALL COMPONENT "file://component_mysql_rest_service";
DROP SCHEMA basic_schema;
DROP SCHEMA mysql_rest_service_metadata;
DROP ROLE mysql_rest_service_admin;
DROP ROLE mysql_rest_service_schema_admin;
DROP ROLE mysql_rest_service_meta_provider;
DROP ROLE mysql_rest_service_data_provider;
DROP ROLE mysql_rest_service_dev;
