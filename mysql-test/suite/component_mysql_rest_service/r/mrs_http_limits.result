

## I. Verify runtime HTTP connection-limit updates
# MySQL Rest Service schema created.
# MySQL REST Service component installed.
# Registred SERVICE at path: /limits
# Registred DB_SCHEMA at path: /limits/db
# Registred DB_OBJECT at path: /limits/db/holder
# Registred DB_OBJECT at path: /limits/db/set-max-connections
LOCK TABLES mrs_http_limits.connection_holder WRITE;
SET GLOBAL mysql_rest_service.http_max_connections = 1;
UNLOCK TABLES;
SET GLOBAL mysql_rest_service.http_max_connections = DEFAULT;

## II. Verify a REST procedure can update the HTTP connection limit
include/assert.inc [REST procedure updates http_max_connections]
SET GLOBAL mysql_rest_service.http_max_connections = DEFAULT;

## III. Verify runtime request-body limit updates and zero-body handling
SET GLOBAL mysql_rest_service.http_max_request_body_size = 0;
Not Found(404)
SET GLOBAL mysql_rest_service.http_max_request_body_size = DEFAULT;

## IV. Verify response-body limit updates and zero-body handling
SET GLOBAL mysql_rest_service.http_max_response_body_size = 0;
Internal Error(500)

Ok(200)

SET GLOBAL mysql_rest_service.http_max_response_body_size = DEFAULT;

## V. Verify a stopped-backend update is applied at the next start
SELECT mysql_rest_service_stop();
mysql_rest_service_stop()
0
SET GLOBAL mysql_rest_service.http_max_request_body_size = 0;
SELECT mysql_rest_service_start();
mysql_rest_service_start()
0
SET GLOBAL mysql_rest_service.http_max_request_body_size = DEFAULT;

# Cleanup
UNINSTALL COMPONENT "file://component_mysql_rest_service";
DROP SCHEMA mrs_http_limits;
DROP SCHEMA mysql_rest_service_metadata;
DROP ROLE mysql_rest_service_admin;
DROP ROLE mysql_rest_service_schema_admin;
DROP ROLE mysql_rest_service_meta_provider;
DROP ROLE mysql_rest_service_data_provider;
DROP ROLE mysql_rest_service_dev;
