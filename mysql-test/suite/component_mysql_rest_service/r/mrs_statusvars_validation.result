

## I. Validate active runtime values
## II. Validate configured values do not change the active snapshot
## III. Validate inactive values and republishing after start
# MySQL Rest Service schema created.
# MySQL REST Service component installed.
include/assert.inc [current_http_port reports the active listener port]
include/assert.inc [current_tls_cert reports the active certificate path]
include/assert.inc [current_tls_key reports the active private-key path]
include/assert.inc [current_tls_cipher reports a resolved active policy]
include/assert.inc [current_io_worker_threads reports 25% of logical CPUs rounded up]
include/assert.inc [configured http_port does not change current_http_port]
include/assert.inc [configured ssl_cert does not change current_tls_cert]
include/assert.inc [configured ssl_key does not change current_tls_key]
include/assert.inc [configured ssl_cipher does not change current_tls_cipher]
include/assert.inc [configured io_worker_threads does not change current_io_worker_threads]
FLUSH STATUS;
include/assert.inc [FLUSH STATUS does not reset current runtime values]
SELECT mysql_rest_service_stop();
mysql_rest_service_stop()
0
include/assert.inc [current_http_port is inactive after stop]
include/assert.inc [current_tls_cert is inactive after stop]
include/assert.inc [current_tls_key is inactive after stop]
include/assert.inc [current_tls_cipher is inactive after stop]
include/assert.inc [current_io_worker_threads is inactive after stop]
SELECT mysql_rest_service_start();
mysql_rest_service_start()
0
include/assert.inc [current_tls_cert applies the configured path after start]
include/assert.inc [current_tls_key applies the configured path after start]
include/assert.inc [current_tls_cipher applies the configured policy after start]
include/assert.inc [current_io_worker_threads applies the configured count after start]

# Cleanup
UNINSTALL COMPONENT "file://component_mysql_rest_service";
DROP SCHEMA mysql_rest_service_metadata;
DROP ROLE mysql_rest_service_admin;
DROP ROLE mysql_rest_service_schema_admin;
DROP ROLE mysql_rest_service_meta_provider;
DROP ROLE mysql_rest_service_data_provider;
DROP ROLE mysql_rest_service_dev;
include/assert.inc [MRS Component status variables must be unregistered]
