

## I. Validate component status after a server restart
#
# 1. Ensure a working component remains operational after a restart with a persisted HTTP port setting
# 2. Reject an invalid metadata account immediately during server startup
# 3. Reject a missing metadata account immediately during server startup
# MySQL Rest Service schema created.
# MySQL REST Service component installed.

#
# I.1. Ensure a working component remains operational after a restart
include/assert.inc [SET PERSIST_ONLY must not change current http_max_connections]
# restart;
include/assert.inc [MRS Component persisted http_port must be active after restart]
include/assert.inc [MRS Component persisted http_max_connections must be loaded after restart]
include/assert.inc [MRS Component persisted http_max_request_body_size must be loaded after restart]
include/assert.inc [MRS Component persisted http_max_response_body_size must be loaded after restart]

#
# I.2. Reject an invalid metadata account during server startup
REVOKE 'mysql_rest_service_meta_provider'
  FROM 'mysql_mrs_metadata'@'localhost';
# restart;

#
# I.3. Reject a missing metadata account during server startup
DROP USER 'mysql_mrs_metadata'@'localhost';
# restart;

#
# Cleanup
UNINSTALL COMPONENT "file://component_mysql_rest_service";
DROP SCHEMA mysql_rest_service_metadata;
DROP ROLE mysql_rest_service_admin;
DROP ROLE mysql_rest_service_schema_admin;
DROP ROLE mysql_rest_service_meta_provider;
DROP ROLE mysql_rest_service_data_provider;
DROP ROLE mysql_rest_service_dev;
