

## I. Keep current runtime values inactive until MRS reports ready
SET @@GLOBAL.DEBUG = '+d, mrs_component_pause_before_runtime_status_publication';
# MySQL Rest Service schema created.
# MySQL REST Service component installed.
include/assert.inc [current_http_port remains inactive before MRS is ready]
include/assert.inc [current_tls_cert remains inactive before MRS is ready]
include/assert.inc [current_tls_key remains inactive before MRS is ready]
include/assert.inc [current_tls_cipher remains inactive before MRS is ready]
include/assert.inc [current_io_worker_threads remains inactive before MRS is ready]
include/assert.inc [state reports STARTING before MRS is ready]
SELECT mysql_rest_service_start();
mysql_rest_service_start()
0
SET @@GLOBAL.DEBUG = '-d, mrs_component_pause_before_runtime_status_publication';
SELECT mysql_rest_service_stop();
mysql_rest_service_stop()
0
include/assert.inc [state reports STOPPED after synchronous stop]
include/assert.inc [cancelled startup does not start the metadata monitor]
SELECT mysql_rest_service_start();
mysql_rest_service_start()
0
include/assert.inc [current_http_port is published after MRS is ready]
include/assert.inc [state reports READY after MRS is ready]
SELECT mysql_rest_service_start();
mysql_rest_service_start()
0

# Cleanup
UNINSTALL COMPONENT "file://component_mysql_rest_service";
DROP SCHEMA mysql_rest_service_metadata;
DROP ROLE mysql_rest_service_admin;
DROP ROLE mysql_rest_service_schema_admin;
DROP ROLE mysql_rest_service_meta_provider;
DROP ROLE mysql_rest_service_data_provider;
DROP ROLE mysql_rest_service_dev;
