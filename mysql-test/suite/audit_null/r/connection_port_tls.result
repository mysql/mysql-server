connecting...
active session is now 'plain_sess'
Login OK
has_port	tls_matches	is_tls
1	1	0
0 rows affected
# Recreate the session on the existing TLS connection
Mysqlx.Ok {
}

Login OK
has_port	tls_matches	is_tls
1	1	1
0 rows affected
closing session tls_sess
Mysqlx.Ok {
  msg: "bye!"
}
switched to session default
closing session plain_sess
Mysqlx.Ok {
  msg: "bye!"
}
switched to session default
ok
DROP USER tls_user@'%';
UNINSTALL PLUGIN null_audit;
