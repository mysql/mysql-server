[mysqld]
connect-timeout=60
log-bin-trust-function-creators=1
innodb-buffer-pool-size=24M
innodb-redo-log-capacity=10M
loose-enable-performance-schema
loose-performance-schema-accounts-size=100
loose-performance-schema-digests-size=400
loose-performance-schema-hosts-size=100
loose-performance-schema-users-size=100
loose-performance-schema-setup-actors-size=100
loose-performance-schema-setup-objects-size=100
loose-performance-schema-events-waits-history-size=10
loose-performance-schema-events-waits-history-long-size=10000
loose-performance-schema-events-stages-history-size=10
loose-performance-schema-events-stages-history-long-size=1000
loose-performance-schema-events-statements-history-size=10
loose-performance-schema-events-statements-history-long-size=1000
loose-performance-schema-events-transactions-history-size=10
loose-performance-schema-events-transactions-history-long-size=1000
loose-performance-schema-session-connect-attrs-size=2048
loose-performance-schema-instrument='%=ON'
loose-performance-schema-consumer-events-stages-current=ON
loose-performance-schema-consumer-events-stages-history=ON
loose-performance-schema-consumer-events-stages-history-long=ON
loose-performance-schema-consumer-events-statements-cpu=ON
loose-performance-schema-consumer-events-statements-current=ON
loose-performance-schema-consumer-events-statements-history=ON
loose-performance-schema-consumer-events-statements-history-long=ON
loose-performance-schema-consumer-events-transactions-current=ON
loose-performance-schema-consumer-events-transactions-history=ON
loose-performance-schema-consumer-events-transactions-history-long=ON
loose-performance-schema-consumer-events-waits-current=ON
loose-performance-schema-consumer-events-waits-history=ON
loose-performance-schema-consumer-events-waits-history-long=ON
loose-performance-schema-consumer-global-instrumentation=ON
loose-performance-schema-consumer-thread-instrumentation=ON
log-error-verbosity=3

[mysql]
default-character-set=utf8mb4

[mysqlshow]
default-character-set=utf8mb4

[mysqlimport]
default-character-set=utf8mb4

[mysqlcheck]
default-character-set=utf8mb4

[mysql_upgrade]
default-character-set=utf8mb4

[mysqltest]
default-character-set=utf8mb4
server-public-key-path=/Users/hlosukwakha/Development/mysql-server/mysql-test/std_data/rsa_public_key.pem
ssl-mode=DISABLED

[mysqld.1]
#!run-master-sh
loose-enable-performance-schema
#abs_datadir=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/mysqld.1/data
#host=localhost
#log-error=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/log/mysqld.1.err
caching_sha2_password_private_key_path=/Users/hlosukwakha/Development/mysql-server/mysql-test/std_data/rsa_private_key.pem
caching_sha2_password_public_key_path=/Users/hlosukwakha/Development/mysql-server/mysql-test/std_data/rsa_public_key.pem
loose-sha256_password_private_key_path=/Users/hlosukwakha/Development/mysql-server/mysql-test/std_data/rsa_private_key.pem
loose-sha256_password_public_key_path=/Users/hlosukwakha/Development/mysql-server/mysql-test/std_data/rsa_public_key.pem
character-sets-dir=/Users/hlosukwakha/Development/mysql-server/share/charsets
datadir=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/mysqld.1/data
port=13000
admin-port=13001
general_log=1
general_log_file=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/mysqld.1/mysqld.log
loose-mysqlx-port=13020
loose-mysqlx-socket=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/tmp/mysqlx.1.sock
loose-mysqlx-ssl=DISABLED
loose-mysqlx-ssl-ca=
loose-mysqlx-ssl-cert=
loose-mysqlx-ssl-key=
pid-file=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/run/mysqld.1.pid
server-id=1
slow_query_log=1
slow_query_log_file=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/mysqld.1/mysqld-slow.log
socket=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/tmp/mysqld.1.sock
ssl-ca=/Users/hlosukwakha/Development/mysql-server/mysql-test/std_data/cacert.pem
ssl-cert=/Users/hlosukwakha/Development/mysql-server/mysql-test/std_data/server-cert.pem
ssl-key=/Users/hlosukwakha/Development/mysql-server/mysql-test/std_data/server-key.pem
tmpdir=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/tmp/mysqld.1
loose-sha256_password_auto_generate_rsa_keys=0
loose-caching_sha2_password_auto_generate_rsa_keys=0
#mtr_basedir=/Users/hlosukwakha/Development/mysql-server
#password=
#user=root
secure-file-priv=/Users/hlosukwakha/Development/mysql-server/mysql-test/var

[mysqlbinlog]
disable-force-if-open
character-sets-dir=/Users/hlosukwakha/Development/mysql-server/share/charsets
local-load=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/tmp

[ENV]
MASTER_MYPORT=13000
MASTER_ADMINPORT=13001
MASTER_MYSOCK=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/tmp/mysqld.1.sock
MASTER_X_MYPORT=13020
MASTER_X_MYSOCK=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/tmp/mysqlx.1.sock

[client]
socket=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/tmp/mysqld.1.sock
password=
user=root
host=localhost
port=13000

[client.1]
socket=/Users/hlosukwakha/Development/mysql-server/mysql-test/var/tmp/mysqld.1.sock
user=root
password=
host=localhost
port=13000

