diff --git a/sql/sched_affinity_manager.cc b/sql/sched_affinity_manager.cc
new file mode 100644
index 00000000..a7cc3afa
--- /dev/null
+++ b/sql/sched_affinity_manager.cc
@@ -0,0 +1,615 @@
+/*****************************************************************************
